<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DbMigrator</RootNamespace>
    <AssemblyName>DbMigrator</AssemblyName>
    <!-- Microsoft.Data.SqlClient does not support Invariant Globalization Mode
         (it throws "Globalization Invariant Mode is not supported" at
         connection time) — do not re-add this setting. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
  </ItemGroup>

</Project>
