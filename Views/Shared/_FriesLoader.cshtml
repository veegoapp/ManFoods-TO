@* Fries-carton page loader. Placed as the first child of a page body (.page-content).
   Shows while the page and all of its data requests are loading, then fades out. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<MvcApp.Resources.SharedResource> L
<div class="page-loader" id="pageLoader" role="status" aria-live="polite">
    <svg class="page-loader-art" viewBox="0 -230 735 1230" aria-hidden="true">
        <defs>
            <clipPath id="plClip"><polygon points="0,-250 735,-250 735,291 678,291 672,292 666,292 660,293 654,293 648,293 642,294 636,294 630,295 624,296 618,302 612,309 606,316 600,322 594,329 588,336 582,342 576,349 570,355 564,361 558,367 552,373 546,378 540,384 534,389 528,394 522,398 516,403 510,407 504,411 498,415 492,418 486,422 480,425 474,428 468,431 462,433 456,435 450,437 444,439 438,441 432,443 426,443 420,445 414,446 408,447 402,448 396,449 390,450 384,449 378,450 372,450 366,450 360,450 354,450 348,449 342,449 336,448 330,447 324,446 318,445 312,444 306,443 300,441 294,438 288,437 282,435 276,432 270,430 264,429 258,425 252,421 246,419 240,415 234,411 228,407 222,404 216,400 210,394 204,390 198,385 192,380 186,374 180,369 174,363 168,356 162,351 156,343 150,337 144,331 138,325 132,316 126,308 120,302 114,295 108,295 102,294 96,293 90,293 84,292 78,292 72,291 0,291"/></clipPath>
            <linearGradient id="plFryG" x1="0" x2="1"><stop offset="0" stop-color="#FFD54A"/><stop offset=".55" stop-color="#FFC72C"/><stop offset="1" stop-color="#F0A400"/></linearGradient>
        </defs>
        <image href="@Url.Content("~/images/fries-carton.webp")" x="0" y="0" width="735" height="1000"/>
        <g clip-path="url(#plClip)">
<g transform="rotate(-9 146 470)"><rect class="pl-fry pl-fry-0" x="120" y="40" width="52" height="430" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(-6 186 470)"><rect class="pl-fry pl-fry-1" x="160" y="-30" width="52" height="500" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(-4 226 470)"><rect class="pl-fry pl-fry-2" x="200" y="20" width="52" height="450" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(-2 266 470)"><rect class="pl-fry pl-fry-3" x="240" y="-60" width="52" height="530" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(-1 308 470)"><rect class="pl-fry pl-fry-4" x="282" y="-5" width="52" height="475" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(0 350 470)"><rect class="pl-fry pl-fry-5" x="324" y="-70" width="52" height="540" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(1 392 470)"><rect class="pl-fry pl-fry-6" x="366" y="0" width="52" height="470" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(3 434 470)"><rect class="pl-fry pl-fry-7" x="408" y="-50" width="52" height="520" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(4 476 470)"><rect class="pl-fry pl-fry-8" x="450" y="10" width="52" height="460" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(6 518 470)"><rect class="pl-fry pl-fry-9" x="492" y="-25" width="52" height="495" rx="14" fill="url(#plFryG)"/></g>
<g transform="rotate(9 560 470)"><rect class="pl-fry pl-fry-10" x="534" y="45" width="52" height="425" rx="14" fill="url(#plFryG)"/></g>
        </g>
    </svg>
    <div class="page-loader-text">@L["Common_Loading"]</div>
</div>
<noscript><style>.page-loader{display:none}</style></noscript>
<script>
(function () {
    var el = document.getElementById('pageLoader');
    if (!el) return;
    if (el.parentElement) el.parentElement.classList.add('pl-host');
    var pending = 0, done = false, start = Date.now(), calm = 0;
    var MIN_MS = 600, CALM_MS = 450, MAX_MS = 25000;
    // Count in-flight data requests (jQuery ajax uses XHR) so the loader stays
    // until the page's data has actually arrived, not just the HTML.
    var send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function () {
        if (!done) { pending++; this.addEventListener('loadend', function () { pending = Math.max(0, pending - 1); }); }
        return send.apply(this, arguments);
    };
    if (window.fetch) {
        var f = window.fetch;
        window.fetch = function () {
            if (done) return f.apply(this, arguments);
            pending++;
            var p = f.apply(this, arguments);
            var dec = function () { pending = Math.max(0, pending - 1); };
            p.then(dec, dec);
            return p;
        };
    }
    function hide() {
        if (done) return;
        done = true;
        clearInterval(timer);
        el.classList.add('pl-hide');
        setTimeout(function () {
            el.style.display = 'none';
            if (el.parentElement) el.parentElement.classList.remove('pl-host');
        }, 400);
    }
    var timer = setInterval(function () {
        var age = Date.now() - start;
        if (age > MAX_MS) return hide();
        var quiet = document.readyState === 'complete' && pending === 0;
        calm = quiet ? calm + 100 : 0;
        if (calm >= CALM_MS && age >= MIN_MS) hide();
    }, 100);
    window.addEventListener('pageshow', function (e) { if (e.persisted) hide(); });
})();
</script>
