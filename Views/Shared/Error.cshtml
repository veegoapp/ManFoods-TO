@model ErrorViewModel
@{
    // Standalone page: there is no root-level _Layout (only the Admin/Home area layouts), so the
    // default Views/_ViewStart.cshtml layout can never be resolved here — and the error page must not
    // depend on anything that could itself fail (session, area, database).
    Layout = null;
    var _lang = Context.Request.Cookies["mf-lang"] == "ar" ? "ar" : "en";
}
<!DOCTYPE html>
<html lang="@_lang" dir="@(_lang == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Common_Error"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="p-4">
    <h1 class="text-danger">@L["Error_Title"]</h1>
    <h2 class="text-danger">@L["Error_Message"]</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>@L["Error_RequestId"]</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p><a href="/">@L["Common_Back"]</a></p>
</body>
</html>
