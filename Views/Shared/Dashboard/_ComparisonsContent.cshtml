        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.raw == null ? '—' : c.formattedValue + '%'}` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v == null ? '' : v.toFixed(1) + '%' } },
            scales: { y: { min: 0, max: 100, ticks: { callback: v => v + '%' } } }
        }
