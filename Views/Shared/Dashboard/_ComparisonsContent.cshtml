function cmpRenderExitCharts(dataA, dataB) {
    // Share of each side's own responses (a count would just reflect how many interviews each period had).
    const reasonRows = [dataA.exitReasons || [], dataB.exitReasons || []];
    const reasonTotals = reasonRows.map(rows => rows.reduce((s, x) => s + (x.value || 0), 0));
    const reasonMaps = reasonRows.map(rows => Object.fromEntries(rows.map(x => [x.label, x.value])));
    const share = (i, label) => reasonTotals[i] > 0 ? Math.round((reasonMaps[i][label] || 0) / reasonTotals[i] * 1000) / 10 : 0;
    const reasons = Array.from(new Set([
        ...Object.keys(reasonMaps[0]), ...Object.keys(reasonMaps[1])
    ])).sort((a, b) => (share(0, b) + share(1, b)) - (share(0, a) + share(1, a))).slice(0, 8);
    cmpExitReasonsChart = mkChart(cmpExitReasonsChart, 'cmpExitReasonsChart', {
        type: 'bar',
        data: { labels: reasons, datasets: [
            { label: cmpLabel('A'), data: reasons.map(x => share(0, x)), backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: reasons.map(x => share(1, x)), backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            indexAxis: 'y',
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}% (${reasonMaps[c.datasetIndex][reasons[c.dataIndex]] || 0})` } } },
            scales: { x: { ticks: { callback: v => v + '%' } } }
        }
    });

    const sentimentA = dataA.exitSentiment?.positivePercent || 0;
    const sentimentB = dataB.exitSentiment?.positivePercent || 0;
    cmpExitSentimentChart = mkChart(cmpExitSentimentChart, 'cmpExitSentimentChart', {
        type: 'bar',
        data: { labels: [cmpL.exitPositive], datasets: [
            { label: cmpLabel('A'), data: [sentimentA], backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: [sentimentB], backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v.toFixed(1) + '%' } },
            scales: { y: { min: 0, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });
    document.getElementById('cmpExitSentimentMeta').innerHTML =
        `<span class="me-3">${sapEscape(cmpLabel('A'))}: ${dataA.exitSentiment?.totalResponses || 0} ${sapEscape(cmpL.exitResponses)}</span>` +
        `<span>${sapEscape(cmpLabel('B'))}: ${dataB.exitSentiment?.totalResponses || 0} ${sapEscape(cmpL.exitResponses)}</span>`;
}

/* Exit Interview drivers — positive-answer % per question, A vs B, ordered by change (A − B), weakest first. */
let cmpExitDriversChart;
const CMP_DRIVER_MIN_RESPONSES = 10;
function cmpRenderDrivers(dataA, dataB) {
    const mapOf = rows => Object.fromEntries((rows || []).map(d => [d.label, d]));
    const mA = mapOf(dataA.exitDrivers), mB = mapOf(dataB.exitDrivers);
    const rows = Array.from(new Set([...Object.keys(mA), ...Object.keys(mB)]))
        .map(label => {
            const a = mA[label] || { positivePercent: 0, totalResponses: 0 }, b = mB[label] || { positivePercent: 0, totalResponses: 0 };
            return { label, a: a.positivePercent, b: b.positivePercent, na: a.totalResponses, nb: b.totalResponses,
                     low: a.totalResponses < CMP_DRIVER_MIN_RESPONSES || b.totalResponses < CMP_DRIVER_MIN_RESPONSES };
        })
        .filter(r => r.na > 0 || r.nb > 0)
        .sort((x, y) => (x.a - x.b) - (y.a - y.b));

    const tbody = document.getElementById('cmpDriversBody');
    if (!rows.length) {
        cmpExitDriversChart = mkChart(cmpExitDriversChart, 'cmpExitDriversChart', { type: 'bar', data: { labels: [], datasets: [] } });
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-3 text-muted">${cmpL.noDataShort}</td></tr>`;
        return;
    }

    cmpExitDriversChart = mkChart(cmpExitDriversChart, 'cmpExitDriversChart', {
        type: 'bar',
        data: { labels: rows.map(r => r.label), datasets: [
            { label: cmpLabel('A'), data: rows.map(r => r.a), backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: rows.map(r => r.b), backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            indexAxis: 'y',
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' },
                tooltip: { callbacks: { label: c => { const r = rows[c.dataIndex]; return ` ${c.dataset.label}: ${c.formattedValue}% (${c.datasetIndex === 0 ? r.na : r.nb} ${cmpL.responsesShort})`; } } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v.toFixed(0) + '%' : '' } },
            scales: { x: { min: 0, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });

    const ltr = v => `<span style="direction:ltr;unicode-bidi:isolate">${v > 0 ? '+' : ''}${v.toFixed(1)}</span>`;
    tbody.innerHTML = rows.map(r => {
        const d = r.a - r.b;
        const color = Math.abs(d) < 0.05 ? 'var(--text-3)' : d > 0 ? 'var(--success)' : 'var(--danger)';
        const title = r.low ? ` title="${sapEscape(cmpL.lowSample)}"` : '';
        return `<tr class="${r.low ? 'cmp-driver-low' : ''}"${title}>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.label)}</td>
            <td class="px-3 py-2 text-center">${r.a.toFixed(1)}% <span class="text-muted">(${r.na})</span></td>
            <td class="px-3 py-2 text-center">${r.b.toFixed(1)}% <span class="text-muted">(${r.nb})</span></td>
            <td class="px-3 py-2 text-center fw-bold" style="color:${color}">${ltr(d)}</td>
        </tr>`;
    }).join('');
}

/* Grouped A/B bars used by the Turnover Breakdown and Scorecard topics. */
const cmpExtraCharts = {};
function cmpDrawBars(id, labels, seriesA, seriesB, { pct = false, tooltip, line = false, horizontal = false } = {}) {
    const fmt = v => v == null ? '—' : pct ? v.toFixed(1) + '%' : (Number.isInteger(v) ? v : v.toFixed(1));
    const colorA = ChartColors.SERIES.SECONDARY, colorB = ChartColors.SERIES.PRIMARY;
    const base = (label, data, color) => line
        ? { label, data, borderColor: color, backgroundColor: color, tension: .25, spanGaps: true, pointRadius: 3 }
        : { label, data, backgroundColor: color, borderRadius: 4 };
    const axis = horizontal ? 'x' : 'y';
    cmpExtraCharts[id] = mkChart(cmpExtraCharts[id], id, {
        type: line ? 'line' : 'bar',
        data: { labels, datasets: [base(cmpLabel('A'), seriesA, colorA), base(cmpLabel('B'), seriesB, colorB)] },
        options: {
            indexAxis: horizontal ? 'y' : 'x',
            interaction: { mode: 'index', intersect: !line },
            plugins: { legend: { position: 'bottom' },
                tooltip: { callbacks: { label: c => tooltip ? tooltip(c) : ` ${c.dataset.label}: ${fmt(c.parsed[axis])}` } },
                datalabels: line
                    ? { display: false }
                    : { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? fmt(v) : '' } },
            scales: pct ? { [axis]: { min: 0, ticks: { callback: v => v + '%' } } } : {}
        }
    });
}

/* Turnover Breakdown: resignations by job / tenure / payroll group (counts; monthly averages when the sides differ in length). */
function cmpRenderBreakdown(dataA, dataB) {
    const draw = (id, rowsA, rowsB, keepOrder) => {
        const mapA = {}, mapB = {};
        (rowsA || []).forEach(r => mapA[r.label] = cmpPerMonth('A', r.value));
        (rowsB || []).forEach(r => mapB[r.label] = cmpPerMonth('B', r.value));
        let labels = Array.from(new Set([...(rowsA || []).map(r => r.label), ...(rowsB || []).map(r => r.label)]));
        if (!keepOrder) labels = labels.sort((x, y) => ((mapA[y] || 0) + (mapB[y] || 0)) - ((mapA[x] || 0) + (mapB[x] || 0))).slice(0, 8);
        cmpDrawBars(id, labels, labels.map(l => mapA[l] || 0), labels.map(l => mapB[l] || 0));
    };
    draw('cmpBkJobChart', dataA.bkJob, dataB.bkJob, false);
    draw('cmpBkTenureChart', dataA.bkTenure, dataB.bkTenure, true);   // tenure buckets keep their natural order
    draw('cmpBkPayrollChart', dataA.bkPayroll, dataB.bkPayroll, false);
}

/* Scorecard: share of each supervisor's store leaders that are flagged (above-average turnover). */
function cmpFlaggedOverall(sc) {
    // Each level lists every leader once, so the level with the most leaders gives the company-wide share.
    const levels = [sc.byOperationConsultant, sc.byOperationManager, sc.bySeniorOperationConsultant, sc.byOperationDirector].map(l => l || []);
    const best = levels.reduce((m, l) => (l.reduce((s, r) => s + r.totalLeaders, 0) > m.reduce((s, r) => s + r.totalLeaders, 0) ? l : m), []);
    const total = best.reduce((s, r) => s + r.totalLeaders, 0), flagged = best.reduce((s, r) => s + r.flaggedLeaders, 0);
    return total > 0 ? flagged * 100 / total : 0;
}
function cmpRenderScorecard(dataA, dataB) {
    const draw = (id, rowsA, rowsB) => {
        const mapA = Object.fromEntries((rowsA || []).map(r => [r.name, r])), mapB = Object.fromEntries((rowsB || []).map(r => [r.name, r]));
        const pctOf = (m, n) => m[n] ? Math.round(m[n].flaggedPercent * 10) / 10 : 0;
        const labels = Array.from(new Set([...Object.keys(mapA), ...Object.keys(mapB)]))
            .sort((x, y) => (pctOf(mapA, y) + pctOf(mapB, y)) - (pctOf(mapA, x) + pctOf(mapB, x))).slice(0, 8);
        cmpDrawBars(id, labels, labels.map(n => pctOf(mapA, n)), labels.map(n => pctOf(mapB, n)), {
            pct: true,
            tooltip: c => { const r = (c.datasetIndex === 0 ? mapA : mapB)[labels[c.dataIndex]]; return ` ${c.dataset.label}: ${c.parsed.y.toFixed(1)}%` + (r ? ` (${r.flaggedLeaders}/${r.totalLeaders})` : ''); }
        });
    };
    draw('cmpScOcChart', dataA.scorecard.byOperationConsultant, dataB.scorecard.byOperationConsultant);
    draw('cmpScOmChart', dataA.scorecard.byOperationManager, dataB.scorecard.byOperationManager);
    draw('cmpScSocChart', dataA.scorecard.bySeniorOperationConsultant, dataB.scorecard.bySeniorOperationConsultant);
    draw('cmpScOdChart', dataA.scorecard.byOperationDirector, dataB.scorecard.byOperationDirector);
}

function cmpRenderCharts(dataA, dataB, group) {
    ({
        turnover: cmpRenderTurnoverChart, ninety: cmpRenderNinetyChart, workforce: cmpRenderWorkforceCharts,
        retention: cmpRenderRetentionChart, exit: cmpRenderExitCharts, breakdown: cmpRenderBreakdown, scorecard: cmpRenderScorecard,
    })[group]?.(dataA, dataB);
}

let cmpTableRows = [];
let cmpTableSortCol = 'store', cmpTableSortAsc = true;
let cmpTurnoverColorRules = null, cmpNinetyColorRules = null;

function cmpComputeTableRows(dataA, dataB) {
    const turnoverA = {}, turnoverB = {}, ninetyA = {}, ninetyB = {};
    dataA.byStore.forEach(r => turnoverA[r.storeName] = r.turnoverRate);
    dataB.byStore.forEach(r => turnoverB[r.storeName] = r.turnoverRate);
    dataA.ninetyByStore.forEach(r => ninetyA[r.label ?? r.storeName] = r.rate ?? r.value);
    dataB.ninetyByStore.forEach(r => ninetyB[r.label ?? r.storeName] = r.rate ?? r.value);

    const stores = Array.from(new Set([...Object.keys(turnoverA), ...Object.keys(turnoverB), ...Object.keys(ninetyA), ...Object.keys(ninetyB)]));
    return stores.map(s => {
        const ta = turnoverA[s], tb = turnoverB[s], na = ninetyA[s], nb = ninetyB[s];
        return {
            store: s, ta, tb, na, nb,
            dt: (ta !== undefined && tb !== undefined) ? ta - tb : null,
            dn: (na !== undefined && nb !== undefined) ? na - nb : null,
        };
    });
}

function cmpRenderTable(dataA, dataB, group) {
    const card = document.getElementById('cmpTableCard');
    card.classList.toggle('cmp-g-turnover', group === 'turnover');
    card.classList.toggle('cmp-g-ninety', group === 'ninety');
    if (panels.A.store || panels.B.store) { card.style.display = 'none'; return; }
    card.style.display = '';

    cmpTableRows = cmpComputeTableRows(dataA, dataB);
    cmpRenderTableRows();
}

function cmpRenderTableRows() {
    if (!cmpTableRows.length) {
        document.getElementById('cmpTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">${cmpL.noDataShort}</td></tr>`;
        return;
    }
    const rateBadge = (rules, v) => (v === undefined || v === null) ? '<span class="text-muted">—</span>' : ChartColors.rateBadgeHtml(rules, v);
    const ltrDelta = v => v === null ? '—' : `<span style="direction:ltr;unicode-bidi:isolate">${v > 0 ? '+' : ''}${v.toFixed(1)}</span>`;

    const rows = cmpTableRows.slice().sort((a, b) => {
        const va = a[cmpTableSortCol], vb = b[cmpTableSortCol];
        const naMissing = va === undefined || va === null, nbMissing = vb === undefined || vb === null;
        if (naMissing && nbMissing) return 0;
        if (naMissing) return 1;   // missing values always sort to the bottom
        if (nbMissing) return -1;
        if (typeof va === 'string') return cmpTableSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
        return cmpTableSortAsc ? va - vb : vb - va;
    });

    document.getElementById('cmpTableBody').innerHTML = rows.map(r => `
        <tr>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.store)}</td>
            <td class="cmp-col-t px-3 py-2 text-center">${rateBadge(cmpTurnoverColorRules, r.ta)}</td>
            <td class="cmp-col-t px-3 py-2 text-center">${rateBadge(cmpTurnoverColorRules, r.tb)}</td>
            <td class="cmp-col-t px-3 py-2 text-center">${ltrDelta(r.dt)}</td>
            <td class="cmp-col-n px-3 py-2 text-center">${rateBadge(cmpNinetyColorRules, r.na)}</td>
            <td class="cmp-col-n px-3 py-2 text-center">${rateBadge(cmpNinetyColorRules, r.nb)}</td>
            <td class="cmp-col-n px-3 py-2 text-center">${ltrDelta(r.dn)}</td>
        </tr>`).join('');
}

/* Compare button, popup and "results are out of date" handling ------------- */
let cmpBusy = false, cmpHasResults = false, cmpStaleFlag = false;
/* Filters a topic cannot honour (its API has no such parameter) — better to say so than to compare unfiltered data. */
const CMP_UNSUPPORTED = { ninety: ['job'], retention: ['job'], scorecard: ['store', 'job'] };
function cmpUnsupportedSet(group) {
    return (CMP_UNSUPPORTED[group] || []).filter(f => panels.A[f] || panels.B[f]).map(f => f === 'job' ? cmpL.fJob : cmpL.fStore);
}
function cmpUpdateUnsupportedHint() {
    const names = (CMP_UNSUPPORTED[cmpSelectedGroup()] || []).map(f => f === 'job' ? cmpL.fJob : cmpL.fStore);
    document.getElementById('cmpUnsupported').hidden = names.length === 0;
    document.getElementById('cmpUnsupportedText').textContent = names.length ? cmpL.unsupported.replace('{0}', names.join(', ')) : '';
}
const cmpSelectedGroup = () => document.querySelector('input[name="cmpGroup"]:checked')?.value || '';

function cmpShowGroup(group) {
    document.querySelectorAll('[data-cmp-groups]').forEach(el =>
        el.classList.toggle('cmp-show', !!group && el.dataset.cmpGroups.split(' ').includes(group)));
}
function cmpResetResults() {
    cmpHasResults = false; cmpStaleFlag = false;
    cmpTabsReset();
    document.querySelectorAll('input[name="cmpGroup"]').forEach(r => { r.checked = false; });
    cmpShowGroup('');
    document.getElementById('cmpPeriodNotice').hidden = true;
    document.getElementById('cmpStale').hidden = true;
    cmpUpdateUnsupportedHint();
    document.getElementById('cmpEmptyState').style.display = '';
}
function cmpMarkStale() {
    if (!cmpHasResults) return;
    cmpStaleFlag = true;   // tabs that were not opened yet would load with the new filters — they ask for a new Compare instead
    document.getElementById('cmpStale').hidden = false;
}
function cmpPopup(text) {
    document.getElementById('cmpModalText').textContent = text;
    document.getElementById('cmpModal').hidden = false;
    document.getElementById('cmpModalOk').focus();
}
const cmpClosePopup = () => { document.getElementById('cmpModal').hidden = true; };
document.getElementById('cmpModalOk').addEventListener('click', cmpClosePopup);
document.getElementById('cmpModal').addEventListener('click', e => { if (e.target.id === 'cmpModal') cmpClosePopup(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') cmpClosePopup(); });
document.querySelectorAll('input[name="cmpGroup"]').forEach(r => r.addEventListener('change', () => { cmpUpdateUnsupportedHint(); cmpMarkStale(); }));

function cmpSetBusy(on, busyLabel) {
    cmpBusy = on;
    document.getElementById('cmpCompareBtn').disabled = on;
    document.getElementById('cmpCompareSpin').hidden = !on;
    document.getElementById('cmpCompareIcon').hidden = on;
    document.getElementById('cmpCompareLabel').textContent = on ? (busyLabel || cmpL.comparing) : cmpL.compareBtn;
}

async function cmpRefreshAll(group) {
    const [dataA, dataB] = await Promise.all([cmpFetchSide('A', group), cmpFetchSide('B', group)]);
    cmpUpdateNorm(group);
    // Show the group's sections first: Chart.js sizes a canvas from its container, which must be visible.
    cmpShowGroup(group);
    document.getElementById('cmpEmptyState').style.display = 'none';
    if (['turnover', 'ninety', 'workforce', 'scorecard'].includes(group)) cmpRenderKpis(dataA, dataB, group);
    if (['turnover', 'ninety'].includes(group)) { cmpRenderInsight(dataA, dataB, group); cmpRenderTable(dataA, dataB, group); }
    if (group === 'drivers') cmpRenderDrivers(dataA, dataB); else cmpRenderCharts(dataA, dataB, group);
    cmpHasResults = true; cmpStaleFlag = false;
    document.getElementById('cmpStale').hidden = true;
    cmpTabsStart(group, dataA, dataB);   // the topic's own extra tabs (loaded when opened)
}

document.getElementById('cmpCompareBtn').addEventListener('click', async () => {
    if (cmpBusy) return;   // one request set at a time — the button is also disabled while it runs
    const group = cmpSelectedGroup();
    if (!group) { cmpPopup(cmpL.needGroup); return; }
    if (!panels.A.months.length || !panels.B.months.length) { cmpPopup(cmpL.needMonths); return; }
    const blocked = cmpUnsupportedSet(group);
    if (blocked.length) { cmpPopup(cmpL.unsupportedPopup.replace('{0}', blocked.join(', '))); return; }
    cmpSetBusy(true);
    try { await cmpRefreshAll(group); }
    catch (e) { cmpPopup(e && e.message === '403' ? cmpL.noAccess : cmpL.loadFailed); }
    finally { cmpSetBusy(false); }
});

/* ══ Tabs ═══════════════════════════════════════════════════════════════════
   Each topic opens on its Overview (what the page always showed). Its other tabs are loaded only when opened,
   from the same filters the comparison was run with — so a tab never adds requests until somebody asks for it. */
const cmpStr = document.getElementById('cmpStr').dataset;
const S = k => cmpStr['s' + k[0].toUpperCase() + k.slice(1)] ?? k;
let cmpRun = null;   // { token, group, data: { A, B }, loaded: {}, active }

const cmpFmtCount = v => v == null ? '—' : (cmpNorm.uneven ? Number(v).toFixed(1) : String(Math.round(v)));
const cmpFmtNum = (v, d = 1) => v == null ? '—' : Number(v).toFixed(d);
const cmpFmtPct = v => v == null ? '—' : Number(v).toFixed(1) + '%';
const cmpBoth = (path, extra = '') => Promise.all(['A', 'B'].map(side => cmpGet(`${path}?${cmpBuildQuery(side)}${extra}`)));

/* tab id -> loader. Overview is the page's own content and has no loader. */
const CMP_TABS = {
    turnover:  [{ id: 'overview' }, { id: 'trend', load: cmpTabTurnoverTrend }, { id: 'teams', load: cmpTabTeams('turnover') }, { id: 'stores', load: cmpTabTurnoverStores }],
    workforce: [{ id: 'overview' }, { id: 'composition', load: cmpTabWorkforceComposition }, { id: 'trend', load: cmpTabWorkforceTrend }, { id: 'teams', load: cmpTabTeams('workforce') }, { id: 'stores', load: cmpTabWorkforceStores }],
    ninety:    [{ id: 'overview' }, { id: 'cohorts', load: cmpTabNinetyCohorts }, { id: 'breakdown', load: cmpTabNinetyBreakdown }, { id: 'teams', load: cmpTabNinetyTeams }],
    retention: [{ id: 'overview' }, { id: 'tenure', load: cmpTabRetentionTenure }, { id: 'stores', load: cmpTabRetentionStores }, { id: 'teams', load: cmpTabRetentionTeams }],
    exit:      [{ id: 'overview' }, { id: 'experience', load: cmpTabExitExperience }, { id: 'more', load: cmpTabExitMore }],
    scorecard: [{ id: 'overview' }, { id: 'supervisors', load: cmpTabScorecardSupervisors }, { id: 'leaders', load: cmpTabScorecardLeaders }],
};

function cmpTabsReset() {
    cmpDisposePane();
    cmpRun = null;
    const bar = document.getElementById('cmpTabs');
    bar.replaceChildren(); bar.hidden = true;
}
function cmpDisposePane() {
    Object.keys(cmpExtraCharts).filter(k => k.startsWith('cmpx-')).forEach(k => { try { cmpExtraCharts[k]?.destroy(); } catch { } delete cmpExtraCharts[k]; });
    const pane = document.getElementById('cmpTabPane');
    pane.replaceChildren(); pane.hidden = true;
}
function cmpTabsStart(group, dataA, dataB) {
    cmpDisposePane();
    cmpRun = { token: (cmpRun?.token || 0) + 1, group, data: { A: dataA, B: dataB }, loaded: { overview: true }, active: 'overview' };
    const tabs = CMP_TABS[group] || [];
    const bar = document.getElementById('cmpTabs');
    bar.replaceChildren();
    tabs.forEach(t => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'cmp-tab' + (t.id === 'overview' ? ' active' : ''); b.dataset.tab = t.id; b.setAttribute('role', 'tab');
        b.textContent = S('tab' + t.id[0].toUpperCase() + t.id.slice(1));
        b.addEventListener('click', () => cmpOpenTab(t.id));
        bar.appendChild(b);
    });
    bar.hidden = tabs.length <= 1;
}
function cmpActivateTab(id) {
    cmpRun.active = id;
    document.querySelectorAll('#cmpTabs .cmp-tab').forEach(b => b.classList.toggle('active', b.dataset.tab === id));
    const pane = document.getElementById('cmpTabPane');
    if (id === 'overview') { cmpShowGroup(cmpRun.group); pane.hidden = true; return; }
    cmpShowGroup('');
    pane.hidden = false;
    pane.querySelectorAll('.cmp-tabbody').forEach(el => { el.hidden = el.dataset.tab !== id; });
}
async function cmpOpenTab(id) {
    if (!cmpRun || cmpBusy || id === cmpRun.active) return;
    const tab = (CMP_TABS[cmpRun.group] || []).find(t => t.id === id);
    if (!tab) return;
    if (cmpRun.loaded[id]) { cmpActivateTab(id); return; }
    if (cmpStaleFlag) { cmpPopup(cmpL.staleTab); return; }

    const previous = cmpRun.active, token = cmpRun.token;
    const body = document.createElement('div');
    body.className = 'cmp-tabbody'; body.dataset.tab = id;
    body.innerHTML = `<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>${sapEscape(S('loading'))}</div>`;
    document.getElementById('cmpTabPane').appendChild(body);
    cmpSetBusy(true, S('loading'));
    cmpActivateTab(id);   // visible before drawing: Chart.js sizes a canvas from its container
    try {
        await tab.load(body, cmpRun);
        if (token === cmpRun?.token) cmpRun.loaded[id] = true;
    } catch (e) {
        body.remove();
        if (token === cmpRun?.token) cmpActivateTab(previous);
        cmpPopup(e && e.message === '403' ? cmpL.noAccess : cmpL.loadFailed);
    } finally {
        cmpSetBusy(false);
    }
}

/* ── building blocks ──────────────────────────────────────────────────────── */
const cmpUid = (c, base) => `cmpx-${c.dataset.tab}-${base}`;
function cmpGrid(c) { const g = document.createElement('div'); g.className = 'charts-grid mb-4'; c.appendChild(g); return g; }
function cmpNote(c, text) { const p = document.createElement('p'); p.className = 'text-muted'; p.textContent = text; c.appendChild(p); }
function cmpChartCard(grid, id, title, sub, basis) {
    const d = document.createElement('div');
    d.className = 'chart-card';
    d.innerHTML = `<div class="chart-header"><h6>${sapEscape(title)}</h6>${sub ? `<p>${sapEscape(sub)}</p>` : ''}</div>`
        + `<div class="chart-body"><canvas id="${id}"></canvas></div>`
        + (basis ? `<p class="cmp-chart-basis"><i class="bi bi-info-circle-fill"></i><span>${sapEscape(basis)}</span></p>` : '');
    grid.appendChild(d);
}
function cmpTableCard(c, title, sub, headers, rows) {
    const d = document.createElement('div');
    d.className = 'chart-card mb-4 p-0'; d.style.overflow = 'hidden';
    const head = headers.map(h => `<th class="px-3 py-2 text-center">${sapEscape(h)}</th>`).join('');
    const body = rows.length
        ? rows.map(r => `<tr>${r.map((cell, i) => `<td class="px-3 py-2 ${i === 0 ? 'fw-semibold' : 'text-center'}">${cell}</td>`).join('')}</tr>`).join('')
        : `<tr><td colspan="${headers.length}" class="text-center py-4 text-muted">${sapEscape(S('noDataShort'))}</td></tr>`;
    d.innerHTML = `<div class="chart-header px-3 pt-3"><h6>${sapEscape(title)}</h6>${sub ? `<p>${sapEscape(sub)}</p>` : ''}</div>`
        + `<div class="table-responsive" style="max-height:420px;overflow-y:auto"><table class="table table-hover mb-0" style="font-size:13px">`
        + `<thead style="background:var(--bg-2);position:sticky;top:0;z-index:1"><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
    c.appendChild(d);
}
/* Δ = A − B, coloured by whether the change is good (lowerIsBetter: true / false) or just a change (undefined). */
function cmpDeltaHtml(a, b, { lowerIsBetter, dec = 1 } = {}) {
    if (a == null || b == null) return '<span class="text-muted">—</span>';
    const d = a - b;
    const flat = Math.abs(d) < Math.pow(10, -dec) / 2;
    const good = lowerIsBetter === undefined ? null : (lowerIsBetter ? d <= 0 : d >= 0);
    const color = flat || good === null ? 'var(--text-3)' : good ? 'var(--success)' : 'var(--danger)';
    return `<span style="color:${color};font-weight:700;direction:ltr;unicode-bidi:isolate">${d > 0 ? '+' : ''}${d.toFixed(dec)}</span>`;
}
const cmpEsc = v => sapEscape(v == null ? '' : String(v));

/* A and B lists of {label,value} side by side: modes — 'count' (monthly average when the sides differ in length),
   'share' (percent of each side's own total) or 'value' (as is). */
function cmpPair(rowsA, rowsB, mode, { topN = 8, keepOrder = false } = {}) {
    const lab = r => r.label || '—';
    const fold = (rows, side) => {
        const total = (rows || []).reduce((sum, r) => sum + (r.value || 0), 0);
        const m = new Map();
        (rows || []).forEach(r => {
            const v = mode === 'share' ? (total > 0 ? r.value * 100 / total : 0) : mode === 'count' ? cmpPerMonth(side, r.value) : r.value;
            m.set(lab(r), (m.get(lab(r)) || 0) + v);
        });
        return m;
    };
    const ma = fold(rowsA, 'A'), mb = fold(rowsB, 'B');
    let labels = [...new Set([...(rowsA || []).map(lab), ...(rowsB || []).map(lab)])];
    if (!keepOrder) labels.sort((x, y) => ((ma.get(y) || 0) + (mb.get(y) || 0)) - ((ma.get(x) || 0) + (mb.get(x) || 0)));
    if (topN) labels = labels.slice(0, topN);
    const r1 = v => Math.round((v || 0) * 10) / 10;
    return { labels, a: labels.map(l => r1(ma.get(l))), b: labels.map(l => r1(mb.get(l))) };
}
/* One bar chart per [endpoint, title, sub] — both sides of the same endpoint. */
async function cmpTabBarCharts(c, defs, mode, basis) {
    const results = await Promise.all(defs.map(d => cmpBoth(d.path)));
    c.replaceChildren();
    const grid = cmpGrid(c);
    defs.forEach((d, i) => {
        const [ra, rb] = results[i];
        const p = cmpPair(ra, rb, d.mode || mode, { topN: d.topN ?? 8, keepOrder: !!d.keepOrder });
        const id = cmpUid(c, d.id);
        cmpChartCard(grid, id, d.title + S('vs'), d.sub, basis);
        cmpDrawBars(id, p.labels, p.a, p.b, { pct: (d.mode || mode) === 'share' || !!d.pct });
    });
}
/* Month-by-month lines/bars from the series both sides share (x axis = month number). */
function cmpSeriesCards(c, sa, sb, defs) {
    const months = [...new Set([...sa.map(p => p.month), ...sb.map(p => p.month)])].sort((x, y) => x - y);
    const at = (series, m, pick) => { const p = series.find(x => x.month === m); return p ? pick(p) : null; };
    const grid = cmpGrid(c);
    defs.forEach(d => {
        const id = cmpUid(c, d.id);
        cmpChartCard(grid, id, d.title + S('vs'), d.sub);
        cmpDrawBars(id, months.map(cmpMonthShortName), months.map(m => at(sa, m, d.pick)), months.map(m => at(sb, m, d.pick)), { pct: !!d.pct, line: !!d.line });
    });
}

/* ── Turnover ─────────────────────────────────────────────────────────────── */
async function cmpTabTurnoverTrend(c) {
    const [sa, sb] = await cmpBoth('/api/dashboard/monthly-series');
    c.replaceChildren();
    cmpSeriesCards(c, sa, sb, [
        { id: 'rate', title: S('chartMonthlyTrend'), pick: p => p.turnoverRate, pct: true, line: true },
        { id: 'res', title: S('seriesResignations'), pick: p => p.resignations },
        { id: 'hires', title: S('seriesHires'), pick: p => p.newHires },
    ]);
}
/* OC / OM / SOC / OD tables (turnover: resignations + rate; workforce: headcount + rate). */
function cmpTabTeams(kind) {
    return async c => {
        const [oa, ob] = await cmpBoth('/api/dashboard/oc-om-analysis');
        c.replaceChildren();
        [['ocRows', S('commonOc')], ['omRows', S('commonOm')], ['socRows', S('commonSoc')], ['odRows', S('commonOd')]].forEach(([key, title]) => {
            const ma = new Map((oa[key] || []).map(r => [r.name, r])), mb = new Map((ob[key] || []).map(r => [r.name, r]));
            const rate = n => (ma.get(n)?.avgTurnoverRate || 0) + (mb.get(n)?.avgTurnoverRate || 0);
            const names = [...new Set([...ma.keys(), ...mb.keys()])].sort((x, y) => rate(y) - rate(x));
            const cnt = (m, n, f, side) => m.get(n) ? cmpPerMonth(side, m.get(n)[f]) : null;
            const rows = names.map(n => {
                const ra = ma.get(n)?.avgTurnoverRate ?? null, rb = mb.get(n)?.avgTurnoverRate ?? null;
                const stores = ma.get(n)?.storeCount ?? mb.get(n)?.storeCount;
                if (kind === 'workforce') {
                    const ha = cnt(ma, n, 'totalHeadcount', 'A'), hb = cnt(mb, n, 'totalHeadcount', 'B');
                    return [cmpEsc(n), stores, cmpFmtCount(ha), cmpFmtCount(hb), cmpDeltaHtml(ha, hb, { dec: cmpNorm.uneven ? 1 : 0 }), cmpFmtPct(ra), cmpFmtPct(rb)];
                }
                const xa = cnt(ma, n, 'totalResignations', 'A'), xb = cnt(mb, n, 'totalResignations', 'B');
                return [cmpEsc(n), stores, cmpFmtCount(xa), cmpFmtCount(xb), cmpFmtPct(ra), cmpFmtPct(rb), cmpDeltaHtml(ra, rb, { lowerIsBetter: true })];
            });
            const headers = kind === 'workforce'
                ? [S('colName'), S('colStores'), S('colHeadcount') + ' A', S('colHeadcount') + ' B', S('colChange'), S('colTurnover') + ' A', S('colTurnover') + ' B']
                : [S('colName'), S('colStores'), S('colResignations') + ' A', S('colResignations') + ' B', S('colTurnover') + ' A', S('colTurnover') + ' B', S('colChange')];
            cmpTableCard(c, title + S('vs'), S('rankedByWeighted'), headers, rows);
        });
    };
}
/* Stores that moved the most, from the store data the Overview already loaded (no request). */
async function cmpTabTurnoverStores(c, run) {
    c.replaceChildren();
    const A = run.data.A.byStore || [], B = run.data.B.byStore || [];
    if (!A.length || !B.length) { cmpNote(c, S('noStoreBreakdown')); return; }
    const mb = new Map(B.map(r => [r.storeName, r]));
    const rows = A.filter(r => mb.has(r.storeName)).map(r => ({ name: r.storeName, a: r.turnoverRate, b: mb.get(r.storeName).turnoverRate }))
        .map(r => ({ ...r, d: r.a - r.b }));
    const render = (title, list) => cmpTableCard(c, title, '', [S('colStore'), S('colTurnover') + ' A', S('colTurnover') + ' B', S('colChange')],
        list.map(r => [cmpEsc(r.name), cmpFmtPct(r.a), cmpFmtPct(r.b), cmpDeltaHtml(r.a, r.b, { lowerIsBetter: true })]));
    render(S('moversImproved'), rows.filter(r => r.d < 0).sort((x, y) => x.d - y.d).slice(0, 10));
    render(S('moversWorsened'), rows.filter(r => r.d > 0).sort((x, y) => y.d - x.d).slice(0, 10));
}

/* ── Workforce ────────────────────────────────────────────────────────────── */
async function cmpTabWorkforceComposition(c) {
    await cmpTabBarCharts(c, [
        { id: 'job', path: '/api/dashboard/headcount-by-job-title', title: S('chartHeadcountByJobTitle'), sub: S('subHeadcountByJobTitle') },
        { id: 'tenure', path: '/api/dashboard/headcount-by-tenure', title: S('chartHeadcountByTenure'), sub: S('subHeadcountByTenure'), keepOrder: true, topN: 0 },
        { id: 'payroll', path: '/api/dashboard/headcount-by-payroll-group', title: S('chartHeadcountByPayroll'), sub: S('subHeadcountByPayroll') },
        { id: 'gender', path: '/api/dashboard/gender-breakdown', title: S('chartHeadcountGender'), sub: S('subHeadcountGender'), topN: 0 },
    ], 'count');
}
async function cmpTabWorkforceTrend(c) {
    const [sa, sb] = await cmpBoth('/api/dashboard/monthly-series');
    c.replaceChildren();
    cmpSeriesCards(c, sa, sb, [
        { id: 'hc', title: S('seriesHeadcount'), pick: p => p.headcount, line: true },
        { id: 'net', title: S('seriesNet'), pick: p => p.newHires - p.resignations },
    ]);
}
async function cmpTabWorkforceStores(c, run) {
    c.replaceChildren();
    const A = run.data.A.byStore || [], B = run.data.B.byStore || [];
    if (!A.length || !B.length) { cmpNote(c, S('noStoreBreakdown')); return; }
    const mb = new Map(B.map(r => [r.storeName, r]));
    const hc = r => cmpNorm.uneven ? Math.round(r.avgHeadcount * 10) / 10 : r.headcount;
    const rows = A.filter(r => mb.has(r.storeName)).sort((x, y) => hc(y) - hc(x)).map(r => {
        const b = mb.get(r.storeName);
        const ha = hc(r), hb = hc(b), na = cmpPerMonth('A', r.newHires), nb = cmpPerMonth('B', b.newHires), xa = cmpPerMonth('A', r.resignations), xb = cmpPerMonth('B', b.resignations);
        return [cmpEsc(r.storeName), cmpFmtCount(ha), cmpFmtCount(hb), cmpDeltaHtml(ha, hb, { dec: cmpNorm.uneven ? 1 : 0 }),
            cmpFmtCount(na), cmpFmtCount(nb), cmpFmtCount(xa), cmpFmtCount(xb)];
    });
    cmpTableCard(c, S('storesHeadcount') + S('vs'), '', [S('colStore'), S('colHeadcount') + ' A', S('colHeadcount') + ' B', S('colChange'),
        S('colNewHires') + ' A', S('colNewHires') + ' B', S('colResignations') + ' A', S('colResignations') + ' B'], rows);
}

/* ── 90-Day ───────────────────────────────────────────────────────────────── */
async function cmpTabNinetyCohorts(c) {
    const [ta, tb] = await cmpBoth('/api/ninety-day-turnover/trend');
    c.replaceChildren();
    const mine = (items, side) => (items || []).filter(i => i.year === panels[side].year && panels[side].months.includes(i.month));
    cmpSeriesCards(c, mine(ta, 'A'), mine(tb, 'B'), [
        { id: 'rate', title: S('chartNinetyByCohort'), sub: S('subNinetyByCohort'), pick: p => p.rate, pct: true, line: true },
        { id: 'hires', title: S('cohortHires'), pick: p => p.totalHires },
        { id: 'early', title: S('cohortLeavers'), pick: p => p.earlyLeavers },
    ]);
}
async function cmpTabNinetyBreakdown(c) {
    const N = '/api/ninety-day-turnover/';
    await cmpTabBarCharts(c, [
        { id: 'reasons', path: N + 'reasons', title: S('ntdReasons'), sub: S('subNtdReasons'), mode: 'share' },
        { id: 'job', path: N + 'job-titles', title: S('ntdByJobTitle'), sub: S('subNtdByJobTitle') },
        { id: 'payroll', path: N + 'payroll-groups', title: S('ntdByPayroll'), sub: S('subNtdByPayroll') },
        { id: 'gender', path: N + 'gender-breakdown', title: S('chartGender'), sub: S('subNtdGender'), topN: 0 },
    ], 'count');
}
async function cmpTabNinetyTeams(c) {
    const [oa, ob] = await cmpBoth('/api/ninety-day-turnover/oc-om-analysis');
    c.replaceChildren();
    [['ocRows', S('commonOc')], ['omRows', S('commonOm')], ['socRows', S('commonSoc')], ['odRows', S('commonOd')]].forEach(([key, title]) => {
        const ma = new Map((oa[key] || []).map(r => [r.name, r])), mb = new Map((ob[key] || []).map(r => [r.name, r]));
        const rate = n => (ma.get(n)?.avgRate || 0) + (mb.get(n)?.avgRate || 0);
        const names = [...new Set([...ma.keys(), ...mb.keys()])].sort((x, y) => rate(y) - rate(x));
        const rows = names.map(n => {
            const a = ma.get(n), b = mb.get(n);
            return [cmpEsc(n), a?.storeCount ?? b?.storeCount, cmpFmtCount(a ? cmpPerMonth('A', a.totalHires) : null), cmpFmtCount(b ? cmpPerMonth('B', b.totalHires) : null),
                cmpFmtCount(a ? cmpPerMonth('A', a.earlyLeavers) : null), cmpFmtCount(b ? cmpPerMonth('B', b.earlyLeavers) : null),
                cmpFmtPct(a?.avgRate), cmpFmtPct(b?.avgRate), cmpDeltaHtml(a?.avgRate ?? null, b?.avgRate ?? null, { lowerIsBetter: true })];
        });
        cmpTableCard(c, title + S('vs'), S('rankedByAvgRate'), [S('colName'), S('colStores'), S('colHires') + ' A', S('colHires') + ' B',
            S('colEarly') + ' A', S('colEarly') + ' B', S('colRate90') + ' A', S('colRate90') + ' B', S('colChange')], rows);
    });
}

/* ── Retention (snapshots of the team at each side's last month) ─────────── */
async function cmpTabRetentionTenure(c) {
    const R = '/api/retention/';
    const [curve, gender, jobs] = await Promise.all([cmpBoth(R + 'active-tenure-curve'), cmpBoth(R + 'by-gender'), cmpBoth(R + 'by-job-title')]);
    c.replaceChildren();
    const grid = cmpGrid(c);
    const draw = (id, title, sub, ra, rb, opts) => {
        const p = cmpPair(ra, rb, 'value', opts);
        const uid = cmpUid(c, id);
        cmpChartCard(grid, uid, title + S('vs'), sub, S('basisSnapshot'));
        cmpDrawBars(uid, p.labels, p.a, p.b, { pct: true });
    };
    const asItems = pts => (pts || []).map(p => ({ label: p.label, value: p.retentionRate }));
    draw('curve', S('chartSurvival'), S('subSurvival'), asItems(curve[0]), asItems(curve[1]), { topN: 0, keepOrder: true });
    draw('gender', S('retByGender'), S('subRetByGender'), gender[0], gender[1], { topN: 0 });
    draw('job', S('retByJobTitle'), S('subRetByJobTitle'), jobs[0], jobs[1], { topN: 10 });
}
async function cmpTabRetentionStores(c) {
    const R = '/api/retention/';
    const [rank, tenure] = await Promise.all([cmpBoth(R + 'store-retention-ranking'), cmpBoth(R + 'average-tenure-by-store')]);
    c.replaceChildren();
    const map = rows => new Map((rows || []).map(r => [r.label, r.value]));
    const ra = map(rank[0]), rb = map(rank[1]), ta = map(tenure[0]), tb = map(tenure[1]);
    const stores = [...ra.keys()].filter(s => rb.has(s));
    if (!stores.length) { cmpNote(c, S('noStoreBreakdown')); return; }
    const rows = stores.sort((x, y) => Math.abs(rb.get(y) - ra.get(y)) - Math.abs(rb.get(x) - ra.get(x))).slice(0, 25)
        .map(s => [cmpEsc(s), cmpFmtPct(ra.get(s)), cmpFmtPct(rb.get(s)), cmpDeltaHtml(ra.get(s), rb.get(s), { lowerIsBetter: false }),
            cmpFmtNum(ta.get(s)), cmpFmtNum(tb.get(s)), cmpDeltaHtml(ta.get(s) ?? null, tb.get(s) ?? null, { lowerIsBetter: false })]);
    cmpTableCard(c, S('storesRetention') + S('vs'), S('basisSnapshot'),
        [S('colStore'), S('colRetention') + ' A', S('colRetention') + ' B', S('colChange'), S('colAvgTenure') + ' A', S('colAvgTenure') + ' B', S('colChange')], rows);
}
async function cmpTabRetentionTeams(c) {
    const R = '/api/retention/average-tenure-by-manager';
    const dims = [['oc', S('commonOc')], ['om', S('commonOm')], ['soc', S('commonSoc')], ['od', S('commonOd')]];
    const results = await Promise.all(dims.map(([d]) => cmpBoth(R, `&dimension=${d}`)));
    c.replaceChildren();
    dims.forEach(([, title], i) => {
        const ma = new Map((results[i][0] || []).map(r => [r.name, r])), mb = new Map((results[i][1] || []).map(r => [r.name, r]));
        const names = [...new Set([...ma.keys(), ...mb.keys()])].sort((x, y) => ((mb.get(y)?.avgTenureMonths || 0) + (ma.get(y)?.avgTenureMonths || 0)) - ((mb.get(x)?.avgTenureMonths || 0) + (ma.get(x)?.avgTenureMonths || 0)));
        const rows = names.map(n => {
            const a = ma.get(n), b = mb.get(n);
            return [cmpEsc(n), a?.stores ?? b?.stores, a?.headcount ?? '—', b?.headcount ?? '—', cmpFmtNum(a?.avgTenureMonths), cmpFmtNum(b?.avgTenureMonths),
                cmpDeltaHtml(a?.avgTenureMonths ?? null, b?.avgTenureMonths ?? null, { lowerIsBetter: false })];
        });
        cmpTableCard(c, title + S('vs'), S('rankedByTenure'), [S('colName'), S('colStores'), S('colHeadcount') + ' A', S('colHeadcount') + ' B',
            S('colAvgTenure') + ' A', S('colAvgTenure') + ' B', S('colChange')], rows);
    });
}

/* ── Exit Interviews (every answer as a share of that side's own answers) ── */
async function cmpTabExitExperience(c) {
    const E = '/api/exit-interviews/';
