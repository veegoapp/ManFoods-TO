async function cmpTabExitMore(c) {
    const E = '/api/exit-interviews/';
    const [jobs, rr] = await Promise.all([cmpBoth(E + 'by-job-title'), cmpBoth(E + 'reason-vs-would-return')]);
    c.replaceChildren();
    const grid = cmpGrid(c);
