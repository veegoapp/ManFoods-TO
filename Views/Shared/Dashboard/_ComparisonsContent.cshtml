                    <th class="cmp-sort cmp-col-t px-3 py-2 text-center" data-col="dt" style="cursor:pointer" title="@L["CMP_TurnoverDiffTitle"]">@L["CMP_ChangeAB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort cmp-col-n px-3 py-2 text-center" data-col="na" style="cursor:pointer">@L["CMP_NinetyA"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort cmp-col-n px-3 py-2 text-center" data-col="nb" style="cursor:pointer">@L["CMP_NinetyB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort cmp-col-n px-3 py-2 text-center" data-col="dn" style="cursor:pointer" title="@L["CMP_NinetyDiffTitle"]">@L["CMP_ChangeAB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                </tr>
            </thead>
            <tbody id="cmpTableBody">
                <tr><td colspan="7" class="text-center py-4 text-muted">@L["Common_Loading"]</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Comparisons page — two independent filter panels (A / B) ──────────
   Reuses fetchJson/mkChart from dashboard.js; does NOT use
   dashboard.js's period/store selects or buildQuery/loadAll (those target
   #periodSelect etc. which don't exist here, so they safely no-op). */

const cmpL = document.getElementById('cmpKpiGrid').dataset;
const panels = {
    A: { year: null, months: [], store: '', om: '', oc: '', soc: '', od: '', job: '', yearMonthsMap: {} },
    B: { year: null, months: [], store: '', om: '', oc: '', soc: '', od: '', job: '', yearMonthsMap: {} }
};

function cmpMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }

function cmpAnchor(side) { return panels[side].months.length ? Math.max(...panels[side].months) : null; }

function cmpBuildQuery(side) {
    const p = panels[side];
    const q = new URLSearchParams();
    if (p.year) q.set('year', p.year);
    if (p.months.length) { q.set('months', p.months.join(',')); q.set('month', Math.max(...p.months)); }
    if (p.store) q.set('store', p.store);
    if (p.om)    q.set('om', p.om);
    if (p.oc)    q.set('oc', p.oc);
    if (p.soc)   q.set('soc', p.soc);
    if (p.od)    q.set('od', p.od);
    if (p.job)   q.set('jobs', p.job);
    return q.toString();
}

function cmpLabel(side) {
    const p = panels[side];
    if (!p.months.length) return side;
    const months = p.months.slice().sort((a, b) => a - b).map(cmpMonthShortName).join('/');
    return `${side} (${months} ${p.year})`;
}

/* Generic searchable single-select combobox ---------------------------- */
function cmpCreateCombobox({ inputId, panelId, onSelect }) {
    const input = document.getElementById(inputId);
    const panel = document.getElementById(panelId);
    const allLabel = input.placeholder;
    let options = [];
    let value = '';

    function render(filterText) {
        const ft = (filterText || '').toLowerCase();
        const filtered = options.filter(o => o.toLowerCase().includes(ft));
        let html = `<div class="cmp-combo-option${value === '' ? ' active' : ''}" data-value="">${allLabel}</div>`;
        html += filtered.map(o => `<div class="cmp-combo-option${o === value ? ' active' : ''}" data-value="${sapEscape(o)}">${sapEscape(o)}</div>`).join('');
        panel.innerHTML = html;
    }
    function open() { panel.classList.add('open'); render(''); input.select(); }
    function close() { panel.classList.remove('open'); input.value = value; }

    panel.addEventListener('mousedown', (e) => {
        const opt = e.target.closest('.cmp-combo-option');
        if (!opt) return;
        e.preventDefault();
        value = opt.dataset.value;
        input.value = value;
        panel.classList.remove('open');
        onSelect(value);
    });
    input.addEventListener('focus', open);
    input.addEventListener('input', () => render(input.value));
    input.addEventListener('blur', () => setTimeout(close, 150));

    return {
        setOptions(list) { options = list || []; },
        setValue(v) { value = v || ''; input.value = value; }
    };
}

const combos = {};
['A', 'B'].forEach(side => {
    combos[`store${side}`] = cmpCreateCombobox({ inputId: `cmpStoreInput${side}`, panelId: `cmpStorePanel${side}`, onSelect: v => { panels[side].store = v; cmpMarkStale(); } });
    combos[`om${side}`]    = cmpCreateCombobox({ inputId: `cmpOmInput${side}`,    panelId: `cmpOmPanel${side}`,    onSelect: v => { panels[side].om    = v; cmpMarkStale(); } });
    combos[`oc${side}`]    = cmpCreateCombobox({ inputId: `cmpOcInput${side}`,    panelId: `cmpOcPanel${side}`,    onSelect: v => { panels[side].oc    = v; cmpMarkStale(); } });
    combos[`soc${side}`]   = cmpCreateCombobox({ inputId: `cmpSocInput${side}`,   panelId: `cmpSocPanel${side}`,   onSelect: v => { panels[side].soc   = v; cmpMarkStale(); } });
    combos[`od${side}`]    = cmpCreateCombobox({ inputId: `cmpOdInput${side}`,    panelId: `cmpOdPanel${side}`,    onSelect: v => { panels[side].od    = v; cmpMarkStale(); } });
    combos[`job${side}`]   = cmpCreateCombobox({ inputId: `cmpJobInput${side}`,   panelId: `cmpJobPanel${side}`,   onSelect: v => { panels[side].job   = v; cmpMarkStale(); } });
});

/* Months multi-select ---------------------------------------------------- */
function cmpBuildMonthsOptions(side) {
    const container = document.getElementById(`cmpMonthsOptions${side}`);
    const p = panels[side];
    const available = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
    container.innerHTML = available.map(m => `
        <label class="cmp-ms-option">
            <input type="checkbox" value="${m}" ${p.months.includes(m) ? 'checked' : ''}>
            <span>${monthName(m, p.year)}</span>
        </label>`).join('');
    container.querySelectorAll('input[type=checkbox]').forEach(cb => {
        cb.addEventListener('change', () => {
            const m = parseInt(cb.value);
            if (cb.checked) { if (!p.months.includes(m)) p.months.push(m); }
            else { p.months = p.months.filter(x => x !== m); }
            p.months.sort((a, b) => a - b);
            cmpRenderMonthsChips(side);
            cmpOnMonthsChanged(side);
        });
    });
}

function cmpRenderMonthsChips(side) {
    const p = panels[side];
    const chipsEl = document.getElementById(`cmpMonthsChips${side}`);
    const labels = document.getElementById(`cmpMonthsMultiselect${side}`).dataset;
    const available = p.yearMonthsMap[p.year] || [];
    if (!p.months.length) { chipsEl.textContent = labels.labelSelect; return; }
    if (p.months.length === available.length) { chipsEl.textContent = labels.labelAll; return; }
    const names = p.months.map(cmpMonthShortName);
    chipsEl.textContent = names.length <= 2 ? names.join('، ') : `${names[0]}، ${names[1]} +${names.length - 2}`;
}

let cmpMonthsDebounce;
function cmpOnMonthsChanged(side) {
    clearTimeout(cmpMonthsDebounce);
    cmpMonthsDebounce = setTimeout(async () => {
        if (!panels[side].months.length) return;
        await cmpLoadDependentLists(side);
        cmpMarkStale();
    }, 250);
}

['A', 'B'].forEach(side => {
    document.getElementById(`cmpMonthsSelectAll${side}`).addEventListener('click', () => {
        const p = panels[side];
        p.months = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side); cmpOnMonthsChanged(side);
    });
    document.getElementById(`cmpMonthsClearAll${side}`).addEventListener('click', () => {
        panels[side].months = [];
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side); cmpOnMonthsChanged(side);
    });
    document.getElementById(`cmpMonthsTrigger${side}`).addEventListener('click', (e) => {
        e.stopPropagation();
        document.getElementById(`cmpMonthsPanel${side}`).classList.toggle('open');
    });
});
document.addEventListener('click', (e) => {
    ['A', 'B'].forEach(side => {
        if (!document.getElementById(`cmpMonthsMultiselect${side}`).contains(e.target))
            document.getElementById(`cmpMonthsPanel${side}`).classList.remove('open');
    });
});

/* Year selects ------------------------------------------------------------ */
['A', 'B'].forEach(side => {
    document.getElementById(`cmpYear${side}`).addEventListener('change', async function () {
        const p = panels[side];
        p.year = parseInt(this.value);
        p.months = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
        p.store = ''; p.om = ''; p.oc = ''; p.soc = ''; p.od = '';
        combos[`store${side}`].setValue(''); combos[`om${side}`].setValue(''); combos[`oc${side}`].setValue(''); combos[`soc${side}`].setValue(''); combos[`od${side}`].setValue('');
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side);
        await cmpLoadDependentLists(side);
        cmpMarkStale();
    });
});

/* "Copy to last year" — mirrors A into B, one year earlier -------------- */
document.getElementById('cmpCopyToLastYear').addEventListener('click', async () => {
    const a = panels.A, b = panels.B;
    const targetYear = a.year - 1;
    if (!b.yearMonthsMap[targetYear]) return;
    b.year = targetYear;
    document.getElementById('cmpYearB').value = targetYear;
    const availableB = b.yearMonthsMap[targetYear] || [];
    b.months = a.months.filter(m => availableB.includes(m));
    b.store = a.store; b.om = a.om; b.oc = a.oc; b.soc = a.soc; b.od = a.od; b.job = a.job;
    combos.storeB.setValue(a.store); combos.omB.setValue(a.om); combos.ocB.setValue(a.oc); combos.socB.setValue(a.soc); combos.odB.setValue(a.od); combos.jobB.setValue(a.job);
    cmpBuildMonthsOptions('B'); cmpRenderMonthsChips('B');
    await cmpLoadDependentLists('B');
    cmpMarkStale();
});

/* Job titles — one request for both sides (not period-dependent), kept for Reset Filters. */
let cmpJobTitles = null;
async function cmpLoadJobTitles() {
    if (!cmpJobTitles) cmpJobTitles = await fetchJson('/api/dashboard/job-titles');
    combos.jobA.setOptions(cmpJobTitles); combos.jobB.setOptions(cmpJobTitles);
}

/* Quick picks for side B, relative to A: the month / quarter before A's first month, or A's months a year earlier. */
async function cmpApplyPreset(kind) {
    const a = panels.A, b = panels.B;
    if (!a.months.length) { cmpPopup(cmpL.needMonths); return; }
    const aMonths = a.months.slice().sort((x, y) => x - y);
    let year, months;
    if (kind === 'lastYear') { year = a.year - 1; months = aMonths; }
    else {
        const list = []; let y = a.year, m = aMonths[0];
        for (let i = 0; i < (kind === 'quarter' ? 3 : 1); i++) { m--; if (m === 0) { m = 12; y--; } list.push({ y, m }); }
        year = list[0].y;                                   // a quarter that crosses a year end keeps the latest year's months
        months = list.filter(x => x.y === year).map(x => x.m);
    }
    const available = a.yearMonthsMap[year] || [];
    months = months.filter(m => available.includes(m)).sort((x, y) => x - y);
    if (!months.length) { cmpPopup(cmpL.presetNoData); return; }
    b.year = year; b.months = months;
    document.getElementById('cmpYearB').value = year;
    cmpBuildMonthsOptions('B'); cmpRenderMonthsChips('B');
    await cmpLoadDependentLists('B');
    cmpMarkStale();
}
document.querySelectorAll('.cmp-preset').forEach(btn => btn.addEventListener('click', () => cmpApplyPreset(btn.dataset.preset)));

/* Store / OM / OC option lists (scoped to each panel's latest month) ---- */
async function cmpLoadDependentLists(side) {
    const anchor = cmpAnchor(side);
    const p = panels[side];
    if (!anchor || !p.year) return;
    const [stores, oms, ocs, socs, ods] = await Promise.all([
        fetchJson(`/api/dashboard/stores?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-managers?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-consultants?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/senior-operation-consultants?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-directors?month=${anchor}&year=${p.year}`)
    ]);
    combos[`store${side}`].setOptions(stores.map(s => s.storeName));
    combos[`om${side}`].setOptions(oms);
    combos[`oc${side}`].setOptions(ocs);
    combos[`soc${side}`].setOptions(socs);
    combos[`od${side}`].setOptions(ods);
}

/* Initial load ------------------------------------------------------------ */
async function cmpInit() {
    const periods = await fetchJson('/api/dashboard/available-periods');
    if (!periods.length) return;

    const yearMonthsMap = {};
    periods.forEach(pd => { (yearMonthsMap[pd.year] = yearMonthsMap[pd.year] || []).push(pd.month); });
    const years = Object.keys(yearMonthsMap).map(Number).sort((a, b) => b - a);

    for (const side of ['A', 'B']) {
        panels[side].yearMonthsMap = yearMonthsMap;
        const yearSel = document.getElementById(`cmpYear${side}`);
        yearSel.innerHTML = years.map(y => `<option value="${y}">${y}</option>`).join('');
        // Reset Filters must actually clear the store/OM/OC/SOC/OD pick on
        // both panels — previously only year/months were reset, so a store
        // picked before hitting Reset stayed selected (and kept the Store
        // Breakdown table hidden, since that table only shows when neither
        // panel has a store).
        panels[side].store = ''; panels[side].om = ''; panels[side].oc = ''; panels[side].soc = ''; panels[side].od = ''; panels[side].job = '';
        combos[`job${side}`].setValue('');
        combos[`store${side}`].setValue(''); combos[`om${side}`].setValue(''); combos[`oc${side}`].setValue(''); combos[`soc${side}`].setValue(''); combos[`od${side}`].setValue('');
    }

    // A defaults to the latest year/all its months; B defaults to the same
    // months one year earlier (the most common "vs last year" use case).
    panels.A.year = years[0];
    panels.A.months = (yearMonthsMap[panels.A.year] || []).slice().sort((a, b) => a - b);
    document.getElementById('cmpYearA').value = panels.A.year;

    const prevYear = panels.A.year - 1;
    if (yearMonthsMap[prevYear]) {
        panels.B.year = prevYear;
        panels.B.months = panels.A.months.filter(m => yearMonthsMap[prevYear].includes(m));
    } else {
        panels.B.year = years[years.length - 1];
        panels.B.months = (yearMonthsMap[panels.B.year] || []).slice().sort((a, b) => a - b);
    }
    document.getElementById('cmpYearB').value = panels.B.year;

    cmpBuildMonthsOptions('A'); cmpRenderMonthsChips('A');
    cmpBuildMonthsOptions('B'); cmpRenderMonthsChips('B');

    await Promise.all([cmpLoadDependentLists('A'), cmpLoadDependentLists('B'), cmpLoadJobTitles()]);
    cmpResetResults();   // nothing is loaded until the user picks what to compare and presses Compare
}

/* Data fetching + rendering ----------------------------------------------- */
// Unlike fetchJson (which returns [] on an error), a failed request here rejects so the page can tell the user.
async function cmpGet(url) {
    const r = await fetch(url);
    if (r.status === 403) throw new Error('403');
    if (!r.ok) throw new Error(String(r.status));
    return r.json();
}

/* Only the requests the chosen group needs — the rest of the page's data is never loaded. */
async function cmpFetchSide(side, group) {
    const q = cmpBuildQuery(side);
    const p = panels[side];
    const data = { kpi: null, ninety: null, byStore: [], ninetyByStore: [], retention: [], exitReasons: [], exitSentiment: null, exitDrivers: [], bkJob: [], bkTenure: [], bkPayroll: [], scorecard: null };
    const jobs = [];
    const load = (key, url) => jobs.push(cmpGet(url).then(v => { data[key] = v; }));
    const companyWide = !p.store;   // the per-store breakdown only exists when no single store is picked

    switch (group) {
        case 'turnover':
        case 'workforce':
            load('kpi', `/api/dashboard/kpis?${q}`);
            if (companyWide) load('byStore', `/api/dashboard/store-comparison?${q}`);
            break;
        case 'ninety':
            load('ninety', `/api/ninety-day-turnover/kpi?${q}`);
            if (companyWide) load('ninetyByStore', `/api/ninety-day-turnover/store-comparison?${q}`);
            break;
        case 'retention': {
            const retentionQ = new URLSearchParams();
            const minMonth = Math.min(...p.months), maxMonth = Math.max(...p.months);
            retentionQ.set('fromMonth', minMonth); retentionQ.set('fromYear', p.year);
            retentionQ.set('toMonth', maxMonth); retentionQ.set('toYear', p.year);
            retentionQ.set('months', p.months.join(','));
            if (p.store) retentionQ.set('store', p.store);
            if (p.om) retentionQ.set('om', p.om);
            if (p.oc) retentionQ.set('oc', p.oc);
            if (p.soc) retentionQ.set('soc', p.soc);
            if (p.od) retentionQ.set('od', p.od);
            load('retention', `/api/retention/milestones?${retentionQ}`);
            break;
        }
        case 'exit':
            load('exitReasons', `/api/exit-interviews/reasons?${q}`);
            load('exitSentiment', `/api/exit-interviews/sentiment-summary?${q}`);
            break;
        case 'drivers':
            load('exitDrivers', `/api/exit-interviews/engagement-drivers?${q}`);
            break;
        case 'breakdown':
            load('bkJob', `/api/dashboard/turnover-by-job-title?${q}`);
            load('bkTenure', `/api/dashboard/turnover-by-tenure?${q}`);
            load('bkPayroll', `/api/dashboard/turnover-by-payroll-group?${q}`);
            break;
        case 'scorecard': {
            // The scorecard only knows year, months and the OM/OC/SOC/OD line — no store or job filter.
            const sq = new URLSearchParams();
            sq.set('year', p.year); sq.set('months', p.months.join(','));
            ['om', 'oc', 'soc', 'od'].forEach(f => { if (p[f]) sq.set(f, p[f]); });
            load('scorecard', `/api/scorecard/rollup?${sq}`);
            break;
        }
    }
    await Promise.all(jobs);
    return data;
}

/* Period-length normalization ---------------------------------------------
   Counts (headcount, hires, resignations) are summed over the selected months, so a 12-month side
   always looks "bigger" than a 1-month side. When the two sides cover a different number of
   months those counts are shown as monthly averages. Turnover % and 90-day % keep the portal's
   usual definition (period totals, with the colour rules built on it) — the notice says so. */
let cmpNorm = { A: 1, B: 1, uneven: false };
function cmpUpdateNorm(group) {
    cmpNorm = { A: Math.max(1, panels.A.months.length), B: Math.max(1, panels.B.months.length), uneven: false };
    cmpNorm.uneven = cmpNorm.A !== cmpNorm.B;
    const note = document.getElementById('cmpPeriodNotice');
    const showNote = cmpNorm.uneven && ['turnover', 'workforce', 'ninety', 'breakdown'].includes(group);
    note.hidden = !showNote;
    if (showNote)
        document.getElementById('cmpPeriodNoticeText').textContent = cmpL.periodNotice.replace('{0}', cmpNorm.A).replace('{1}', cmpNorm.B);
}
const cmpPerMonth = (side, v) => cmpNorm.uneven ? Math.round(v / cmpNorm[side] * 10) / 10 : v;
const cmpCount = v => cmpNorm.uneven ? Number(v).toFixed(1) : v;

function cmpDeltaBadge(a, b, lowerIsBetter) {
    const delta = a - b;
    let cls = 'neutral';
    if (lowerIsBetter === true)  cls = delta <= 0 ? 'good' : 'bad';
    if (lowerIsBetter === false) cls = delta >= 0 ? 'good' : 'bad';
    const sign = delta > 0 ? '+' : '';
    const icon = delta > 0 ? 'bi-arrow-up-short' : delta < 0 ? 'bi-arrow-down-short' : 'bi-dash';
    return `<span class="cmp-kpi-delta ${cls}"><i class="bi ${icon}"></i>${sign}${delta.toFixed(1)} ${cmpL.deltaSuffix}</span>`;
}

function cmpRenderKpis(dataA, dataB, group) {
    const pm = cmpPerMonth;
    const tag = (label, suffix) => cmpNorm.uneven ? `${label} (${suffix})` : label;
    const all = [
        { groups: ['turnover', 'workforce'], label: tag(cmpL.kpiHeadcount, cmpL.avgMonthly),  desc: cmpL.kpiHeadcountDesc,    a: () => pm('A', dataA.kpi.totalHeadcount),    b: () => pm('B', dataB.kpi.totalHeadcount),    fmt: cmpCount,                lowerIsBetter: null },
        { groups: ['turnover', 'workforce'], label: tag(cmpL.kpiNewHires, cmpL.perMonth),     desc: cmpL.kpiNewHiresDesc,     a: () => pm('A', dataA.kpi.newHires),          b: () => pm('B', dataB.kpi.newHires),          fmt: cmpCount,                lowerIsBetter: false },
        { groups: ['turnover', 'workforce'], label: tag(cmpL.kpiResignations, cmpL.perMonth), desc: cmpL.kpiResignationsDesc, a: () => pm('A', dataA.kpi.totalResignations), b: () => pm('B', dataB.kpi.totalResignations), fmt: cmpCount,                lowerIsBetter: true },
        { groups: ['turnover'],              label: cmpL.kpiTurnover,                         desc: cmpL.kpiTurnoverDesc,     a: () => dataA.kpi.turnoverRate,               b: () => dataB.kpi.turnoverRate,               fmt: v => v.toFixed(1) + '%', lowerIsBetter: true },
        { groups: ['ninety'],                label: tag(cmpL.kpiEarlyLeavers, cmpL.perMonth), desc: cmpL.kpiEarlyLeaversDesc, a: () => pm('A', dataA.ninety.earlyLeavers),   b: () => pm('B', dataB.ninety.earlyLeavers),   fmt: cmpCount,                lowerIsBetter: true },
        { groups: ['ninety'],                label: cmpL.kpiNinetyRate,                       desc: cmpL.kpiNinetyRateDesc,   a: () => dataA.ninety.rate,                    b: () => dataB.ninety.rate,                    fmt: v => v.toFixed(1) + '%', lowerIsBetter: true },
        { groups: ['scorecard'],             label: cmpL.kpiScTurnover,                       desc: cmpL.kpiScTurnoverDesc,   a: () => dataA.scorecard.averageTurnoverRate,  b: () => dataB.scorecard.averageTurnoverRate,  fmt: v => v.toFixed(1) + '%', lowerIsBetter: true },
        { groups: ['scorecard'],             label: cmpL.kpiScFlagged,                        desc: cmpL.kpiScFlaggedDesc,    a: () => cmpFlaggedOverall(dataA.scorecard),   b: () => cmpFlaggedOverall(dataB.scorecard),   fmt: v => v.toFixed(1) + '%', lowerIsBetter: true }
    ];
    // Values are read only for the cards of the chosen group (the other groups' data was never loaded).
    const metrics = all.filter(m => m.groups.includes(group)).map(m => ({ ...m, a: m.a(), b: m.b() }));

    document.getElementById('cmpKpiGrid').innerHTML = metrics.map(m => `
        <div class="cmp-kpi-card">
            <div class="cmp-kpi-label">${m.label}</div>
            <div class="kpi-desc" style="margin-bottom:8px">${m.desc}</div>
            <div class="cmp-kpi-values">
                <div class="cmp-kpi-val a"><span class="cmp-kpi-tag">A</span><span class="cmp-kpi-num">${m.fmt(m.a)}</span></div>
                <div class="cmp-kpi-val b"><span class="cmp-kpi-tag">B</span><span class="cmp-kpi-num">${m.fmt(m.b)}</span></div>
            </div>
            ${cmpDeltaBadge(m.a, m.b, m.lowerIsBetter)}
        </div>
    `).join('');
}

function cmpInsightCard(metric, aVal, bVal) {
    const delta = aVal - bVal;
    const flat = Math.abs(delta) < 0.05;
    const improved = delta <= 0;
    const icon  = flat ? 'bi-dash-circle-fill' : improved ? 'bi-arrow-down-circle-fill' : 'bi-arrow-up-circle-fill';
    const color = flat ? { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
                : improved ? { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' }
                : { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD };
    const title = (flat ? cmpL.titleNoChange : improved ? cmpL.titleImproved : cmpL.titleWorsened).replace('{0}', metric);
    const tail = flat ? cmpL.unchanged
        : (improved ? cmpL.better : cmpL.worse).replace('{0}', Math.abs(delta).toFixed(1));
    const desc = cmpL.insightDesc
        .replace('{0}', cmpLabel('A')).replace('{1}', aVal.toFixed(1))
        .replace('{2}', cmpLabel('B')).replace('{3}', bVal.toFixed(1))
        .replace('{4}', tail);
    return cmpInsightCardHtml(icon, color, title, desc);
}

function cmpInsightCardHtml(icon, color, title, desc) {
    // Escaped here, once, regardless of what got folded into title/desc
    // above (e.g. a store name in cmpMoverInsightCard) — the single render
    // point for every insight card in this file.
    return `<div class="col-md-4">
        <div style="background:${color.bg};border-left:4px solid ${color.border};border-radius:8px;padding:14px 16px;height:100%">
            <div class="d-flex align-items-start gap-2">
                <i class="bi ${icon} mt-1 flex-shrink-0" style="color:${color.text};font-size:17px"></i>
                <div>
                    <div style="font-size:13px;font-weight:700;color:${color.text};margin-bottom:3px">${sapEscape(title)}</div>
                    <div style="font-size:12.5px;color:var(--text-2);line-height:1.55">${sapEscape(desc)}</div>
                </div>
            </div>
        </div>
    </div>`;
}

/* Third insight: whichever store moved the most (either direction) in
   Turnover Rate between A and B — only meaningful company-wide, same
   guard as the Store Breakdown table below. */
function cmpMoverInsightCard(dataA, dataB) {
    if (panels.A.store || panels.B.store) return '';
    const rows = cmpComputeTableRows(dataA, dataB).filter(r => r.dt !== null);
    if (!rows.length) return '';
    const biggest = rows.reduce((m, r) => Math.abs(r.dt) > Math.abs(m.dt) ? r : m);
    if (Math.abs(biggest.dt) < 0.05) return '';
    const improved = biggest.dt <= 0;
    const icon  = improved ? 'bi-trophy-fill' : 'bi-exclamation-triangle-fill';
    const color = improved ? { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' }
                            : { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD };
    const title = (improved ? cmpL.moverTitleImproved : cmpL.moverTitleWorsened).replace('{0}', biggest.store);
    const desc = (improved ? cmpL.moverDescImproved : cmpL.moverDescWorsened)
        .replace('{0}', biggest.ta.toFixed(1)).replace('{1}', cmpLabel('A'))
        .replace('{2}', biggest.tb.toFixed(1)).replace('{3}', cmpLabel('B'))
        .replace('{4}', Math.abs(biggest.dt).toFixed(1));
    return cmpInsightCardHtml(icon, color, title, desc);
}

function cmpRenderInsight(dataA, dataB, group) {
    document.getElementById('cmpInsightContainer').innerHTML = group === 'turnover'
        ? cmpInsightCard(cmpL.metricTurnoverRate, dataA.kpi.turnoverRate, dataB.kpi.turnoverRate) + cmpMoverInsightCard(dataA, dataB)
        : cmpInsightCard(cmpL.metricNinetyRate, dataA.ninety.rate, dataB.ninety.rate);
}

let cmpTurnoverChart, cmpNinetyChart;
let cmpWorkforceChart, cmpResignationsChart, cmpRetentionChart, cmpExitReasonsChart, cmpExitSentimentChart;
function cmpBuildSeries(dataA, dataB, storeKey, overallA, overallB, metricKey = 'turnoverRate', perMonth = false) {
    const allA = !panels.A.store, allB = !panels.B.store;
    if (allA && allB) {
        const mapA = {}, mapB = {};
        const base = r => metricKey === 'turnoverRate'
            ? (r.value ?? r.turnoverRate)
            : (r[metricKey] ?? 0);
        const valueOf = (r, side) => perMonth ? cmpPerMonth(side, base(r)) : base(r);
        (dataA[storeKey] || []).forEach(r => mapA[r.label ?? r.storeName] = valueOf(r, 'A'));
        (dataB[storeKey] || []).forEach(r => mapB[r.label ?? r.storeName] = valueOf(r, 'B'));
        const stores = Array.from(new Set([...Object.keys(mapA), ...Object.keys(mapB)]))
            .sort((s1, s2) => ((mapA[s2] || 0) + (mapB[s2] || 0)) - ((mapA[s1] || 0) + (mapB[s1] || 0)))
            .slice(0, 8);
        const r1 = v => Math.round((v || 0) * 10) / 10;
        return { labels: stores, seriesA: stores.map(s => r1(mapA[s])), seriesB: stores.map(s => r1(mapB[s])) };
    }
    return { labels: [cmpL.overall], seriesA: [overallA], seriesB: [overallB] };
}

function cmpRenderTurnoverChart(dataA, dataB) {
    const t = cmpBuildSeries(dataA, dataB, 'byStore', dataA.kpi.turnoverRate, dataB.kpi.turnoverRate);
    cmpTurnoverChart = mkChart(cmpTurnoverChart, 'cmpTurnoverChart', {
        type: 'bar',
        data: { labels: t.labels, datasets: [
            { label: cmpLabel('A'), data: t.seriesA, backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: t.seriesB, backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v.toFixed(1) + '%' : '' } },
            scales: { y: { ticks: { callback: v => v + '%' } } }
        }
    });

}

