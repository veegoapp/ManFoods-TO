        <p class="cmp-chart-basis"><i class="bi bi-info-circle-fill"></i><span>@L["CMP_BasisExitReasons"]</span></p>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["Chart_ExitSentimentCompare"]</h6><p>@L["CMP_ExitSentimentSub"]</p></div>
        <div class="chart-body">
            <canvas id="cmpExitSentimentChart"></canvas>
        </div>
        <div id="cmpExitSentimentMeta" class="cmp-table-hint text-center mt-2"></div>
        <p class="cmp-chart-basis"><i class="bi bi-info-circle-fill"></i><span>@L["CMP_BasisExitSentiment"]</span></p>
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
    <h5 class="mb-0 fw-bold">@L["Comparisons_StoreBreakdown"]</h5>
    <span class="cmp-table-hint">@L["Comparisons_StoreBreakdownHint"]</span>
</div>
<div class="chart-card mb-4 p-0" style="overflow:hidden" id="cmpTableCard">
    <div class="table-responsive" style="max-height:420px;overflow-y:auto">
        <table class="table table-hover mb-0" style="font-size:13px">
            <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                <tr>
                    <th class="cmp-sort px-3 py-2" data-col="store" style="cursor:pointer">@L["Common_StoreName"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="ta" style="cursor:pointer">@L["CMP_TurnoverA"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="tb" style="cursor:pointer">@L["CMP_TurnoverB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="dt" style="cursor:pointer" title="@L["CMP_TurnoverDiffTitle"]">@L["CMP_ChangeAB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="na" style="cursor:pointer">@L["CMP_NinetyA"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="nb" style="cursor:pointer">@L["CMP_NinetyB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="cmp-sort px-3 py-2 text-center" data-col="dn" style="cursor:pointer" title="@L["CMP_NinetyDiffTitle"]">@L["CMP_ChangeAB"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                </tr>
            </thead>
            <tbody id="cmpTableBody">
                <tr><td colspan="7" class="text-center py-4 text-muted">@L["Common_Loading"]</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Comparisons page — two independent filter panels (A / B) ──────────
   Reuses fetchJson/mkChart from dashboard.js; does NOT use
   dashboard.js's period/store selects or buildQuery/loadAll (those target
   #periodSelect etc. which don't exist here, so they safely no-op). */

const cmpL = document.getElementById('cmpKpiGrid').dataset;
const panels = {
    A: { year: null, months: [], store: '', om: '', oc: '', soc: '', od: '', yearMonthsMap: {} },
    B: { year: null, months: [], store: '', om: '', oc: '', soc: '', od: '', yearMonthsMap: {} }
};

function cmpMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }

function cmpAnchor(side) { return panels[side].months.length ? Math.max(...panels[side].months) : null; }

function cmpBuildQuery(side) {
    const p = panels[side];
    const q = new URLSearchParams();
    if (p.year) q.set('year', p.year);
    if (p.months.length) { q.set('months', p.months.join(',')); q.set('month', Math.max(...p.months)); }
    if (p.store) q.set('store', p.store);
    if (p.om)    q.set('om', p.om);
    if (p.oc)    q.set('oc', p.oc);
    if (p.soc)   q.set('soc', p.soc);
    if (p.od)    q.set('od', p.od);
    return q.toString();
}

function cmpLabel(side) {
    const p = panels[side];
    if (!p.months.length) return side;
    const months = p.months.slice().sort((a, b) => a - b).map(cmpMonthShortName).join('/');
    return `${side} (${months} ${p.year})`;
}

/* Generic searchable single-select combobox ---------------------------- */
function cmpCreateCombobox({ inputId, panelId, onSelect }) {
    const input = document.getElementById(inputId);
    const panel = document.getElementById(panelId);
    const allLabel = input.placeholder;
    let options = [];
    let value = '';

    function render(filterText) {
        const ft = (filterText || '').toLowerCase();
        const filtered = options.filter(o => o.toLowerCase().includes(ft));
        let html = `<div class="cmp-combo-option${value === '' ? ' active' : ''}" data-value="">${allLabel}</div>`;
        html += filtered.map(o => `<div class="cmp-combo-option${o === value ? ' active' : ''}" data-value="${sapEscape(o)}">${sapEscape(o)}</div>`).join('');
        panel.innerHTML = html;
    }
    function open() { panel.classList.add('open'); render(''); input.select(); }
    function close() { panel.classList.remove('open'); input.value = value; }

    panel.addEventListener('mousedown', (e) => {
        const opt = e.target.closest('.cmp-combo-option');
        if (!opt) return;
        e.preventDefault();
        value = opt.dataset.value;
        input.value = value;
        panel.classList.remove('open');
        onSelect(value);
    });
    input.addEventListener('focus', open);
    input.addEventListener('input', () => render(input.value));
    input.addEventListener('blur', () => setTimeout(close, 150));

    return {
        setOptions(list) { options = list || []; },
        setValue(v) { value = v || ''; input.value = value; }
    };
}

const combos = {};
['A', 'B'].forEach(side => {
    combos[`store${side}`] = cmpCreateCombobox({ inputId: `cmpStoreInput${side}`, panelId: `cmpStorePanel${side}`, onSelect: v => { panels[side].store = v; cmpRefreshAll(); } });
    combos[`om${side}`]    = cmpCreateCombobox({ inputId: `cmpOmInput${side}`,    panelId: `cmpOmPanel${side}`,    onSelect: v => { panels[side].om    = v; cmpRefreshAll(); } });
    combos[`oc${side}`]    = cmpCreateCombobox({ inputId: `cmpOcInput${side}`,    panelId: `cmpOcPanel${side}`,    onSelect: v => { panels[side].oc    = v; cmpRefreshAll(); } });
    combos[`soc${side}`]   = cmpCreateCombobox({ inputId: `cmpSocInput${side}`,   panelId: `cmpSocPanel${side}`,   onSelect: v => { panels[side].soc   = v; cmpRefreshAll(); } });
    combos[`od${side}`]    = cmpCreateCombobox({ inputId: `cmpOdInput${side}`,    panelId: `cmpOdPanel${side}`,    onSelect: v => { panels[side].od    = v; cmpRefreshAll(); } });
});

/* Months multi-select ---------------------------------------------------- */
function cmpBuildMonthsOptions(side) {
    const container = document.getElementById(`cmpMonthsOptions${side}`);
    const p = panels[side];
    const available = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
    container.innerHTML = available.map(m => `
        <label class="cmp-ms-option">
            <input type="checkbox" value="${m}" ${p.months.includes(m) ? 'checked' : ''}>
            <span>${monthName(m, p.year)}</span>
        </label>`).join('');
    container.querySelectorAll('input[type=checkbox]').forEach(cb => {
        cb.addEventListener('change', () => {
            const m = parseInt(cb.value);
            if (cb.checked) { if (!p.months.includes(m)) p.months.push(m); }
            else { p.months = p.months.filter(x => x !== m); }
            p.months.sort((a, b) => a - b);
            cmpRenderMonthsChips(side);
            cmpOnMonthsChanged(side);
        });
    });
}

function cmpRenderMonthsChips(side) {
    const p = panels[side];
    const chipsEl = document.getElementById(`cmpMonthsChips${side}`);
    const labels = document.getElementById(`cmpMonthsMultiselect${side}`).dataset;
    const available = p.yearMonthsMap[p.year] || [];
    if (!p.months.length) { chipsEl.textContent = labels.labelSelect; return; }
    if (p.months.length === available.length) { chipsEl.textContent = labels.labelAll; return; }
    const names = p.months.map(cmpMonthShortName);
    chipsEl.textContent = names.length <= 2 ? names.join('، ') : `${names[0]}، ${names[1]} +${names.length - 2}`;
}

let cmpMonthsDebounce;
function cmpOnMonthsChanged(side) {
    clearTimeout(cmpMonthsDebounce);
    cmpMonthsDebounce = setTimeout(async () => {
        if (!panels[side].months.length) return;
        await cmpLoadDependentLists(side);
        await cmpRefreshAll();
    }, 250);
}

['A', 'B'].forEach(side => {
    document.getElementById(`cmpMonthsSelectAll${side}`).addEventListener('click', () => {
        const p = panels[side];
        p.months = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side); cmpOnMonthsChanged(side);
    });
    document.getElementById(`cmpMonthsClearAll${side}`).addEventListener('click', () => {
        panels[side].months = [];
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side); cmpOnMonthsChanged(side);
    });
    document.getElementById(`cmpMonthsTrigger${side}`).addEventListener('click', (e) => {
        e.stopPropagation();
        document.getElementById(`cmpMonthsPanel${side}`).classList.toggle('open');
    });
});
document.addEventListener('click', (e) => {
    ['A', 'B'].forEach(side => {
        if (!document.getElementById(`cmpMonthsMultiselect${side}`).contains(e.target))
            document.getElementById(`cmpMonthsPanel${side}`).classList.remove('open');
    });
});

/* Year selects ------------------------------------------------------------ */
['A', 'B'].forEach(side => {
    document.getElementById(`cmpYear${side}`).addEventListener('change', async function () {
        const p = panels[side];
        p.year = parseInt(this.value);
        p.months = (p.yearMonthsMap[p.year] || []).slice().sort((a, b) => a - b);
        p.store = ''; p.om = ''; p.oc = ''; p.soc = ''; p.od = '';
        combos[`store${side}`].setValue(''); combos[`om${side}`].setValue(''); combos[`oc${side}`].setValue(''); combos[`soc${side}`].setValue(''); combos[`od${side}`].setValue('');
        cmpBuildMonthsOptions(side); cmpRenderMonthsChips(side);
        await cmpLoadDependentLists(side);
        await cmpRefreshAll();
    });
});

/* "Copy to last year" — mirrors A into B, one year earlier -------------- */
document.getElementById('cmpCopyToLastYear').addEventListener('click', async () => {
    const a = panels.A, b = panels.B;
    const targetYear = a.year - 1;
    if (!b.yearMonthsMap[targetYear]) return;
    b.year = targetYear;
    document.getElementById('cmpYearB').value = targetYear;
    const availableB = b.yearMonthsMap[targetYear] || [];
    b.months = a.months.filter(m => availableB.includes(m));
    b.store = a.store; b.om = a.om; b.oc = a.oc; b.soc = a.soc; b.od = a.od;
    combos.storeB.setValue(a.store); combos.omB.setValue(a.om); combos.ocB.setValue(a.oc); combos.socB.setValue(a.soc); combos.odB.setValue(a.od);
    cmpBuildMonthsOptions('B'); cmpRenderMonthsChips('B');
    await cmpLoadDependentLists('B');
    await cmpRefreshAll();
});

/* Store / OM / OC option lists (scoped to each panel's latest month) ---- */
async function cmpLoadDependentLists(side) {
    const anchor = cmpAnchor(side);
    const p = panels[side];
    if (!anchor || !p.year) return;
    const [stores, oms, ocs, socs, ods] = await Promise.all([
        fetchJson(`/api/dashboard/stores?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-managers?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-consultants?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/senior-operation-consultants?month=${anchor}&year=${p.year}`),
        fetchJson(`/api/dashboard/operation-directors?month=${anchor}&year=${p.year}`)
    ]);
    combos[`store${side}`].setOptions(stores.map(s => s.storeName));
    combos[`om${side}`].setOptions(oms);
    combos[`oc${side}`].setOptions(ocs);
    combos[`soc${side}`].setOptions(socs);
    combos[`od${side}`].setOptions(ods);
}

/* Initial load ------------------------------------------------------------ */
async function cmpInit() {
    const periods = await fetchJson('/api/dashboard/available-periods');
    if (!periods.length) return;

    const yearMonthsMap = {};
    periods.forEach(pd => { (yearMonthsMap[pd.year] = yearMonthsMap[pd.year] || []).push(pd.month); });
    const years = Object.keys(yearMonthsMap).map(Number).sort((a, b) => b - a);

    for (const side of ['A', 'B']) {
        panels[side].yearMonthsMap = yearMonthsMap;
        const yearSel = document.getElementById(`cmpYear${side}`);
        yearSel.innerHTML = years.map(y => `<option value="${y}">${y}</option>`).join('');
        // Reset Filters must actually clear the store/OM/OC/SOC/OD pick on
        // both panels — previously only year/months were reset, so a store
        // picked before hitting Reset stayed selected (and kept the Store
        // Breakdown table hidden, since that table only shows when neither
        // panel has a store).
        panels[side].store = ''; panels[side].om = ''; panels[side].oc = ''; panels[side].soc = ''; panels[side].od = '';
        combos[`store${side}`].setValue(''); combos[`om${side}`].setValue(''); combos[`oc${side}`].setValue(''); combos[`soc${side}`].setValue(''); combos[`od${side}`].setValue('');
    }

    // A defaults to the latest year/all its months; B defaults to the same
    // months one year earlier (the most common "vs last year" use case).
    panels.A.year = years[0];
    panels.A.months = (yearMonthsMap[panels.A.year] || []).slice().sort((a, b) => a - b);
    document.getElementById('cmpYearA').value = panels.A.year;

    const prevYear = panels.A.year - 1;
    if (yearMonthsMap[prevYear]) {
        panels.B.year = prevYear;
        panels.B.months = panels.A.months.filter(m => yearMonthsMap[prevYear].includes(m));
    } else {
        panels.B.year = years[years.length - 1];
        panels.B.months = (yearMonthsMap[panels.B.year] || []).slice().sort((a, b) => a - b);
    }
    document.getElementById('cmpYearB').value = panels.B.year;

    cmpBuildMonthsOptions('A'); cmpRenderMonthsChips('A');
    cmpBuildMonthsOptions('B'); cmpRenderMonthsChips('B');

    await Promise.all([cmpLoadDependentLists('A'), cmpLoadDependentLists('B')]);
    await cmpRefreshAll();
}

/* Data fetching + rendering ----------------------------------------------- */
async function cmpFetchSide(side) {
    const q = cmpBuildQuery(side);
    const p = panels[side];
    const retentionQ = new URLSearchParams();
    const minMonth = Math.min(...p.months), maxMonth = Math.max(...p.months);
    retentionQ.set('fromMonth', minMonth); retentionQ.set('fromYear', p.year);
    retentionQ.set('toMonth', maxMonth); retentionQ.set('toYear', p.year);
    retentionQ.set('months', p.months.join(','));
    if (p.store) retentionQ.set('store', p.store);
    if (p.om) retentionQ.set('om', p.om);
    if (p.oc) retentionQ.set('oc', p.oc);
    if (p.soc) retentionQ.set('soc', p.soc);
    if (p.od) retentionQ.set('od', p.od);
    const exitQ = new URLSearchParams(q);
    const [kpi, ninety, retention, exitReasons, exitSentiment] = await Promise.all([
        fetchJson(`/api/dashboard/kpis?${q}`),
        fetchJson(`/api/ninety-day-turnover/kpi?${q}`),
        fetchJson(`/api/retention/milestones?${retentionQ}`),
        fetchJson(`/api/exit-interviews/reasons?${exitQ}`),
        fetchJson(`/api/exit-interviews/sentiment-summary?${exitQ}`)
    ]);
    let byStore = [], ninetyByStore = [];
    if (!panels[side].store) {
        [byStore, ninetyByStore] = await Promise.all([
            fetchJson(`/api/dashboard/store-comparison?${q}`),
            fetchJson(`/api/ninety-day-turnover/store-comparison?${q}`)
        ]);
    }
    return { kpi, ninety, byStore, ninetyByStore, retention, exitReasons, exitSentiment };
}

function cmpDeltaBadge(a, b, lowerIsBetter) {
    const delta = a - b;
    let cls = 'neutral';
    if (lowerIsBetter === true)  cls = delta <= 0 ? 'good' : 'bad';
    if (lowerIsBetter === false) cls = delta >= 0 ? 'good' : 'bad';
    const sign = delta > 0 ? '+' : '';
    const icon = delta > 0 ? 'bi-arrow-up-short' : delta < 0 ? 'bi-arrow-down-short' : 'bi-dash';
    return `<span class="cmp-kpi-delta ${cls}"><i class="bi ${icon}"></i>${sign}${delta.toFixed(1)} ${cmpL.deltaSuffix}</span>`;
}

function cmpRenderKpis(dataA, dataB) {
    const metrics = [
        { label: cmpL.kpiHeadcount,     desc: cmpL.kpiHeadcountDesc,     a: dataA.kpi.totalHeadcount,      b: dataB.kpi.totalHeadcount,      fmt: v => v,                  lowerIsBetter: null },
        { label: cmpL.kpiNewHires,      desc: cmpL.kpiNewHiresDesc,      a: dataA.kpi.newHires,            b: dataB.kpi.newHires,            fmt: v => v,                  lowerIsBetter: false },
        { label: cmpL.kpiResignations,  desc: cmpL.kpiResignationsDesc,  a: dataA.kpi.totalResignations,   b: dataB.kpi.totalResignations,   fmt: v => v,                  lowerIsBetter: true },
        { label: cmpL.kpiTurnover,      desc: cmpL.kpiTurnoverDesc,      a: dataA.kpi.turnoverRate,        b: dataB.kpi.turnoverRate,        fmt: v => v.toFixed(1) + '%', lowerIsBetter: true },
        { label: cmpL.kpiEarlyLeavers,  desc: cmpL.kpiEarlyLeaversDesc,  a: dataA.ninety.earlyLeavers,     b: dataB.ninety.earlyLeavers,     fmt: v => v,                  lowerIsBetter: true },
        { label: cmpL.kpiNinetyRate,    desc: cmpL.kpiNinetyRateDesc,    a: dataA.ninety.rate,             b: dataB.ninety.rate,             fmt: v => v.toFixed(1) + '%', lowerIsBetter: true }
    ];

    document.getElementById('cmpKpiGrid').innerHTML = metrics.map(m => `
        <div class="cmp-kpi-card">
            <div class="cmp-kpi-label">${m.label}</div>
            <div class="kpi-desc" style="margin-bottom:8px">${m.desc}</div>
            <div class="cmp-kpi-values">
                <div class="cmp-kpi-val a"><span class="cmp-kpi-tag">A</span><span class="cmp-kpi-num">${m.fmt(m.a)}</span></div>
                <div class="cmp-kpi-val b"><span class="cmp-kpi-tag">B</span><span class="cmp-kpi-num">${m.fmt(m.b)}</span></div>
            </div>
            ${cmpDeltaBadge(m.a, m.b, m.lowerIsBetter)}
        </div>
    `).join('');
}

function cmpInsightCard(metric, aVal, bVal) {
    const delta = aVal - bVal;
    const flat = Math.abs(delta) < 0.05;
    const improved = delta <= 0;
    const icon  = flat ? 'bi-dash-circle-fill' : improved ? 'bi-arrow-down-circle-fill' : 'bi-arrow-up-circle-fill';
    const color = flat ? { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
                : improved ? { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' }
                : { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD };
    const title = (flat ? cmpL.titleNoChange : improved ? cmpL.titleImproved : cmpL.titleWorsened).replace('{0}', metric);
    const tail = flat ? cmpL.unchanged
        : (improved ? cmpL.better : cmpL.worse).replace('{0}', Math.abs(delta).toFixed(1));
    const desc = cmpL.insightDesc
        .replace('{0}', cmpLabel('A')).replace('{1}', aVal.toFixed(1))
        .replace('{2}', cmpLabel('B')).replace('{3}', bVal.toFixed(1))
        .replace('{4}', tail);
    return cmpInsightCardHtml(icon, color, title, desc);
}

function cmpInsightCardHtml(icon, color, title, desc) {
    // Escaped here, once, regardless of what got folded into title/desc
    // above (e.g. a store name in cmpMoverInsightCard) — the single render
    // point for every insight card in this file.
    return `<div class="col-md-4">
        <div style="background:${color.bg};border-left:4px solid ${color.border};border-radius:8px;padding:14px 16px;height:100%">
            <div class="d-flex align-items-start gap-2">
                <i class="bi ${icon} mt-1 flex-shrink-0" style="color:${color.text};font-size:17px"></i>
                <div>
                    <div style="font-size:13px;font-weight:700;color:${color.text};margin-bottom:3px">${sapEscape(title)}</div>
                    <div style="font-size:12.5px;color:var(--text-2);line-height:1.55">${sapEscape(desc)}</div>
                </div>
            </div>
        </div>
    </div>`;
}

/* Third insight: whichever store moved the most (either direction) in
   Turnover Rate between A and B — only meaningful company-wide, same
   guard as the Store Breakdown table below. */
function cmpMoverInsightCard(dataA, dataB) {
    if (panels.A.store || panels.B.store) return '';
    const rows = cmpComputeTableRows(dataA, dataB).filter(r => r.dt !== null);
    if (!rows.length) return '';
    const biggest = rows.reduce((m, r) => Math.abs(r.dt) > Math.abs(m.dt) ? r : m);
    if (Math.abs(biggest.dt) < 0.05) return '';
    const improved = biggest.dt <= 0;
    const icon  = improved ? 'bi-trophy-fill' : 'bi-exclamation-triangle-fill';
    const color = improved ? { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' }
                            : { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD };
    const title = (improved ? cmpL.moverTitleImproved : cmpL.moverTitleWorsened).replace('{0}', biggest.store);
    const desc = (improved ? cmpL.moverDescImproved : cmpL.moverDescWorsened)
        .replace('{0}', biggest.ta.toFixed(1)).replace('{1}', cmpLabel('A'))
        .replace('{2}', biggest.tb.toFixed(1)).replace('{3}', cmpLabel('B'))
        .replace('{4}', Math.abs(biggest.dt).toFixed(1));
    return cmpInsightCardHtml(icon, color, title, desc);
}

function cmpRenderInsight(dataA, dataB) {
    document.getElementById('cmpInsightContainer').innerHTML =
        cmpInsightCard(cmpL.metricTurnoverRate, dataA.kpi.turnoverRate, dataB.kpi.turnoverRate) +
        cmpInsightCard(cmpL.metricNinetyRate, dataA.ninety.rate, dataB.ninety.rate) +
        cmpMoverInsightCard(dataA, dataB);
}

let cmpTurnoverChart, cmpNinetyChart;
let cmpWorkforceChart, cmpResignationsChart, cmpRetentionChart, cmpExitReasonsChart, cmpExitSentimentChart;
function cmpBuildSeries(dataA, dataB, storeKey, overallA, overallB, metricKey = 'turnoverRate') {
    const allA = !panels.A.store, allB = !panels.B.store;
    if (allA && allB) {
        const mapA = {}, mapB = {};
        const valueOf = r => metricKey === 'turnoverRate'
            ? (r.value ?? r.turnoverRate)
            : (r[metricKey] ?? 0);
        (dataA[storeKey] || []).forEach(r => mapA[r.label ?? r.storeName] = valueOf(r));
        (dataB[storeKey] || []).forEach(r => mapB[r.label ?? r.storeName] = valueOf(r));
        const stores = Array.from(new Set([...Object.keys(mapA), ...Object.keys(mapB)]))
            .sort((s1, s2) => ((mapA[s2] || 0) + (mapB[s2] || 0)) - ((mapA[s1] || 0) + (mapB[s1] || 0)))
            .slice(0, 8);
        return { labels: stores, seriesA: stores.map(s => mapA[s] || 0), seriesB: stores.map(s => mapB[s] || 0) };
    }
    return { labels: [cmpL.overall], seriesA: [overallA], seriesB: [overallB] };
}

function cmpRenderCharts(dataA, dataB) {
    const t = cmpBuildSeries(dataA, dataB, 'byStore', dataA.kpi.turnoverRate, dataB.kpi.turnoverRate);
    cmpTurnoverChart = mkChart(cmpTurnoverChart, 'cmpTurnoverChart', {
        type: 'bar',
        data: { labels: t.labels, datasets: [
            { label: cmpLabel('A'), data: t.seriesA, backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: t.seriesB, backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v.toFixed(1) + '%' : '' } },
            scales: { y: { ticks: { callback: v => v + '%' } } }
        }
    });

    const n = cmpBuildSeries(dataA, dataB, 'ninetyByStore', dataA.ninety.rate, dataB.ninety.rate, 'rate');
    cmpNinetyChart = mkChart(cmpNinetyChart, 'cmpNinetyChart', {
        type: 'bar',
        data: { labels: n.labels, datasets: [
            { label: cmpLabel('A'), data: n.seriesA, backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: n.seriesB, backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v.toFixed(1) + '%' : '' } },
            scales: { y: { ticks: { callback: v => v + '%' } } }
        }
    });

    const workforce = cmpBuildSeries(dataA, dataB, 'byStore', dataA.kpi.totalHeadcount, dataB.kpi.totalHeadcount, 'headcount');
    cmpWorkforceChart = mkChart(cmpWorkforceChart, 'cmpWorkforceChart', {
        type: 'bar',
        data: { labels: workforce.labels, datasets: [
            { label: cmpLabel('A'), data: workforce.seriesA, backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: workforce.seriesB, backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v : '' } }
        }
    });

    const resignations = cmpBuildSeries(dataA, dataB, 'byStore', dataA.kpi.totalResignations, dataB.kpi.totalResignations, 'resignations');
    cmpResignationsChart = mkChart(cmpResignationsChart, 'cmpResignationsChart', {
        type: 'bar',
        data: { labels: resignations.labels, datasets: [
            { label: cmpLabel('A'), data: resignations.seriesA, backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: resignations.seriesB, backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v > 0 ? v : '' } }
        }
    });

    const retentionLabels = Array.from(new Set([
        ...(dataA.retention || []).map(x => x.label),
        ...(dataB.retention || []).map(x => x.label)
    ]));
    const retentionValues = (rows) => {
        const map = Object.fromEntries((rows || []).map(x => [x.label, x.totalHires > 0 ? x.retentionRate : null]));
        return retentionLabels.map(label => map[label] ?? null);
    };
    cmpRetentionChart = mkChart(cmpRetentionChart, 'cmpRetentionChart', {
        type: 'bar',
        data: { labels: retentionLabels, datasets: [
            { label: cmpLabel('A'), data: retentionValues(dataA.retention), backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: retentionValues(dataB.retention), backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.raw == null ? '—' : c.formattedValue + '%'}` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v == null ? '' : v.toFixed(1) + '%' } },
            scales: { y: { min: 0, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });

    const reasonMaps = [dataA.exitReasons || [], dataB.exitReasons || []].map(rows =>
        Object.fromEntries(rows.map(x => [x.label, x.value])));
    const reasons = Array.from(new Set([
        ...Object.keys(reasonMaps[0]), ...Object.keys(reasonMaps[1])
    ])).sort((a, b) => (reasonMaps[0][b] || 0) + (reasonMaps[1][b] || 0) - (reasonMaps[0][a] || 0) - (reasonMaps[1][a] || 0)).slice(0, 8);
    cmpExitReasonsChart = mkChart(cmpExitReasonsChart, 'cmpExitReasonsChart', {
        type: 'bar',
        data: { labels: reasons, datasets: [
            { label: cmpLabel('A'), data: reasons.map(x => reasonMaps[0][x] || 0), backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: reasons.map(x => reasonMaps[1][x] || 0), backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            indexAxis: 'y',
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}` } } }
        }
    });

    const sentimentA = dataA.exitSentiment?.positivePercent || 0;
    const sentimentB = dataB.exitSentiment?.positivePercent || 0;
    cmpExitSentimentChart = mkChart(cmpExitSentimentChart, 'cmpExitSentimentChart', {
        type: 'bar',
        data: { labels: [cmpL.exitPositive], datasets: [
            { label: cmpLabel('A'), data: [sentimentA], backgroundColor: ChartColors.SERIES.SECONDARY, borderRadius: 4 },
            { label: cmpLabel('B'), data: [sentimentB], backgroundColor: ChartColors.SERIES.PRIMARY, borderRadius: 4 }
        ] },
        options: {
            interaction: { mode: 'index', intersect: true },
            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 10, weight: 'bold' }, formatter: v => v.toFixed(1) + '%' } },
            scales: { y: { min: 0, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });
    document.getElementById('cmpExitSentimentMeta').innerHTML =
        `<span class="me-3">${sapEscape(cmpLabel('A'))}: ${dataA.exitSentiment?.totalResponses || 0} ${sapEscape(cmpL.exitResponses)}</span>` +
        `<span>${sapEscape(cmpLabel('B'))}: ${dataB.exitSentiment?.totalResponses || 0} ${sapEscape(cmpL.exitResponses)}</span>`;
}

let cmpTableRows = [];
let cmpTableSortCol = 'store', cmpTableSortAsc = true;
let cmpTurnoverColorRules = null, cmpNinetyColorRules = null;

function cmpComputeTableRows(dataA, dataB) {
    const turnoverA = {}, turnoverB = {}, ninetyA = {}, ninetyB = {};
    dataA.byStore.forEach(r => turnoverA[r.storeName] = r.turnoverRate);
    dataB.byStore.forEach(r => turnoverB[r.storeName] = r.turnoverRate);
    dataA.ninetyByStore.forEach(r => ninetyA[r.label ?? r.storeName] = r.rate ?? r.value);
    dataB.ninetyByStore.forEach(r => ninetyB[r.label ?? r.storeName] = r.rate ?? r.value);

    const stores = Array.from(new Set([...Object.keys(turnoverA), ...Object.keys(turnoverB)]));
    return stores.map(s => {
        const ta = turnoverA[s], tb = turnoverB[s], na = ninetyA[s], nb = ninetyB[s];
        return {
            store: s, ta, tb, na, nb,
            dt: (ta !== undefined && tb !== undefined) ? ta - tb : null,
            dn: (na !== undefined && nb !== undefined) ? na - nb : null,
        };
    });
}

function cmpRenderTable(dataA, dataB) {
    const card = document.getElementById('cmpTableCard');
    if (panels.A.store || panels.B.store) { card.style.display = 'none'; return; }
    card.style.display = '';

    cmpTableRows = cmpComputeTableRows(dataA, dataB);
    cmpRenderTableRows();
}

function cmpRenderTableRows() {
    if (!cmpTableRows.length) {
        document.getElementById('cmpTableBody').innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">${cmpL.noDataShort}</td></tr>`;
        return;
    }
    const rateBadge = (rules, v) => (v === undefined || v === null) ? '<span class="text-muted">—</span>' : ChartColors.rateBadgeHtml(rules, v);
    const ltrDelta = v => v === null ? '—' : `<span style="direction:ltr;unicode-bidi:isolate">${v > 0 ? '+' : ''}${v.toFixed(1)}</span>`;

    const rows = cmpTableRows.slice().sort((a, b) => {
        const va = a[cmpTableSortCol], vb = b[cmpTableSortCol];
        const naMissing = va === undefined || va === null, nbMissing = vb === undefined || vb === null;
        if (naMissing && nbMissing) return 0;
        if (naMissing) return 1;   // missing values always sort to the bottom
        if (nbMissing) return -1;
        if (typeof va === 'string') return cmpTableSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
        return cmpTableSortAsc ? va - vb : vb - va;
    });

    document.getElementById('cmpTableBody').innerHTML = rows.map(r => `
        <tr>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.store)}</td>
            <td class="px-3 py-2 text-center">${rateBadge(cmpTurnoverColorRules, r.ta)}</td>
            <td class="px-3 py-2 text-center">${rateBadge(cmpTurnoverColorRules, r.tb)}</td>
            <td class="px-3 py-2 text-center">${ltrDelta(r.dt)}</td>
            <td class="px-3 py-2 text-center">${rateBadge(cmpNinetyColorRules, r.na)}</td>
            <td class="px-3 py-2 text-center">${rateBadge(cmpNinetyColorRules, r.nb)}</td>
            <td class="px-3 py-2 text-center">${ltrDelta(r.dn)}</td>
        </tr>`).join('');
}

async function cmpRefreshAll() {
    if (!panels.A.months.length || !panels.B.months.length) return;
    const [dataA, dataB] = await Promise.all([cmpFetchSide('A'), cmpFetchSide('B')]);
    cmpRenderKpis(dataA, dataB);
    cmpRenderInsight(dataA, dataB);
    cmpRenderCharts(dataA, dataB);
    cmpRenderTable(dataA, dataB);
}

/* Store Breakdown table — sort headers ------------------------------------ */
document.querySelectorAll('#cmpTableCard .cmp-sort').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (cmpTableSortCol === col) { cmpTableSortAsc = !cmpTableSortAsc; }
        else { cmpTableSortCol = col; cmpTableSortAsc = col === 'store'; }
        document.querySelectorAll('#cmpTableCard .cmp-sort i').forEach(i => i.className = 'bi bi-arrow-down-up text-muted');
        const icon = th.querySelector('i');
        if (icon) icon.className = cmpTableSortAsc ? 'bi bi-sort-up text-danger' : 'bi bi-sort-down text-danger';
        cmpRenderTableRows();
    });
});

(async function cmpInitPage() {
    [cmpTurnoverColorRules, cmpNinetyColorRules] = await Promise.all([
        ChartColors.loadRateRules('turnover'),
        ChartColors.loadRateRules('ninety-day'),
    ]);
    await cmpInit();
})();
</script>
