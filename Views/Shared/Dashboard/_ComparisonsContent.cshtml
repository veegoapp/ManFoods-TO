<div class="cmp-chooser mb-4">
    <div class="cmp-chooser-title">@L["CMP_ChooseTitle"]</div>
    <div class="cmp-chooser-sub">@L["CMP_ChooseSub"]</div>
    <div class="cmp-chooser-options" role="radiogroup" aria-label="@L["CMP_ChooseTitle"]">
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="turnover"><span><i class="bi bi-graph-down-arrow"></i>@L["CMP_Grp_turnover"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="breakdown"><span><i class="bi bi-diagram-3"></i>@L["CMP_Grp_breakdown"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="ninety"><span><i class="bi bi-person-x"></i>@L["CMP_Grp_ninety"]</span></label>
