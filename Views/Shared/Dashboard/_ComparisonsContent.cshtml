/* ── Scorecard ────────────────────────────────────────────────────────────── */
const cmpScoreBoth = dim => Promise.all(['A', 'B'].map(side => {
    const p = panels[side], q = new URLSearchParams({ dimension: dim, year: p.year, months: p.months.join(',') });
    ['om', 'oc', 'soc', 'od'].forEach(f => { if (p[f]) q.set(f, p[f]); });
    return cmpGet(`/api/scorecard?${q}`);
}));
/* The four scorecard measures as A / B / change columns. */
function cmpScoreCells(a, b) {
    const m = (f, lower) => [cmpFmtPct(a?.[f]), cmpFmtPct(b?.[f]), cmpDeltaHtml(a?.[f] ?? null, b?.[f] ?? null, { lowerIsBetter: lower })];
    return [...m('turnoverRate', true), ...m('earlyLeaver90Rate', true), ...m('retention180Rate', false), ...m('exitSentimentPercent', false)];
}
function cmpScoreHeaders(first) {
    const group = (label) => [label + ' A', label + ' B', S('colChange')];
    return [first, ...group(S('colTurnoverRate')), ...group(S('colEarlyLeave')), ...group(S('col180')), ...group(S('colSentiment'))];
}
async function cmpTabScorecardSupervisors(c) {
    const [oc, om] = await Promise.all([cmpScoreBoth('oc'), cmpScoreBoth('om')]);
    c.replaceChildren();
    [[oc, S('scByOc')], [om, S('scByOm')]].forEach(([[ra, rb], title]) => {
        const ma = new Map((ra || []).map(r => [r.name, r])), mb = new Map((rb || []).map(r => [r.name, r]));
        const names = [...new Set([...ma.keys(), ...mb.keys()])].sort((x, y) => ((mb.get(y)?.turnoverRate || 0) + (ma.get(y)?.turnoverRate || 0)) - ((mb.get(x)?.turnoverRate || 0) + (ma.get(x)?.turnoverRate || 0)));
        cmpTableCard(c, title + S('vs'), '', cmpScoreHeaders(S('colName')), names.map(n => [cmpEsc(n), ...cmpScoreCells(ma.get(n), mb.get(n))]));
    });
}
async function cmpTabScorecardLeaders(c) {
    const [ra, rb] = (await cmpScoreBoth('leader'));
    c.replaceChildren();
    const mb = new Map((rb || []).map(r => [r.name, r]));
    const rows = (ra || []).filter(r => mb.has(r.name)).map(r => ({ a: r, b: mb.get(r.name), d: r.turnoverRate - mb.get(r.name).turnoverRate }));
    const render = (title, list) => cmpTableCard(c, title, '', cmpScoreHeaders(S('colLeader')), list.map(r => [cmpEsc(r.a.name), ...cmpScoreCells(r.a, r.b)]));
    render(S('leadersImproved'), rows.filter(r => r.d < 0).sort((x, y) => x.d - y.d).slice(0, 10));
    render(S('leadersWorsened'), rows.filter(r => r.d > 0).sort((x, y) => y.d - x.d).slice(0, 10));
}

/* Store Breakdown table — sort headers ------------------------------------ */
document.querySelectorAll('#cmpTableCard .cmp-sort').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (cmpTableSortCol === col) { cmpTableSortAsc = !cmpTableSortAsc; }
        else { cmpTableSortCol = col; cmpTableSortAsc = col === 'store'; }
        document.querySelectorAll('#cmpTableCard .cmp-sort i').forEach(i => i.className = 'bi bi-arrow-down-up text-muted');
        const icon = th.querySelector('i');
        if (icon) icon.className = cmpTableSortAsc ? 'bi bi-sort-up text-danger' : 'bi bi-sort-down text-danger';
        cmpRenderTableRows();
    });
});

(async function cmpInitPage() {
    [cmpTurnoverColorRules, cmpNinetyColorRules] = await Promise.all([
        ChartColors.loadRateRules('turnover'),
        ChartColors.loadRateRules('ninety-day'),
    ]);
    await cmpInit();
})();
</script>
