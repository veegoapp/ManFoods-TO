}

function cmpRenderRetentionChart(dataA, dataB) {
    const retentionLabels = Array.from(new Set([
        ...(dataA.retention || []).map(x => x.label),
        ...(dataB.retention || []).map(x => x.label)
    ]));
    const retentionValues = (rows) => {
