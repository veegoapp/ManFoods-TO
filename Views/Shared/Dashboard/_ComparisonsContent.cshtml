<div class="cmp-chooser mb-4">
    <div class="cmp-chooser-title">@L["CMP_ChooseTitle"]</div>
    <div class="cmp-chooser-sub">@L["CMP_ChooseSub"]</div>
    <div class="cmp-chooser-options" role="radiogroup" aria-label="@L["CMP_ChooseTitle"]">
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="turnover"><span><i class="bi bi-graph-down-arrow"></i>@L["CMP_Grp_turnover"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="ninety"><span><i class="bi bi-person-x"></i>@L["CMP_Grp_ninety"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="workforce"><span><i class="bi bi-people"></i>@L["CMP_Grp_workforce"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="retention"><span><i class="bi bi-hourglass-split"></i>@L["CMP_Grp_retention"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="exit"><span><i class="bi bi-chat-square-text"></i>@L["CMP_Grp_exit"]</span></label>
        <label class="cmp-opt"><input type="radio" name="cmpGroup" value="drivers"><span><i class="bi bi-chat-heart"></i>@L["CMP_Grp_drivers"]</span></label>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap mt-3">
        <button type="button" id="cmpCompareBtn" class="cmp-compare-btn">
            <span class="spinner-border spinner-border-sm" id="cmpCompareSpin" hidden></span>
            <i class="bi bi-bar-chart-line" id="cmpCompareIcon"></i><span id="cmpCompareLabel">@L["CMP_CompareBtn"]</span>
        </button>
        <span class="cmp-stale" id="cmpStale" hidden><i class="bi bi-exclamation-circle me-1"></i>@L["CMP_StaleNote"]</span>
    </div>
</div>

<div id="cmpEmptyState" class="empty-state mb-4"><i class="bi bi-bar-chart-steps"></i><p>@L["CMP_EmptyHint"]</p></div>

<div id="cmpModal" class="cmp-modal" hidden role="alertdialog" aria-modal="true" aria-describedby="cmpModalText">
    <div class="cmp-modal-card">
        <i class="bi bi-exclamation-circle-fill"></i>
        <p id="cmpModalText"></p>
        <button type="button" id="cmpModalOk" class="cmp-compare-btn">@L["CMP_Ok"]</button>
    </div>
</div>

<div class="cmp-notice" id="cmpPeriodNotice" hidden><i class="bi bi-exclamation-triangle-fill"></i><span id="cmpPeriodNoticeText"></span></div>

<div class="d-flex align-items-center gap-2 mb-3" data-cmp-groups="turnover ninety">
    <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
    <h5 class="mb-0 fw-bold">@L["Common_SmartInsights"]</h5>
    <span class="badge ms-1" style="background:oklch(0.6 0.16 25);color:#1C1C27;font-size:10px;padding:4px 8px">@L["Common_AutoGenerated"]</span>
</div>
<div id="cmpInsightContainer" class="row g-3 mb-4" data-cmp-groups="turnover ninety">
    <div class="col-12 text-center py-3 text-muted">
        <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["Common_Loading"]
    </div>
</div>

<div class="cmp-kpi-grid mb-4" id="cmpKpiGrid" data-cmp-groups="turnover ninety workforce"
