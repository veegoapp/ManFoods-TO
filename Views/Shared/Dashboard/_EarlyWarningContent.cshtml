/* Trend — one Summary snapshot per available month, all-time (not limited to
   the current Months selection), same pattern as the Turnover page's
   Turnover Rate by Month chart. */
let ewTrendChartInstance;
async function ewLoadTrendChart() {
    ewSetTitleBadge('ewTrendTitle', false);
    const allPeriods = await fetch('/api/dashboard/available-periods').then(r => r.ok ? r.json() : []);
    if (!allPeriods || !allPeriods.length) return;
    const sortedPeriods = allPeriods.slice().sort((a, b) => (a.year * 100 + a.month) - (b.year * 100 + b.month));
    const results = await Promise.all(sortedPeriods.map(({ month, year }) => {
        const q = new URLSearchParams({ year, months: month });
        if (ewStoreFilter) q.set('store', ewStoreFilter);
        if (ewJobFilter.length) q.set('jobs', ewJobFilter.join(','));
        return fetch(`/api/early-warning/summary?${q.toString()}`).then(r => r.ok ? r.json() : null);
    }));

    const labels = sortedPeriods.map(({ month, year }) => `${ewMonthShortName(month)} ${String(year).slice(-2)}`);
    const ctx = document.getElementById('ewTrendChart');
    if (!ctx) return;
    if (ewTrendChartInstance) ewTrendChartInstance.destroy();
    ewTrendChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [
                { label: 'Total Watchlist', data: results.map(r => r?.totalWatchlist ?? null), borderColor: ChartColors.SERIES.PRIMARY, backgroundColor: 'transparent', tension: 0.3, pointRadius: 3, spanGaps: true },
                { label: 'High Risk (4-5★)', data: results.map(r => r?.highRiskCount ?? null), borderColor: ChartColors.SEMANTIC.BAD, backgroundColor: 'transparent', tension: 0.3, pointRadius: 3, spanGaps: true },
            ]
        },
        options: {
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { labels: { color: 'oklch(0.5 0.03 258)', font: { size: 11 } } },
                tooltip: { enabled: true },
                datalabels: { display: false }
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: 'oklch(0.5 0.03 258)' } },
                y: { beginAtZero: true, ticks: { color: 'oklch(0.5 0.03 258)', precision: 0 }, grid: { color: 'oklch(0.92 0.008 255)' } }
            }
        }
    });
}

/* Smart Insights — computed client-side from the already-fetched watchlist,
   plain "what stands out" statements, no extra network calls. */
function ewRenderInsights(rows) {
    const el = document.getElementById('ewInsights');
    if (!rows || !rows.length) { el.innerHTML = '<div class="text-muted" style="font-size:13px">' + EW_L.noWatchlistPeriod + '</div>'; return; }
    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
    };
    const items = [];

    const highRisk = rows.filter(r => r.stars >= 4);
    items.push({
        icon: 'bi-exclamation-triangle-fill', color: highRisk.length > 0 ? 'danger' : 'secondary',
        title: EW_L.insightHighRiskTitle,
        description: EW_L.insightHighRiskDesc
            .replace('{0}', highRisk.length)
            .replace('{1}', rows.length)
            .replace('{2}', Math.round(highRisk.length / rows.length * 100)),
    });

    const reasonCounts = {};
    rows.forEach(r => r.reasons.forEach(x => { reasonCounts[x.type] = (reasonCounts[x.type] || 0) + 1; }));
    const topReason = Object.entries(reasonCounts).sort((a, b) => b[1] - a[1])[0];
    if (topReason) {
        const label = ewReasonTypeLabel(topReason[0]);
        items.push({
            icon: 'bi-graph-up-arrow', color: 'warning',
            title: EW_L.insightTopReasonTitle,
            description: EW_L.insightTopReasonDesc
                .replace('{0}', label)
                .replace('{1}', topReason[1])
                .replace('{2}', rows.length),
        });
    }

    const storeCounts = {};
    highRisk.forEach(r => { if (r.store) storeCounts[r.store] = (storeCounts[r.store] || 0) + 1; });
    const topStore = Object.entries(storeCounts).sort((a, b) => b[1] - a[1])[0];
    if (topStore) {
        items.push({
            icon: 'bi-shop', color: 'danger',
            title: EW_L.insightTopStoreTitle,
            description: EW_L.insightTopStoreDesc
                .replace('{0}', topStore[0])
                .replace('{1}', topStore[1]),
        });
    }

    const roleCounts = {};
    rows.forEach(r => { if (r.jobTitle) roleCounts[r.jobTitle] = (roleCounts[r.jobTitle] || 0) + 1; });
    const topRole = Object.entries(roleCounts).sort((a, b) => b[1] - a[1])[0];
    if (topRole) {
        items.push({
            icon: 'bi-person-badge', color: 'secondary',
            title: EW_L.insightTopRoleTitle,
            description: EW_L.insightTopRoleDesc
                .replace('{0}', topRole[0])
                .replace('{1}', topRole[1])
                .replace('{2}', rows.length),
        });
    }

    // item.title/description are escaped once below, at render — any
    // dynamic value folded into them above (e.g. topStore[0]/topRole[0])
    // must stay unescaped at construction time, or it double-encodes here.
    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6">
            <div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
                    <div>
                        <div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
                        <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('') + '</div>';
}

async function ewLoadWatchlist() {
    ewWatchlistData = await ewFetch('watchlist') || [];
    ewRenderHighRiskTable(ewWatchlistData);
    ewRenderTable(ewWatchlistData);
    ewLoadReasonChart(ewWatchlistData);
    ewLoadStoreChart(ewWatchlistData);
    ewLoadHighRiskStoreChart(ewWatchlistData);
    ewLoadJobTitleChart(ewWatchlistData);
    ewLoadStarDistChart(ewWatchlistData);
    ewRenderInsights(ewWatchlistData);
}

async function ewLoadAll() {
    if (!ewYear || !ewMonths.length) return;
    await Promise.all([ewLoadSummary(), ewLoadWatchlist(), ewLoadTrendChart()]);
}

document.getElementById('ewSearch').addEventListener('input', () => ewRenderTable(ewWatchlistData));

(async function init() {
    ewRiskColorRules = await ChartColors.loadRateRules('early-warning');
    const hasData = await ewLoadFilters();
    if (hasData) await ewLoadAll();
})();
</script>
