@{
    var storeFromUrl = Context.Request.Query["store"].ToString();
}

<style>
.sp-page { --sp-accent: #0072B2; --sp-soft: rgba(0,114,178,.1); }
.sp-hero { display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap; padding:24px; margin-bottom:18px; background:var(--card-bg); border:1px solid var(--card-border); border-radius:var(--radius-lg); box-shadow:var(--shadow-sm); }
.sp-hero h1 { margin:0; font-size:clamp(1.4rem,2.4vw,2rem); }
.sp-hero p { margin:6px 0 0; color:var(--text-2); font-size:13px; }
.sp-hero-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
.sp-filter { display:flex; gap:8px; align-items:center; padding:7px 10px; background:var(--bg-2); border:1px solid var(--card-border); border-radius:8px; color:var(--text-2); font-size:12px; }
.sp-filter select { min-width:118px; border:0; outline:0; background:transparent; color:var(--text); font-size:12px; }
.sp-back { display:inline-flex; align-items:center; gap:7px; color:var(--text-2); text-decoration:none; font-size:12.5px; font-weight:700; }
.sp-back:hover { color:var(--red); }
.sp-state { margin-bottom:16px; }
.sp-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:18px; }
.sp-kpi { padding:16px; background:var(--card-bg); border:1px solid var(--card-border); border-radius:10px; }
.sp-kpi-icon { color:var(--sp-accent); font-size:17px; margin-bottom:10px; }
.sp-kpi-value { font-size:23px; font-weight:800; color:var(--text); }
.sp-kpi-label { color:var(--text-2); font-size:12px; margin-top:3px; }
.sp-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.sp-card { background:var(--card-bg); border:1px solid var(--card-border); border-radius:10px; padding:18px; min-width:0; }
.sp-card-wide { grid-column:1/-1; }
.sp-card-title { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
.sp-card-title h3 { margin:0; font-size:15px; font-weight:800; }
.sp-card-title i { color:var(--sp-accent); margin-inline-end:7px; }
.sp-muted { color:var(--text-2); font-size:12px; }
.sp-list { display:grid; gap:10px; }
.sp-row { display:grid; grid-template-columns:minmax(110px,1fr) minmax(100px,2fr) auto; gap:10px; align-items:center; font-size:12px; }
.sp-row-label { color:var(--text-2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.sp-track { height:8px; overflow:hidden; background:var(--bg-2); border-radius:99px; }
.sp-fill { display:block; height:100%; min-width:2px; background:var(--sp-accent); border-radius:99px; }
.sp-row-value { color:var(--text); font-weight:700; white-space:nowrap; }
.sp-tabs { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 16px; }
.sp-tab { padding:9px 13px; border:1px solid var(--card-border); border-radius:8px; color:var(--text-2); background:var(--card-bg); font-size:12px; font-weight:700; cursor:pointer; }
.sp-tab:hover,.sp-tab.active { color:#fff; background:var(--sp-accent); border-color:var(--sp-accent); }
.sp-panel { display:none; }
.sp-panel.active { display:block; }
.sp-table-wrap { overflow:auto; }
.sp-table { width:100%; border-collapse:collapse; font-size:12px; }
.sp-table th,.sp-table td { padding:9px 8px; text-align:start; border-bottom:1px solid var(--card-border); }
.sp-table th { color:var(--text-2); font-weight:700; }
.sp-badge { display:inline-flex; padding:4px 8px; border-radius:999px; background:var(--sp-soft); color:var(--sp-accent); font-size:11px; font-weight:800; }
.sp-empty { padding:24px 10px; text-align:center; color:var(--text-2); font-size:12px; }
.sp-chart-wrap { height:250px; position:relative; }
.sp-chart-wrap canvas { direction:ltr; }
.sp-rate-table-wrap { overflow:auto; }
.sp-rate-table { width:100%; border-collapse:collapse; font-size:12px; }
.sp-rate-table th,.sp-rate-table td { padding:9px 8px; text-align:start; border-bottom:1px solid var(--card-border); white-space:nowrap; }
.sp-rate-table th { color:var(--text-2); font-weight:700; }
.sp-rate-table td.rate { color:var(--sp-accent); font-weight:800; text-align:end; }
.sp-leader-current { display:inline-flex; align-items:center; gap:6px; padding:4px 9px; border-radius:999px; background:var(--sp-soft); color:var(--sp-accent); font-weight:800; font-size:11px; }
.sp-health { display:grid; grid-template-columns:minmax(230px,.85fr) minmax(0,1.6fr); gap:16px; margin-bottom:18px; }
.sp-health-hero { padding:20px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:linear-gradient(135deg,var(--card-bg),var(--bg-2)); box-shadow:var(--shadow-sm); }
.sp-health-kicker { color:var(--text-2); font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
.sp-health-title { display:flex; align-items:center; gap:9px; margin-top:10px; font-size:23px; font-weight:850; }
.sp-health-title i { font-size:18px; }
.sp-health-copy { margin:9px 0 0; color:var(--text-2); font-size:12px; line-height:1.6; }
.sp-health-meta { display:flex; flex-wrap:wrap; gap:7px; margin-top:15px; }
.sp-health-chip { display:inline-flex; align-items:center; gap:5px; padding:5px 9px; border-radius:999px; background:var(--card-bg); border:1px solid var(--card-border); color:var(--text-2); font-size:11px; font-weight:750; }
.sp-health-good { --health-color:oklch(0.5 0.15 155); --health-bg:oklch(0.62 0.15 155 / .1); }
.sp-health-watch { --health-color:oklch(0.6 0.14 75); --health-bg:oklch(0.75 0.16 75 / .13); }
.sp-health-critical { --health-color:oklch(0.6 0.22 22); --health-bg:oklch(0.6 0.22 22 / .1); }
.sp-health-state { color:var(--health-color); }
.sp-health-state .sp-health-title { color:var(--health-color); }
.sp-health-state .sp-health-hero { border-color:color-mix(in srgb,var(--health-color) 36%,var(--card-border)); background:linear-gradient(135deg,var(--health-bg),var(--card-bg)); }
.sp-health-panels { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.sp-health-panel { min-width:0; padding:15px; border:1px solid var(--card-border); border-radius:10px; background:var(--card-bg); }
.sp-health-panel-title { display:flex; align-items:center; gap:7px; margin-bottom:11px; color:var(--text); font-size:12.5px; font-weight:800; }
.sp-health-panel-title i { color:var(--sp-accent); }
.sp-health-list { display:grid; gap:8px; }
.sp-health-row { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; font-size:12px; }
.sp-health-row-label { color:var(--text-2); min-width:0; }
.sp-health-row-value { color:var(--text); font-weight:800; text-align:end; white-space:nowrap; }
.sp-health-issue { display:flex; align-items:flex-start; gap:7px; color:var(--text-2); font-size:12px; line-height:1.45; }
.sp-health-issue i { margin-top:2px; color:var(--health-color,var(--sp-accent)); }
.sp-health-progress { height:7px; margin-top:5px; overflow:hidden; background:var(--bg-2); border-radius:99px; }
.sp-health-progress > span { display:block; height:100%; background:var(--sp-accent); border-radius:inherit; }
.sp-health-empty { color:var(--text-3); font-size:12px; }
@@media (max-width: 900px) { .sp-kpis { grid-template-columns:repeat(2,minmax(0,1fr)); } .sp-health { grid-template-columns:1fr; } }
@@media (max-width: 640px) { .sp-grid { grid-template-columns:1fr; } .sp-card-wide { grid-column:auto; } .sp-kpis { grid-template-columns:1fr 1fr; } .sp-hero { padding:18px; } .sp-row { grid-template-columns:1fr auto; } .sp-track { grid-column:1/-1; grid-row:2; } .sp-health-panels { grid-template-columns:1fr; } }
</style>

<div id="spRoot" class="sp-page" data-store="@storeFromUrl"
     data-area-prefix="@((ViewContext.RouteData.Values["area"]?.ToString() ?? "Home") == "Admin" ? "/admin" : "/home")"
     data-title="@L["SP_PageTitle"]" data-subtitle="@L["SP_PageSub"]"
     data-no-store="@L["SP_NoStore"]" data-loading="@L["SP_Loading"]"
     data-no-data="@L["SP_NoData"]" data-employees="@L["Common_Employees"]"
     data-resignations="@L["Common_Resignations"]" data-percent="@L["Common_Percent"]">
    <div class="sp-hero">
        <div>
            <a class="sp-back" id="spBackLink" href="#"><i class="bi bi-arrow-left"></i>@L["Common_Back"]</a>
            <h1 id="spStoreName" class="mt-2">@L["SP_PageTitle"]</h1>
            <p id="spSubtitle">@L["SP_PageSub"]</p>
        </div>
        <div class="sp-hero-actions">
            <label class="sp-filter"><i class="bi bi-calendar3"></i><span>@L["SP_From"]</span><select id="spFromPeriod"></select></label>
            <label class="sp-filter"><i class="bi bi-calendar-check"></i><span>@L["SP_To"]</span><select id="spToPeriod"></select></label>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="spRefresh"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>

    @{
        var storeProfileGuide = new PageGuideViewModel
        {
            PageKey = "storeprofile",
            Overview = L["Guide_StoreProfile_Overview"],
            FilterNote = L["Guide_StoreProfile_FilterNote"],
            Sections = new List<PageGuideSection>
            {
                new() { Icon = "bi-compass", Title = L["SP_HealthKicker"], Body = L["Guide_StoreProfile_Health"] },
                new() { Icon = "bi-people", Title = L["SP_RiskSummary"], Body = L["Guide_StoreProfile_WorkforceRisk"] },
                new() { Icon = "bi-diagram-3-fill", Title = L["SP_StaffingPlan"], Body = L["Guide_StoreProfile_StaffingPlan"] },
                new() { Icon = "bi-graph-up-arrow", Title = L["SP_TurnoverTrend"], Body = L["Guide_StoreProfile_Turnover"] },
                new() { Icon = "bi-bar-chart-line", Title = L["SP_HeadcountTrend"], Body = L["Guide_StoreProfile_HeadcountAndInsights"] },
                new() { Icon = "bi-hourglass-split", Title = L["Nav_Retention"], Body = L["Guide_StoreProfile_Retention"] },
                new() { Icon = "bi-stopwatch", Title = L["SP_NinetyDayKpi"], Body = L["Guide_StoreProfile_EarlyLeavers"] },
                new() { Icon = "bi-chat-left-text", Title = L["SP_ExitSentiment"], Body = L["Guide_StoreProfile_Exit"] },
                new() { Icon = "bi-clipboard-check", Title = L["SP_ActionPlan"], Body = L["Guide_StoreProfile_ActionPlan"] },
                new() { Icon = "bi-person-badge", Title = L["SP_StoreLeaders"], Body = L["Guide_StoreProfile_Leaders"] },
            }
        };
    }
    @await Html.PartialAsync("~/Views/Shared/Dashboard/_PageGuide.cshtml", storeProfileGuide)

    <div id="spState" class="sp-state"></div>
    <div id="spHealthSummary"></div>
    <div id="spKpis" class="sp-kpis"></div>

    <div class="sp-tabs" role="tablist">
        <button class="sp-tab active" data-panel="overview">@L["SP_Overview"]</button>
        <button class="sp-tab" data-panel="workforce">@L["Nav_Workforce"]</button>
        <button class="sp-tab" data-panel="turnover">@L["Nav_Turnover"]</button>
        <button class="sp-tab" data-panel="retention">@L["Nav_Retention"]</button>
        <button class="sp-tab" data-panel="ninety">@L["Nav_NinetyDay"]</button>
        <button class="sp-tab" data-panel="warning">@L["Nav_EarlyWarning"]</button>
        <button class="sp-tab" data-panel="exit">@L["Nav_ExitInterviews"]</button>
        <button class="sp-tab" data-panel="action">@L["Nav_ActionCenter"]</button>
         <button class="sp-tab" data-panel="leaders">@L["SP_StoreLeaders"]</button>
    </div>

    <section class="sp-panel active" id="spPanel-overview"><div class="sp-grid">
        <div class="sp-card"><div class="sp-card-title"><h3><i class="bi bi-graph-up"></i>@L["SP_TurnoverTrend"]</h3></div><div class="sp-chart-wrap"><canvas id="spTurnoverChart"></canvas></div></div>
        <div class="sp-card"><div class="sp-card-title"><h3><i class="bi bi-people"></i>@L["SP_HeadcountTrend"]</h3></div><div class="sp-chart-wrap"><canvas id="spHeadcountChart"></canvas></div></div>
        <div class="sp-card"><div class="sp-card-title"><h3><i class="bi bi-person-exclamation"></i>@L["SP_RiskSummary"]</h3></div><div id="spRiskSummary"></div></div>
        <div class="sp-card"><div class="sp-card-title"><h3><i class="bi bi-lightbulb"></i>@L["SP_QuickInsights"]</h3></div><div id="spInsights"></div></div>
    </div></section>

    <section class="sp-panel" id="spPanel-leaders"><div id="spLeaders"></div></section>
    <section class="sp-panel" id="spPanel-workforce"><div id="spWorkforce"></div></section>
    <section class="sp-panel" id="spPanel-turnover"><div id="spTurnover"></div></section>
    <section class="sp-panel" id="spPanel-retention"><div id="spRetention"></div></section>
    <section class="sp-panel" id="spPanel-ninety"><div id="spNinety"></div></section>
    <section class="sp-panel" id="spPanel-warning"><div id="spWarning"></div></section>
    <section class="sp-panel" id="spPanel-exit"><div id="spExit"></div></section>
    <section class="sp-panel" id="spPanel-action"><div id="spAction"></div></section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script>
(function () {
    const root = document.getElementById('spRoot');
    if (!root) return;
    const d = root.dataset;
    const store = d.store || '';
    const areaPrefix = d.areaPrefix || '/home';
    let periods = [], fromPeriod = null, toPeriod = null, loadedPanels = new Set();
    let turnoverChart = null, headcountChart = null, overviewData = {};

    const $ = id => document.getElementById(id);
    const esc = value => sapEscape(value ?? '');
    const arr = value => Array.isArray(value) ? value : [];
    const number = value => Number.isFinite(Number(value)) ? Number(value) : 0;
    const labelOf = row => row?.label ?? row?.name ?? row?.storeName ?? row?.reason ?? '—';
    const valueOf = row => number(row?.value ?? row?.count ?? row?.total ?? row?.rate ?? row?.turnoverRate ?? row?.retentionRate ?? row?.positivePercent ?? row?.percentage ?? row?.earlyLeaverRate);
    const fmt = value => number(value).toLocaleString();
    const pct = value => `${number(value).toFixed(1)}%`;

    function setState(message, type) {
        $('spState').innerHTML = message ? `<div class="alert alert-${type || 'info'} py-2 small">${esc(message)}</div>` : '';
    }

    async function get(url, fallback) {
        try {
            const response = await fetch(url);
            return response.ok ? await response.json() : fallback;
        } catch { return fallback; }
    }

    function periodValue(p) { return `${p.month}-${p.year}`; }
    function periodKey(p) { return p.year * 100 + p.month; }
    function periodLabel(p) {
        return new Date(p.year, p.month - 1, 1).toLocaleString(undefined, { month: 'short', year: 'numeric' });
    }
    function selectedPeriods() {
        if (!fromPeriod || !toPeriod) return periods.slice().sort((a, b) => periodKey(a) - periodKey(b));
        const from = Math.min(periodKey(fromPeriod), periodKey(toPeriod));
        const to = Math.max(periodKey(fromPeriod), periodKey(toPeriod));
        return periods.filter(p => periodKey(p) >= from && periodKey(p) <= to)
            .slice().sort((a, b) => periodKey(a) - periodKey(b));
    }
    function periodQuery() {
        const q = new URLSearchParams({ store });
        if (toPeriod) { q.set('month', toPeriod.month); q.set('year', toPeriod.year); }
        if (fromPeriod) { q.set('fromMonth', fromPeriod.month); q.set('fromYear', fromPeriod.year); }
        if (fromPeriod) q.set('sinceYear', fromPeriod.year);
        return q;
    }
    function snapshotQuery() {
        const q = new URLSearchParams({ store });
        if (toPeriod) {
            q.set('year', toPeriod.year);
            q.set('months', toPeriod.month);
        }
        return q;
    }
    function exitRangeQuery() {
        const q = new URLSearchParams({ store });
        const range = selectedPeriods();
        if (range.length && range.every(p => p.year === range[0].year)) {
            q.set('year', range[0].year);
            q.set('months', range.map(p => p.month).join(','));
        } else if (toPeriod) {
            q.set('year', toPeriod.year);
        }
        return q;
    }

    function renderBars(items, suffix) {
        const rows = arr(items).map(r => ({ label: labelOf(r), value: valueOf(r) })).filter(r => r.label !== '—');
        if (!rows.length) return `<div class="sp-empty">${esc(d.noData)}</div>`;
        const max = Math.max(...rows.map(r => r.value), 1);
        return `<div class="sp-list">${rows.slice(0, 10).map(r => `<div class="sp-row">
            <span class="sp-row-label" title="${esc(r.label)}">${esc(r.label)}</span>
            <span class="sp-track"><span class="sp-fill" style="width:${Math.max(2, r.value / max * 100)}%"></span></span>
            <span class="sp-row-value">${fmt(r.value)}${suffix || ''}</span>
        </div>`).join('')}</div>`;
    }
    function card(title, icon, body, wide) {
        return `<div class="sp-card${wide ? ' sp-card-wide' : ''}"><div class="sp-card-title"><h3><i class="bi ${icon}"></i>${esc(title)}</h3></div>${body}</div>`;
    }
    function renderCards(items) {
        return `<div class="sp-grid">${items.join('')}</div>`;
    }
    function renderRateTable(rows, rateKey, extraColumns) {
        if (!rows.length) return `<div class="sp-empty">${esc(d.noData)}</div>`;
        const headers = [`<th>${esc('@L["SP_To"]')}</th>`, `<th class="text-end">${esc('@L["Common_Percent"]')}</th>`]
            .concat((extraColumns || []).map(c => `<th class="text-end">${esc(c.label)}</th>`)).join('');
        const body = rows.map(r => `<tr>
            <td>${esc(r.periodLabel || r.label)}</td>
            <td class="rate">${pct(r[rateKey])}</td>
            ${(extraColumns || []).map(c => `<td class="text-end">${fmt(r[c.key])}</td>`).join('')}
        </tr>`).join('');
        return `<div class="sp-rate-table-wrap"><table class="sp-rate-table"><thead><tr>${headers}</tr></thead><tbody>${body}</tbody></table></div>`;
    }
    // Projected vs actual headcount for the selected month, by job, plus the next few months.
    function renderStaffingPlan(plan) {
        if (!plan || !plan.hasData) return `<div class="sp-empty">${esc('@L["SP_PlanNoData"]')}</div>`;
        const has = plan.hasActual;
        const gapCell = g => has ? `<td class="text-end" style="color:${g < 0 ? 'oklch(0.55 0.2 22)' : g > 0 ? 'oklch(0.45 0.15 250)' : 'inherit'}">${g > 0 ? '+' : ''}${fmt(g)}</td>` : '<td class="text-end">—</td>';
        const jobs = arr(plan.byJob).filter(r => r.projected > 0 || r.actual > 0);
        const jobRows = jobs.map(r => `<tr><td>${esc(r.name)}</td><td class="text-end">${fmt(r.projected)}</td><td class="text-end">${has ? fmt(r.actual) : '—'}</td>${gapCell(r.gap)}</tr>`).join('');
        const k = plan.kpis || {};
        const totalRow = `<tr style="font-weight:700"><td>${esc('@L["Common_Total"]')}</td><td class="text-end">${fmt(k.projected)}</td><td class="text-end">${has ? fmt(k.actual) : '—'}</td>${gapCell(k.gap || 0)}</tr>`;
        const head = `<thead><tr><th>${esc('@L["WP_ColJob"]')}</th><th class="text-end">${esc('@L["WP_ColProjected"]')}</th><th class="text-end">${esc('@L["WP_ColActual"]')}</th><th class="text-end">${esc('@L["WP_ColGap"]')}</th></tr></thead>`;
        const monthLabel = m => new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' });
        const upcoming = arr(plan.upcoming);
        const upcomingHtml = upcoming.length > 1 ? `<div class="mt-3" style="font-size:12px;color:var(--text-3)">${esc('@L["SP_PlanUpcoming"]')}</div>
            <div class="sp-rate-table-wrap"><table class="sp-rate-table"><thead><tr><th>${esc('@L["WP_Month"]')}</th><th class="text-end">${esc('@L["WP_ColProjected"]')}</th><th class="text-end">${esc('@L["WP_ColActual"]')}</th></tr></thead><tbody>${
                upcoming.map(u => `<tr><td>${esc(monthLabel(u.month))} ${esc(plan.year)}</td><td class="text-end">${fmt(u.projected)}</td><td class="text-end">${u.actual == null ? '—' : fmt(u.actual)}</td></tr>`).join('')
            }</tbody></table></div>` : '';
        return `<div class="sp-rate-table-wrap"><table class="sp-rate-table">${head}<tbody>${jobRows}${totalRow}</tbody></table></div>${upcomingHtml}`;
    }
    function renderLeaderTracking(rows) {
        if (!rows.length) return `<div class="sp-card"><div class="sp-empty">${esc('@L["SP_NoLeaderHistory"]')}</div></div>`;
        const body = rows.map((r, index) => `<tr>
            <td><span class="sp-leader-current">${index === rows.length - 1 ? '<i class="bi bi-person-check"></i>' : '<i class="bi bi-person"></i>'}${esc(r.storeLeader)}</span></td>
            <td>${esc(r.fromPeriod)}</td>
            <td>${esc(r.toPeriod)}</td>
            <td class="text-end">${fmt(r.months)}</td>
        </tr>`).join('');
        return `<div class="sp-card sp-card-wide"><div class="sp-card-title"><h3><i class="bi bi-person-badge"></i>${esc('@L["SP_StoreLeaders"]')}</h3></div>
            <div class="sp-table-wrap"><table class="sp-table"><thead><tr>
                <th>${esc('@L["SP_LeaderName"]')}</th><th>${esc('@L["SP_LeaderFrom"]')}</th><th>${esc('@L["SP_LeaderTo"]')}</th><th class="text-end">${esc('@L["SP_LeaderMonths"]')}</th>
            </tr></thead><tbody>${body}</tbody></table></div></div>`;
    }

    function renderKpis(kpis, warning, sentiment) {
        const watchCount = number(warning?.inWatchlist ?? warning?.watchlistCount ?? overviewData.watchlist?.length);
        const sentimentValue = sentiment?.positivePercent ?? sentiment?.positiveRate;
        const cards = [
            ['bi-people-fill', d.employees, fmt(kpis?.totalHeadcount ?? kpis?.headcount)],
            ['bi-person-dash-fill', d.resignations, fmt(kpis?.totalResignations ?? kpis?.resignations)],
            ['bi-arrow-repeat', '@L["Common_TurnoverRate"]', pct(kpis?.turnoverRate)],
            ['bi-person-exclamation', '@L["SP_Watchlist"]', fmt(watchCount)],
            ['bi-chat-heart', '@L["SP_ExitSentiment"]', sentimentValue == null ? '—' : pct(sentimentValue)],
        ];
        $('spKpis').innerHTML = cards.map(c => `<div class="sp-kpi"><div class="sp-kpi-icon"><i class="bi ${c[0]}"></i></div><div class="sp-kpi-value">${esc(c[2])}</div><div class="sp-kpi-label">${esc(c[1])}</div></div>`).join('');
    }

    function renderRisk(warning, watchlist, action) {
        const highRisk = arr(watchlist).filter(x => number(x.stars ?? x.riskScore) >= 4).length;
        const status = action?.status ?? action?.planStatus ?? 'None';
        $('spRiskSummary').innerHTML = `<div class="sp-list">
            <div class="sp-row"><span class="sp-row-label">${esc('@L["SP_Watchlist"]')}</span><span></span><span class="sp-row-value">${fmt(watchlist.length)}</span></div>
            <div class="sp-row"><span class="sp-row-label">${esc('@L["SP_HighRisk"]')}</span><span></span><span class="sp-row-value">${fmt(highRisk)}</span></div>
            <div class="sp-row"><span class="sp-row-label">${esc('@L["SP_ActionPlan"]')}</span><span></span><span class="sp-badge">${esc(status)}</span></div>
        </div>`;
    }

    function renderInsights(kpis, warning, action) {
        const items = [];
        if (number(kpis?.turnoverRate) > 0) items.push(`${d.resignations}: ${pct(kpis.turnoverRate)}`);
        if (arr(overviewData.watchlist).length) items.push(`${esc('@L["SP_Watchlist"]')}: ${overviewData.watchlist.length}`);
        if (action?.status && action.status !== 'None') items.push(`${esc('@L["SP_ActionPlan"]')}: ${esc(action.status)}`);
        $('spInsights').innerHTML = items.length ? `<div class="sp-list">${items.map(x => `<div class="sp-row"><span class="sp-row-label">${x}</span></div>`).join('')}</div>` : `<div class="sp-empty">${esc(d.noData)}</div>`;
    }

    function healthTone(kpis, ninety, warning, action) {
        const turnover = number(kpis?.turnoverRate);
        const severity = String(action?.severity || '').toLowerCase();
        if (severity === 'critical' || turnover >= 15) return { tone: 'critical', label: '@L["SP_HealthCritical"]', icon: 'bi-exclamation-octagon-fill' };
        if (severity === 'high' || severity === 'medium' || turnover >= 8 || number(warning?.watchlistCount ?? overviewData.watchlist?.length) > 0 || action?.status === 'Active') {
            return { tone: 'watch', label: '@L["SP_HealthWatch"]', icon: 'bi-exclamation-triangle-fill' };
        }
        return { tone: 'good', label: '@L["SP_HealthGood"]', icon: 'bi-check-circle-fill' };
    }

    function metricChange(baseline, current) {
        if (baseline == null || current == null || !Number.isFinite(Number(baseline)) || !Number.isFinite(Number(current))) return null;
        return Number(current) - Number(baseline);
    }

    function changeMarkup(delta) {
        if (delta == null || Math.abs(delta) < 0.05) return `<span class="sp-health-row-value">—</span>`;
        const color = delta < 0 ? 'oklch(0.5 0.15 155)' : ChartColors.SEMANTIC.BAD;
        const icon = delta < 0 ? 'bi-arrow-down-right' : 'bi-arrow-up-right';
        return `<span class="sp-health-row-value" style="color:${color}"><i class="bi ${icon}"></i> ${Math.abs(delta).toFixed(1)}pt</span>`;
    }

    function renderHealthSummary(kpis, ninety, warning, watchlist, action, signalHistory) {
        const root = $('spHealthSummary');
        if (!root) return;

        const health = healthTone(kpis, ninety, warning, action);
        const recommendations = arr(action?.recommendations);
        const completed = recommendations.filter(r => r.isCompleted).length;
        const progress = recommendations.length ? Math.round(completed / recommendations.length * 100) : 0;
        const persistentSignals = arr(signalHistory?.persistence).filter(x => x.isPersistent);
        const latestSignals = arr(signalHistory?.periods).find(x => x.hasData);
        const turnoverDelta = metricChange(action?.baselineTurnoverRate, kpis?.turnoverRate);
        const earlyDelta = metricChange(action?.baselineEarlyLeaverRate, ninety?.rate ?? ninety?.earlyLeaverRate);
        const issues = [];
        const addIssue = (icon, text) => issues.push({ icon, text });

        if (action?.status === 'Active') addIssue('bi-clipboard2-pulse-fill', esc('@L["SP_HealthActivePlan"]'));
        if (persistentSignals.length) addIssue('bi-arrow-repeat', `${persistentSignals.length} ${esc('@L["SP_HealthRecurringSignals"]')}`);
        if (number(watchlist?.length) > 0) addIssue('bi-person-exclamation', `${watchlist.length} ${esc('@L["SP_HighRisk"]')}`);
        if (turnoverDelta != null && turnoverDelta > 0.05) addIssue('bi-graph-up-arrow', esc('@L["SP_HealthTurnoverRising"]'));
        if (!issues.length) addIssue('bi-check2-circle', esc('@L["SP_NoPriorityIssues"]'));

        const latestSignalText = latestSignals
            ? (latestSignals.hasData
                ? (latestSignals.signals?.length ? `${latestSignals.signals.length} ${esc('@L["SP_HealthSignalsThisPeriod"]')}` : esc('@L["SP_HealthNoSignalsThisPeriod"]'))
                : esc('@L["SP_HealthNoDataThisPeriod"]'))
            : esc('@L["SP_HealthNoSignalHistory"]');

        root.innerHTML = `
            <div class="sp-health sp-health-state sp-health-${health.tone}">
                <div class="sp-health-hero">
                    <div class="sp-health-kicker">${esc('@L["SP_HealthKicker"]')}</div>
                    <div class="sp-health-title"><i class="bi ${health.icon}"></i>${esc(health.label)}</div>
                    <p class="sp-health-copy">${esc('@L["SP_HealthDescription"]')}</p>
                    <div class="sp-health-meta">
                        <span class="sp-health-chip"><i class="bi bi-calendar3"></i>${esc(fromPeriod && toPeriod ? `${periodLabel(fromPeriod)} – ${periodLabel(toPeriod)}` : d.noData)}</span>
                        <span class="sp-health-chip"><i class="bi bi-broadcast-pin"></i>${esc(latestSignalText)}</span>
                    </div>
                </div>
                <div class="sp-health-panels">
                    <div class="sp-health-panel">
                        <div class="sp-health-panel-title"><i class="bi bi-flag-fill"></i>${esc('@L["SP_PriorityIssues"]')}</div>
                        <div class="sp-health-list">${issues.map(item => `<div class="sp-health-issue"><i class="bi ${item.icon}"></i><span>${item.text}</span></div>`).join('')}</div>
                    </div>
                    <div class="sp-health-panel">
                        <div class="sp-health-panel-title"><i class="bi bi-clipboard-check"></i>${esc('@L["SP_ActionProgress"]')}</div>
                        <div class="sp-health-list">
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_ActionPlan"]')}</span><span class="sp-health-row-value">${esc(action?.status ?? 'None')}</span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_Recommendations"]')}</span><span class="sp-health-row-value">${completed}/${recommendations.length}</span></div>
                            <div class="sp-health-progress"><span style="width:${progress}%"></span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_HealthBaselineChange"]')}</span>${changeMarkup(turnoverDelta)}</div>
                        </div>
                    </div>
                    <div class="sp-health-panel">
                        <div class="sp-health-panel-title"><i class="bi bi-arrow-down-up"></i>${esc('@L["SP_HealthBaseline"]')}</div>
                        <div class="sp-health-list">
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["Common_TurnoverRate"]')}</span><span class="sp-health-row-value">${pct(kpis?.turnoverRate)}</span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_NinetyDayKpi"]')}</span><span class="sp-health-row-value">${pct(ninety?.rate ?? ninety?.earlyLeaverRate)}</span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_HealthEarlyChange"]')}</span>${changeMarkup(earlyDelta)}</div>
                        </div>
                    </div>
                    <div class="sp-health-panel">
                        <div class="sp-health-panel-title"><i class="bi bi-shield-exclamation"></i>${esc('@L["SP_SignalHistory"]')}</div>
                        <div class="sp-health-list">
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_HealthRecurringSignals"]')}</span><span class="sp-health-row-value">${persistentSignals.length}</span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_HighRisk"]')}</span><span class="sp-health-row-value">${watchlist.length}</span></div>
                            <div class="sp-health-row"><span class="sp-health-row-label">${esc('@L["SP_HealthHistoricalPlans"]')}</span><span class="sp-health-row-value">${fmt(action?.historicalPlanCount)}</span></div>
                        </div>
                    </div>
                </div>
            </div>`;
    }

    function renderTrend(canvasId, existing, data, valueKey, color, fill) {
        if (existing) existing.destroy();
        const rows = arr(data).filter(r => r && (r[valueKey] != null || r.value != null || r.rate != null));
        const canvas = $(canvasId);
        if (!canvas) return null;
        const wrap = canvas.parentElement;
        const empty = wrap?.querySelector('.sp-chart-empty');
        if (!rows.length || typeof Chart === 'undefined') {
            canvas.style.display = 'none';
            if (wrap && !empty) {
                const message = document.createElement('div');
                message.className = 'sp-chart-empty sp-empty';
                message.textContent = d.noData;
                wrap.appendChild(message);
            }
            return null;
        }
        canvas.style.display = '';
        empty?.remove();
        return new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: { labels: rows.map(r => r.label ?? r.periodLabel ?? ''), datasets: [{ data: rows.map(r => number(r[valueKey] ?? r.value ?? r.rate)), borderColor: color, backgroundColor: fill, fill: true, tension: .3, pointRadius: 3, pointHoverRadius: 6 }] },
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, datalabels:{display:false} }, scales:{ x:{grid:{display:false}}, y:{beginAtZero:true} } }
        });
    }

    async function loadStorePeriodData() {
        const ordered = selectedPeriods();
        const values = await Promise.all(ordered.map(p =>
            get(`/api/dashboard/kpis?store=${encodeURIComponent(store)}&month=${p.month}&year=${p.year}`, {})));
        return ordered.map((p, i) => ({
            label: periodLabel(p),
            periodLabel: periodLabel(p),
            turnoverRate: number(values[i]?.turnoverRate),
            headcount: number(values[i]?.totalHeadcount ?? values[i]?.headcount),
            resignations: number(values[i]?.totalResignations ?? values[i]?.resignations)
        }));
    }

    async function loadNinetyTrend() {
        const ordered = selectedPeriods();
        const values = await Promise.all(ordered.map(p =>
            get(`/api/ninety-day-turnover/kpi?store=${encodeURIComponent(store)}&month=${p.month}&year=${p.year}`, {})));
        return ordered.map((p, i) => ({
            label: periodLabel(p),
            periodLabel: periodLabel(p),
            rate: number(values[i]?.rate),
            totalHires: number(values[i]?.totalHires),
            earlyLeavers: number(values[i]?.earlyLeavers)
        }));
    }

    async function loadExitTrend() {
        const ordered = selectedPeriods();
        const values = await Promise.all(ordered.map(p =>
            get(`/api/exit-interviews/sentiment-summary?store=${encodeURIComponent(store)}&year=${p.year}&months=${p.month}`, {})));
        return ordered.map((p, i) => ({
            label: periodLabel(p),
            periodLabel: periodLabel(p),
            positivePercent: number(values[i]?.positivePercent),
            totalResponses: number(values[i]?.totalResponses)
        }));
    }

    async function loadOverview() {
        if (!store) { setState(d.noStore, 'warning'); return; }
        setState(d.loading, 'info');
        const q = periodQuery(), sq = snapshotQuery(), eq = exitRangeQuery();
        const [kpis, periodData, warning, watchlist, sentiment, action, ninety, signalHistory] = await Promise.all([
            get(`/api/dashboard/kpis?${q}`, {}),
            loadStorePeriodData(),
            get(`/api/early-warning/summary?${sq}`, {}),
            get(`/api/early-warning/watchlist?${sq}`, []),
            get(`/api/exit-interviews/sentiment-summary?${eq}`, {}),
            get(`/api/store-action-plan/action-center/detail?store=${encodeURIComponent(store)}`, null),
            get(`/api/ninety-day-turnover/kpi?${q}`, {}),
            get(`/api/store-action-plan/action-center/signal-history?store=${encodeURIComponent(store)}`, {})
        ]);
        overviewData = { kpis, periodData, warning, watchlist, sentiment, action, ninety, signalHistory };
        $('spStoreName').textContent = store;
        $('spSubtitle').textContent = `${d.subtitle} · ${fromPeriod && toPeriod ? `${periodLabel(fromPeriod)} – ${periodLabel(toPeriod)}` : ''}`;
        renderHealthSummary(kpis, ninety, warning, arr(watchlist), action, signalHistory);
        renderKpis(kpis, warning, sentiment);
        renderRisk(warning, arr(watchlist), action);
        renderInsights(kpis, warning, action);
        turnoverChart = renderTrend('spTurnoverChart', turnoverChart, periodData, 'turnoverRate', ChartColors.SERIES.SECONDARY, ChartColors.SERIES_FILL.SECONDARY);
        headcountChart = renderTrend('spHeadcountChart', headcountChart, periodData, 'headcount', ChartColors.SERIES.PRIMARY, ChartColors.SERIES_FILL.PRIMARY);
        setState('', '');
    }

    async function loadPanel(panel) {
        const q = periodQuery(), sq = snapshotQuery(), eq = exitRangeQuery();
        const target = $(`sp${panel[0].toUpperCase()}${panel.slice(1)}`);
        if (!target || loadedPanels.has(panel)) return;
        target.innerHTML = `<div class="sp-card"><div class="sp-empty">${esc(d.loading)}</div></div>`;
        let html = '';
        if (panel === 'workforce') {
            const [jobs, payroll, tenure, gender, plan] = await Promise.all([
                get(`/api/dashboard/headcount-by-job-title?${q}`, []), get(`/api/dashboard/headcount-by-payroll-group?${q}`, []),
                get(`/api/dashboard/headcount-by-tenure?${q}`, []), get(`/api/dashboard/gender-breakdown?${q}`, []),
                toPeriod ? get(`/api/workforce-planning/store-plan?store=${encodeURIComponent(store)}&year=${toPeriod.year}&month=${toPeriod.month}`, null) : Promise.resolve(null)
            ]);
            html = renderCards([card('@L["SP_ByJobTitle"]','bi-person-badge',renderBars(jobs,d.employees)),
                card('@L["SP_StaffingPlan"]','bi-diagram-3-fill',renderStaffingPlan(plan)),card('@L["SP_ByPayroll"]','bi-wallet2',renderBars(payroll,d.employees)),card('@L["SP_ByTenure"]','bi-hourglass-split',renderBars(tenure,d.employees)),card('@L["SP_ByGender"]','bi-gender-ambiguous',renderBars(gender,d.employees))]);
        } else if (panel === 'turnover') {
            const [jobs, tenure, payroll, reasons, periodData] = await Promise.all([
                get(`/api/dashboard/turnover-by-job-title?${q}`, []), get(`/api/dashboard/turnover-by-tenure?${q}`, []),
                get(`/api/dashboard/turnover-by-payroll-group?${q}`, []), get(`/api/exit-interviews/reasons?${eq}`, []),
                loadStorePeriodData()
            ]);
            html = renderCards([
                card('@L["SP_TurnoverByJob"]','bi-person-badge',renderBars(jobs,d.resignations)),
                card('@L["SP_TurnoverByTenure"]','bi-hourglass-split',renderBars(tenure,d.resignations)),
                card('@L["SP_TurnoverByPayroll"]','bi-wallet2',renderBars(payroll,d.resignations)),
                card('@L["SP_ExitReasons"]','bi-chat-square-text',renderBars(reasons,'')),
                card('@L["SP_MonthlyTurnover"]','bi-graph-up-arrow',renderRateTable(periodData,'turnoverRate',[
                    { key:'headcount', label:d.employees }, { key:'resignations', label:d.resignations }
                ]),true)
            ]);
        } else if (panel === 'retention') {
            const [tenure, jobs, gender, hiring] = await Promise.all([
                get(`/api/retention/tenure-distribution?${q}`, []), get(`/api/retention/by-job-title?${q}`, []),
                get(`/api/retention/by-gender?${q}`, []), get(`/api/retention/monthly-hiring-volume?${q}`, [])
            ]);
            html = renderCards([card('@L["SP_RetentionTenure"]','bi-hourglass-split',renderBars(tenure,d.employees)),card('@L["SP_RetentionJobs"]','bi-person-badge',renderBars(jobs,'')),card('@L["SP_RetentionGender"]','bi-gender-ambiguous',renderBars(gender,'')),card('@L["SP_HiringTrend"]','bi-person-plus',renderBars(hiring,d.employees))]);
        } else if (panel === 'ninety') {
            const [kpi, trend] = await Promise.all([get(`/api/ninety-day-turnover/kpi?${q}`, {}), loadNinetyTrend()]);
            html = renderCards([
                card('@L["SP_NinetyDayKpi"]','bi-hourglass-split',`<div class="sp-kpi-value">${pct(kpi?.rate ?? kpi?.earlyLeaverRate)}</div><div class="sp-muted mt-2">${esc(d.subtitle)}</div>`),
                card('@L["SP_MonthlyNinety"]','bi-graph-up',renderRateTable(trend,'rate',[
                    { key:'totalHires', label:'@L["Common_NewHires"]' }, { key:'earlyLeavers', label:'@L["Common_Resignations"]' }
                ]),true)
            ]);
        } else if (panel === 'warning') {
            const rows = arr(overviewData.watchlist);
            const table = rows.length ? `<div class="sp-table-wrap"><table class="sp-table"><thead><tr><th>${esc('@L["EW_HireName"]')}</th><th>${esc('@L["EW_JobTitle"]')}</th><th>${esc('@L["EW_RiskScore"]')}</th><th>${esc('@L["EW_Reasons"]')}</th></tr></thead><tbody>${rows.slice(0,20).map(r => `<tr><td>${esc(r.employeeName ?? r.name)}</td><td>${esc(r.jobTitle)}</td><td>${esc(r.stars ?? r.riskScore ?? '—')}</td><td>${esc(Array.isArray(r.reasons) ? r.reasons.join(', ') : r.reason ?? '—')}</td></tr>`).join('')}</tbody></table></div>` : `<div class="sp-empty">${esc(d.noData)}</div>`;
            html = renderCards([card('@L["SP_Watchlist"]','bi-person-exclamation',table,true)]);
        } else if (panel === 'exit') {
            const [reasons, wouldReturn, experience, workload, training, exitTrend] = await Promise.all([
                get(`/api/exit-interviews/reasons?${eq}`, []), get(`/api/exit-interviews/would-return?${eq}`, []),
                get(`/api/exit-interviews/overall-experience?${eq}`, []), get(`/api/exit-interviews/workload?${eq}`, []),
                get(`/api/exit-interviews/training?${eq}`, []), loadExitTrend()
            ]);
            html = renderCards([
                card('@L["SP_ExitReasons"]','bi-chat-square-text',renderBars(reasons,'')),
                card('@L["SP_WouldReturn"]','bi-arrow-return-left',renderBars(wouldReturn,'')),
                card('@L["SP_Experience"]','bi-star',renderBars(experience,'')),
                card('@L["SP_Workload"]','bi-speedometer2',renderBars(workload,'')),
                card('@L["SP_Training"]','bi-mortarboard',renderBars(training,'')),
                card('@L["SP_MonthlyExit"]','bi-chat-heart',renderRateTable(exitTrend,'positivePercent',[
                    { key:'totalResponses', label:'@L["SP_Responses"]' }
                ]),true)
            ]);
        } else if (panel === 'action') {
            const action = overviewData.action;
            html = renderCards([card('@L["SP_ActionPlan"]','bi-bullseye',action ? `<div class="sp-list"><div class="sp-row"><span class="sp-row-label">${esc('@L["SP_Status"]')}</span><span></span><span class="sp-badge">${esc(action.status ?? action.planStatus ?? 'None')}</span></div><div class="sp-row"><span class="sp-row-label">${esc('@L["SP_Severity"]')}</span><span></span><span class="sp-row-value">${esc(action.severity ?? action.riskLevel ?? '—')}</span></div><div class="sp-row"><span class="sp-row-label">${esc('@L["SP_Recommendations"]')}</span><span></span><span class="sp-row-value">${fmt(arr(action.recommendations).length)}</span></div></div>` : `<div class="sp-empty">${esc(d.noData)}</div>`,true)]);
        } else if (panel === 'leaders') {
            const rows = await get(`/api/dashboard/store-leader-tracking?store=${encodeURIComponent(store)}`, []);
            html = renderLeaderTracking(rows);
        }
        target.innerHTML = html;
        loadedPanels.add(panel);
    }

    async function initPeriods() {
        periods = await get('/api/dashboard/available-periods', []);
        const from = $('spFromPeriod'), to = $('spToPeriod');
        const options = periods.map(p => `<option value="${periodValue(p)}">${esc(periodLabel(p))}</option>`).join('');
        from.innerHTML = options; to.innerHTML = options;
        if (periods.length) {
            const currentYear = new Date().getFullYear();
            const sameYear = periods.filter(p => p.year === currentYear);
            const defaultPeriods = sameYear.length ? sameYear : periods.filter(p => p.year === periods[0].year);
            const ordered = defaultPeriods.slice().sort((a, b) => periodKey(a) - periodKey(b));
            fromPeriod = ordered[0];
            toPeriod = ordered[ordered.length - 1];
            to.value = periodValue(toPeriod); from.value = periodValue(fromPeriod);
        }
        await loadOverview();
    }
    function updatePeriod(select, isFrom) {
        const value = select.value.split('-').map(Number);
        const picked = periods.find(p => p.month === value[0] && p.year === value[1]);
        if (picked) { if (isFrom) fromPeriod = picked; else toPeriod = picked; }
        loadedPanels.clear();
        loadOverview().then(() => {
            const active = document.querySelector('.sp-tab.active')?.dataset.panel;
            if (active && active !== 'overview') loadPanel(active);
        });
    }

    $('spBackLink').href = `${areaPrefix}/dashboard/stores`;
    document.querySelectorAll('.sp-tab').forEach(tab => tab.addEventListener('click', async () => {
        document.querySelectorAll('.sp-tab').forEach(x => x.classList.toggle('active', x === tab));
        document.querySelectorAll('.sp-panel').forEach(x => x.classList.toggle('active', x.id === `spPanel-${tab.dataset.panel}`));
        await loadPanel(tab.dataset.panel);
    }));
    $('spFromPeriod').addEventListener('change', e => updatePeriod(e.target, true));
    $('spToPeriod').addEventListener('change', e => updatePeriod(e.target, false));
    $('spRefresh').addEventListener('click', async () => {
        loadedPanels.clear();
        await loadOverview();
        const active = document.querySelector('.sp-tab.active')?.dataset.panel;
        if (active && active !== 'overview') await loadPanel(active);
    });
    initPeriods();
})();
</script>