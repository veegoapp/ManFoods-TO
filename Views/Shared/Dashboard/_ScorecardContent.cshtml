/* Ranking table ----------------------------------------------------------- */
let scRankingRows = [];
const scSortState = { key: 'turnoverRate', dir: 'desc' };
const scLeaderProfileUrl = '@Url.Action("StoreLeaderProfile", "Dashboard")';

function scSortValue(row, key) {
    const v = row[key];
    return typeof v === 'string' ? v.toLowerCase() : v;
}

function scApplySort(rows) {
    if (!scSortState.key) return rows;
    return rows.slice().sort((a, b) => {
        const va = scSortValue(a, scSortState.key), vb = scSortValue(b, scSortState.key);
        if (va < vb) return scSortState.dir === 'asc' ? -1 : 1;
        if (va > vb) return scSortState.dir === 'asc' ? 1 : -1;
        return 0;
    });
}

function scWireSortHeaders() {
    document.querySelectorAll('#scBody').forEach(tbody => {
        tbody.closest('table').querySelectorAll('.sc-sort-header').forEach(th => {
            th.addEventListener('click', () => {
                const key = th.dataset.sortKey;
                scSortState.dir = (scSortState.key === key && scSortState.dir === 'asc') ? 'desc' : 'asc';
                scSortState.key = key;
                th.closest('table').querySelectorAll('.sc-sort-header').forEach(h => h.classList.remove('sc-sort-asc', 'sc-sort-desc'));
                th.classList.add(scSortState.dir === 'asc' ? 'sc-sort-asc' : 'sc-sort-desc');
                scRenderRankingTable();
            });
        });
    });
}

function scRenderRankingTable() {
    const tbody = document.getElementById('scBody');
    const noDataText = document.getElementById('scContent').dataset.noDataWindow;
    const noSentimentText = document.getElementById('scContent').dataset.noSentiment;
    if (!scRankingRows.length) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">${noDataText}</td></tr>`;
        return;
    }
    const rows = scApplySort(scRankingRows);
    tbody.innerHTML = rows.map(r => `
        <tr>
            <td class="px-3 py-2 fw-semibold"><a class="sc-leader-link" href="${scLeaderProfileHref(r.name)}">${sapEscape(r.name)}</a></td>
            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2 text-center">${scMetricBadge(r.turnoverRate, 'turnover')}</td>
            <td class="px-3 py-2 text-center">${scMetricBadge(r.earlyLeaver90Rate, 'ninetyDay')}</td>
            <td class="px-3 py-2 text-center">${scMetricBadge(r.retention180Rate, 'retention')}</td>
            <td class="px-3 py-2 text-center">${r.exitResponseCount > 0 ? scRateBadge(r.exitSentimentPercent, true) : `<span class="text-muted" style="font-size:11px">${noSentimentText}</span>`}</td>
        </tr>`).join('');
}

function scLeaderProfileHref(name) {
    const q = new URLSearchParams({ leader: name, dimension: scDimension });
    if (scYear) q.set('year', scYear);
    if (scMonths.length) q.set('months', scMonths.join(','));
    return `${scLeaderProfileUrl}?${q.toString()}`;
}

