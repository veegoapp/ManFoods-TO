};

function scRenderKpis(leaderRows, rollup) {
    const el = document.getElementById('scKpiCards');
    const totalLeaders = leaderRows.length;
    const totalHeadcount = leaderRows.reduce((s, r) => s + r.headcount, 0);
    const avgTurnover = rollup.averageTurnoverRate || 0;
    const flagged = leaderRows.filter(r => r.turnoverRate > avgTurnover).length;
    const flaggedPercent = totalLeaders ? Math.round((flagged / totalLeaders) * 100) : 0;

    el.innerHTML = `
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-person-badge-fill"></i></div><div class="kpi-value">${totalLeaders}</div><div class="kpi-label">${sapEscape(SC_I18N.kpiTotalLeaders)}</div><div class="kpi-desc">${sapEscape(SC_I18N.kpiTotalLeadersDesc)}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-people-fill"></i></div><div class="kpi-value">${totalHeadcount}</div><div class="kpi-label">${sapEscape(SC_I18N.kpiTotalHeadcount)}</div><div class="kpi-desc">${sapEscape(SC_I18N.kpiTotalHeadcountDesc)}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-graph-up"></i></div><div class="kpi-value">${avgTurnover.toFixed(1)}%</div><div class="kpi-label">${sapEscape(SC_I18N.kpiAvgTurnover)}</div><div class="kpi-desc">${sapEscape(SC_I18N.averageTurnover)}</div></div>
        <div class="kpi-card"><div class="kpi-icon text-danger"><i class="bi bi-exclamation-triangle-fill"></i></div><div class="kpi-value text-danger">${flagged} <span style="font-size:13px;font-weight:600">(${flaggedPercent}%)</span></div><div class="kpi-label">${sapEscape(SC_I18N.kpiFlaggedLeaders)}</div><div class="kpi-desc">${sapEscape(SC_I18N.kpiFlaggedLeadersDesc)}</div></div>`;
}

function scRenderInsights(leaderRows, rollup) {
    const el = document.getElementById('scInsights');
    const items = [];
    const withHeadcount = leaderRows.filter(r => r.headcount > 0);

    if (withHeadcount.length >= 2) {
        const best = withHeadcount.slice().sort((a, b) => a.turnoverRate - b.turnoverRate)[0];
        items.push({ icon: 'bi-trophy-fill', color: 'success', title: SC_I18N.insightBestLeaderTitle,
            description: `${best.name} — ${best.turnoverRate.toFixed(1)}% ${SC_I18N.insightBestLeaderDesc}` });

        const worst = withHeadcount.slice().sort((a, b) => b.turnoverRate - a.turnoverRate)[0];
        if (worst.name !== best.name)
            items.push({ icon: 'bi-exclamation-triangle-fill', color: 'danger', title: SC_I18N.insightWorstLeaderTitle,
                description: `${worst.name} — ${worst.turnoverRate.toFixed(1)}% ${SC_I18N.insightWorstLeaderDesc}` });
    }

    const topOc = (rollup.byOperationConsultant || []).slice().sort((a, b) => b.flaggedPercent - a.flaggedPercent)[0];
    if (topOc && topOc.flaggedPercent > 0)
        items.push({ icon: 'bi-person-badge', color: 'warning', title: SC_I18N.insightTopOcTitle,
            description: `${topOc.name} — ${topOc.flaggedLeaders}/${topOc.totalLeaders} (${topOc.flaggedPercent.toFixed(0)}%) ${SC_I18N.insightTopOcDesc}` });

    const topOm = (rollup.byOperationManager || []).slice().sort((a, b) => b.flaggedPercent - a.flaggedPercent)[0];
    if (topOm && topOm.flaggedPercent > 0)
        items.push({ icon: 'bi-person-gear', color: 'warning', title: SC_I18N.insightTopOmTitle,
            description: `${topOm.name} — ${topOm.flaggedLeaders}/${topOm.totalLeaders} (${topOm.flaggedPercent.toFixed(0)}%) ${SC_I18N.insightTopOmDesc}` });

    if (!items.length) {
        el.innerHTML = `<div class="text-muted" style="font-size:13px">${document.getElementById('scContent').dataset.noInsights}</div>`;
        return;
    }

    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: ChartColors.SEMANTIC.GOOD, text: ChartColors.SEMANTIC.GOOD },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
    };
    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6">
            <div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
                    <div>
                        <div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
                        <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('') + '</div>';
}

async function scLoadKpisAndInsights(rollup) {
    const q = scBuildQuery({ dimension: 'leader' });
    const res = await fetch(`/api/scorecard?${q.toString()}`);
    const leaderRows = res.ok ? await res.json() : [];
    scRenderKpis(leaderRows, rollup);
    scRenderInsights(leaderRows, rollup);
}

async function scLoadAll() {
    if (!scYear || !scMonths.length) return;
    const [, , rollup] = await Promise.all([scLoadRanking(), scLoadLeaderDetail(), scLoadRollup()]);
    await scLoadKpisAndInsights(rollup);
}

(async function init() {
    await scLoadColorRules();
    const hasData = await scLoadFilters();
    if (hasData) await scLoadAll();
})();
</script>
