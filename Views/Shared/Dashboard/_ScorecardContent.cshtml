<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Scorecard page — Year + discrete Months multi-select controls the
   aggregation window for all three sections: ranking, leader drill-down,
   and OC/OM rollup. Same filter components as Turnover/Retention/etc. */
let scYear = null, scMonths = [], scYearMonthsMap = {};
let scDimension = 'leader';
let scSelectedLeader = '';
let scOmFilter = '', scOcFilter = '', scSocFilter = '', scOdFilter = '';
let scJobFilter = [];

function scMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }
function scMonthLongName(m, y) { return new Date(y, m - 1).toLocaleString('default', { month: 'long', year: 'numeric' }); }

/* Range-filter badge (dashboard.js) — captures each title's original text once
   so repeated filter-change reloads don't stack badges. Every section here
   aggregates across the full scMonths window, so "affected" is always true
   once more than one month is selected. */
const scTitleBase = {};
function scSetTitleBadge(id) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!(id in scTitleBase)) scTitleBase[id] = el.textContent;
    el.innerHTML = scTitleBase[id] + ' ' + rangeFilterBadge(scMonths.length > 1, true);
}

function scBuildQuery(extra) {
    const q = new URLSearchParams(extra || {});
    if (scYear) q.set('year', scYear);
    if (scMonths.length) q.set('months', scMonths.join(','));
    if (scOmFilter)  q.set('om', scOmFilter);
    if (scOcFilter)  q.set('oc', scOcFilter);
    if (scSocFilter) q.set('soc', scSocFilter);
    if (scOdFilter)  q.set('od', scOdFilter);
    if (scJobFilter.length) q.set('jobs', scJobFilter.join(','));
    return q;
}

function scRateBadge(rate, goodIsHigh) {
    const good = goodIsHigh ? rate >= 70 : rate <= 5;
    const warn = goodIsHigh ? (rate >= 40 && rate < 70) : (rate > 5 && rate <= 12);
    const bg = good ? ChartColors.SEMANTIC.GOOD : warn ? ChartColors.SEMANTIC.WARNING : ChartColors.SEMANTIC.BAD;
    const fg = warn ? '#1C1C27' : '#fff';
    return `<span style="background:${bg};color:${fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${rate.toFixed(1)}%</span>`;
}

/* Turnover/90-Day/Retention rate columns go through the Settings-page rules
