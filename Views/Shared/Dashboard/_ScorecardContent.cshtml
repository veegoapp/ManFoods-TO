/* Initial filter load -------------------------------------------------------- */
async function scLoadFilters() {
    const [periods, leaders, jobs] = await Promise.all([
        fetch('/api/dashboard/available-periods').then(r => r.ok ? r.json() : []),
        fetch(`/api/scorecard/leaders?${scBuildQuery().toString()}`).then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/job-titles').then(r => r.ok ? r.json() : []),
    ]);

    const hasData = (periods || []).length > 0;
    document.getElementById('scEmptyState').style.display = hasData ? 'none' : '';
    document.getElementById('scContent').style.display = hasData ? '' : 'none';
    if (!hasData) return false;

    scYearMonthsMap = {};
    (periods || []).forEach(p => { (scYearMonthsMap[p.year] = scYearMonthsMap[p.year] || []).push(p.month); });
    const years = Object.keys(scYearMonthsMap).map(Number).sort((a, b) => b - a);
    const yearSel = document.getElementById('scYearSelect');
    yearSel.innerHTML = years.map(y => `<option value="${y}">${y}</option>`).join('');
    scYear = years[0];
    yearSel.value = scYear;
    scMonths = (scYearMonthsMap[scYear] || []).slice().sort((a, b) => a - b);
    scBuildMonthsOptions();
    scRenderMonthsChips();

    scLeaderCombo.setOptions(leaders || []);
    if (scJobPanel) {
        scJobPanel.innerHTML = (jobs || []).map(job => `
            <label class="job-filter-option">
                <input type="checkbox" value="${sapEscape(job)}" ${scJobFilter.includes(job) ? 'checked' : ''}>
                <span>${sapEscape(job)}</span>
            </label>`).join('') || '<div class="job-filter-empty">No jobs available</div>';
    }

    const [managers, consultants, seniorConsultants, directors] = await Promise.all([
        fetch('/api/dashboard/operation-managers').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/operation-consultants').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/senior-operation-consultants').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/operation-directors').then(r => r.ok ? r.json() : []),
    ]);
    scOmCombo.setOptions(managers || []);
    scOcCombo.setOptions(consultants || []);
    scSocCombo.setOptions(seniorConsultants || []);
    scOdCombo.setOptions(directors || []);
    return true;
}

