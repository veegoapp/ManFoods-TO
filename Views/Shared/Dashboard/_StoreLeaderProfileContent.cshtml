<style>
.slp-hero {
    display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap;
    padding:22px 24px; margin-bottom:20px; background:var(--card-bg); border:1px solid var(--card-border);
    border-radius:var(--radius-lg); box-shadow:var(--shadow-sm);
}
.slp-hero h1 { margin:0; font-size:clamp(1.35rem,2.5vw,2rem); }
.slp-hero p { margin:5px 0 0; color:var(--text-2); font-size:13px; }
.slp-back { display:inline-flex; align-items:center; gap:7px; color:var(--text-2); text-decoration:none; font-size:13px; font-weight:700; }
.slp-back:hover { color:var(--red); }
.slp-window { color:var(--text-2); font-size:12px; background:var(--bg-2); padding:7px 11px; border-radius:999px; }
.slp-section-title { display:flex; align-items:center; gap:9px; margin:26px 0 10px; }
.slp-section-title h5 { margin:0; font-weight:800; }
.slp-section-title .section-accent { margin:0; }
.slp-card-title { padding:16px 18px 0; }
.slp-card-title h6 { margin:0; font-weight:800; }
.slp-card-title p { margin:4px 0 0; color:var(--text-2); font-size:12px; }
.slp-chart-card { min-height:100%; }
.slp-chart-wrap { padding:12px 18px 18px; min-height:250px; }
.slp-chart-wrap canvas { max-height:290px; direction:ltr; }
.slp-bars { padding:12px 18px 18px; }
.slp-bar-row { margin-bottom:12px; }
.slp-bar-label { display:flex; justify-content:space-between; gap:12px; color:var(--text-2); font-size:12px; margin-bottom:5px; }
.slp-bar-label strong { color:var(--text); }
.slp-bar-track { height:8px; background:var(--bg-2); border-radius:99px; overflow:hidden; }
.slp-bar-fill { height:100%; min-width:2px; background:var(--red); border-radius:99px; }
.slp-bar-fill.good { background:oklch(0.58 0.16 150); }
.slp-bar-fill.warn { background:oklch(0.72 0.16 75); }
.slp-empty { color:var(--text-2); text-align:center; padding:28px 12px; font-size:13px; }
.slp-comment { max-width:600px; white-space:normal; color:var(--text-2); }
.slp-kpi-value { direction:ltr; unicode-bidi:isolate; }
@@media (max-width: 767px) {
    .slp-hero { padding:18px; }
    .slp-hero .btn { width:100%; }
}
</style>

<div id="slpPage" data-no-data="@L["SLP_NoData"]" data-no-exit="@L["SLP_NoExitData"]"
     data-no-comments="@L["SLP_NoComments"]" data-loading="@L["Common_Loading"]">
    <div class="slp-hero">
        <div>
            <a class="slp-back" href="@Url.Action("Scorecard", "Dashboard")"><i class="bi bi-arrow-left"></i>@L["SLP_Back"]</a>
            <h1 id="slpName" class="mt-2">@L["Common_Loading"]</h1>
            <p>@L["SLP_PageSub"]</p>
        </div>
        <span id="slpWindow" class="slp-window"></span>
    </div>

    <div id="slpError" class="alert alert-warning" style="display:none"></div>
    <div id="slpBody" style="display:none">
        <div id="slpKpis" class="kpi-grid mb-4"></div>

        <div class="slp-section-title">
            <div class="section-accent"></div><h5>@L["SLP_History"]</h5>
        </div>
        <div class="row g-3">
            <div class="col-xl-7">
                <div class="chart-card slp-chart-card">
                    <div class="slp-card-title"><h6>@L["SLP_TurnoverTrend"]</h6><p>@L["SLP_TurnoverTrendSub"]</p></div>
                    <div class="slp-chart-wrap"><canvas id="slpHistoryChart"></canvas></div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="chart-card slp-chart-card p-0" style="overflow:hidden">
                    <div class="slp-card-title"><h6>@L["SLP_StoreHistory"]</h6><p>@L["SLP_StoreHistorySub"]</p></div>
                    <div class="table-responsive" style="max-height:330px;overflow-y:auto">
                        <table class="table table-hover table-sm mb-0" style="font-size:12px">
                            <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                                <tr><th class="px-3 py-2">@L["SLP_Store"]</th><th class="px-3 py-2">@L["SLP_Period"]</th><th class="px-3 py-2 text-center">@L["SLP_Headcount"]</th><th class="px-3 py-2 text-center">@L["SLP_Turnover"]</th></tr>
                            </thead>
                            <tbody id="slpHistoryBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="slp-section-title"><div class="section-accent"></div><h5>@L["SLP_ExitInsights"]</h5></div>
        <div class="row g-3">
            <div class="col-xl-6">
                <div class="chart-card slp-chart-card">
                    <div class="slp-card-title"><h6>@L["SLP_ExitSentiment"]</h6><p>@L["SLP_ExitSentimentSub"]</p></div>
                    <div class="slp-chart-wrap"><canvas id="slpExitTrendChart"></canvas></div>
                </div>
            </div>
            <div class="col-xl-6"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_ReasonsLeaving"]</h6></div><div id="slpReasons" class="slp-bars"></div></div></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_WouldReturn"]</h6></div><div id="slpWouldReturn" class="slp-bars"></div></div></div>
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_OverallExperience"]</h6></div><div id="slpExperience" class="slp-bars"></div></div></div>
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_EngagementDrivers"]</h6></div><div id="slpDrivers" class="slp-bars"></div></div></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_Workload"]</h6></div><div id="slpWorkload" class="slp-bars"></div></div></div>
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_Training"]</h6></div><div id="slpTraining" class="slp-bars"></div></div></div>
            <div class="col-lg-4"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_FairTreatment"]</h6></div><div id="slpFairTreatment" class="slp-bars"></div></div></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-6"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_ReasonVsReturn"]</h6></div><div id="slpReasonReturn" class="slp-bars"></div></div></div>
            <div class="col-lg-6"><div class="chart-card slp-chart-card"><div class="slp-card-title"><h6>@L["SLP_JobTitles"]</h6></div><div id="slpJobTitles" class="slp-bars"></div></div></div>
        </div>

        <div class="slp-section-title"><div class="section-accent"></div><h5>@L["SLP_Comments"]</h5></div>
        <div class="chart-card p-0 mb-4" style="overflow:hidden">
            <div class="table-responsive" style="max-height:450px;overflow-y:auto">
                <table class="table table-hover mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1"><tr><th class="px-3 py-2">@L["SLP_Store"]</th><th class="px-3 py-2">@L["SLP_Question"]</th><th class="px-3 py-2">@L["SLP_Comment"]</th><th class="px-3 py-2">@L["SLP_Date"]</th></tr></thead>
                    <tbody id="slpComments"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script>
(() => {
    const page = document.getElementById('slpPage');
    const params = new URLSearchParams(window.location.search);
    const leader = params.get('leader') || '';
    const dimension = ['leader', 'oc', 'om'].includes(params.get('dimension')) ? params.get('dimension') : 'leader';
    const labels = {
        noData: page.dataset.noData, noExit: page.dataset.noExit, noComments: page.dataset.noComments,
        headcount: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_Headcount"].Value)),
        resignations: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_Resignations"].Value)),
        turnover: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_Turnover"].Value)),
        responses: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_ExitResponses"].Value)),
        transferred: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_Transferred"].Value)),
        exitSentiment: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SLP_ExitSentiment"].Value))
    };
    let historyChart = null, exitTrendChart = null;

    function esc(value) {
        const el = document.createElement('span');
        el.textContent = value == null ? '' : String(value);
        return el.innerHTML;
    }
    function pct(value) { return `${Number(value || 0).toFixed(1)}%`; }
    function metricCard(icon, title, value, sub, color) {
        return `<div class="kpi-card"><div class="kpi-icon" style="--kpi-color:${color}"><i class="bi ${icon}"></i></div><div class="kpi-content"><div class="kpi-label">${esc(title)}</div><div class="kpi-value slp-kpi-value">${esc(value)}</div><div class="kpi-sub">${esc(sub)}</div></div></div>`;
    }
    function barList(id, rows, positive = false) {
        const el = document.getElementById(id);
        if (!rows || !rows.length) { el.innerHTML = `<div class="slp-empty">${esc(labels.noExit)}</div>`; return; }
        const max = Math.max(...rows.map(r => Number(r.value ?? r.positivePercent ?? 0)), 1);
        el.innerHTML = rows.slice(0, 8).map(r => {
            const value = Number(r.value ?? r.positivePercent ?? 0);
            const label = r.label || '';
            const cls = positive ? (value >= 70 ? 'good' : value >= 40 ? 'warn' : '') : '';
            return `<div class="slp-bar-row"><div class="slp-bar-label"><span>${esc(label)}</span><strong>${pct(value)}</strong></div><div class="slp-bar-track"><div class="slp-bar-fill ${cls}" style="width:${Math.max(2, value / max * 100)}%"></div></div></div>`;
        }).join('');
    }
    function answerBars(id, rows) {
        const el = document.getElementById(id);
        if (!rows || !rows.length) { el.innerHTML = `<div class="slp-empty">${esc(labels.noExit)}</div>`; return; }
        const total = rows.reduce((sum, r) => sum + Number(r.value || 0), 0) || 1;
        el.innerHTML = rows.slice(0, 8).map(r => {
            const share = Number(r.value || 0) * 100 / total;
            return `<div class="slp-bar-row"><div class="slp-bar-label"><span>${esc(r.label)}</span><strong>${r.value} (${share.toFixed(1)}%)</strong></div><div class="slp-bar-track"><div class="slp-bar-fill" style="width:${Math.max(2, share)}%"></div></div></div>`;
        }).join('');
    }
    function renderHistory(rows) {
        const body = document.getElementById('slpHistoryBody');
        if (!rows || !rows.length) { body.innerHTML = `<tr><td colspan="4" class="slp-empty">${esc(labels.noData)}</td></tr>`; return; }
        body.innerHTML = rows.map(r => `<tr><td class="px-3 py-2 fw-semibold">${esc(r.store)}${r.isStoreTransition ? `<span class="sc-transfer-badge">${esc(labels.transferred)}</span>` : ''}</td><td class="px-3 py-2">${esc(r.periodLabel)}</td><td class="px-3 py-2 text-center">${r.headcount}</td><td class="px-3 py-2 text-center">${pct(r.turnoverRate)}</td></tr>`).join('');
        const ctx = document.getElementById('slpHistoryChart');
        if (historyChart) historyChart.destroy();
        historyChart = new Chart(ctx, { type:'line', data:{ labels:rows.map(r => r.periodLabel), datasets:[
            { label:labels.turnover, data:rows.map(r => r.turnoverRate), borderColor:ChartColors.SERIES.SECONDARY, backgroundColor:ChartColors.SERIES_FILL.SECONDARY, fill:true, tension:.3 },
            { label:labels.headcount, data:rows.map(r => r.headcount), borderColor:ChartColors.SERIES.PRIMARY, backgroundColor:'transparent', yAxisID:'y1', tension:.3 }
        ]}, options:{ responsive:true, interaction:{mode:'index',intersect:false}, scales:{ y:{beginAtZero:true,ticks:{callback:v=>v+'%'}}, y1:{beginAtZero:true,position:'right',grid:{drawOnChartArea:false}} } }});
    }
    function renderExitTrend(rows) {
        const ctx = document.getElementById('slpExitTrendChart');
        if (!rows || !rows.length) { ctx.parentElement.innerHTML = `<div class="slp-empty">${esc(labels.noExit)}</div>`; return; }
        const keys = [...new Set(rows.flatMap(r => Object.keys(r.counts || {})))].slice(0, 5);
        if (exitTrendChart) exitTrendChart.destroy();
        exitTrendChart = new Chart(ctx, { type:'bar', data:{ labels:rows.map(r => r.label), datasets:keys.map((key, i) => ({ label:key, data:rows.map(r => (r.counts || {})[key] || 0), backgroundColor:[ChartColors.SERIES.SECONDARY, ChartColors.SERIES.PRIMARY, ChartColors.SERIES.TERTIARY, ChartColors.SERIES.QUINARY, ChartColors.SERIES.VIOLET][i % 5] })) }, options:{ responsive:true, scales:{x:{stacked:true},y:{stacked:true,beginAtZero:true}} }});
    }
    async function load() {
        if (!leader) { document.getElementById('slpError').textContent = labels.noData; document.getElementById('slpError').style.display=''; return; }
        const q = new URLSearchParams({ leader });
        if (params.get('year')) q.set('year', params.get('year'));
        if (params.get('months')) q.set('months', params.get('months'));
        q.set('dimension', dimension);
        const res = await fetch(`/api/scorecard/leader-profile?${q.toString()}`);
        if (!res.ok) { document.getElementById('slpError').textContent = labels.noData; document.getElementById('slpError').style.display=''; return; }
        const p = await res.json(), s = p.summary || {}, sentiment = p.exitSentiment || {};
        document.getElementById('slpName').textContent = p.name || leader;
        document.getElementById('slpWindow').textContent = params.get('year') ? `${params.get('year')}${params.get('months') ? ' · ' + params.get('months') : ''}` : '';
        document.getElementById('slpKpis').innerHTML = [
            metricCard('bi-arrow-repeat', labels.turnover, pct(s.turnoverRate), labels.resignations + ': ' + (p.history || []).reduce((n,r)=>n+r.resignations,0), 'oklch(0.55 0.19 25)'),
            metricCard('bi-people', labels.headcount, s.headcount || 0, labels.responses + ': ' + (sentiment.totalResponses || 0), 'oklch(0.55 0.19 250)'),
            metricCard('bi-hourglass-split', '90-Day', pct(s.earlyLeaver90Rate), labels.noData, 'oklch(0.72 0.16 75)'),
            metricCard('bi-shield-check', '180-Day', pct(s.retention180Rate), labels.noData, 'oklch(0.58 0.16 150)'),
            metricCard('bi-chat-heart', labels.exitSentiment || 'Exit Sentiment', pct(sentiment.positivePercent), labels.responses + ': ' + (sentiment.totalResponses || 0), 'oklch(0.55 0.2 300)')
        ].join('');
        renderHistory(p.history || []);
        renderExitTrend(p.reasonsTrend || []);
        answerBars('slpReasons', p.exitReasons);
        answerBars('slpWouldReturn', p.wouldReturn);
        answerBars('slpExperience', p.overallExperience);
        barList('slpDrivers', p.engagementDrivers, true);
        answerBars('slpWorkload', p.workloadCondition);
        answerBars('slpTraining', p.training);
        answerBars('slpFairTreatment', p.fairTreatment);
        barList('slpReasonReturn', (p.reasonVsWouldReturn || []).map(r => ({ label: r.reason, positivePercent: r.wouldReturnPercent })), true);
        answerBars('slpJobTitles', p.jobTitles);
        const comments = document.getElementById('slpComments');
        comments.innerHTML = p.comments && p.comments.length ? p.comments.map(c => `<tr><td class="px-3 py-2">${esc(c.store)}</td><td class="px-3 py-2">${esc(c.questionLabel)}</td><td class="px-3 py-2 slp-comment">${esc(c.text)}</td><td class="px-3 py-2">${c.submittedAt ? new Date(c.submittedAt).toLocaleDateString() : '—'}</td></tr>`).join('') : `<tr><td colspan="4" class="slp-empty">${esc(labels.noComments)}</td></tr>`;
        document.getElementById('slpBody').style.display='';
    }
    load().catch(() => { document.getElementById('slpError').textContent = labels.noData; document.getElementById('slpError').style.display=''; });
})();
</script>