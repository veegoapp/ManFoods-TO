async function rtLoadOcTenureCharts(ocRows) {
    const data = (ocRows || []).map(r => ({ label: r.name, value: r.avgTenureMonths }));
    rtOcTenureTopInstance = rtRenderTenureRankChart('rtOcTenureTopChart', rtOcTenureTopInstance, data.slice(0, 5), ChartColors.SEMANTIC.GOOD);
    rtOcTenureBottomInstance = rtRenderTenureRankChart('rtOcTenureBottomChart', rtOcTenureBottomInstance, data.slice(-5).reverse(), ChartColors.SEMANTIC.BAD);
}

/* ── How soon people leave, and how much hiring is happening — both always
   full history, so they read clearly even for a young company. ─────────── */
let rtFirstResignInstance;
async function rtLoadFirstResignationChart() {
    const r = await fetch(`/api/retention/time-to-first-resignation?${rtFilterQuery().toString()}`);
    const data = r.ok ? await r.json() : [];
    const total = data.reduce((s, d) => s + d.value, 0);
    const ctx = document.getElementById('rtFirstResignChart');
    if (!ctx) return;
    if (rtFirstResignInstance) rtFirstResignInstance.destroy();
    rtFirstResignInstance = new Chart(ctx.getContext('2d'), {
        type: 'bar',
        data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => d.value), backgroundColor: ChartColors.colorsByLabel(data.map(d => d.label), null), borderRadius: 6, maxBarThickness: 46 }] },
        options: {
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: c => ` ${c.formattedValue} resignation(s) (${total > 0 ? (c.parsed.y / total * 100).toFixed(0) : 0}% of all resignations)` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' }
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: 'oklch(0.5 0.03 258)' } },
                y: { beginAtZero: true, ticks: { color: 'oklch(0.5 0.03 258)', precision: 0 }, grid: { color: 'oklch(0.92 0.008 255)' } }
            }
        }
    });
}

let rtHiringVolumeInstance;
async function rtLoadHiringVolumeChart() {
    const q = rtFilterQuery();
    if (rtYear) q.set('sinceYear', rtYear);
    const r = await fetch(`/api/retention/monthly-hiring-volume?${q.toString()}`);
    const data = r.ok ? await r.json() : [];
    const ctx = document.getElementById('rtHiringVolumeChart');
    if (!ctx) return;
    if (rtHiringVolumeInstance) rtHiringVolumeInstance.destroy();
    rtHiringVolumeInstance = new Chart(ctx.getContext('2d'), {
        type: 'line',
        data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => d.value), borderColor: ChartColors.SERIES.PRIMARY, backgroundColor: ChartColors.SERIES_FILL.PRIMARY, tension: 0.35, fill: true, pointRadius: 3, pointHoverRadius: 6 }] },
        options: {
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: c => ` ${c.formattedValue} new hire(s)` } },
                datalabels: { display: false }
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: 'oklch(0.5 0.03 258)' } },
                y: { beginAtZero: true, ticks: { color: 'oklch(0.5 0.03 258)', precision: 0 }, grid: { color: 'oklch(0.92 0.008 255)' } }
            }
        }
    });
}

function rtRenderInsights(items) {
    const el = document.getElementById('rtInsights');
    if (!items || !items.length) { el.innerHTML = '<div class="text-muted" style="font-size:13px">' + rtL.noInsights + '</div>'; return; }
    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: ChartColors.SEMANTIC.GOOD, text: ChartColors.SEMANTIC.GOOD },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
    };
    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6">
            <div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
                    <div>
                        <div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
                        <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('') + '</div>';
}

async function rtLoadInsights() {
    rtRenderInsights(await rtFetch('insights'));
}

async function rtLoadAll() {
    if (!rtYear || !rtMonths.length) return;
    const [ocRows] = await Promise.all([
        rtLoadManagerTenureTable(),
        rtLoadMilestones(), rtLoadSurvivalCurve(), rtLoadLeaderboard(), rtLoadTenureByStore(), rtLoadInsights(),
        rtLoadJobTitleChart(), rtLoadGenderChart(), rtLoadStoreTenureCharts(),
        rtLoadFirstResignationChart(), rtLoadHiringVolumeChart(),
    ]);
    await rtLoadOcTenureCharts(ocRows);
}

(async function init() {
    const hasData = await rtLoadFilters();
    if (hasData) await rtLoadAll();
})();
</script>
