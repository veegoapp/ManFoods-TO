            new() { Icon = "bi-award", Title = L["RT_TenureMilestonesTitle"], Body = L["Guide_Retention_Milestones"] },
            new() { Icon = "bi-shop", Title = L["Retention_TenureByStore"], Body = L["Guide_Retention_Chart_TenureByStore"] },
            new() { Icon = "bi-graph-up", Title = L["Chart_SurvivalCurve"], Body = L["Guide_Retention_Chart_Survival"] },
            new() { Icon = "bi-trophy", Title = L["Retention_LeaderboardTop"], Body = L["Guide_Retention_Chart_LeaderboardTop"] },
