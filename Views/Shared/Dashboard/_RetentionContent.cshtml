/* Initial filter load ------------------------------------------------------ */
async function rtLoadFilters() {
    const [stores, cohortPeriods, managers, consultants, seniorConsultants, directors, jobs] = await Promise.all([
        fetch('/api/retention/stores').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/available-periods').then(r => r.ok ? r.json() : []),
        fetch('/api/retention/operation-managers').then(r => r.ok ? r.json() : []),
        fetch('/api/retention/operation-consultants').then(r => r.ok ? r.json() : []),
        fetch('/api/retention/senior-operation-consultants').then(r => r.ok ? r.json() : []),
        fetch('/api/retention/operation-directors').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/job-titles').then(r => r.ok ? r.json() : []),
    ]);

    const hasData = (stores || []).length > 0;
    document.getElementById('rtEmptyState').style.display = hasData ? 'none' : '';
    document.getElementById('rtContent').style.display = hasData ? '' : 'none';
    if (!hasData) return false;

    rtYearMonthsMap = {};
    (cohortPeriods || []).forEach(p => { (rtYearMonthsMap[p.year] = rtYearMonthsMap[p.year] || []).push(p.month); });
    const years = Object.keys(rtYearMonthsMap).map(Number).sort((a, b) => b - a);
    const yearSel = document.getElementById('rtYearSelect');
    yearSel.innerHTML = years.map(y => `<option value="${y}">${y}</option>`).join('');
    rtYear = years[0];
    yearSel.value = rtYear;
    rtMonths = (rtYearMonthsMap[rtYear] || []).slice().sort((a, b) => a - b);
    rtBuildMonthsOptions();
    rtRenderMonthsChips();

    rtStoreCombo.setOptions(stores || []);
    rtOmCombo.setOptions(managers || []);
    rtOcCombo.setOptions(consultants || []);
    rtSocCombo.setOptions(seniorConsultants || []);
    rtOdCombo.setOptions(directors || []);
    if (rtJobPanel) {
        rtJobPanel.innerHTML = (jobs || []).map(job => `
            <label class="job-filter-option">
                <input type="checkbox" value="${sapEscape(job)}" ${rtJobFilter.includes(job) ? 'checked' : ''}>
                <span>${sapEscape(job)}</span>
            </label>`).join('') || '<div class="job-filter-empty">No jobs available</div>';
    }
    return true;
}

/* KPI cards mirror the "Team Experience by Store" table below: each card is a
   tenure bucket's share of CURRENT active headcount (a snapshot), not a
   survival/eligibility rate — so a bucket nobody has reached yet correctly
   reads 0%, and short-tenure resignations never distort a longer bucket's card. */
function rtRenderMilestones(items) {
    const el = document.getElementById('rtMilestoneCards');
    if (!items) { el.innerHTML = ''; return; }
    const total = items.reduce((s, b) => s + b.value, 0);
    if (!total) { el.innerHTML = '<div class="text-muted small py-3">' + rtL.noActiveHeadcount + '</div>'; return; }
    const byLabel = {};
    items.forEach(b => { byLabel[b.label] = b.value; });
    el.innerHTML = Object.keys(ChartColors.RETENTION_TENURE_BUCKET_COLORS).map(label => {
        const value = byLabel[label] || 0;
        const pct = value / total * 100;
        const color = ChartColors.RETENTION_TENURE_BUCKET_COLORS[label];
        return `<div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-people-fill" style="color:${color}"></i></div>
            <div class="kpi-value" style="color:${color}">${pct.toFixed(1)}%</div>
            <div class="kpi-label">${label}</div>
            <div class="kpi-desc">${rtL.milestoneDesc}</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">${value}/${total} ${rtL.activeEmployeesSuffix}</div>
        </div>`;
    }).join('');
}

