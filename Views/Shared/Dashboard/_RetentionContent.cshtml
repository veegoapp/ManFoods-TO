<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<!-- dashboard.js is included only for shared helpers (rangeFilterBadge, fetchJson) —
     this page has its own Year+Months filter UI, so dashboard.js's period/store
     selects and loadPeriods() no-op here (no matching element IDs on this page). -->
<script>
/* ── Retention page — Year + discrete cohort-Months multi-select, same
   filter components as Turnover/Comparisons/90-Day/Workforce. */
const rtL = document.getElementById('rtContent').dataset;
let rtYear = null, rtMonths = [], rtYearMonthsMap = {};
let rtStoreFilter = '', rtOmFilter = '', rtOcFilter = '', rtSocFilter = '', rtOdFilter = '';
let rtJobFilter = [];

function rtMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }
function rtMonthLongName(m, y) { return new Date(y, m - 1).toLocaleString('default', { month: 'long', year: 'numeric' }); }
function rtAnchor() { return rtMonths.length ? Math.max(...rtMonths) : null; }

/* Range-filter badge (dashboard.js) — captures each title's original text
   once, so repeated filter-change reloads don't stack badges. This page's
   filter is a discrete cohort-Months multi-select (like 90-Day Turnover),
   so "range active" means more than one month is checked. */
const rtTitleBase = {};
function rtSetTitleBadge(id, affected) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!(id in rtTitleBase)) rtTitleBase[id] = el.textContent;
    el.innerHTML = rtTitleBase[id] + ' ' + rangeFilterBadge(rtMonths.length > 1, affected);
}

function rtBuildQuery(extra) {
    const q = new URLSearchParams(extra || {});
    if (rtYear) q.set('toYear', rtYear);
    if (rtMonths.length) {
        q.set('months', rtMonths.join(','));
        q.set('toMonth', rtAnchor());
    }
    if (rtStoreFilter) q.set('store', rtStoreFilter);
    if (rtOmFilter)    q.set('om', rtOmFilter);
