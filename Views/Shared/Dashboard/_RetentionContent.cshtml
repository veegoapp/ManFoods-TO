/* Team Experience by Store — replaces the old single company-wide doughnut
   with a per-store breakdown table (or a single row when a store is picked). */
function rtRenderTenureTable(rows) {
    const tbody = document.getElementById('rtTenureTableBody');
    if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-muted">' + rtL.noData + '</td></tr>'; return; }
    tbody.innerHTML = rows.map(r => {
        const total = r.buckets.reduce((s, b) => s + b.value, 0) || 1;
        const bucketColor = b => ChartColors.RETENTION_TENURE_BUCKET_COLORS[b.label] || ChartColors.hashColor(b.label);
        const segs = r.buckets.filter(b => b.value > 0).map((b) => {
            const pct = Math.round(b.value / total * 100);
            return `<span class="rt-tenure-bar-seg" style="width:${pct}%;background:${bucketColor(b)}" title="${b.label}: ${b.value} (${pct}%)"></span>`;
        }).join('');
        const legend = r.buckets.filter(b => b.value > 0).map((b) =>
            `<span style="color:var(--text-3);font-size:10.5px;margin-inline-end:8px"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${bucketColor(b)};margin-inline-end:3px"></span>${b.label} (${b.value})</span>`
        ).join('');
        return `<tr>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.storeName)}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2">
                <div class="rt-tenure-bar-row"><div class="rt-tenure-bar-track">${segs}</div></div>
                <div>${legend}</div>
            </td>
        </tr>`;
    }).join('');
}

