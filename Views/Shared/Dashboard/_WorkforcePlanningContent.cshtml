    host.innerHTML = WP_GROUP_DEFS.map(g => `
        <div class="chart-card p-0" style="overflow:hidden">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon" style="--icon-color:${g.color}"><i class="bi ${g.icon}"></i></span>
                <div><h6 class="mb-0">${sapEscape(wpL[g.id.toLowerCase() + 'Title'])}</h6><p class="mb-0">${sapEscape(wpL[g.id.toLowerCase() + 'Sub'])}</p></div>
            </div>
            <div class="table-responsive wp-group-wrap">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1"><tr id="wpGrpHead${g.id}">
                        ${wpTh('name', wpL.colName)}${wpTh('stores', wpL.colStores, 'text-center')}${wpTh('projected', wpL.colProjected, 'text-center')}
                        ${wpTh('actual', wpL.colActual, 'text-center')}${wpTh('gap', wpL.colGap, 'text-center')}${wpTh('shortage', wpL.colShortage, 'text-center')}${wpTh('attrition', wpL.colAttrition, 'text-center')}${wpTh('hiring', wpL.colHiring, 'text-center')}
                        ${wpTh('fill', wpL.colFill)}${wpTh('status', wpL.colStatus)}
                    </tr></thead>
                    <tbody id="wpGrpBody${g.id}"></tbody>
