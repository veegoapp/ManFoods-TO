/* ── Store drill-down: click a store to see its jobs, so every number in its row can be traced ── */
const wpOpenStores = new Set();
const wpStoreJobs = new Map(); // store -> job rows (or 'loading')
const wpNum = v => Math.round(v * 10) / 10;

async function wpToggleStore(store) {
    if (wpOpenStores.has(store)) { wpOpenStores.delete(store); wpRenderStores(); return; }
    wpOpenStores.add(store);
    wpRenderStores();
    wpFetchStoreJobs(store);
}
async function wpFetchStoreJobs(store) {
    if (wpStoreJobs.has(store)) return;
    wpStoreJobs.set(store, 'loading');
    const d = wpData;
    const q = new URLSearchParams({ store, year: d.year, month: d.month });
    if (wpState.job) q.set('jobs', wpState.job);
    try {
        const r = await fetch('/api/workforce-planning/store-jobs?' + q);
        if (!r.ok) throw new Error();
        const rows = await r.json();
        if (wpData === d) wpStoreJobs.set(store, rows); // ignore if the filters changed meanwhile
    } catch { if (wpData === d) wpStoreJobs.set(store, []); }
    if (wpData === d) wpRenderStores();
}

function wpDrillHtml(store, rows) {
    if (rows === 'loading' || !rows) return `<div class="text-muted" style="font-size:13px">${sapEscape(wpL.drillLoading)}</div>`;
    const lines = rows.map(r => {
        const p = r.projected, a = r.actual ?? 0, gap = a - p;
        return { job: r.job, p, a, gap, shortage: Math.max(0, p - a), exp: r.expectedAttrition ?? 0, need: r.hiringNeed ?? 0 };
    });
    const sum = f => lines.reduce((t, l) => t + f(l), 0);
    const short = sum(l => l.shortage), exp = Math.round(sum(l => l.exp)), need = Math.round(sum(l => l.need));
    const body = lines.map(l => `<tr><td>${sapEscape(l.job)}</td><td class="num">${l.p}</td><td class="num">${l.a}</td>
        <td class="num ${wpGapClass(l.gap)}">${wpGapText(l.gap)}</td><td class="num">${l.shortage}</td><td class="num">${wpNum(l.exp)}</td><td class="num"><b>${wpNum(l.need)}</b></td></tr>`).join('');
    const foot = `<tr><td>${sapEscape(wpL.total)}</td><td class="num">${sum(l => l.p)}</td><td class="num">${sum(l => l.a)}</td>
        <td class="num ${wpGapClass(sum(l => l.gap))}">${wpGapText(sum(l => l.gap))}</td><td class="num">${short}</td><td class="num">${exp}</td><td class="num">${need}</td></tr>`;
    const diff = short + exp - need;
    const absorbed = diff > 0 ? `<div class="wp-explain">${sapEscape(wpFmt(wpL.drillAbsorbed, diff, exp, need, short + exp))}</div>` : '';
    return `<div style="font-weight:700;font-size:13px">${sapEscape(wpFmt(wpL.drillTitle, store))}</div>
        <div class="wp-table-wrap" style="max-height:340px"><table class="wp-sub"><thead><tr><th>${sapEscape(wpL.colJob)}</th><th class="num">${sapEscape(wpL.colProjected)}</th><th class="num">${sapEscape(wpL.colActual)}</th>
        <th class="num">${sapEscape(wpL.colGap)}</th><th class="num">${sapEscape(wpL.colShortage)}</th><th class="num">${sapEscape(wpL.colAttrition)}</th><th class="num">${sapEscape(wpL.colHiring)}</th></tr></thead>
        <tbody>${body}</tbody><tfoot>${foot}</tfoot></table></div>
        <div class="wp-explain">${sapEscape(wpL.drillFormula)}</div>${absorbed}`;
}

function wpRenderStores() {
    const term = (document.getElementById('wpSearch').value || '').trim().toLowerCase();
    const has = wpData.hasActual;
    const rows = wpSortRows(wpData.byStore.filter(r => !term || r.name.toLowerCase().includes(term) || (r.operationConsultant || '').toLowerCase().includes(term)));
    wpMarkSortedHeader();
    document.getElementById('wpStoreRows').innerHTML = rows.map(r => {
        const gapTxt = has ? wpGapText(r.gap) : '—';
        const gapCls = !has ? '' : wpGapClass(r.gap);
        const fill = has
            ? `<span class="wp-fill"><span style="width:${Math.min(100, r.fillPercent)}%;background:${wpFillColor(r.status)}"></span></span>${r.fillPercent}%`
            : '—';
        const open = has && wpOpenStores.has(r.name);
        const main = `<tr class="${has ? 'wp-click' : ''} ${open ? 'wp-open' : ''}" ${has ? `data-store="${sapEscape(r.name)}" title="${sapEscape(wpL.drillHint)}"` : ''}>
            <td>${has ? '<i class="bi bi-chevron-right wp-chev"></i>' : ''}${sapEscape(r.name)}</td>
            <td>${r.operationConsultant ? sapEscape(r.operationConsultant) : '—'}</td>
            <td class="num">${r.projected}</td>
            <td class="num">${has ? r.actual : '—'}</td>
            <td class="num ${gapCls}">${gapTxt}</td>
            <td class="num">${has ? r.shortage : '—'}</td>
            <td class="num">${has ? Math.round(r.expectedAttrition) : '—'}</td>
            <td class="num">${has ? r.hiringNeed : '—'}</td>
            <td>${fill}</td>
            <td><span class="wp-pill ${r.status}">${sapEscape(wpPillLabel(r.status))}</span></td>
        </tr>`;
        return main + (open ? `<tr class="wp-detail"><td colspan="10">${wpDrillHtml(r.name, wpStoreJobs.get(r.name))}</td></tr>` : '');
    }).join('');
}
document.getElementById('wpStoreRows').addEventListener('click', e => {
    const tr = e.target.closest('tr.wp-click');
    if (tr && !e.target.closest('.wp-detail')) wpToggleStore(tr.dataset.store);
});

document.getElementById('wpYear').addEventListener('change', e => { wpState.year = e.target.value; wpState.month = ''; wpLoad(); });
document.getElementById('wpMonth').addEventListener('change', e => { wpState.month = e.target.value; wpLoad(); });
document.getElementById('wpStore').addEventListener('change', e => { wpState.store = e.target.value; wpLoad(); });
document.getElementById('wpJob').addEventListener('change', e => { wpState.job = e.target.value; wpLoad(); });
[['wpOc', 'oc'], ['wpOm', 'om'], ['wpSoc', 'soc'], ['wpOd', 'od']].forEach(([id, key]) =>
    document.getElementById(id).addEventListener('change', e => { wpState[key] = e.target.value; wpLoad(); }));
document.getElementById('wpReset').addEventListener('click', () => {
    Object.keys(wpState).forEach(k => { wpState[k] = ''; });
    wpLoad();
});
document.getElementById('wpSearch').addEventListener('input', wpRenderStores);
document.querySelectorAll('#wpStoreHead th.sortable').forEach(th => th.addEventListener('click', () => {
    wpToggleSort(wpSort, th.dataset.sort);
    wpRenderStores();
}));
wpLoad();
</script>
