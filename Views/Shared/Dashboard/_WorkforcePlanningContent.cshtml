    WP_GROUP_DEFS.forEach(g => {
        wpGroupSort[g.key] = { key: null, dir: 'asc' };
        document.querySelectorAll(`#wpGrpHead${g.id} th.sortable`).forEach(th => th.addEventListener('click', () => {
            wpToggleSort(wpGroupSort[g.key], th.dataset.sort);
            wpRenderGroup(g);
        }));
    });
}

function wpRenderGroup(g) {
    const has = wpData.hasActual;
    const state = wpGroupSort[g.key];
