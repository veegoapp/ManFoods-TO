// Click a column header to sort by it; click again to flip the direction. Until a header
// is clicked the server order (largest shortage first) is kept.
const wpSort = { key: null, dir: 'asc' };
const WP_STATUS_ORDER = { critical: 0, watch: 1, ok: 2, over: 3, none: 4 };
const wpSortValue = {
    name: r => r.name, oc: r => r.operationConsultant || '', stores: r => r.storeCount,
    projected: r => r.projected, actual: r => r.actual, gap: r => r.gap, hiring: r => r.hiringNeed, shortage: r => r.shortage, attrition: r => r.expectedAttrition,
    fill: r => r.fillPercent, status: r => WP_STATUS_ORDER[r.status] ?? 9,
};
// Shared by every sortable table on the page; `state` is { key, dir }.
function wpSortRowsBy(rows, state) {
    if (!state.key) return rows;
    const val = wpSortValue[state.key], sign = state.dir === 'asc' ? 1 : -1;
    return [...rows].sort((a, b) => {
        const x = val(a), y = val(b);
        // Stores with no consultant always sink to the bottom, whatever the direction.
        if (state.key === 'oc' && (!x || !y) && x !== y) return !x ? 1 : -1;
        const c = typeof x === 'string' ? x.localeCompare(y, undefined, { sensitivity: 'base', numeric: true }) : x - y;
        return (c || a.name.localeCompare(b.name)) * sign;
    });
}
const wpSortRows = rows => wpSortRowsBy(rows, wpSort);
function wpToggleSort(state, key) {
    state.dir = state.key === key && state.dir === 'asc' ? 'desc' : 'asc';
    state.key = key;
}
function wpMarkSorted(headEl, state) {
    headEl.querySelectorAll('th.sortable').forEach(th => {
        const on = th.dataset.sort === state.key;
        th.classList.toggle('sorted', on);
        th.querySelector('i').className = 'bi ' + (on ? (state.dir === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down-fill');
    });
}
const wpMarkSortedHeader = () => wpMarkSorted(document.getElementById('wpStoreHead'), wpSort);


