<script>Chart.register(ChartDataLabels);</script>
<script>
/* Workforce Planning — projected vs actual headcount. One endpoint
   (/api/workforce-planning/summary) returns the filter options, KPIs, per-job
   and per-store breakdowns and the year's trend; the server caches the heavy
   reads, so changing a filter here never re-reads whole tables from the DB. */
const wpL = document.getElementById('wpL').dataset;
const WP_I = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> {
    ["OverallOk_T"] = L["WP_In_OverallOk_T"].Value,
    ["OverallWatch_T"] = L["WP_In_OverallWatch_T"].Value,
    ["OverallLow_T"] = L["WP_In_OverallLow_T"].Value,
    ["OverallOver_T"] = L["WP_In_OverallOver_T"].Value,
    ["WorstPg_T"] = L["WP_In_WorstPg_T"].Value,
    ["Overall_D"] = L["WP_In_Overall_D"].Value,
    ["WorstStore_T"] = L["WP_In_WorstStore_T"].Value,
    ["WorstStore_D"] = L["WP_In_WorstStore_D"].Value,
    ["StoresBelow_T"] = L["WP_In_StoresBelow_T"].Value,
    ["StoresBelow_D"] = L["WP_In_StoresBelow_D"].Value,
    ["StoresOk_T"] = L["WP_In_StoresOk_T"].Value,
    ["StoresOk_D"] = L["WP_In_StoresOk_D"].Value,
    ["WorstJob_T"] = L["WP_In_WorstJob_T"].Value,
    ["WorstJob_D"] = L["WP_In_WorstJob_D"].Value,
    ["Hiring_T"] = L["WP_In_Hiring_T"].Value,
    ["Hiring_D"] = L["WP_In_Hiring_D"].Value,
    ["NoHiring_T"] = L["WP_In_NoHiring_T"].Value,
    ["NoHiring_D"] = L["WP_In_NoHiring_D"].Value,
    ["WorstOc_T"] = L["WP_In_WorstOc_T"].Value,
    ["WorstOc_D"] = L["WP_In_WorstOc_D"].Value,
    ["Surplus_T"] = L["WP_In_Surplus_T"].Value,
    ["Surplus_D"] = L["WP_In_Surplus_D"].Value,
    ["Outlook_T"] = L["WP_In_Outlook_T"].Value,
    ["Outlook_D"] = L["WP_In_Outlook_D"].Value,
    ["NoData"] = L["WP_In_NoData"].Value,
}));
const wpState = { year: '', month: '', store: '', job: '', oc: '', om: '', soc: '', od: '' };
let wpJobChart, wpTrendChart, wpData;

// Bar colours: dark enough for the white value labels drawn on the bars.
const WP_PROJECTED = 'oklch(0.5 0.06 258)';
const WP_ACTUAL = 'oklch(0.55 0.19 25)';
const wpMonthName = (m, style) => new Date(2000, m - 1, 1).toLocaleString('default', { month: style || 'long' });
const wpPillLabel = s => wpL[s] || '';
// Gap = actual − projected: negative = shortage (red), positive = surplus (blue, shown with a +).
const wpGapText = g => (g > 0 ? '+' : '') + g;
const wpGapClass = g => g < 0 ? 'wp-gap-short' : g > 0 ? 'wp-gap-over' : '';
const wpFillColor = s => s === 'critical' ? 'oklch(0.6 0.22 22)' : s === 'watch' ? 'oklch(0.75 0.16 75)' : s === 'over' ? 'oklch(0.6 0.13 250)' : 'oklch(0.62 0.15 155)';

function wpFillSelect(id, options, value) {
    const el = document.getElementById(id);
    el.innerHTML = options.map(o => `<option value="${sapEscape(o.value)}">${sapEscape(o.label)}</option>`).join('');
    el.value = String(value ?? '');
}

async function wpLoad() {
    const q = new URLSearchParams();
    if (wpState.year) q.set('year', wpState.year);
    if (wpState.month) q.set('month', wpState.month);
    if (wpState.store) q.set('store', wpState.store);
    if (wpState.job) q.set('jobs', wpState.job);
    ['oc', 'om', 'soc', 'od'].forEach(k => { if (wpState[k]) q.set(k, wpState[k]); });
    let d;
    try {
        const r = await fetch('/api/workforce-planning/summary?' + q);
        if (!r.ok) throw new Error();
        d = await r.json();
    } catch {
        document.getElementById('wpEmpty').hidden = false;
        return;
    }
    wpData = d;
    wpStoreJobs.clear(); // the filters or the period may have changed the figures
    if (!d.hasData) {
        document.getElementById('wpEmpty').hidden = false;
        document.getElementById('wpBody').hidden = true;
        document.getElementById('wpFilters').hidden = true;
        return;
    }
    document.getElementById('wpEmpty').hidden = true;
    document.getElementById('wpBody').hidden = false;
    document.getElementById('wpFilters').hidden = false;

    // Keep the state in sync with what the server actually resolved.
    wpState.year = d.year; wpState.month = d.month;
    wpFillSelect('wpYear', d.years.map(y => ({ value: y, label: y })), d.year);
    wpFillSelect('wpMonth', d.months.map(m => ({ value: m, label: wpMonthName(m) })), d.month);
    wpFillSelect('wpStore', [{ value: '', label: wpL.allStores }].concat(d.stores.map(s => ({ value: s, label: s }))), wpState.store);
    wpFillSelect('wpJob', [{ value: '', label: wpL.allJobs }].concat(d.jobs.map(j => ({ value: j, label: j }))), wpState.job);
    const people = (id, all, list, key) => wpFillSelect(id, [{ value: '', label: all }].concat((list || []).map(n => ({ value: n, label: n }))), wpState[key]);
    people('wpOc', wpL.allOc, d.operationConsultants, 'oc');
    people('wpOm', wpL.allOm, d.operationManagers, 'om');
    people('wpSoc', wpL.allSoc, d.seniorOperationConsultants, 'soc');
    people('wpOd', wpL.allOd, d.operationDirectors, 'od');

    document.getElementById('wpNoActual').hidden = d.hasActual;
    wpRenderKpis(d);
    wpRenderInsights(d);
    wpRenderJobChart(d);
    wpRenderTrend(d);
    wpRenderPayroll(d);
    wpRenderStores();
    wpOpenStores.forEach(st => { if (d.byStore.some(r => r.name === st)) wpFetchStoreJobs(st); else wpOpenStores.delete(st); });
    wpRenderGroups();
    wpRenderRisk(d); // separate request: never delays the rest of the page
}

/* ── Staffing vs turnover map: one dot per store. Bottom-right of the red zone = short-staffed AND people leaving. ── */
let wpRiskChart;
async function wpRenderRisk(d) {
    const card = document.getElementById('wpRiskCard');
    card.hidden = true;
    if (!d.hasActual) return;
    const q = new URLSearchParams({ year: d.year, month: d.month });
    if (wpState.store) q.set('store', wpState.store);
    if (wpState.job) q.set('jobs', wpState.job);
    ['oc', 'om', 'soc', 'od'].forEach(k => { if (wpState[k]) q.set(k, wpState[k]); });
    let r;
    try { const res = await fetch('/api/workforce-planning/risk-map?' + q); if (!res.ok) return; r = await res.json(); } catch { return; }
    if (wpData !== d || !r.points.length) return; // a newer load replaced this one
    card.hidden = false;
    const danger = p => p.fillPercent < 95 && p.turnoverRate > r.avgTurnover;
    if (wpRiskChart) wpRiskChart.destroy();
    wpRiskChart = new Chart(document.getElementById('wpRiskChart'), {
        type: 'scatter',
        data: { datasets: [{
            data: r.points.map(p => ({ x: p.fillPercent, y: p.turnoverRate, p })),
            pointRadius: 6, pointHoverRadius: 8,
            backgroundColor: r.points.map(p => danger(p) ? 'oklch(0.6 0.22 22)' : 'oklch(0.62 0.15 155)'),
        }] },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                datalabels: { display: false },
                tooltip: { enabled: true, callbacks: {
                    title: items => items[0].raw.p.store,
                    label: c => { const p = c.raw.p; return [`${wpL.fill}: ${p.fillPercent}%`, `${wpL.riskY}: ${p.turnoverRate}%`, `${wpL.riskResign}: ${p.resignations}`, `${wpL.gap}: ${wpGapText(p.gap)}`]; },
                } },
            },
            scales: {
                x: { title: { display: true, text: wpL.riskX }, grid: { color: ctx => ctx.tick.value === 95 ? 'rgba(200,50,50,.6)' : 'rgba(128,128,128,.12)' } },
                y: { beginAtZero: true, title: { display: true, text: wpL.riskY }, grid: { color: ctx => ctx.tick.value === Math.round(r.avgTurnover) ? 'rgba(200,50,50,.6)' : 'rgba(128,128,128,.12)' } },
            },
        },
    });
    const n = r.points.filter(danger).length;
    document.getElementById('wpRiskNote').textContent = wpFmt(wpL.riskNote, n, r.avgTurnover);
}

/* ── Smart Insights: plain-language takeaways computed from the numbers on the page ── */
const wpFmt = (tpl, ...a) => String(tpl).replace(/\{(\d+)\}/g, (_, i) => a[i] ?? '');
const WP_INSIGHT_COLORS = {
    danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: 'oklch(0.6 0.22 22)', text: 'oklch(0.6 0.22 22)' },
    warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: 'oklch(0.75 0.16 75)', text: 'oklch(0.6 0.14 75)' },
    success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' },
    secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' },
};
const wpSigned = n => (n > 0 ? '+' : '') + n;

function wpRenderInsights(d) {
    const items = [];
    const k = d.kpis, has = d.hasActual;
    const add = (icon, color, title, description) => items.push({ icon, color, title, description });

    if (has && k.projected > 0) {
        const over = k.actual > k.projected;
        const tone = over ? 'secondary' : k.fillPercent >= 95 ? 'success' : k.fillPercent >= 85 ? 'warning' : 'danger';
        const title = over ? WP_I.OverallOver_T : k.fillPercent >= 95 ? WP_I.OverallOk_T : k.fillPercent >= 85 ? WP_I.OverallWatch_T : WP_I.OverallLow_T;
        add(tone === 'success' ? 'bi-check-circle-fill' : over ? 'bi-arrow-up-circle-fill' : 'bi-exclamation-triangle-fill', tone, title, wpFmt(WP_I.Overall_D, k.fillPercent, k.actual, k.projected, wpSigned(k.gap)));

        const stores = d.byStore.filter(r => r.projected > 0);
        const worst = [...stores].filter(r => r.gap < 0).sort((a, b) => a.fillPercent - b.fillPercent || a.gap - b.gap)[0];
        if (worst) add('bi-shop', worst.status === 'critical' ? 'danger' : 'warning', WP_I.WorstStore_T, wpFmt(WP_I.WorstStore_D, worst.name, worst.fillPercent, Math.abs(worst.gap)));

        const pg = [...wpPayrollRows(d)].filter(r => r.gap < 0 && r.projected > 0).sort((a, b) => a.fillPercent - b.fillPercent || a.gap - b.gap)[0];
        if (pg && pg.status !== 'ok') add('bi-wallet2', pg.status === 'critical' ? 'danger' : 'warning', WP_I.WorstPg_T, wpFmt(WP_I.WorstStore_D, pg.name, pg.fillPercent, Math.abs(pg.gap)));

        const critical = stores.filter(r => r.status === 'critical').length, watch = stores.filter(r => r.status === 'watch').length;
        if (critical + watch > 0) add('bi-graph-down-arrow', critical > 0 ? 'danger' : 'warning', WP_I.StoresBelow_T, wpFmt(WP_I.StoresBelow_D, critical, watch));
        else if (stores.length) add('bi-patch-check-fill', 'success', WP_I.StoresOk_T, WP_I.StoresOk_D);

        const job = [...d.byJob].filter(r => r.gap < 0).sort((a, b) => a.gap - b.gap)[0];
        if (job) add('bi-person-badge', 'warning', WP_I.WorstJob_T, wpFmt(WP_I.WorstJob_D, job.name, Math.abs(job.gap), job.fillPercent));

        if (k.hiringNeed > 0) add('bi-person-plus-fill', 'warning', WP_I.Hiring_T, wpFmt(WP_I.Hiring_D, k.hiringNeed, k.shortage, Math.round(k.expectedAttrition)));
        else add('bi-person-check-fill', 'success', WP_I.NoHiring_T, WP_I.NoHiring_D);

        const oc = [...(d.byOperationConsultant || [])].filter(r => r.gap < 0 && r.projected > 0).sort((a, b) => a.fillPercent - b.fillPercent)[0];
        if (oc && oc.status !== 'ok') add('bi-person-lines-fill', oc.status === 'critical' ? 'danger' : 'warning', WP_I.WorstOc_T, wpFmt(WP_I.WorstOc_D, oc.name, oc.storeCount, oc.fillPercent, Math.abs(oc.gap)));

        const overStores = stores.filter(r => r.status === 'over').length;
        if (overStores > 0) add('bi-arrow-up-circle-fill', 'secondary', WP_I.Surplus_T, wpFmt(WP_I.Surplus_D, overStores));
    }

    // Next month's plan against where the store base is now (works for future months too).
    const next = (d.trend || []).filter(t => t.month > d.month)[0];
    if (next) {
        const now = has ? k.actual : k.projected;
        const diff = next.projected - now;
        add('bi-calendar-event', diff > 0 ? 'warning' : 'secondary', WP_I.Outlook_T,
            wpFmt(WP_I.Outlook_D, wpMonthName(next.month) + ' ' + d.year, next.projected, wpSigned(diff)));
    }

    const el = document.getElementById('wpInsights');
    if (!items.length) { el.innerHTML = `<div class="text-muted" style="font-size:13px">${sapEscape(WP_I.NoData)}</div>`; return; }
    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = WP_INSIGHT_COLORS[item.color] || WP_INSIGHT_COLORS.secondary;
        return `<div class="col-md-6"><div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
            <div class="d-flex align-items-start gap-2"><i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
            <div><div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
            <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div></div></div></div></div>`;
    }).join('') + '</div>';
}

function wpRenderKpis(d) {
    const k = d.kpis, has = d.hasActual;
    const dash = '—';
    const gapColor = !has ? '' : k.gap < 0 ? 'text-danger' : '';
