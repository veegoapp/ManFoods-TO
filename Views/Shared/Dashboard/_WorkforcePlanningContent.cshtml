const wpTh = (key, label, cls) => `<th class="sortable px-3 py-2 ${cls || ''}" data-sort="${key}">${sapEscape(label)}<i class="bi"></i></th>`;

function wpBuildGroups() {
    const host = document.getElementById('wpGroups');
