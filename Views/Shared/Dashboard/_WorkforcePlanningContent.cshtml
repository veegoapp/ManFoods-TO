            new() { Icon = "bi-graph-up-arrow", Title = L["WP_ChartTrend"], Body = L["Guide_WP_Trend"] },
            new() { Icon = "bi-wallet2", Title = L["WP_ChartByPayroll"], Body = L["Guide_WP_Payroll"] },
            new() { Icon = "bi-shop", Title = L["WP_StoresTable"], Body = L["Guide_WP_Stores"] },
            new() { Icon = "bi-people", Title = L["Common_ByOcOm"], Body = L["Guide_WP_Groups"] },
