            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.projected}</td>
            <td class="px-3 py-2 text-center">${has ? r.actual : '—'}</td>
            <td class="px-3 py-2 text-center ${gapCls}">${gapTxt}</td>
            <td class="px-3 py-2 text-center">${has ? r.shortage : '—'}</td>
            <td class="px-3 py-2 text-center">${has ? Math.round(r.expectedAttrition) : '—'}</td>
            <td class="px-3 py-2 text-center">${has ? r.hiringNeed : '—'}</td>
            <td class="px-3 py-2" style="white-space:nowrap">${tube}</td>
