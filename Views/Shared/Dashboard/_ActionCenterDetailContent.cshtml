@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";

    // Localized label maps for the Store Health section, handed to JS as one
    // JSON object (System.Text.Json escapes non-ASCII to \uXXXX, which JS
    // decodes correctly inside <script>).
    var acdLabels = new Dictionary<string, object>
    {
        ["sev"] = new Dictionary<string, string>
        {
            ["Critical"] = L["ACH_Sev_Critical"].Value, ["High"] = L["ACH_Sev_High"].Value,
            ["Medium"] = L["ACH_Sev_Medium"].Value, ["Low"] = L["ACH_Sev_Low"].Value, ["Healthy"] = L["ACH_Sev_Healthy"].Value,
        },
        ["pillar"] = new Dictionary<string, string>
        {
            ["turnover"] = L["ACH_Pillar_turnover"].Value, ["early_attrition"] = L["ACH_Pillar_early_attrition"].Value,
            ["retention"] = L["ACH_Pillar_retention"].Value, ["engagement"] = L["ACH_Pillar_engagement"].Value,
            ["leadership"] = L["ACH_Pillar_leadership"].Value, ["workforce"] = L["ACH_Pillar_workforce"].Value,
        },
        ["pillarDesc"] = new Dictionary<string, string>
        {
            ["turnover"] = L["ACH_PillarDesc_turnover"].Value, ["early_attrition"] = L["ACH_PillarDesc_early_attrition"].Value,
            ["retention"] = L["ACH_PillarDesc_retention"].Value, ["engagement"] = L["ACH_PillarDesc_engagement"].Value,
            ["leadership"] = L["ACH_PillarDesc_leadership"].Value, ["workforce"] = L["ACH_PillarDesc_workforce"].Value,
        },
        ["driver"] = new Dictionary<string, string>
        {
            ["fair_treatment"] = L["ACH_Driver_fair_treatment"].Value, ["complaints_handling"] = L["ACH_Driver_complaints_handling"].Value,
            ["benefits_match"] = L["ACH_Driver_benefits_match"].Value, ["workload"] = L["ACH_Driver_workload"].Value,
            ["communication"] = L["ACH_Driver_communication"].Value, ["encourage_opinions"] = L["ACH_Driver_encourage_opinions"].Value,
            ["teamwork"] = L["ACH_Driver_teamwork"].Value, ["task_fit"] = L["ACH_Driver_task_fit"].Value,
            ["training"] = L["ACH_Driver_training"].Value, ["use_personal_abilities"] = L["ACH_Driver_use_personal_abilities"].Value,
        },
        ["action"] = new Dictionary<string, string>
        {
            ["Action_Turnover_StayInterviews"] = L["Action_Turnover_StayInterviews"].Value,
            ["Action_Turnover_Workload"] = L["Action_Turnover_Workload"].Value,
            ["Action_Early_Onboarding"] = L["Action_Early_Onboarding"].Value,
            ["Action_Early_Buddy"] = L["Action_Early_Buddy"].Value,
            ["Action_Retention_Growth"] = L["Action_Retention_Growth"].Value,
            ["Action_Engagement_Fairness"] = L["Action_Engagement_Fairness"].Value,
            ["Action_Engagement_Complaints"] = L["Action_Engagement_Complaints"].Value,
            ["Action_Engagement_Benefits"] = L["Action_Engagement_Benefits"].Value,
            ["Action_Engagement_Workload"] = L["Action_Engagement_Workload"].Value,
            ["Action_Engagement_Communication"] = L["Action_Engagement_Communication"].Value,
            ["Action_Engagement_Voice"] = L["Action_Engagement_Voice"].Value,
            ["Action_Engagement_Teamwork"] = L["Action_Engagement_Teamwork"].Value,
            ["Action_Engagement_TaskFit"] = L["Action_Engagement_TaskFit"].Value,
            ["Action_Engagement_Training"] = L["Action_Engagement_Training"].Value,
            ["Action_Engagement_Growth"] = L["Action_Engagement_Growth"].Value,
            ["Action_Engagement_Generic"] = L["Action_Engagement_Generic"].Value,
            ["Action_Leadership_Stability"] = L["Action_Leadership_Stability"].Value,
            ["Action_Workforce_Staffing"] = L["Action_Workforce_Staffing"].Value,
            ["Action_Workforce_AtRisk"] = L["Action_Workforce_AtRisk"].Value,
        },
        ["ui"] = new Dictionary<string, string>
        {
            ["healthTitle"] = L["ACH_HealthTitle"].Value,
            ["healthSub"] = L["ACH_HealthSub"].Value,
            ["pillarTitle"] = L["ACH_PillarBreakdownTitle"].Value,
            ["planTitle"] = L["ACH_WeightedPlanTitle"].Value,
            ["planSub"] = L["ACH_WeightedPlanSub"].Value,
            ["outlookTitle"] = L["ACH_OutlookTitle"].Value,
            ["current"] = L["ACH_OutlookCurrent"].Value,
            ["projected"] = L["ACH_OutlookProjected"].Value,
            ["plannedHires"] = L["ACH_OutlookPlannedHires"].Value,
            ["gap"] = L["ACH_OutlookGap"].Value,
            ["shortfall"] = L["ACH_OutlookShortfall"].Value,
            ["surplus"] = L["ACH_OutlookSurplus"].Value,
            ["balanced"] = L["ACH_OutlookBalanced"].Value,
            ["projectionPending"] = L["ACH_ProjectionPending"].Value,
            ["vs"] = L["ACH_Vs"].Value,
            ["weight"] = L["ACH_Weight"].Value,
            ["noActions"] = L["ACH_NoActions"].Value,
            ["priorityHigh"] = L["ACH_PriorityHigh"].Value,
            ["priorityMedium"] = L["ACH_PriorityMedium"].Value,
            ["priorityLow"] = L["ACH_PriorityLow"].Value,
            ["noDataPillar"] = L["ACH_PillarNoData"].Value,
        },
    };
}
<style>
.acd-back-btn { display:inline-flex; align-items:center; gap:6px; font-size:13.5px; font-weight:600; color:var(--text-2); text-decoration:none; margin-bottom:14px; }
.acd-back-btn:hover { color:var(--red); }
.acd-back-btn i { font-size:12px; }
[dir="rtl"] .acd-back-btn i { transform:scaleX(-1); }
.acd-kpi-label { font-size:11px; color:var(--text-3); }
.acd-kpi-value { font-size:22px; font-weight:700; margin-top:2px; }
.acd-kpi-delta { font-size:11.5px; margin-top:2px; font-weight:600; }
.acd-meta-label { font-size:11px; color:var(--text-3); }
.acd-rec-item { display:flex; align-items:flex-start; gap:10px; border-left:3px solid var(--red); padding:10px 12px; background:var(--card-bg-2); border-radius:8px; }
.acd-rec-item.acd-rec-done { border-left-color:oklch(0.62 0.15 155); opacity:0.7; }
.acd-rec-category { font-size:10.5px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; font-weight:700; }
.acd-rec-text.done { text-decoration:line-through; color:var(--text-3); }
.acd-note-item { border-bottom:1px solid var(--card-border); padding-bottom:10px; }
.acd-badge { padding:3px 9px; border-radius:20px; font-size:11px; font-weight:700; display:inline-block; }
.acd-monthly-turnover-table { width:100%; table-layout:fixed; direction:ltr; }
.acd-monthly-turnover-table th,
.acd-monthly-turnover-table td { vertical-align:middle; text-align:left; }
.acd-monthly-turnover-table th { white-space:normal; line-height:1.3; }
.acd-monthly-turnover-table td { white-space:nowrap; }
.acd-monthly-turnover-table th:nth-child(1),
.acd-monthly-turnover-table td:nth-child(1) { width:12%; }
.acd-monthly-turnover-table th:nth-child(2),
.acd-monthly-turnover-table td:nth-child(2),
.acd-monthly-turnover-table th:nth-child(3),
.acd-monthly-turnover-table td:nth-child(3) { width:15%; }
.acd-monthly-turnover-table th:nth-child(4),
.acd-monthly-turnover-table td:nth-child(4),
.acd-monthly-turnover-table th:nth-child(5),
.acd-monthly-turnover-table td:nth-child(5) { width:29%; }
.chart-body canvas { direction:ltr; }
.acd-check { width:18px; height:18px; cursor:pointer; accent-color:oklch(0.5 0.15 155); margin-top:2px; flex-shrink:0; }

/* ── Store Health section ─────────────────────────────────────────────── */
.ach-hero { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
.ach-hero-ring { width:88px; height:88px; flex-shrink:0; }
.ach-hero-score { font-size:30px; font-weight:800; line-height:1; }
.ach-hero-unit { font-size:12px; color:var(--text-3); }
.ach-pillar-row { display:grid; grid-template-columns:minmax(150px,1.3fr) 2fr auto; gap:12px; align-items:center; padding:10px 0; border-bottom:1px solid var(--card-border); }
.ach-pillar-row:last-child { border-bottom:none; }
.ach-pillar-name { font-weight:700; font-size:13px; }
.ach-pillar-desc { font-size:11px; color:var(--text-3); margin-top:1px; }
.ach-pillar-bar { height:8px; border-radius:20px; background:var(--card-bg-2); overflow:hidden; }
.ach-pillar-fill { height:100%; border-radius:20px; }
.ach-pillar-ev { font-size:11px; color:var(--text-2); margin-top:4px; font-variant-numeric:tabular-nums; }
.ach-chips { display:flex; gap:3px; margin-top:5px; }
.ach-chip { width:20px; height:6px; border-radius:2px; background:var(--card-bg-2); }
.ach-driver-tag { display:inline-block; font-size:10.5px; padding:2px 8px; border-radius:20px; background:oklch(0.6 0.22 22 / .1); color:var(--text-2); margin:3px 4px 0 0; }
.ach-act { display:flex; align-items:flex-start; gap:10px; padding:11px 13px; background:var(--card-bg-2); border-radius:8px; border-left:3px solid var(--red); }
.ach-act.done { opacity:0.65; border-left-color:oklch(0.62 0.15 155); }
.ach-act-pri { font-size:9.5px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; padding:2px 7px; border-radius:5px; white-space:nowrap; }
.ach-act-weight { font-size:11px; color:var(--text-3); font-variant-numeric:tabular-nums; }
.ach-out-grid { display:flex; gap:22px; flex-wrap:wrap; align-items:flex-end; }
.ach-out-num { font-size:24px; font-weight:800; line-height:1; }
.ach-out-lbl { font-size:11px; color:var(--text-3); margin-top:3px; }
</style>

