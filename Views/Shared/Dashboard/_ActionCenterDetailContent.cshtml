<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/store-action-plan.js" asp-append-version="true"></script>
<script>
const acdContentEl = document.getElementById('acdContent');
const ACD_D = acdContentEl.dataset;
const AC_L = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(acdLabels));
const AC_PILLARS = ['turnover','early_attrition','retention','engagement','leadership','workforce'];

function achLabel(map, key) { return (AC_L[map] && AC_L[map][key]) || key; }
function achSevColor(sev) {
    switch (sev) {
        case 'Critical': return { c: ChartColors.SEMANTIC.BAD, bg:'oklch(0.6 0.22 22 / .12)' };
        case 'High':     return { c:'oklch(0.62 0.19 45)', bg:'oklch(0.7 0.19 45 / .14)' };
        case 'Medium':   return { c:'oklch(0.6 0.14 75)', bg:'oklch(0.75 0.16 75 / .14)' };
        case 'Low':      return { c:'oklch(0.58 0.09 90)', bg:'oklch(0.8 0.09 90 / .18)' };
        default:         return { c:'oklch(0.5 0.15 155)', bg:'oklch(0.62 0.15 155 / .12)' };
    }
}
function achStatusColor(status) { return achSevColor(status === 'healthy' || status === 'no_data' ? 'Healthy' : status).c; }
function achRing(score, color, cls) {
    const r = 15, c = 2 * Math.PI * r, off = c * (1 - Math.max(0, Math.min(100, score)) / 100);
    return `<svg class="${cls}" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="${r}" fill="none" stroke="var(--card-bg-2)" stroke-width="5"/>
        <circle cx="20" cy="20" r="${r}" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round"
                stroke-dasharray="${c.toFixed(1)}" stroke-dashoffset="${off.toFixed(1)}" transform="rotate(-90 20 20)"/></svg>`;
}

/// Store Health analytical section — score hero, weighted pillar breakdown
/// (with evidence + engagement drivers), ranked weighted action plan, and the
/// forward workforce outlook. Fed by /action-center/health/detail; rendered
/// above the existing plan-lifecycle sections without altering them.
function acdHealthHtml(detail) {
    if (!detail || !detail.health) return '';
    const u = AC_L.ui, h = detail.health;
    const sev = achSevColor(h.severity);

    // Hero
    let html = `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-1">${sapEscape(u.healthTitle)}</h6>
        <p class="text-muted-custom mb-3" style="font-size:12px">${sapEscape(u.healthSub)}</p>
        <div class="ach-hero">
            <div style="position:relative;display:inline-grid;place-items:center">
                ${achRing(h.healthScore, sev.c, 'ach-hero-ring')}
                <div style="position:absolute;text-align:center"><div class="ach-hero-score" style="color:${sev.c}">${h.healthScore}</div><div class="ach-hero-unit">/100</div></div>
            </div>
            <div>
                <span class="acd-badge" style="background:${sev.bg};color:${sev.c};font-size:12px">${sapEscape(achLabel('sev', h.severity))}</span>
                <div style="margin-top:8px;font-size:12.5px;color:var(--text-2)">${sapEscape(u.healthSub)}</div>
            </div>
        </div>`;

    // Pillar breakdown
    const byKey = {}; (h.pillars || []).forEach(p => byKey[p.key] = p);
    html += `<div class="mt-4"><div class="acd-meta-label mb-2" style="font-weight:700;text-transform:uppercase;letter-spacing:.5px">${sapEscape(u.pillarTitle)}</div>`;
    html += AC_PILLARS.map(k => {
        const p = byKey[k];
        const name = achLabel('pillar', k), desc = achLabel('pillarDesc', k);
        if (!p || !p.hasData) {
            return `<div class="ach-pillar-row">
                <div><div class="ach-pillar-name">${sapEscape(name)}</div><div class="ach-pillar-desc">${sapEscape(desc)}</div></div>
                <div style="font-size:12px;color:var(--text-3)">${sapEscape(u.noDataPillar)}</div><div></div></div>`;
        }
        const col = achStatusColor(p.status);
        const chips = [1,2,3].map(i => `<span class="ach-chip" style="${p.points >= i ? 'background:' + col : ''}"></span>`).join('');
        let ev = '';
        if (p.evidence && (p.evidence.value !== undefined)) ev = `${p.evidence.value}% ${sapEscape(u.vs)} ${p.evidence.baseline}%`;
        else if (p.evidence && p.evidence.leaders !== undefined) ev = `${p.evidence.leaders} / ${p.evidence.months}m`;
        else if (p.evidence && p.evidence.gap !== undefined) ev = `${p.evidence.gap} (${p.evidence.gapPct}%)`;
        else if (p.evidence && p.evidence.atRisk !== undefined) ev = `${p.evidence.atRisk}`;
        const drivers = (p.drivers && p.drivers.length)
            ? `<div>${p.drivers.slice(0,4).map(dr => `<span class="ach-driver-tag">${sapEscape(achLabel('driver', dr.key))} · ${dr.negativePercent}%</span>`).join('')}</div>` : '';
        return `<div class="ach-pillar-row">
            <div><div class="ach-pillar-name">${sapEscape(name)}</div><div class="ach-pillar-desc">${sapEscape(desc)}</div><div class="ach-chips">${chips}</div></div>
            <div><div class="ach-pillar-bar"><div class="ach-pillar-fill" style="width:${Math.round(p.subScore)}%;background:${col}"></div></div>
                ${ev ? `<div class="ach-pillar-ev">${sapEscape(ev)}</div>` : ''}${drivers}</div>
            <div style="text-align:right;font-weight:800;color:${col};font-size:15px">${Math.round(p.subScore)}</div>
        </div>`;
    }).join('');
    html += `</div></div>`;

    // Weighted action plan
    const acts = detail.actions || [];
    const priLabel = { high: u.priorityHigh, medium: u.priorityMedium, low: u.priorityLow };
    html += `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-1">${sapEscape(u.planTitle)}</h6>
        <p class="text-muted-custom mb-3" style="font-size:12px">${sapEscape(u.planSub)}</p>`;
    if (!acts.length) {
        html += `<p class="text-muted-custom mb-0">${sapEscape(u.noActions)}</p>`;
    } else {
        html += `<div class="d-flex flex-column gap-2">` + acts.map(a => {
            const pc = achSevColor(a.priority === 'high' ? 'Critical' : a.priority === 'medium' ? 'Medium' : 'Low');
            const label = a.actionKey ? achLabel('action', a.actionKey) : (a.text || '');
            const toggle = a.recommendationId
                ? `<input type="checkbox" class="acd-check" ${a.isCompleted ? 'checked' : ''} onchange="acdToggleRec(${a.recommendationId}, this.checked)">`
                : `<i class="bi bi-dot" style="font-size:20px;color:${pc.c};margin:-4px -4px 0 -4px"></i>`;
            return `<div class="ach-act${a.isCompleted ? ' done' : ''}">
                ${toggle}
                <div style="flex:1">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <span class="ach-act-pri" style="background:${pc.bg};color:${pc.c}">${sapEscape(priLabel[a.priority] || a.priority)}</span>
                        <span style="font-size:11px;color:var(--text-3)">${sapEscape(achLabel('pillar', a.pillarKey))}</span>
                        ${a.evidence ? `<span class="ach-act-weight">· ${sapEscape(a.evidence)}</span>` : ''}
                    </div>
                    <div style="font-size:13.5px${a.isCompleted ? ';text-decoration:line-through;color:var(--text-3)' : ''}">${sapEscape(label)}</div>
                </div>
                <div class="ach-act-weight" title="${sapEscape(u.weight)}">${Math.round(a.weight)}</div>
            </div>`;
        }).join('') + `</div>`;
    }
    html += `</div>`;

    // Workforce outlook
    const o = detail.outlook;
    html += `<div class="card-dark mb-4"><h6 class="fw-bold mb-3">${sapEscape(u.outlookTitle)}</h6>`;
    if (!o || !o.hasData) {
        html += `<p class="text-muted-custom mb-0"><i class="bi bi-info-circle me-1"></i>${sapEscape(u.projectionPending)}</p>`;
    } else {
        const gapColor = o.gap > 0 ? ChartColors.SEMANTIC.BAD : o.gap < 0 ? 'oklch(0.6 0.14 75)' : 'oklch(0.5 0.15 155)';
        const gapWord = o.gap > 0 ? u.shortfall : o.gap < 0 ? u.surplus : u.balanced;
        html += `<div class="ach-out-grid">
            <div><div class="ach-out-num">${o.currentHeadcount}</div><div class="ach-out-lbl">${sapEscape(u.current)}</div></div>
            <div style="color:var(--text-3);font-size:20px;padding-bottom:6px">→</div>
            <div><div class="ach-out-num">${o.projectedHeadcount}</div><div class="ach-out-lbl">${sapEscape(u.projected)} · ${sapEscape(o.label)}</div></div>
            <div><div class="ach-out-num" style="color:${gapColor}">${o.gap > 0 ? '+' : ''}${o.gap}</div><div class="ach-out-lbl">${sapEscape(u.gap)} — ${sapEscape(gapWord)}${o.gap !== 0 ? ` (${Math.abs(o.gapPercent)}%)` : ''}</div></div>
            ${o.plannedHires ? `<div><div class="ach-out-num" style="color:oklch(0.5 0.15 155)">${o.plannedHires}</div><div class="ach-out-lbl">${sapEscape(u.plannedHires)}</div></div>` : ''}
        </div>`;
    }
    html += `</div>`;
    return html;
}

function sapAntiForgeryToken() {
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
const ACD_SEVERITY_META = {
    Critical: { label: ACD_D.severityCritical, bg: 'oklch(0.6 0.22 22 / .12)', color: ChartColors.SEMANTIC.BAD },
    High:     { label: ACD_D.severityHigh,     bg: 'oklch(0.7 0.19 45 / .14)', color: 'oklch(0.6 0.19 45)' },
    Medium:   { label: ACD_D.severityMedium,   bg: 'oklch(0.75 0.16 75 / .14)', color: 'oklch(0.6 0.14 75)' },
    Low:      { label: ACD_D.severityLow,      bg: 'var(--card-bg-2)', color: 'var(--text-2)' },
    None:     { label: ACD_D.severityNone,     bg: 'oklch(0.62 0.15 155 / .12)', color: 'oklch(0.5 0.15 155)' },
};
const ACD_TARGET_WINDOW_LABEL = {
    Critical: ACD_D.targetWindowCritical,
    Standard: ACD_D.targetWindowStandard,
    Custom:   ACD_D.targetWindowCustom,
};
// data-signal-name-* attribute names are the signal code lowercased with
// underscores stripped (see the data attributes on #acdContent above).
const SIGNAL_NAME_MAP = {
    HIGH_OVERALL_TURNOVER:   ACD_D.signalNameHighoverallturnover,
    EARLY_TURNOVER_90D:      ACD_D.signalNameEarlyturnover90d,
    LOW_RETENTION_6M:        ACD_D.signalNameLowretention6m,
    LEADERSHIP_INSTABILITY:  ACD_D.signalNameLeadershipinstability,
    LOW_EXIT_SENTIMENT:      ACD_D.signalNameLowexitsentiment,
    REASON_CONCENTRATION:    ACD_D.signalNameReasonconcentration,
    EARLY_WARNING_WATCHLIST: ACD_D.signalNameEarlywarningwatchlist,
    NO_DOMINANT_DRIVER:      ACD_D.signalNameNodominantdriver,
};
function acdSignalName(code) { return SIGNAL_NAME_MAP[code] || code; }

function acdFmtDate(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}
function acdDateInputValue(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toISOString().slice(0, 10);
}
function acdRate(v) { return (v === null || v === undefined) ? '—' : Number(v).toFixed(1) + '%'; }
function acdCurrentStore() { return new URLSearchParams(window.location.search).get('store'); }

let acdTrendChartInst = null;
function acdRenderTrendChart(snapshots) {
    const canvas = document.getElementById('acdTrendChart');
    if (!canvas) return;
    if (acdTrendChartInst) acdTrendChartInst.destroy();
    acdTrendChartInst = new Chart(canvas, {
        type: 'line',
        data: {
            labels: snapshots.map(s => s.label),
            datasets: [
                { label: ACD_D.chartTurnover, data: snapshots.map(s => s.turnoverRate), borderColor: ChartColors.SEMANTIC.BAD, backgroundColor: 'transparent', tension: 0.3, pointRadius: 3, spanGaps: true },
                { label: ACD_D.chartEarlyLeaver, data: snapshots.map(s => s.earlyLeaverRate), borderColor: ChartColors.SEMANTIC.WARNING, backgroundColor: 'transparent', tension: 0.3, pointRadius: 3, spanGaps: true },
                { label: ACD_D.chartSignals, data: snapshots.map(s => s.signalCount), borderColor: 'var(--text-3)', backgroundColor: 'transparent', tension: 0.3, pointRadius: 3, yAxisID: 'y1', borderDash: [4, 3] },
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: true, position: 'bottom' }, datalabels: { display: false } },
            scales: {
                y:  { beginAtZero: true, position: 'left', title: { display: true, text: '%' } },
                y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 0 }, title: { display: true, text: ACD_D.chartSignalsAxis } },
            }
        }
    });
}

/// Renders the Monthly Turnover Performance table from a MonthlyTurnoverHistoryDto
/// (or null if it couldn't be loaded — the section is simply omitted). Periods
/// are sorted oldest-first for display so January is the first row; the
/// month-over-month change is a plain percentage-point subtraction against the
/// chronologically previous row, same style as the existing Monthly
/// Performance table below it — no new calculation rule.
function acdMonthlyTurnoverHtml(history) {
    const d = ACD_D;
    if (!history) return '';

    const periods = [...(history.periods || [])].sort((a, b) =>
        (a.year * 12 + a.month) - (b.year * 12 + b.month));
    if (periods.length === 0) {
        return `<div class="card-dark mb-4">
            <h6 class="fw-bold mb-3">${sapEscape(d.monthlyTurnoverTitle)}</h6>
            <p class="text-muted-custom mb-0">${sapEscape(d.monthlyTurnoverEmpty)}</p>
        </div>`;
    }

    function ppChange(cur, prev) {
        if (cur === null || cur === undefined || prev === null || prev === undefined) return '—';
        const delta = cur - prev;
        if (Math.abs(delta) < 0.05) return `<span style="color:var(--text-3)">— ${sapEscape(d.noChange)}</span>`;
        const improving = delta < 0;
        return `<span style="color:${improving ? 'oklch(0.5 0.15 155)' : ChartColors.SEMANTIC.BAD}"><i class="bi ${improving ? 'bi-arrow-down-right' : 'bi-arrow-up-right'}"></i> ${delta > 0 ? '+' : ''}${delta.toFixed(1)}pp</span>`;
    }

    const rows = periods.map((p, i) => {
        const prev = i > 0 ? periods[i - 1] : null;
        return `<tr>
            <td style="white-space:nowrap;font-weight:600;font-size:12.5px">${sapEscape(p.label)}</td>
            <td>${acdRate(p.overallTurnoverRate)}</td>
            <td>${acdRate(p.ninetyDayTurnoverRate)}</td>
            <td>${prev ? ppChange(p.overallTurnoverRate, prev.overallTurnoverRate) : '—'}</td>
            <td>${prev ? ppChange(p.ninetyDayTurnoverRate, prev.ninetyDayTurnoverRate) : '—'}</td>
        </tr>`;
    }).join('');

    return `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-3">${sapEscape(d.monthlyTurnoverTitle)}</h6>
        <div style="overflow-x:auto">
            <table class="table acd-monthly-turnover-table" style="margin-bottom:0">
                <thead>
                    <tr>
                        <th scope="col">${sapEscape(d.commonMonth)}</th>
                        <th scope="col">${sapEscape(d.monthlyTurnoverOverall)}</th>
                        <th scope="col">${sapEscape(d.monthlyTurnoverNinetyDay)}</th>
                        <th scope="col">${sapEscape(d.monthlyTurnoverOverallChange)}</th>
                        <th scope="col">${sapEscape(d.monthlyTurnoverNinetyDayChange)}</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        </div>
    </div>`;
}

/// Renders the Monthly Performance table straight from data.metricSnapshots —
/// no new data source, no business logic. Snapshots arrive oldest-first (same
/// order the trend chart already uses); this renders newest-first for at-a-
/// glance recency, computing each row's "change vs previous month" from the
/// chronological (oldest-first) order before reversing for display.
function acdMonthlyPerformanceHtml(snaps) {
    const d = ACD_D;

    if (!snaps || snaps.length === 0) {
        return `<div class="card-dark mb-4">
            <h6 class="fw-bold mb-3">${sapEscape(d.monthlyPerfTitle)}</h6>
            <p class="text-muted-custom mb-0">${sapEscape(d.monthlyPerfEmpty)}</p>
        </div>`;
    }

    const rows = snaps.map((s, i) => {
        const prev = i > 0 ? snaps[i - 1] : null;
        let changeCell = '—';
        if (prev && s.turnoverRate !== null && s.turnoverRate !== undefined &&
            prev.turnoverRate !== null && prev.turnoverRate !== undefined) {
            const delta = s.turnoverRate - prev.turnoverRate;
            if (Math.abs(delta) < 0.05) {
                changeCell = `<span style="color:var(--text-3)">— ${sapEscape(d.noChange)}</span>`;
            } else {
                const improving = delta < 0;
                changeCell = `<span style="color:${improving ? 'oklch(0.5 0.15 155)' : ChartColors.SEMANTIC.BAD}"><i class="bi ${improving ? 'bi-arrow-down-right' : 'bi-arrow-up-right'}"></i> ${delta > 0 ? '+' : ''}${delta.toFixed(1)}pt</span>`;
            }
        }
        return { html: `<tr>
            <td style="white-space:nowrap;font-weight:600;font-size:12.5px">${sapEscape(s.label)}</td>
            <td>${acdRate(s.turnoverRate)}</td>
            <td>${acdRate(s.earlyLeaverRate)}</td>
            <td>${acdRate(s.retentionRate)}</td>
            <td>${s.signalCount ?? '—'}</td>
            <td>${changeCell}</td>
        </tr>` };
    }).reverse().map(r => r.html).join('');

    return `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-3">${sapEscape(d.monthlyPerfTitle)}</h6>
        <div style="overflow-x:auto">
            <table class="table" style="margin-bottom:0">
                <thead>
                    <tr>
                        <th>${sapEscape(d.commonMonth)}</th>
                        <th>${sapEscape(d.monthlyPerfTurnover)}</th>
                        <th>${sapEscape(d.monthlyPerfEarlyLeaver)}</th>
                        <th>${sapEscape(d.monthlyPerfRetention)}</th>
                        <th>${sapEscape(d.monthlyPerfSignalCount)}</th>
                        <th>${sapEscape(d.monthlyPerfChange)}</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        </div>
    </div>`;
}

/// Renders the Signal History card from a SignalHistoryDto (or null if it
/// couldn't be loaded — the section is simply omitted, never shown broken).
function acdSignalHistoryHtml(history) {
    const d = ACD_D;
    if (!history) return '';

    const persistentCodes = new Set((history.persistence || []).filter(p => p.isPersistent).map(p => p.signalCode));

    let rows;
    if (!history.periods || history.periods.length === 0) {
        rows = `<tr><td colspan="2" class="text-center py-3 text-muted-custom">${sapEscape(d.signalHistoryEmpty)}</td></tr>`;
    } else {
        rows = history.periods.map(p => {
            let cell;
            if (!p.hasData) {
                cell = `<span class="acd-badge" style="background:var(--card-bg-2);color:var(--text-3)">${sapEscape(d.signalHistoryNoData)}</span>`;
            } else if (!p.signals || p.signals.length === 0) {
                cell = `<span style="color:var(--text-3);font-size:12.5px">${sapEscape(d.signalHistoryClean)}</span>`;
            } else {
                cell = p.signals.map(code => {
                    const isPersistent = persistentCodes.has(code);
                    return `<span class="acd-badge" style="background:${isPersistent ? 'oklch(0.6 0.22 22 / .12)' : 'var(--card-bg-2)'};color:${isPersistent ? ChartColors.SEMANTIC.BAD : 'var(--text-2)'};margin:2px 4px 2px 0" title="${isPersistent ? sapEscape(d.signalHistoryPersistent) : ''}">${sapEscape(acdSignalName(code))}${isPersistent ? ' ★' : ''}</span>`;
                }).join('');
            }
            return `<tr><td style="white-space:nowrap;font-weight:600;font-size:12.5px">${sapEscape(p.label)}</td><td>${cell}</td></tr>`;
        }).join('');
    }

    return `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-1">${sapEscape(d.signalHistoryTitle)}</h6>
        <p class="text-muted-custom mb-3" style="font-size:12px">${sapEscape(d.signalHistoryDesc)}</p>
        <div style="overflow-x:auto">
            <table class="table" style="margin-bottom:0">
                <tbody>${rows}</tbody>
            </table>
        </div>
    </div>`;
}

function acdRender(data, signalHistory, monthlyTurnoverHistory, health) {
    const d = ACD_D;

    document.getElementById('acdStoreName').textContent = data.storeName;
    document.title = data.storeName + ' — ' + ACD_D.brandHub;

    const statusMeta = sapStatusMeta(data.status, { active: d.statusActive, resolved: d.statusResolved, none: d.statusNone });
    const sevMeta = ACD_SEVERITY_META[data.severity] || ACD_SEVERITY_META.None;

    let badges = `<span class="acd-badge" style="background:${SAP_TONE_BG[statusMeta.tone]};color:${SAP_TONE_VAR[statusMeta.tone]}">${sapEscape(statusMeta.label)}</span>`;
    if (data.status === 'Active') badges += ` <span class="acd-badge" style="background:${sevMeta.bg};color:${sevMeta.color}">${sapEscape(sevMeta.label)}</span>`;
    if (data.isChronic) badges += ` <span class="acd-badge" style="background:oklch(0.75 0.16 75 / .14);color:oklch(0.6 0.14 75)">${sapEscape(d.chronic)}</span>`;
    if (data.isStalled) badges += ` <span class="acd-badge" style="background:oklch(0.6 0.22 22 / .12);color:${ChartColors.SEMANTIC.BAD}">${sapEscape(d.stalled)}</span>`;
    document.getElementById('acdSubtitle').innerHTML = badges;

    const resp = data.responsibleParty;
    const respHtml = resp && resp.name
        ? `${sapEscape(resp.name)}${resp.role ? ` <span style="color:var(--text-3)">(${sapEscape(resp.role.replace('_', ' '))})</span>` : ''}`
        : '—';

    // Small note under the Target Resolution Date saying which window it
    // reflects (Critical/Standard/Custom) — derived server-side purely from
    // comparing the date against when the plan opened; doesn't change the
    // date itself.
    function acdTargetWindowBadge(d2) {
        if (!d2.targetWindowType) return '';
        const label = ACD_TARGET_WINDOW_LABEL[d2.targetWindowType] || d2.targetWindowType;
        return `<div style="font-size:11px;color:var(--text-3);margin-top:4px">${sapEscape(label)}</div>`;
    }

    if (data.status === 'None') {
        // No active/historical plan — still surface the live health analysis so
        // an at-risk store that hasn't yet tripped plan detection is not blank.
        const healthSection = acdHealthHtml(health);
        acdContentEl.innerHTML = (healthSection || '') +
            `<div class="card-dark empty-state"><i class="bi bi-clipboard-check"></i><p>${sapEscape(d.noIssues)}</p></div>`;
        return;
    }

    let html = '';

    // ── Store Health analysis (score, weighted pillars, action plan, outlook) ──
    html += acdHealthHtml(health);

    // ── KPI cards: baseline vs. latest snapshot ──
    const snaps = data.metricSnapshots || [];
    const latest = snaps.length ? snaps[snaps.length - 1] : null;
    // higherIsBetter: true for Retention Rate (up = improving), false for
    // Turnover/Early-Leaver Rate (down = improving) — a rising retention
    // rate must never be flagged red just because it went up.
    function deltaHtml(base, cur, higherIsBetter) {
        if (base === null || base === undefined || cur === null || cur === undefined) return '';
        const delta = cur - base;
        if (Math.abs(delta) < 0.05) return `<div class="acd-kpi-delta" style="color:var(--text-3)">— ${sapEscape(d.noChange)}</div>`;
        const improving = higherIsBetter ? delta > 0 : delta < 0;
        const arrowUp = delta > 0;
        return `<div class="acd-kpi-delta" style="color:${improving ? 'oklch(0.5 0.15 155)' : ChartColors.SEMANTIC.BAD}"><i class="bi ${arrowUp ? 'bi-arrow-up-right' : 'bi-arrow-down-right'}"></i> ${delta > 0 ? '+' : ''}${delta.toFixed(1)}pt</div>`;
    }
    html += `<div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="card-dark">
            <div class="acd-kpi-label">${sapEscape(d.kpiTurnover)}</div>
            <div class="acd-kpi-value">${acdRate(latest ? latest.turnoverRate : data.baselineTurnoverRate)}</div>
            ${latest ? deltaHtml(data.baselineTurnoverRate, latest.turnoverRate) : ''}
        </div></div>
        <div class="col-sm-4"><div class="card-dark">
            <div class="acd-kpi-label">${sapEscape(d.kpiEarlyLeaver)}</div>
            <div class="acd-kpi-value">${acdRate(latest ? latest.earlyLeaverRate : data.baselineEarlyLeaverRate)}</div>
            ${latest ? deltaHtml(data.baselineEarlyLeaverRate, latest.earlyLeaverRate) : ''}
        </div></div>
        <div class="col-sm-4"><div class="card-dark">
            <div class="acd-kpi-label">${sapEscape(d.kpiRetention)}</div>
            <div class="acd-kpi-value">${acdRate(latest ? latest.retentionRate : data.baselineRetentionRate)}</div>
            ${latest ? deltaHtml(data.baselineRetentionRate, latest.retentionRate, true) : ''}
        </div></div>
    </div>`;

    if (snaps.length >= 2) {
        html += `<div class="chart-card mb-4">
            <div class="chart-header"><h6>${sapEscape(d.trendTitle)}</h6></div>
            <div class="chart-body" style="height:260px"><canvas id="acdTrendChart"></canvas></div>
        </div>`;
    }

    // ── Monthly Turnover Performance table — Overall/90-Day Turnover % per
    // month straight from the same DashboardService/NinetyDayTurnoverService
    // calls used for live signal detection. Shown above Monthly Performance. ──
    html += acdMonthlyTurnoverHtml(monthlyTurnoverHistory);

    // ── Monthly Performance table — same data.metricSnapshots the KPI cards
    // and trend chart above already use, just laid out as one row per month. ──
    html += acdMonthlyPerformanceHtml(snaps);

    // ── Meta card ──
    html += `<div class="card-dark mb-4">
        <div class="d-flex flex-wrap gap-4 mb-3">
            <div><div class="acd-meta-label">${sapEscape(d.metaResponsible)}</div><div class="fw-semibold mt-1">${respHtml}</div></div>
            <div><div class="acd-meta-label">${sapEscape(d.metaCreated)}</div><div class="fw-semibold mt-1">${acdFmtDate(data.createdAt)}</div></div>
            ${data.status === 'Resolved' ? `<div><div class="acd-meta-label">${sapEscape(d.metaResolved)}</div><div class="fw-semibold mt-1">${acdFmtDate(data.resolvedAt)}</div></div>` : ''}
            <div><div class="acd-meta-label">${sapEscape(d.reportingQuarter)}</div><div class="fw-semibold mt-1">Q${data.reportingQuarter} ${data.reportingYear}</div></div>
            <div><div class="acd-meta-label">${sapEscape(d.metaHealthyStreak)}</div><div class="fw-semibold mt-1">${data.healthyStreakCount} ${sapEscape(d.healthyStreakSuffix)}</div></div>
            ${data.isChronic ? `<div><div class="acd-meta-label">${sapEscape(d.chronic)}</div><div class="fw-semibold mt-1">${data.historicalPlanCount} ${sapEscape(d.plansOverTime)}</div></div>` : ''}
        </div>
        <div class="acd-meta-label mb-1">${sapEscape(d.detectedIssues)}</div>
        <div style="white-space:pre-line;font-size:13.5px;color:var(--text-2)">${sapEscape(data.detectedIssuesSummary) || '—'}</div>
        ${data.status === 'Resolved' && data.closedByName ? `<div class="mt-3 pt-3" style="border-top:1px solid var(--card-border)">
            <div class="acd-meta-label mb-1">${sapEscape(d.closedBy)}</div>
            <div class="fw-semibold" style="font-size:13.5px">${sapEscape(data.closedByName)}</div>
            ${data.manualCloseReason ? `<div class="acd-meta-label mt-2 mb-1">${sapEscape(d.closedReason)}</div><div style="font-size:13.5px;color:var(--text-2)">${sapEscape(data.manualCloseReason)}</div>` : ''}
        </div>` : ''}
    </div>`;

    // ── Assignment panel (Admin only, active plans) ──
    if (data.canManage && data.status === 'Active') {
        html += `<div class="card-dark mb-4">
            <h6 class="fw-bold mb-3">${sapEscape(d.assignmentTitle)}</h6>
            <div class="row g-3 align-items-end">
                <div class="col-sm-5">
                    <label class="acd-meta-label d-block mb-1">${sapEscape(d.assignedTo)}</label>
                    <input type="text" id="acdAssignedName" class="form-control form-control-dark" value="${data.assignedToName ? sapEscape(data.assignedToName) : ''}">
                </div>
                <div class="col-sm-4">
                    <label class="acd-meta-label d-block mb-1">${sapEscape(d.targetDate)}</label>
                    <input type="date" id="acdTargetDate" class="form-control form-control-dark" value="${acdDateInputValue(data.targetResolutionDate)}">
                    ${acdTargetWindowBadge(data)}
                </div>
                <div class="col-sm-3">
                    <button class="btn-primary w-100" id="acdSaveAssignBtn" type="button" onclick="acdSaveAssignment()"><i class="bi bi-check-lg me-1"></i>${sapEscape(d.save)}</button>
                </div>
            </div>
            <div id="acdAssignMsg" class="small mt-2" style="display:none"></div>
        </div>`;
    } else if (data.assignedToName || data.targetResolutionDate) {
        html += `<div class="card-dark mb-4">
            <h6 class="fw-bold mb-3">${sapEscape(d.assignmentTitle)}</h6>
            <div class="d-flex flex-wrap gap-4">
                <div><div class="acd-meta-label">${sapEscape(d.assignedTo)}</div><div class="fw-semibold mt-1">${data.assignedToName ? sapEscape(data.assignedToName) : '—'}</div></div>
                <div><div class="acd-meta-label">${sapEscape(d.targetDate)}</div><div class="fw-semibold mt-1">${acdFmtDate(data.targetResolutionDate)}</div>${acdTargetWindowBadge(data)}</div>
            </div>
        </div>`;
    }

    // ── Recommendations checklist ──
    const recs = data.recommendations || [];
    const completed = recs.filter(r => r.isCompleted).length;
    const pct = recs.length > 0 ? Math.round(completed / recs.length * 100) : 0;
    html += `<div class="card-dark mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h6 class="fw-bold mb-0">${sapEscape(d.recommendations)}</h6>
            ${recs.length ? `<span style="font-size:12px;color:var(--text-3)">${completed}/${recs.length} (${pct}%)</span>` : ''}
        </div>
        ${recs.length === 0 ? `<p class="text-muted-custom mb-0">${sapEscape(d.noRecommendations)}</p>` : `
        <div class="d-flex flex-column gap-2" id="acdRecList">
            ${recs.map(r => `
                <div class="acd-rec-item${r.isCompleted ? ' acd-rec-done' : ''}" data-rec-id="${r.id}">
                    <input type="checkbox" class="acd-check" ${r.isCompleted ? 'checked' : ''} onchange="acdToggleRec(${r.id}, this.checked)">
                    <div style="flex:1">
                        <div class="acd-rec-category">${sapEscape(r.category)}</div>
                        <div class="acd-rec-text${r.isCompleted ? ' done' : ''}" style="font-size:13.5px;margin-top:2px">${sapEscape(r.recommendationText)}</div>
                        ${r.isCompleted && r.completedByName ? `<div style="font-size:11px;color:var(--text-3);margin-top:3px">${sapEscape(d.completedBy)} ${sapEscape(r.completedByName)} — ${acdFmtDate(r.completedAt)}</div>` : ''}
                    </div>
                </div>`).join('')}
        </div>`}
    </div>`;

    // ── Signal History ──
    html += acdSignalHistoryHtml(signalHistory);

    // ── Notes ──
    const notes = data.notes || [];
    html += `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-3">${sapEscape(d.notes)}</h6>
        <div class="d-flex flex-column gap-3 mb-3" id="acdNotesList">
            ${notes.length === 0 ? `<p class="text-muted-custom mb-0">${sapEscape(d.noNotes)}</p>` : notes.map(n => `
                <div class="acd-note-item">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="fw-semibold" style="font-size:13px">${sapEscape(n.authorName)}${n.authorRole ? ` <span style="color:var(--text-3);font-weight:400">(${sapEscape(n.authorRole.replace('_', ' '))})</span>` : ''}</span>
                        <span style="font-size:11px;color:var(--text-3);white-space:nowrap">${acdFmtDate(n.createdAt)}</span>
                    </div>
                    <div style="font-size:13.5px;color:var(--text-2);margin-top:4px;white-space:pre-line">${sapEscape(n.noteText)}</div>
                </div>
            `).join('')}
        </div>
        ${data.canAddNotes ? `
        <div class="d-flex flex-column gap-2">
            <textarea id="acdNoteInput" rows="3" class="form-control form-control-dark" placeholder="${sapEscape(d.notePlaceholder)}"></textarea>
            <div id="acdNoteError" class="small" style="display:none;color:oklch(0.6 0.22 22)"></div>
            <button class="btn-primary align-self-start" id="acdAddNoteBtn" type="button" onclick="acdSubmitNote()"><i class="bi bi-plus-lg me-1"></i>${sapEscape(d.addNote)}</button>
        </div>` : ''}
    </div>`;

    // ── Manual close (Admin only, active plans) ──
    if (data.canManage && data.status === 'Active') {
        html += `<div class="card-dark mb-4">
            <h6 class="fw-bold mb-2">${sapEscape(d.manualCloseTitle)}</h6>
            <p class="text-muted-custom" style="font-size:12.5px">${sapEscape(d.manualCloseDesc)}</p>
            <textarea id="acdCloseReason" rows="2" class="form-control form-control-dark mb-2" placeholder="${sapEscape(d.manualClosePlaceholder)}"></textarea>
            <div id="acdCloseMsg" class="small mb-2" style="display:none"></div>
            <button class="btn-primary" id="acdCloseBtn" type="button" style="background:${ChartColors.SEMANTIC.BAD};border-color:${ChartColors.SEMANTIC.BAD}" onclick="acdManualClose()"><i class="bi bi-x-circle me-1"></i>${sapEscape(d.manualCloseBtn)}</button>
        </div>`;
    }

    acdContentEl.innerHTML = html;
    if (snaps.length >= 2) acdRenderTrendChart(snaps);
}

async function acdLoad() {
    const store = acdCurrentStore();
    const d = ACD_D;

    if (!store) {
        acdContentEl.innerHTML = `<div class="card-dark empty-state"><i class="bi bi-shop"></i><p>${sapEscape(d.noStoreSelected)}</p></div>`;
        return;
    }

    const data = await sapFetchJson('/api/store-action-plan/action-center/detail?store=' + encodeURIComponent(store));
    if (!data) {
        document.getElementById('acdStoreName').textContent = store;
        acdContentEl.innerHTML = `<div class="card-dark empty-state"><i class="bi bi-lock"></i><p>${sapEscape(d.noAccess)}</p></div>`;
        return;
    }

    const signalHistory = data.status !== 'None'
        ? await sapFetchJson('/api/store-action-plan/action-center/signal-history?store=' + encodeURIComponent(store))
        : null;
    const monthlyTurnoverHistory = data.status !== 'None'
        ? await sapFetchJson('/api/store-action-plan/action-center/monthly-turnover?store=' + encodeURIComponent(store))
        : null;
    const health = await sapFetchJson('/api/store-action-plan/action-center/health/detail?store=' + encodeURIComponent(store));

    acdRender(data, signalHistory, monthlyTurnoverHistory, health);
}

async function acdToggleRec(id, isCompleted) {
    const item = document.querySelector(`.acd-rec-item[data-rec-id="${id}"]`);
    try {
        const res = await fetch(`/api/store-action-plan/recommendations/${id}/toggle`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': sapAntiForgeryToken() },
            body: JSON.stringify({ isCompleted })
        });
        if (!res.ok) { await acdLoad(); return; }
        await acdLoad();
    } catch { await acdLoad(); }
}

async function acdSaveAssignment() {
    const store = acdCurrentStore();
    const btn = document.getElementById('acdSaveAssignBtn');
    const msgEl = document.getElementById('acdAssignMsg');
    const name = (document.getElementById('acdAssignedName').value || '').trim();
    const dateVal = document.getElementById('acdTargetDate').value || null;
    const d = ACD_D;

    btn.disabled = true;
    try {
        const res = await fetch(`/api/store-action-plan/${encodeURIComponent(store)}/assign`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': sapAntiForgeryToken() },
            body: JSON.stringify({ assignedToName: name || null, targetResolutionDate: dateVal })
        });
        msgEl.style.display = 'block';
        if (res.ok) {
            msgEl.style.color = 'oklch(0.5 0.15 155)';
            msgEl.textContent = d.saved;
        } else {
            msgEl.style.color = 'oklch(0.6 0.22 22)';
            msgEl.textContent = await res.text();
        }
    } catch {
        msgEl.style.display = 'block';
        msgEl.style.color = 'oklch(0.6 0.22 22)';
        msgEl.textContent = ACD_D.error;
    } finally {
        btn.disabled = false;
    }
}

async function acdManualClose() {
    const store = acdCurrentStore();
    const btn = document.getElementById('acdCloseBtn');
    const msgEl = document.getElementById('acdCloseMsg');
    const reason = (document.getElementById('acdCloseReason').value || '').trim();
    const d = ACD_D;

    msgEl.style.display = 'none';
    if (!reason) {
        msgEl.style.display = 'block';
        msgEl.style.color = 'oklch(0.6 0.22 22)';
        msgEl.textContent = d.manualCloseReasonRequired;
        return;
    }

    if (!confirm(d.manualCloseDesc)) return;

    btn.disabled = true;
    try {
        const res = await fetch(`/api/store-action-plan/${encodeURIComponent(store)}/close`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': sapAntiForgeryToken() },
            body: JSON.stringify({ reason })
        });
        if (!res.ok) {
            msgEl.style.display = 'block';
            msgEl.style.color = 'oklch(0.6 0.22 22)';
            msgEl.textContent = await res.text();
            btn.disabled = false;
            return;
        }
        await acdLoad();
    } catch {
        msgEl.style.display = 'block';
        msgEl.style.color = 'oklch(0.6 0.22 22)';
        msgEl.textContent = ACD_D.error;
        btn.disabled = false;
    }
}

async function acdSubmitNote() {
    const store = acdCurrentStore();
    const textEl = document.getElementById('acdNoteInput');
    const errEl = document.getElementById('acdNoteError');
    const btn = document.getElementById('acdAddNoteBtn');
    const d = ACD_D;
    const text = (textEl.value || '').trim();

    errEl.style.display = 'none';
    if (!text) {
        errEl.textContent = d.noteRequired;
        errEl.style.display = 'block';
        return;
    }

    btn.disabled = true;
    try {
        const res = await fetch(`/api/store-action-plan/${encodeURIComponent(store)}/notes`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': sapAntiForgeryToken() },
            body: JSON.stringify({ noteText: text })
        });

        if (!res.ok) {
            const msg = await res.json().catch(() => null);
            errEl.textContent = (typeof msg === 'string' && msg) ? msg : d.noteAddFailed;
            errEl.style.display = 'block';
            btn.disabled = false;
            return;
        }

        await acdLoad();
    } catch {
        errEl.textContent = d.noteAddFailedRetry;
        errEl.style.display = 'block';
        btn.disabled = false;
    }
}

acdLoad();
</script>
