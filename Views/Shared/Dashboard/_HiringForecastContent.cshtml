@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __isAdminArea = !string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase);
}
<style>
.hf-select-wrap { position:relative; }
.hf-select {
    appearance:none; -webkit-appearance:none;
    background:var(--card-bg); border:1px solid var(--card-border); color:var(--text);
    border-radius:var(--radius-sm); font-size:13.5px; font-weight:600;
    height:42px; padding:0 34px 0 14px; min-width:110px; max-width:260px;
    box-shadow:var(--shadow-sm); cursor:pointer;
}
.hf-select:focus { outline:none; border-color:var(--red); box-shadow:0 0 0 3px var(--red-light); }
.hf-select-wrap i { position:absolute; top:50%; right:12px; transform:translateY(-50%); font-size:11px; color:var(--text-3); pointer-events:none; }
[dir="rtl"] .hf-select { padding:0 14px 0 34px; }
[dir="rtl"] .hf-select-wrap i { right:auto; left:12px; }
.hf-note {
    display:flex; align-items:flex-start; gap:10px; margin-bottom:14px; padding:12px 14px; font-size:13px;
    background:oklch(0.75 0.16 75 / .1); border:1px solid oklch(0.75 0.16 75 / .35);
    border-radius:var(--radius-sm); color:var(--text-2);
}
.hf-note i { color:oklch(0.6 0.14 75); font-size:16px; flex-shrink:0; margin-top:1px; }
.hf-wrap { max-height:640px; overflow:auto; }
.hf-table { width:100%; border-collapse:separate; border-spacing:0; font-size:13.5px; }
.hf-table th, .hf-table td { padding:9px 12px; border-bottom:1px solid var(--card-border); white-space:nowrap; text-align:start; }
.hf-table thead th { position:sticky; top:0; z-index:2; background:var(--bg-2); color:var(--text); font-weight:700; }
.hf-table td.num, .hf-table th.num { text-align:center; font-variant-numeric:tabular-nums; min-width:62px; }
.hf-table th.sortable { cursor:pointer; user-select:none; }
.hf-table th.sortable:hover { color:var(--red); }
.hf-table th.sortable i { font-size:10px; margin-inline-start:5px; opacity:.35; }
.hf-table th.sortable.sorted i { opacity:1; color:var(--red); }
.hf-table th .hf-tag { display:block; font-size:10px; font-weight:600; color:var(--text-3); }
.hf-table td.hf-zero { color:var(--text-3); }
.hf-table td.hf-total, .hf-table th.hf-total { font-weight:700; background:var(--bg-2); }
.hf-table tfoot td { position:sticky; bottom:0; z-index:2; background:var(--bg-2); font-weight:700; border-top:2px solid var(--card-border); }
.hf-search {
    background:var(--card-bg); border:1px solid var(--card-border); color:var(--text);
    border-radius:var(--radius-sm); font-size:13px; height:36px; padding:0 12px; min-width:200px;
}
.hf-empty { padding:40px 20px; text-align:center; color:var(--text-3); font-size:14px; }
.hf-empty i { font-size:34px; display:block; margin-bottom:10px; }
.chart-body canvas { direction:ltr; }
.hf-legend { font-size:12px; color:var(--text-3); }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_HiringForecast"]</h1>
        <p class="page-subtitle">@L["Page_HiringForecastSub"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-end" id="hfFilters" hidden>
        <div class="hf-select-wrap"><select id="hfYear" class="hf-select" aria-label="@L["WP_Year"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfMonth" class="hf-select" aria-label="@L["WP_Month"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfStore" class="hf-select" aria-label="@L["WP_ColStore"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfJob" class="hf-select" aria-label="@L["WP_ColJob"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfOc" class="hf-select" aria-label="@L["Common_OperationConsultant"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfOm" class="hf-select" aria-label="@L["Common_OperationManagers"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfSoc" class="hf-select" aria-label="@L["Common_SeniorOperationConsultants"]"></select><i class="bi bi-chevron-down"></i></div>
        <div class="hf-select-wrap"><select id="hfOd" class="hf-select" aria-label="@L["Common_OperationDirectors"]"></select><i class="bi bi-chevron-down"></i></div>
        <button type="button" class="reset-filters-btn" id="hfReset"><i class="bi bi-arrow-counterclockwise"></i>@L["Common_ResetFilters"]</button>
    </div>
</div>

@{
    var hiringForecastGuide = new PageGuideViewModel
    {
        PageKey = "hiringforecast",
        Overview = L["Guide_HF_Overview"],
        FilterNote = L["Guide_HF_FilterNote"],
        Sections = new List<PageGuideSection>
        {
            new() { Icon = "bi-speedometer2", Title = L["Guide_HF_KpisTitle"], Body = L["Guide_HF_Kpis"] },
            new() { Icon = "bi-lightbulb-fill", Title = L["Common_SmartInsights"], Body = L["Guide_HF_Insights"] },
            new() { Icon = "bi-bar-chart-fill", Title = L["HF_ChartTitle"], Body = L["Guide_HF_Chart"] },
            new() { Icon = "bi-table", Title = L["Guide_HF_MatrixTitle"], Body = L["Guide_HF_Matrix"] },
            new() { Icon = "bi-calculator", Title = L["Guide_HF_MethodTitle"], Body = L["Guide_HF_Method"] },
            new() { Icon = "bi-exclamation-triangle", Title = L["Guide_HF_LimitsTitle"], Body = L["Guide_HF_Limits"] },
        }
    };
}
@await Html.PartialAsync("~/Views/Shared/Dashboard/_PageGuide.cshtml", hiringForecastGuide)

<div id="hfEmpty" class="chart-card" hidden>
    <div class="hf-empty">
        <i class="bi bi-person-plus"></i>
        <div id="hfEmptyText">@L["WP_NoData"]</div>
        @if (__isAdminArea)
        {
            <div class="mt-2"><a href="/admin/dashboard/uploads?tab=jobproj">@L["WP_NoDataAdmin"]</a></div>
        }
    </div>
</div>

<div id="hfBody" hidden>
    <div id="hfKpis" class="kpi-grid mb-3"></div>

    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-lightbulb-fill" style="color:oklch(0.75 0.16 75)"></i>
        <h5 class="mb-0 fw-bold">@L["Common_SmartInsights"]</h5>
        <span class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px">@L["Common_AutoGenerated"]</span>
    </div>
    <div class="chart-card mb-3"><div id="hfInsights"></div></div>
    <div class="chart-card mb-3">
        <div class="chart-header"><h6>@L["HF_ChartTitle"]</h6><p>@L["HF_ChartSub"]</p></div>
        <div class="chart-body" style="position:relative;height:280px"><canvas id="hfChart"></canvas></div>
    </div>
    <div class="chart-card mb-3">
        <div class="chart-header"><h6>@L["HF_JobTitle"]</h6><p>@L["HF_JobSub"]</p></div>
        <div class="chart-body" style="position:relative;height:340px"><canvas id="hfJobChart"></canvas></div>
        <div class="hf-wrap mt-3">
            <table class="hf-table">
                <thead><tr id="hfJobHead"></tr></thead>
                <tbody id="hfJobRows"></tbody>
                <tfoot><tr id="hfJobFoot"></tr></tfoot>
            </table>
        </div>
    </div>
    <div id="hfNote" class="hf-note"><i class="bi bi-info-circle-fill"></i><span id="hfNoteText"></span></div>
    <div class="chart-card">
        <div class="chart-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div><h6>@L["HF_Title"]</h6><p>@L["HF_Sub"]</p></div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="hf-select-wrap"><select id="hfBy" class="hf-select" aria-label="@L["HF_ViewBy"]">
                    <option value="store">@L["HF_ViewBy"]: @L["WP_ColStore"]</option>
                    <option value="job">@L["HF_ViewBy"]: @L["WP_ColJob"]</option>
                    <option value="payroll">@L["HF_ViewBy"]: @L["HF_ByPayroll"]</option>
                    <option value="consultant">@L["HF_ViewBy"]: @L["Common_OperationConsultant"]</option>
                </select><i class="bi bi-chevron-down"></i></div>
                <input type="search" id="hfSearch" class="hf-search" placeholder="@L["WP_Search"]">
            </div>
        </div>
        <div class="hf-wrap">
            <table class="hf-table">
                <thead><tr id="hfHead"></tr></thead>
                <tbody id="hfBodyRows"></tbody>
                <tfoot><tr id="hfFoot"></tr></tfoot>
            </table>
        </div>
        <div class="hf-legend mt-2">@L["HF_Legend"]</div>
    </div>
    <div id="hfGroups" class="d-flex flex-column gap-3 mt-3"></div>
</div>

<div id="hfL" hidden
     data-all-oc="@L["Common_AllOperationConsultants"]" data-all-om="@L["Common_AllOperationManagers"]" data-all-soc="@L["WP_AllSoc"]" data-all-od="@L["WP_AllOd"]" data-all-stores="@L["WP_AllStores"]" data-all-jobs="@L["WP_AllJobs"]"
     data-kpi-year="@L["HF_KpiYear"]" data-kpi-year-d="@L["HF_KpiYearDesc"]" data-kpi-peak="@L["HF_KpiPeak"]" data-kpi-peak-d="@L["HF_KpiPeakDesc"]" data-kpi-next="@L["HF_KpiNext"]" data-kpi-next-d="@L["HF_KpiNextDesc"]" data-kpi-store="@L["HF_KpiStore"]" data-kpi-store-d="@L["HF_KpiStoreDesc"]"
     data-chart-label="@L["HF_ChartLabel"]"
     data-job="@L["WP_ColJob"]" data-payroll="@L["HF_ByPayroll"]"
     data-all-months="@L["HF_AllMonths"]" data-k-month="@L["HF_KpiMonth"]" data-k-month-d="@L["HF_KpiMonthDesc"]" data-k-share="@L["HF_KpiShare"]" data-k-share-d="@L["HF_KpiShareDesc"]" data-k-from="@L["HF_KpiFrom"]" data-k-from-d="@L["HF_KpiFromDesc"]" data-k-store-m="@L["HF_KpiStoreMonth"]" data-k-store-m-d="@L["HF_KpiStoreMonthDesc"]"
     data-store="@L["WP_ColStore"]" data-oc="@L["Common_OperationConsultant"]" data-total="@L["HF_Total"]" data-forecast="@L["HF_Forecast"]" data-roster="@L["HF_Roster"]"
     data-note="@L["HF_Note"]" data-note-none="@L["HF_NoteNoRoster"]" data-no-rows="@L["Common_NoData"]"
     data-oc-title="@L["Common_OperationConsultants"]" data-od-title="@L["Common_OperationDirectors"]" data-om-title="@L["Common_OperationManagers"]" data-soc-title="@L["Common_SeniorOperationConsultants"]"
     data-oc-sub="@L["HF_GrpSubOc"]" data-od-sub="@L["HF_GrpSubOd"]" data-om-sub="@L["HF_GrpSubOm"]" data-soc-sub="@L["HF_GrpSubSoc"]" data-col-name="@L["Common_Name"]" data-col-stores="@L["Common_Stores"]"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie_light.min.js"></script>
<script src="~/js/page-loader.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script>
/* Hiring Forecast — hires needed per store per month. One endpoint
   (/api/workforce-planning/hiring-forecast); the server caches the heavy reads. */
const hfL = document.getElementById('hfL').dataset;
const HF_I = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> {
    ["Peak_T"] = L["HF_In_Peak_T"].Value, ["Peak_D"] = L["HF_In_Peak_D"].Value,
    ["Next_T"] = L["HF_In_Next_T"].Value, ["Next_D"] = L["HF_In_Next_D"].Value,
    ["Concentration_T"] = L["HF_In_Concentration_T"].Value, ["Concentration_D"] = L["HF_In_Concentration_D"].Value,
    ["Trend_T"] = L["HF_In_Trend_T"].Value, ["Trend_D"] = L["HF_In_Trend_D"].Value,
    ["EarlyLeavers_T"] = L["HF_In_EarlyLeavers_T"].Value, ["EarlyLeavers_D"] = L["HF_In_EarlyLeavers_D"].Value,
    ["Consultant_T"] = L["HF_In_Consultant_T"].Value, ["Consultant_D"] = L["HF_In_Consultant_D"].Value,
    ["NoNeed_T"] = L["HF_In_NoNeed_T"].Value, ["NoNeed_D"] = L["HF_In_NoNeed_D"].Value,
    ["NoHires_T"] = L["HF_In_NoHires_T"].Value, ["NoHires_D"] = L["HF_In_NoHires_D"].Value,
    ["Month_T"] = L["HF_In_Month_T"].Value, ["Month_D"] = L["HF_In_Month_D"].Value, ["Above"] = L["HF_In_Above"].Value, ["Below"] = L["HF_In_Below"].Value, ["Rises"] = L["HF_In_Rises"].Value, ["Falls"] = L["HF_In_Falls"].Value,
    ["More"] = L["HF_In_More"].Value, ["Fewer"] = L["HF_In_Fewer"].Value,
}));
const hfState = { by: 'store', year: '', month: '', store: '', job: '', oc: '', om: '', soc: '', od: '' };
const hfSort = { key: 'total', dir: 'desc' };
let hfData, hfJobData, hfChart, hfJobChart;
const hfMi = () => hfState.month ? +hfState.month - 1 : -1; // selected month (0-based), -1 = the whole year
const hfCols = () => hfMi() >= 0 ? [hfMi()] : [...Array(12).keys()]; // month columns the tables show
const hfMonthName = (m, style) => new Date(2000, m - 1, 1).toLocaleString('default', { month: style || 'short' });

function hfFillSelect(id, options, value) {
    const el = document.getElementById(id);
    el.innerHTML = options.map(o => `<option value="${sapEscape(o.value)}">${sapEscape(o.label)}</option>`).join('');
    el.value = String(value ?? '');
}

async function hfLoad() {
    const q = new URLSearchParams();
    q.set('by', hfState.by);
    if (hfState.year) q.set('year', hfState.year);
    if (hfState.store) q.set('store', hfState.store);
    if (hfState.job) q.set('jobs', hfState.job);
    ['oc', 'om', 'soc', 'od'].forEach(k => { if (hfState[k]) q.set(k, hfState[k]); });
    let d, jd;
    const done = PageLoader.begin();
    try {
        // The by-job card always needs the per-job rows, whatever the table below is grouped by (same cached server data).
        const qJob = new URLSearchParams(q); qJob.set('by', 'job');
        const get = async p => { const r = await fetch('/api/workforce-planning/hiring-forecast?' + p); if (!r.ok) throw new Error(); return r.json(); };
        [d, jd] = await Promise.all([get(q), hfState.by === 'job' ? null : get(qJob)]);
        if (!jd) jd = d;
    } catch {
        document.getElementById('hfEmpty').hidden = false;
        return;
    } finally {
        done();
    }
    hfData = d; hfJobData = jd;
    const show = d.hasData && d.hasRoster;
    document.getElementById('hfEmpty').hidden = show;
    document.getElementById('hfBody').hidden = !show;
    document.getElementById('hfFilters').hidden = !d.hasData;
    if (d.hasData && !d.hasRoster) document.getElementById('hfEmptyText').textContent = hfL.noteNone;
    if (!d.hasData) return;

    // A filter value that no longer exists (e.g. a store missing from the newly picked year) would keep filtering
    // while its dropdown shows blank: drop it and load again.
    const stale = [['store', d.stores], ['job', d.jobs], ['oc', d.operationConsultants], ['om', d.operationManagers],
        ['soc', d.seniorOperationConsultants], ['od', d.operationDirectors]].filter(([k, list]) => hfState[k] && !(list || []).includes(hfState[k]));
    if (stale.length) { stale.forEach(([k]) => { hfState[k] = ''; }); return hfLoad(); }

    hfState.year = d.year;
    hfFillSelect('hfYear', d.years.map(y => ({ value: y, label: y })), d.year);
    const monthsWithData = [...Array(12).keys()].filter(i => d.monthModes[i] !== 'none');
    if (hfState.month && !monthsWithData.includes(+hfState.month - 1)) hfState.month = '';
    hfFillSelect('hfMonth', [{ value: '', label: hfL.allMonths }].concat(monthsWithData.map(i => ({ value: i + 1, label: hfMonthName(i + 1, 'long') }))), hfState.month);
    hfFillSelect('hfStore', [{ value: '', label: hfL.allStores }].concat(d.stores.map(s => ({ value: s, label: s }))), hfState.store);
    hfFillSelect('hfJob', [{ value: '', label: hfL.allJobs }].concat(d.jobs.map(j => ({ value: j, label: j }))), hfState.job);
    const people = (id, all, list, key) => hfFillSelect(id, [{ value: '', label: all }].concat((list || []).map(n => ({ value: n, label: n }))), hfState[key]);
    people('hfOc', hfL.allOc, d.operationConsultants, 'oc');
    people('hfOm', hfL.allOm, d.operationManagers, 'om');
    people('hfSoc', hfL.allSoc, d.seniorOperationConsultants, 'soc');
    people('hfOd', hfL.allOd, d.operationDirectors, 'od');
    if (!show) return;

    document.getElementById('hfNoteText').textContent = hfL.note
        .replace('{0}', hfMonthName(d.baselineMonth) + ' ' + d.baselineYear)
        .replace('{1}', d.earlyLeaverRate).replace('{2}', d.attritionMonths);
    hfRenderKpis(d);
    hfRenderInsights(d);
    hfRenderChart(d);
    hfRenderJobs();
    hfRender();
    hfRenderGroups();
}

// Headline numbers, all derived from the matrix the server already returned.
function hfRenderKpis(d) {
    const idx = [...Array(12).keys()].filter(i => d.monthModes[i] !== 'none');
    const card = (icon, cls, val, label, desc) =>
        `<div class="kpi-card"><div class="kpi-icon ${cls}"><i class="bi ${icon}"></i></div><div class="kpi-value ${cls}">${val}</div><div class="kpi-label">${sapEscape(label)}</div><div class="kpi-desc">${sapEscape(desc)}</div></div>`;
    const mi = hfState.month ? +hfState.month - 1 : -1; // selected month (0-based), -1 = the whole year
    const now = new Date();
    let html;
    if (mi >= 0) {
        // One month: its total, its share of the year, the three months starting with it, and its biggest store.
        const name = hfMonthName(mi + 1, 'long');
        const tot = d.monthTotals[mi];
        const span = idx.filter(i => i >= mi).slice(0, 3);
        const top = d.rows.reduce((b, r) => (!b || r.months[mi] > b.months[mi]) ? r : b, null);
        html = card('bi-person-plus-fill', tot > 0 ? 'text-danger' : '', tot, hfL.kMonth.replace('{0}', name), hfL.kMonthD) +
            card('bi-pie-chart-fill', '', d.grandTotal > 0 ? Math.round(tot * 100 / d.grandTotal) + '%' : '—', hfL.kShare, hfL.kShareD) +
            card('bi-calendar-range', '', span.reduce((t, i) => t + d.monthTotals[i], 0), hfL.kFrom.replace('{0}', name), hfL.kFromD) +
            (d.by === 'store' ? card('bi-shop', '', top && top.months[mi] > 0 ? `${sapEscape(top.store)} (${top.months[mi]})` : '—', hfL.kStoreM.replace('{0}', name), hfL.kStoreMD) : '');
    } else {
        let peak = null;
        idx.forEach(i => { if (!peak || d.monthTotals[i] > d.monthTotals[peak.i]) peak = { i }; });
        // "Next 3 months": from this month on when viewing the current year, else the first three months of the plan.
        const upcoming = (d.year === now.getFullYear() ? idx.filter(i => i >= now.getMonth()) : idx).slice(0, 3);
        const next3 = upcoming.reduce((a, i) => a + d.monthTotals[i], 0);
        const top = d.rows.reduce((b, r) => (!b || r.total > b.total) ? r : b, null);
        html = card('bi-person-plus-fill', d.grandTotal > 0 ? 'text-danger' : '', d.grandTotal, hfL.kpiYear, hfL.kpiYearD) +
            card('bi-calendar-event', '', peak && d.monthTotals[peak.i] > 0 ? `${hfMonthName(peak.i + 1)} (${d.monthTotals[peak.i]})` : '—', hfL.kpiPeak, hfL.kpiPeakD) +
            card('bi-calendar-range', '', upcoming.length ? next3 : '—', hfL.kpiNext, hfL.kpiNextD) +
            (d.by === 'store' ? card('bi-shop', '', top && top.total > 0 ? `${sapEscape(top.store)} (${top.total})` : '—', hfL.kpiStore, hfL.kpiStoreD) : '');
    }
    document.getElementById('hfKpis').innerHTML = html;
}

// Hires per month: roster months in dark red, forecast months in a lighter red.
function hfRenderChart(d) {
    const idx = [...Array(12).keys()].filter(i => d.monthModes[i] !== 'none');
    if (hfChart) hfChart.destroy();
    hfChart = new Chart(document.getElementById('hfChart'), {
        type: 'bar',
        data: {
            labels: idx.map(i => hfMonthName(i + 1)),
            datasets: [{
                data: idx.map(i => d.monthTotals[i]), borderRadius: 3,
                // With a month selected, that month keeps its colour and the others fade.
                backgroundColor: idx.map(i => {
                    const base = d.monthModes[i] === 'forecast' ? 'oklch(0.72 0.14 25)' : 'oklch(0.52 0.2 25)';
                    return hfState.month && +hfState.month - 1 !== i ? base.replace(')', ' / .3)') : base;
                }),
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { enabled: true, callbacks: {
                    title: items => hfMonthName(idx[items[0].dataIndex] + 1) + ' — ' + (d.monthModes[idx[items[0].dataIndex]] === 'forecast' ? hfL.forecast : hfL.roster),
                    label: c => ` ${hfL.chartLabel}: ${c.formattedValue}`,
                } },
                datalabels: { anchor: 'end', align: 'top', color: getComputedStyle(document.body).color, font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' }
            },
            layout: { padding: { top: 18 } },
            scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: 'rgba(128,128,128,.12)' } } }
        }
    });
}

/* Hires needed per job: the selected month, or the whole year. Follows every filter; jobs with no need are hidden. */
function hfRenderJobs() {
    const d = hfJobData, modes = d.monthModes;
    const mi = hfState.month ? +hfState.month - 1 : -1;
    const valueOf = r => mi >= 0 ? r.months[mi] : r.total;
    const rows = d.rows.filter(r => valueOf(r) > 0).sort((a, b) => valueOf(b) - valueOf(a) || a.store.localeCompare(b.store));
    const total = mi >= 0 ? d.monthTotals[mi] : d.grandTotal;

    if (hfJobChart) hfJobChart.destroy();
    // Horizontal bars: one row per job, so the height grows with the number of jobs.
    document.getElementById('hfJobChart').parentElement.style.height = Math.max(120, rows.length * 26 + 50) + 'px';
    hfJobChart = new Chart(document.getElementById('hfJobChart'), {
        type: 'bar',
        data: { labels: rows.map(r => r.store), datasets: [{ data: rows.map(valueOf), borderRadius: 3, backgroundColor: 'oklch(0.52 0.2 25)' }] },
        options: {
            indexAxis: 'y',
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: c => ` ${hfL.chartLabel}: ${c.formattedValue}` } },
                datalabels: { anchor: 'end', align: 'right', color: getComputedStyle(document.body).color, font: { size: 11, weight: 'bold' } }
            },
            layout: { padding: { right: 28 } },
            scales: { y: { grid: { display: false }, ticks: { autoSkip: false } }, x: { beginAtZero: true, grid: { color: 'rgba(128,128,128,.12)' } } }
        }
    });

    const th = (label, cls, sub) => `<th class="${cls || ''}">${sapEscape(label)}${sub ? `<span class="hf-tag">${sapEscape(sub)}</span>` : ''}</th>`;
    let h = th(hfL.job);
    for (const i of hfCols()) h += th(hfMonthName(i + 1), 'num', modes[i] === 'none' ? '' : modes[i] === 'forecast' ? hfL.forecast : hfL.roster);
    document.getElementById('hfJobHead').innerHTML = h + (mi < 0 ? th(hfL.total, 'num hf-total') : '');

    const max = Math.max(1, ...rows.flatMap(r => hfCols().map(i => r.months[i])));
    const cell = (v, mode, on) => mode === 'none'
        ? '<td class="num hf-zero">—</td>'
        : `<td class="num ${v === 0 ? 'hf-zero' : ''} ${on ? 'fw-bold' : ''}" style="${v > 0 ? `background:oklch(0.6 0.2 25 / ${(0.08 + 0.5 * v / max).toFixed(2)})` : ''}">${v}</td>`;
    document.getElementById('hfJobRows').innerHTML = rows.length ? rows.map(r =>
        `<tr><td>${sapEscape(r.store)}</td>` + hfCols().map(i => cell(r.months[i], modes[i], false)).join('') + (mi < 0 ? `<td class="num hf-total">${r.total}</td>` : '') + `</tr>`).join('')
        : `<tr><td colspan="14" class="text-center py-3 text-muted">${sapEscape(hfL.noRows)}</td></tr>`;
    document.getElementById('hfJobFoot').innerHTML = `<td>${sapEscape(hfL.total)}</td>`
        + hfCols().map(i => `<td class="num">${modes[i] === 'none' ? '—' : d.monthTotals[i]}</td>`).join('') + (mi < 0 ? `<td class="num">${d.grandTotal}</td>` : '');
}

/* ── Smart Insights: plain-language takeaways computed from the matrix on screen ── */
const hfFmt = (tpl, ...a) => String(tpl).replace(/\{(\d+)\}/g, (_, i) => a[i] ?? '');
const HF_COLORS = {
    danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: 'oklch(0.6 0.22 22)', text: 'oklch(0.6 0.22 22)' },
    warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: 'oklch(0.75 0.16 75)', text: 'oklch(0.6 0.14 75)' },
    success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' },
    secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' },
};
function hfRenderInsights(d) {
    const items = [];
    const add = (icon, color, title, description) => items.push({ icon, color, title, description });
    const idx = [...Array(12).keys()].filter(i => d.monthModes[i] !== 'none');
    const mi = hfState.month ? +hfState.month - 1 : -1; // selected month (0-based), -1 = the whole year
    const valueOf = mi >= 0 ? r => r.months[mi] : r => r.total;
    const total = mi >= 0 ? d.monthTotals[mi] : d.grandTotal;
    const pct = (a, b) => Math.round(a * 100 / b);
    if (!idx.length || total <= 0) { add('bi-info-circle-fill', 'secondary', HF_I.NoHires_T, HF_I.NoHires_D); }
    else {
        if (mi >= 0) {
            // The month on its own: its size against the year and the monthly average, and where its hires come from.
            const name = hfMonthName(mi + 1, 'long');
            const avg = Math.round(d.grandTotal / idx.length);
            add('bi-calendar-event', total > avg ? 'warning' : 'secondary', hfFmt(HF_I.Month_T, name),
                hfFmt(HF_I.Month_D, name, total, pct(total, d.grandTotal), avg, d.monthModes[mi] === 'forecast' ? hfL.forecast : hfL.roster));
        } else {
            // Busiest month
            const peak = idx.reduce((b, i) => d.monthTotals[i] > d.monthTotals[b] ? i : b, idx[0]);
            add('bi-calendar-event', 'warning', hfFmt(HF_I.Peak_T, hfMonthName(peak + 1, 'long')), hfFmt(HF_I.Peak_D, hfMonthName(peak + 1, 'long'), d.monthTotals[peak], pct(d.monthTotals[peak], total)));

            // The next three months against the monthly average
            const now = new Date();
            const upcoming = (d.year === now.getFullYear() ? idx.filter(i => i >= now.getMonth()) : idx).slice(0, 3);
            const avg = total / idx.length;
            if (upcoming.length) {
                const nextAvg = upcoming.reduce((t, i) => t + d.monthTotals[i], 0) / upcoming.length;
                const diff = Math.round((nextAvg - avg) * 100 / avg);
                if (Math.abs(diff) >= 5) add(diff > 0 ? 'bi-arrow-up-circle-fill' : 'bi-arrow-down-circle-fill', diff > 0 ? 'danger' : 'success',
                    hfFmt(HF_I.Next_T, diff > 0 ? HF_I.Above : HF_I.Below), hfFmt(HF_I.Next_D, Math.round(nextAvg), Math.round(avg), Math.abs(diff), diff > 0 ? HF_I.More : HF_I.Fewer));
            }

            // Rising or falling through the year
            if (idx.length >= 3) {
                const first = idx[0], last = idx[idx.length - 1];
                const a = d.monthTotals[first], b = d.monthTotals[last];
                if (a > 0) {
                    const diff = Math.round((b - a) * 100 / a);
                    if (Math.abs(diff) >= 5) add(diff > 0 ? 'bi-graph-up-arrow' : 'bi-graph-down-arrow', diff > 0 ? 'warning' : 'success',
                        hfFmt(HF_I.Trend_T, diff > 0 ? HF_I.Rises : HF_I.Falls), hfFmt(HF_I.Trend_D, hfMonthName(first + 1), a, hfMonthName(last + 1), b, Math.abs(diff), diff > 0 ? HF_I.More : HF_I.Fewer));
                }
            }
        }

        // How concentrated the hiring is
        const sorted = [...d.rows].sort((x, y) => valueOf(y) - valueOf(x));
        if (sorted.length >= 4) {
            const n = sorted.length >= 10 ? 5 : 3;
            const top = sorted.slice(0, n).filter(r => valueOf(r) > 0); // never list a row that needs no hires
            const share = pct(top.reduce((t, r) => t + valueOf(r), 0), total);
            if (top.length >= 2) add('bi-bullseye', share >= 40 ? 'danger' : 'secondary', hfFmt(HF_I.Concentration_T, top.length, share),
                hfFmt(HF_I.Concentration_D, top.map(r => `${r.store || '—'} (${valueOf(r)})`).join(', ')));
        }

        // The consultant whose stores need the most hires (store view only)
        if (d.by === 'store') {
            const byOc = {};
            d.rows.forEach(r => { if (r.operationConsultant) { const o = byOc[r.operationConsultant] ||= { hires: 0, stores: 0 }; o.hires += valueOf(r); o.stores++; } });
            const ocs = Object.entries(byOc).sort((x, y) => y[1].hires - x[1].hires);
            if (ocs.length >= 2 && ocs[0][1].hires > 0) add('bi-person-badge', 'secondary', hfFmt(HF_I.Consultant_T, ocs[0][0]),
                hfFmt(HF_I.Consultant_D, ocs[0][0], ocs[0][1].hires, pct(ocs[0][1].hires, total), ocs[0][1].stores));
            const none = d.rows.filter(r => valueOf(r) === 0).length;
            if (none > 0) add('bi-check-circle-fill', 'success', hfFmt(HF_I.NoNeed_T, none), HF_I.NoNeed_D);
        }

        // Hires that only replace new people who leave early
        if (d.earlyLeaverRate > 0) add('bi-hourglass-split', 'secondary', hfFmt(HF_I.EarlyLeavers_T, d.earlyLeaverRate),
            hfFmt(HF_I.EarlyLeavers_D, Math.round(total * d.earlyLeaverRate / 100), total, d.earlyLeaverRate));
    }
    const colors = c => HF_COLORS[c] || HF_COLORS.secondary;
    document.getElementById('hfInsights').innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colors(item.color);
        return `<div class="col-md-6"><div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
            <div class="d-flex align-items-start gap-2"><i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
            <div><div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
            <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div></div></div></div></div>`;
    }).join('') + '</div>';
}

const hfVal = {
    store: r => r.store.toLowerCase(), oc: r => (r.operationConsultant || '').toLowerCase(), total: r => hfMi() >= 0 ? r.months[hfMi()] : r.total, // the selected month, else the whole year
};
for (let i = 0; i < 12; i++) hfVal['m' + i] = r => r.months[i];

function hfRender() {
    const d = hfData;
    const modes = d.monthModes;
    const head = document.getElementById('hfHead');
    const th = (key, label, cls, sub) => `<th class="sortable ${cls || ''}" data-sort="${key}">${sapEscape(label)}<i class="bi"></i>${sub ? `<span class="hf-tag">${sapEscape(sub)}</span>` : ''}</th>`;
    const first = { store: hfL.store, job: hfL.job, payroll: hfL.payroll, consultant: hfL.oc }[d.by] || hfL.store;
    let h = th('store', first) + (d.by === 'store' ? th('oc', hfL.oc) : '');
    for (const i of hfCols()) h += th('m' + i, hfMonthName(i + 1), 'num', modes[i] === 'none' ? '' : modes[i] === 'forecast' ? hfL.forecast : hfL.roster);
    head.innerHTML = h + (hfMi() < 0 ? th('total', hfL.total, 'num hf-total') : '');
    head.querySelectorAll('th.sortable').forEach(el => el.addEventListener('click', () => {
        hfSort.dir = hfSort.key === el.dataset.sort && hfSort.dir === 'asc' ? 'desc' : 'asc';
        hfSort.key = el.dataset.sort;
        hfRender();
    }));
    head.querySelectorAll('th.sortable').forEach(el => {
        const on = el.dataset.sort === hfSort.key;
        el.classList.toggle('sorted', on);
        el.querySelector('i').className = 'bi ' + (on && hfSort.dir === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill');
    });

    const term = (document.getElementById('hfSearch').value || '').trim().toLowerCase();
    let rows = d.rows.filter(r => !term || r.store.toLowerCase().includes(term) || (r.operationConsultant || '').toLowerCase().includes(term));
    if (/^m\d+$/.test(hfSort.key) && hfMi() >= 0 && hfSort.key !== 'm' + hfMi()) hfSort.key = 'total';
    const val = hfVal[hfSort.key], sign = hfSort.dir === 'asc' ? 1 : -1;
    rows = [...rows].sort((a, b) => {
        const x = val(a), y = val(b);
        if (hfSort.key === 'oc' && (!x || !y) && x !== y) return !x ? 1 : -1;
        const c = typeof x === 'string' ? x.localeCompare(y, undefined, { numeric: true }) : x - y;
        return (c || a.store.localeCompare(b.store)) * sign;
    });

    // Colour each cell by its size relative to the biggest store-month on screen.
    const max = Math.max(1, ...d.rows.flatMap(r => hfCols().map(i => r.months[i])));
    const cell = (v, mode) => mode === 'none'
        ? '<td class="num hf-zero">—</td>'
        : `<td class="num ${v === 0 ? 'hf-zero' : ''}" style="${v > 0 ? `background:oklch(0.6 0.2 25 / ${(0.08 + 0.5 * v / max).toFixed(2)})` : ''}">${v}</td>`;
    const body = document.getElementById('hfBodyRows');
    body.innerHTML = rows.length ? rows.map(r =>
        `<tr><td>${r.store ? sapEscape(r.store) : '—'}</td>${d.by === 'store' ? `<td>${r.operationConsultant ? sapEscape(r.operationConsultant) : '—'}</td>` : ''}`
        + hfCols().map(i => cell(r.months[i], modes[i])).join('')
        + (hfMi() < 0 ? `<td class="num hf-total">${r.total}</td>` : '') + `</tr>`).join('')
        : `<tr><td colspan="15" class="text-center py-3 text-muted">${sapEscape(hfL.noRows)}</td></tr>`;

    // Totals always cover the filtered stores, not just the search result.
    document.getElementById('hfFoot').innerHTML = `<td>${sapEscape(hfL.total)}</td>${d.by === 'store' ? '<td></td>' : ''}`
        + hfCols().map(i => `<td class="num">${modes[i] === 'none' ? '—' : d.monthTotals[i]}</td>`).join('')
        + (hfMi() < 0 ? `<td class="num">${d.grandTotal}</td>` : '');
}

/* Per-leader roll-ups: the same rounded store-month hires added up under each store's leader (always by store). */
const HF_GROUP_DEFS = [
    { key: 'byOperationConsultant', id: 'Oc', role: 'oc', abbr: 'OC' },
    { key: 'byOperationDirector', id: 'Od', role: 'od', abbr: 'OD' },
    { key: 'byOperationManager', id: 'Om', role: 'om', abbr: 'OM' },
    { key: 'bySeniorOperationConsultant', id: 'Soc', role: 'soc', abbr: 'SOC' },
];
const hfGroupSort = {};
HF_GROUP_DEFS.forEach(g => { hfGroupSort[g.key] = { key: 'total', dir: 'desc' }; });

function hfRenderGroups() {
    const d = hfData, modes = d.monthModes;
    const host = document.getElementById('hfGroups');
    host.innerHTML = HF_GROUP_DEFS.map(g => `
        <div class="chart-card p-0" style="overflow:hidden">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon role-icon role-icon-${g.role}" data-role="${g.abbr}"><i class="bi bi-person-fill"></i></span>
                <div><h6 class="mb-0">${sapEscape(hfL[g.id.toLowerCase() + 'Title'])}</h6><p class="mb-0">${sapEscape(hfL[g.id.toLowerCase() + 'Sub'])}</p></div>
            </div>
            <div class="hf-wrap"><table class="hf-table"><thead><tr id="hfGrpHead${g.id}"></tr></thead><tbody id="hfGrpBody${g.id}"></tbody><tfoot><tr id="hfGrpFoot${g.id}"></tr></tfoot></table></div>
        </div>`).join('');
    HF_GROUP_DEFS.forEach(g => {
        const state = hfGroupSort[g.key];
        const th = (key, label, cls, sub) => `<th class="sortable ${cls || ''}" data-sort="${key}">${sapEscape(label)}<i class="bi"></i>${sub ? `<span class="hf-tag">${sapEscape(sub)}</span>` : ''}</th>`;
        const head = document.getElementById('hfGrpHead' + g.id);
        let h = th('name', hfL.colName) + th('stores', hfL.colStores, 'num');
        for (const i of hfCols()) h += th('m' + i, hfMonthName(i + 1), 'num', modes[i] === 'none' ? '' : modes[i] === 'forecast' ? hfL.forecast : hfL.roster);
        head.innerHTML = h + (hfMi() < 0 ? th('total', hfL.total, 'num hf-total') : '');
        if (/^m\d+$/.test(state.key) && hfMi() >= 0 && state.key !== 'm' + hfMi()) state.key = 'total';
        head.querySelectorAll('th.sortable').forEach(el => {
            const on = el.dataset.sort === state.key;
            el.classList.toggle('sorted', on);
            el.querySelector('i').className = 'bi ' + (on && state.dir === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill');
            el.addEventListener('click', () => { state.dir = state.key === el.dataset.sort && state.dir === 'asc' ? 'desc' : 'asc'; state.key = el.dataset.sort; hfRenderGroups(); });
        });
        const all = d[g.key] || [];
        const val = state.key === 'name' ? (r => r.store) : state.key === 'stores' ? (r => r.storeCount) : hfVal[state.key];
        const sign = state.dir === 'asc' ? 1 : -1;
        const rows = [...all].sort((a, b) => { const x = val(a), y = val(b); const c = typeof x === 'string' ? x.localeCompare(y, undefined, { numeric: true }) : x - y; return (c || a.store.localeCompare(b.store)) * sign; });
        const max = Math.max(1, ...all.flatMap(r => hfCols().map(i => r.months[i])));
        const cell = (v, mode) => mode === 'none'
            ? '<td class="num hf-zero">—</td>'
            : `<td class="num ${v === 0 ? 'hf-zero' : ''}" style="${v > 0 ? `background:oklch(0.6 0.2 25 / ${(0.08 + 0.5 * v / max).toFixed(2)})` : ''}">${v}</td>`;
        document.getElementById('hfGrpBody' + g.id).innerHTML = rows.length ? rows.map(r =>
            `<tr><td class="fw-semibold">${sapEscape(r.store)}</td><td class="num">${r.storeCount}</td>`
            + hfCols().map(i => cell(r.months[i], modes[i])).join('')
            + (hfMi() < 0 ? `<td class="num hf-total">${r.total}</td>` : '') + `</tr>`).join('')
            : `<tr><td colspan="15" class="text-center py-3 text-muted">${sapEscape(hfL.noRows)}</td></tr>`;
        const sums = Array.from({ length: 12 }, (_, i) => all.reduce((t, r) => t + r.months[i], 0));
        document.getElementById('hfGrpFoot' + g.id).innerHTML = all.length
            ? `<td>${sapEscape(hfL.total)}</td><td></td>` + hfCols().map(i => `<td class="num">${modes[i] === 'none' ? '—' : sums[i]}</td>`).join('') + (hfMi() < 0 ? `<td class="num">${all.reduce((t, r) => t + r.total, 0)}</td>` : '')
            : '';
    });
}

document.getElementById('hfBy').addEventListener('change', e => { hfState.by = e.target.value; hfLoad(); });
document.getElementById('hfYear').addEventListener('change', e => { hfState.year = e.target.value; hfState.month = ''; hfLoad(); });
// The month applies to everything on the page: cards, insights, charts and every table.
document.getElementById('hfMonth').addEventListener('change', e => { hfState.month = e.target.value; if (hfData) { hfRenderKpis(hfData); hfRenderInsights(hfData); hfRenderChart(hfData); hfRenderJobs(); hfRender(); hfRenderGroups(); } });
document.getElementById('hfStore').addEventListener('change', e => { hfState.store = e.target.value; hfLoad(); });
document.getElementById('hfJob').addEventListener('change', e => { hfState.job = e.target.value; hfLoad(); });
[['hfOc', 'oc'], ['hfOm', 'om'], ['hfSoc', 'soc'], ['hfOd', 'od']].forEach(([id, key]) =>
    document.getElementById(id).addEventListener('change', e => { hfState[key] = e.target.value; hfLoad(); }));
document.getElementById('hfReset').addEventListener('click', () => { Object.keys(hfState).forEach(k => { hfState[k] = k === 'by' ? hfState.by : ''; }); hfLoad(); });
document.getElementById('hfSearch').addEventListener('input', () => hfData && hfRender());
hfLoad();
</script>
