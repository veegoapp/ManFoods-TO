<div id="wfL" hidden
     data-kpi-headcount="@L["Common_TotalHeadcount"]"
     data-kpi-headcount-desc="@L["WF_KpiHeadcountDesc"]"
     data-kpi-new-hires="@L["Common_NewHires"]"
     data-kpi-new-hires-desc="@L["WF_KpiNewHiresDesc"]"
     data-kpi-resignations="@L["Common_Resignations"]"
     data-kpi-resignations-desc="@L["TV_KpiResignationsDesc"]"
     data-kpi-range-note="@L["WF_KpiRangeNote"]"
     data-employees-suffix="@L["Common_EmployeesCountSuffix"]"
     data-no-data="@L["Common_NoData"]"></div>

<script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Workforce page — Year + discrete Months multi-select, same filter
   components as Turnover/Comparisons/90-Day pages. Has its own KPI cards
   (wfLoadKpis, below) rather than reusing dashboard.js's loadKpis(), and
   does NOT use dashboard.js's loadCharts() (that one is resignation-based)
   — this page renders its own active-headcount composition charts instead. */
const wfL = document.getElementById('wfL').dataset;
function wfMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }

/* Appends a rangeFilterBadge (dashboard.js) to a title element, without
   losing the original text on repeated calls (loadAll runs again on every
   filter change) — the original text is captured once, on first call. */
const wfTitleBase = {};
function wfSetTitleBadge(id, affected) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!(id in wfTitleBase)) wfTitleBase[id] = el.textContent;
    el.innerHTML = wfTitleBase[id] + ' ' + rangeFilterBadge(isPeriodRangeActive(), affected);
}

/* Workforce's own KPI cards: same shared /api/dashboard/kpis endpoint as
   every other page (Total Headcount/New Hires/Resignations sum across a
   selected From→To range there too), just without the Turnover Rate card
   — that one belongs on the Turnover page. */
async function wfLoadKpis() {
    const kpiEl = document.getElementById('kpiCards');
    if (!kpiEl) return;
    const data = await fetchJson('/api/dashboard/kpis?' + buildQuery());
    kpiEl.innerHTML = `
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-people-fill"></i></div><div class="kpi-value">${data.totalHeadcount||0}</div><div class="kpi-label">${wfL.kpiHeadcount}</div><div class="kpi-desc">${wfL.kpiHeadcountDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon text-success"><i class="bi bi-person-plus-fill"></i></div><div class="kpi-value text-success">${data.newHires||0}</div><div class="kpi-label">${wfL.kpiNewHires}</div><div class="kpi-desc">${wfL.kpiNewHiresDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon text-danger"><i class="bi bi-person-dash-fill"></i></div><div class="kpi-value text-danger">${data.totalResignations||0}</div><div class="kpi-label">${wfL.kpiResignations}</div><div class="kpi-desc">${wfL.kpiResignationsDesc}</div></div>
    `;
    const noteEl = document.getElementById('wfKpiRangeNote');
    if (noteEl) noteEl.innerHTML = isPeriodRangeActive() ? rangeFilterBadge(true, true) + ' ' + wfL.kpiRangeNote : '';
}

/* ── Composition charts ──────────────────────────────────────────── */
let wfJobTitleChart, wfPayrollChart, wfTenureChart, wfGenderChart;

async function wfLoadJobTitleChart() {
    wfSetTitleBadge('wfJobTitleTitle', true);
    const data = await fetchJson(`/api/dashboard/headcount-by-job-title?${buildQuery()}`);
    const labels = data.map(d => d.label);
    const colors = ChartColors.colorsByLabel(labels, null);
    wfJobTitleChart = mkChart(wfJobTitleChart, 'wfJobTitleChart', {
        type: 'bar',
        data: { labels, datasets: [{ data: data.map(d => d.value), backgroundColor: colors, borderRadius: 4 }] },
        options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.formattedValue} ${wfL.employeesSuffix}` } },
            datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' } },
            scales: { x: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } }, y: { grid: { display: false }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadPayrollChart() {
    wfSetTitleBadge('wfPayrollTitle', true);
    const data = await fetchJson(`/api/dashboard/headcount-by-payroll-group?${buildQuery()}`);
    const labels = data.map(d => d.label);
    const colors = ChartColors.colorsByLabel(labels, ChartColors.PAYROLL_GROUP_COLORS);
    wfPayrollChart = mkChart(wfPayrollChart, 'wfPayrollChart', {
        type: 'bar',
        data: { labels, datasets: [{ data: data.map(d => d.value), backgroundColor: colors, borderRadius: 4 }] },
        options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.formattedValue} ${wfL.employeesSuffix}` } },
            datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' } },
            scales: { x: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } }, y: { grid: { display: false }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadTenureChart() {
    wfSetTitleBadge('wfTenureTitle', true);
    const data = await fetchJson(`/api/dashboard/headcount-by-tenure?${buildQuery()}`);
    const labels = data.map(d => d.label);
    const colors = ChartColors.colorsByLabel(labels, null);
    wfTenureChart = mkChart(wfTenureChart, 'wfTenureChart', {
        type: 'bar',
        data: { labels, datasets: [{ data: data.map(d => d.value), backgroundColor: colors, borderRadius: 4 }] },
        options: { plugins: { legend: { display: false }, tooltip: { enabled: true, callbacks: { label: c => ` ${c.formattedValue} ${wfL.employeesSuffix}` } },
            datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' } },
            scales: { x: { grid: { display: false }, ticks: { color: '#5B5875' } }, y: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadGenderChart() {
    wfSetTitleBadge('wfGenderTitle', true);
    const data = await fetchJson(`/api/dashboard/gender-breakdown?${buildQuery()}`);
    const genderLabels = data.map(d => d.label);
    const genderColors = ChartColors.colorsByLabel(genderLabels, ChartColors.GENDER_COLORS);
    wfGenderChart = mkChart(wfGenderChart, 'wfGenderChart', {
        type: 'doughnut',
        data: { labels: genderLabels, datasets: [{ data: data.map(d => d.value), backgroundColor: genderColors, borderWidth: 0 }] },
        options: { plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.formattedValue}` } } } }
    });

    const el = document.getElementById('wfGenderStatsList');
    if (!data.length) { el.innerHTML = ''; return; }
    const total = data.reduce((s, d) => s + d.value, 0);
    el.innerHTML = data.map((d, i) => {
        const pct = total > 0 ? Math.round(d.value / total * 100) : 0;
        return `<div class="wf-gender-row">
            <span class="wf-gender-dot" style="background:${genderColors[i]}"></span>
            <span class="wf-gender-label">${sapEscape(d.label)}</span>
            <span class="wf-gender-value">${d.value} <span class="wf-gender-pct">(${pct}%)</span></span>
        </div>`;
    }).join('');
}

/* Headcount trend — always full history from the selected year onward,
   unaffected by the Months multi-select (same rule as the Turnover page's
   Monthly Trend chart). */
let wfHeadcountTrendChart;
async function wfLoadHeadcountTrend() {
    wfSetTitleBadge('wfTrendTitle', false);
    const q = new URLSearchParams();
    if (storeFilter) q.set('store', storeFilter);
    if (omFilter)    q.set('om', omFilter);
    if (ocFilter)    q.set('oc', ocFilter);
    if (socFilter)   q.set('soc', socFilter);
    if (odFilter)    q.set('od', odFilter);
    if (jobFilter.length) q.set('jobs', jobFilter.join(','));
    if (fromPeriodYear) q.set('sinceYear', fromPeriodYear);
    const data = await fetchJson(`/api/dashboard/headcount-trend?${q.toString()}`);
    const fmt = pk => { const [y, m] = pk.split('-'); return new Date(+y, +m - 1, 1).toLocaleString('default', { month: 'short', year: '2-digit' }); };
    wfHeadcountTrendChart = mkChart(wfHeadcountTrendChart, 'wfHeadcountTrendChart', {
        type: 'line',
        data: {
            labels: data.map(d => fmt(d.label)),
            datasets: [{ data: data.map(d => d.value), borderColor: ChartColors.SERIES.PRIMARY, backgroundColor: ChartColors.SERIES_FILL.PRIMARY, tension: 0.35, fill: true, pointRadius: 3, pointHoverRadius: 6 }]
        },
        options: {
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: { enabled: true, callbacks: { label: c => ` ${c.formattedValue} ${wfL.employeesSuffix}` } }
            },
            // min:4000 (not beginAtZero) — headcount is never realistically near
            // zero, so starting the axis there just wastes space on a flat gap.
            scales: { x: { grid: { display: false }, ticks: { color: '#5B5875' } }, y: { min: 4000, grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875', stepSize: 200 } } }
        }
    });
}

/* Headcount by store, with a simple gender mix per store -------------- */
function wfRenderMixChips(breakdown, colorFor) {
    const total = Object.values(breakdown).reduce((s, v) => s + v, 0) || 1;
    return Object.entries(breakdown).map(([label, value]) => {
        const pct = Math.round(value / total * 100);
        return `<span><span class="wf-store-gender-dot" style="background:${colorFor(label)}"></span>${sapEscape(label)} ${pct}%</span>`;
    }).join(' ');
}

function wfRenderStoreTable(rows) {
    const tbody = document.getElementById('wfStoreTableBody');
    if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">' + wfL.noData + '</td></tr>'; return; }
    tbody.innerHTML = rows.map(r => {
        const genderHtml  = wfRenderMixChips(r.genderBreakdown, l => ChartColors.GENDER_COLORS[l] || ChartColors.hashColor(l));
        const payrollHtml = wfRenderMixChips(r.payrollGroupBreakdown || {}, l => ChartColors.PAYROLL_GROUP_COLORS[l] || ChartColors.hashColor(l));
        return `<tr>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.storeName)}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2"><div class="wf-store-gender-mini">${genderHtml}</div></td>
            <td class="px-3 py-2"><div class="wf-store-gender-mini">${payrollHtml || '—'}</div></td>
        </tr>`;
    }).join('');
}

async function wfLoadStoreTable() {
    wfSetTitleBadge('wfStoreBreakdownTitle', false);
    if (!periodMonth || !periodYear) return;
    const q = new URLSearchParams({ month: periodMonth, year: periodYear });
    if (omFilter) q.set('om', omFilter);
    if (ocFilter) q.set('oc', ocFilter);
    if (socFilter) q.set('soc', socFilter);
    if (odFilter) q.set('od', odFilter);
    if (jobFilter.length) q.set('jobs', jobFilter.join(','));
    const data = await fetchJson(`/api/dashboard/store-headcount-breakdown?${q.toString()}`);
    wfRenderStoreTable(data);
}

/* OC / OM tables (reusing the same rendering approach as Turnover) ------- */
let wfTurnoverColorRules = null;
function wfRenderOcOmTable(tbodyId, rows) {
    const tbody = document.getElementById(tbodyId);
    if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted">' + wfL.noData + '</td></tr>'; return; }
    tbody.innerHTML = rows.map(r => {
        const badge = ChartColors.rateBadgeHtml(wfTurnoverColorRules, r.avgTurnoverRate);
        return `<tr>
            <td class="px-3 py-2 fw-semibold">${sapEscape(r.name)}</td>
            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.totalHeadcount}</td>
            <td class="px-3 py-2 text-center">${badge}</td>
        </tr>`;
    }).join('');
}

async function wfLoadOcOm() {
    wfSetTitleBadge('wfOcTitle', true);
    wfSetTitleBadge('wfOdTitle', true);
    wfSetTitleBadge('wfOmTitle', true);
    wfSetTitleBadge('wfSocTitle', true);
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/oc-om-analysis?${buildQuery()}`);
    wfRenderOcOmTable('ocTableBody', data.ocRows);
    wfRenderOcOmTable('omTableBody', data.omRows);
    wfRenderOcOmTable('socTableBody', data.socRows);
    wfRenderOcOmTable('odTableBody', data.odRows);
}

/* Uses dashboard.js's shared #periodSelect/#fromPeriodSelect/#storeSelect/
   #omSelect/#ocSelect filter bar (periodMonth/periodYear/fromPeriodMonth/
   fromPeriodYear/storeFilter/omFilter/ocFilter/buildQuery()) — the same
   continuous From→To range used on every other page. dashboard.js's own
   loadCharts() and loadKpis() are not used here — this page has its own
   versions of both — invoked via loadAll below, which dashboard.js's
   loadPeriods() (called at the bottom of dashboard.js) triggers once
   periods are loaded. */
loadAll = async function () {
    if (!wfTurnoverColorRules) wfTurnoverColorRules = await ChartColors.loadRateRules('turnover');
    await Promise.all([
        wfLoadKpis(),
        wfLoadJobTitleChart(),
        wfLoadPayrollChart(),
        wfLoadTenureChart(),
        wfLoadGenderChart(),
        wfLoadHeadcountTrend(),
        wfLoadStoreTable(),
        wfLoadOcOm()
    ]);
};
</script>
