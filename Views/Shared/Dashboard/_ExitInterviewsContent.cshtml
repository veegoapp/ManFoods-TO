    const ctx = document.getElementById('eiReasonsTrendChart');
    if (!ctx) return;
    if (eiReasonsTrendChart) eiReasonsTrendChart.destroy();
    if (!data.length) return;
    const reasons = Object.keys(data[0].counts || {});
    // Assigned by position (not by label hash) so every reason present in
    // this chart is guaranteed a distinct color from the palette — a hash
    // lookup can send two different reasons to the same slot.
    const colors = reasons.map((_, i) => ChartColors.CATEGORICAL_PALETTE[i % ChartColors.CATEGORICAL_PALETTE.length]);
    eiReasonsTrendChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: data.map(d => d.label),
            datasets: reasons.map((reason, i) => ({
                label: reason,
                data: data.map(d => d.counts[reason] ?? 0),
                borderColor: colors[i],
                backgroundColor: 'transparent',
                tension: 0.3, pointRadius: 3, spanGaps: true,
            })),
        },
        options: {
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { position: 'bottom', labels: { color: 'oklch(0.5 0.03 258)', font: { size: 10.5 }, boxWidth: 10 } },
                tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}` } },
                datalabels: { display: false },
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: 'oklch(0.5 0.03 258)' } },
                y: { beginAtZero: true, ticks: { color: 'oklch(0.5 0.03 258)', precision: 0 }, grid: { color: 'oklch(0.92 0.008 255)' } },
            },
        },
    });
}

