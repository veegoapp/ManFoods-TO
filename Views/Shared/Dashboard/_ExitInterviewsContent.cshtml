    const returnPct = returnTotal > 0 ? Math.round(yes / returnTotal * 100) : 0;

    el.innerHTML = `
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-chat-square-text-fill"></i></div><div class="kpi-value">${eiSentimentData.totalResponses}</div><div class="kpi-label">@L["EI_TotalInterviews"]</div><div class="kpi-desc">${eiL.kpiTotalDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-emoji-smile-fill"></i></div><div class="kpi-value" style="color:${eiDriverTone(eiSentimentData.positivePercent)}">${eiSentimentData.positivePercent.toFixed(1)}%</div><div class="kpi-label">@L["EI_PositiveSentiment"]</div><div class="kpi-desc">${eiL.kpiPositiveDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-box-arrow-right"></i></div><div class="kpi-value" style="font-size:16px">${topReason ? sapEscape(topReason.label) : '—'}</div><div class="kpi-label">@L["EI_TopReason"]</div><div class="kpi-desc">${topReason && reasonTotal > 0 ? eiL.kpiTopReasonDesc.replace('{0}', Math.round(topReason.value / reasonTotal * 100)) : eiL.noDataShort}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-arrow-repeat"></i></div><div class="kpi-value" style="color:${eiDriverTone(returnPct)}">${returnPct}%</div><div class="kpi-label">@L["EI_WouldReturnRate"]</div><div class="kpi-desc">${eiL.kpiReturnDesc}</div></div>
    `;
}

function eiRenderInsights() {
    const el = document.getElementById('eiInsights');
    if (!eiSentimentData || !eiSentimentData.totalResponses) { el.innerHTML = '<div class="text-muted" style="font-size:13px">' + eiL.noInterviewData + '</div>'; return; }
    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: ChartColors.SEMANTIC.GOOD, text: ChartColors.SEMANTIC.GOOD },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
    };
    const items = [];

    items.push({
        icon: 'bi-emoji-smile-fill', color: eiSentimentData.positivePercent >= 70 ? 'success' : eiSentimentData.positivePercent >= 40 ? 'warning' : 'danger',
        title: eiL.insightSentimentTitle,
        description: eiL.insightSentimentDesc
            .replace('{0}', eiSentimentData.positivePercent.toFixed(1))
            .replace('{1}', eiSentimentData.totalResponses),
    });

    const reasonTotal = eiReasonsData.reduce((s, d) => s + d.value, 0);
    if (eiReasonsData.length && reasonTotal > 0) {
        const top = eiReasonsData[0];
        items.push({
            icon: 'bi-box-arrow-right', color: 'warning',
            title: eiL.insightTopReasonTitle,
            description: eiL.insightTopReasonDesc
                .replace('{0}', top.label)
                .replace('{1}', Math.round(top.value / reasonTotal * 100))
                .replace('{2}', top.value)
                .replace('{3}', reasonTotal),
        });
    }

    if (eiDriversData.length) {
        const best = eiDriversData[eiDriversData.length - 1];
        const worst = eiDriversData[0];
        if (worst) items.push({
            icon: 'bi-exclamation-triangle-fill', color: 'danger',
            title: eiL.insightWeakestTitle,
            description: eiL.insightWeakestDesc
                .replace('{0}', worst.label)
                .replace('{1}', worst.positivePercent)
                .replace('{2}', worst.totalResponses),
        });
        if (best && best.label !== worst?.label) items.push({
            icon: 'bi-hand-thumbs-up-fill', color: 'success',
            title: eiL.insightStrongestTitle,
            description: eiL.insightStrongestDesc
                .replace('{0}', best.label)
                .replace('{1}', best.positivePercent)
                .replace('{2}', best.totalResponses),
        });
    }

    // item.title/description are escaped once below, at render — any
    // dynamic value folded into them above (e.g. top.label) must stay
    // unescaped at construction time, or it double-encodes here.
    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6">
            <div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
                    <div>
                        <div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
                        <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('') + '</div>';
}

let eiCommentsData = [];

/* Generic sortable-header wiring — each table tracks its own sort key/dir,
   same pattern as the Early Warning page's High Risk / Watch List tables. */
const eiSortState = {}; // tableId -> { key, dir }

function eiSortValue(row, key) {
    return (row[key] || '').toString().toLowerCase();
}

function eiApplySort(tableId, rows) {
    const state = eiSortState[tableId];
    if (!state || !state.key) return rows;
    return rows.slice().sort((a, b) => {
        const va = eiSortValue(a, state.key), vb = eiSortValue(b, state.key);
        if (va < vb) return state.dir === 'asc' ? -1 : 1;
        if (va > vb) return state.dir === 'asc' ? 1 : -1;
        return 0;
    });
}

function eiWireSortHeaders(tableId, renderFn) {
    const table = document.getElementById(tableId).closest('table');
    table.querySelectorAll('.ei-sort-header').forEach(th => {
        th.addEventListener('click', () => {
            const key = th.dataset.sortKey;
            const state = eiSortState[tableId] || { key: null, dir: 'asc' };
            state.dir = (state.key === key && state.dir === 'asc') ? 'desc' : 'asc';
            state.key = key;
            eiSortState[tableId] = state;
            table.querySelectorAll('.ei-sort-header').forEach(h => h.classList.remove('ei-sort-asc', 'ei-sort-desc'));
            th.classList.add(state.dir === 'asc' ? 'ei-sort-asc' : 'ei-sort-desc');
            renderFn();
        });
    });
}

function eiPopulateQuestionFilter() {
    const sel = document.getElementById('eiCommentQuestionFilter');
    const current = sel.value;
    const questions = [...new Set(eiCommentsData.map(c => c.questionLabel))].sort();
    sel.innerHTML = `<option value="">@L["EI_AllQuestions"]</option>` + questions.map(q => `<option value="${q}">${q}</option>`).join('');
    sel.value = questions.includes(current) ? current : '';
}

function eiCommentRowsHtml(rows, includeQuestionCol) {
    return rows.map(c => `
        <tr>
            <td class="px-3 py-2 fw-semibold">${c.store ? sapEscape(c.store) : '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2" style="color:var(--text-2)">${c.storeLeader ? sapEscape(c.storeLeader) : '<span class="text-muted">—</span>'}</td>
            ${includeQuestionCol ? `<td class="px-3 py-2" style="white-space:nowrap;color:var(--text-2)">${sapEscape(c.questionLabel)}</td>` : ''}
            <td class="px-3 py-2">${sapEscape(c.text)}</td>
        </tr>`).join('');
}

function eiRenderComments() {
    const search = (document.getElementById('eiCommentSearch').value || '').toLowerCase();
    const questionFilter = document.getElementById('eiCommentQuestionFilter').value;
    let rows = eiCommentsData.filter(c =>
        (!questionFilter || c.questionLabel === questionFilter) &&
        (c.text.toLowerCase().includes(search) ||
        (c.store || '').toLowerCase().includes(search) ||
        (c.questionLabel || '').toLowerCase().includes(search))
    );
    rows = eiApplySort('eiCommentsBody', rows);
    const labels = document.querySelector('[data-comments-count-label]').dataset;
    const badge = document.getElementById('eiCommentCountBadge');
    if (badge) badge.textContent = `${rows.length} ${labels.commentsCountLabel}`;

    const tbody = document.getElementById('eiCommentsBody');
    if (!rows.length) { tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">${labels.noCommentsLabel}</td></tr>`; return; }
    tbody.innerHTML = eiCommentRowsHtml(rows, true);
}

/* "What They Would Change" — same shape as the Comments table above, fixed
   to just that one free-text question. */
const EI_CHANGE_QUESTION_LABEL = "What They'd Change";
function eiRenderChangeComments() {
    const search = (document.getElementById('eiChangeCommentSearch').value || '').toLowerCase();
    let rows = eiCommentsData.filter(c =>
        c.questionLabel === EI_CHANGE_QUESTION_LABEL &&
        (c.text.toLowerCase().includes(search) || (c.store || '').toLowerCase().includes(search))
    );
    rows = eiApplySort('eiChangeCommentsBody', rows);
    const labels = document.querySelector('[data-comments-count-label]').dataset;
    const badge = document.getElementById('eiChangeCommentCountBadge');
    if (badge) badge.textContent = `${rows.length} ${labels.commentsCountLabel}`;

    const tbody = document.getElementById('eiChangeCommentsBody');
    if (!rows.length) { tbody.innerHTML = `<tr><td colspan="3" class="text-center py-4 text-muted">${labels.noCommentsLabel}</td></tr>`; return; }
    tbody.innerHTML = eiCommentRowsHtml(rows, false);
}

eiWireSortHeaders('eiCommentsBody', eiRenderComments);
eiWireSortHeaders('eiChangeCommentsBody', eiRenderChangeComments);

async function eiLoadComments() {
    eiCommentsData = await eiFetch('comments');
    eiPopulateQuestionFilter();
    eiRenderComments();
    eiRenderChangeComments();
}

async function eiLoadAll() {
    // Allow eiYear=0 (undated sentinel). Only bail if year is genuinely unset.
    if (eiYear === null || eiYear === undefined) return;
    if (eiYear > 0 && !eiMonths.length) return;
    await Promise.all([
        eiLoadReasons(), eiLoadReturn(), eiLoadExperience(), eiLoadTraining(), eiLoadFairTreatment(),
        eiLoadWorkload(), eiLoadWorkPressure(), eiLoadDrivers(), eiLoadComments(), eiLoadSentiment(),
        eiLoadJobTitleChart(), eiLoadReasonsTrendChart(), eiLoadReasonReturnChart(),
    ]);
    eiRenderSummary();
    eiRenderInsights();
}

document.getElementById('eiCommentSearch').addEventListener('input', eiRenderComments);
document.getElementById('eiCommentQuestionFilter').addEventListener('change', eiRenderComments);
document.getElementById('eiChangeCommentSearch').addEventListener('input', eiRenderChangeComments);

(async function init() {
    const hasData = await eiLoadFilters();
    if (hasData) await eiLoadAll();
})();
</script>
