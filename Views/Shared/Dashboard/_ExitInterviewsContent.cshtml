function eiYesTotal(data) {
    const YES = ['yes', 'y', 'true', 'نعم'];
    const yes = data.find(d => YES.includes((d.label || '').trim().toLowerCase()));
    const total = data.reduce((s, d) => s + d.value, 0);
    return { yes: yes ? yes.value : 0, total };
}

function eiRenderSummary() {
    const el = document.getElementById('eiSummaryCards');
    if (!eiSentimentData || eiSentimentData.totalResponses === undefined) { el.innerHTML = ''; return; }
