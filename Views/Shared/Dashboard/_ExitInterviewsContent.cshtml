/* Initial filter load ------------------------------------------------------ */
async function eiLoadFilters() {
    const [opts, periods, jobs] = await Promise.all([
        fetch('/api/exit-interviews/filters').then(r => r.ok ? r.json() : {}),
        fetch('/api/exit-interviews/available-periods').then(r => r.ok ? r.json() : []),
        fetch('/api/dashboard/job-titles').then(r => r.ok ? r.json() : []),
    ]);

    const hasData = (periods || []).length > 0;
    document.getElementById('eiEmptyState').style.display = hasData ? 'none' : '';
    document.getElementById('eiContent').style.display = hasData ? '' : 'none';
    if (!hasData) return false;

    eiYearMonthsMap = {};
    (periods || []).forEach(p => { (eiYearMonthsMap[p.year] = eiYearMonthsMap[p.year] || []).push(p.month); });
    const years = Object.keys(eiYearMonthsMap).map(Number).sort((a, b) => b - a);
    const yearSel = document.getElementById('eiYearSelect');
    // year=0 is the "undated" sentinel — show a friendly label instead of "0".
    yearSel.innerHTML = years.map(y => `<option value="${y}">${y === 0 ? 'All Data' : y}</option>`).join('');
    eiYear = years[0];
    yearSel.value = eiYear;
    eiMonths = (eiYearMonthsMap[eiYear] || []).slice().sort((a, b) => a - b);
    // When the sentinel period is active hide the months multi-select (there
    // is no meaningful month breakdown for undated rows).
    document.getElementById('eiMonthsMultiselect').style.display = eiYear === 0 ? 'none' : '';
    eiBuildMonthsOptions();
    eiRenderMonthsChips();

    eiStoreCombo.setOptions(opts.stores || []);
    eiLeaderCombo.setOptions(opts.storeLeaders || []);
    eiOcCombo.setOptions(opts.operationConsultants || []);
    eiOmCombo.setOptions(opts.operationManagers || []);
    if (eiJobPanel) {
        eiJobPanel.innerHTML = (jobs || []).map(job => `
            <label class="job-filter-option">
                <input type="checkbox" value="${sapEscape(job)}" ${eiJobFilter.includes(job) ? 'checked' : ''}>
                <span>${sapEscape(job)}</span>
            </label>`).join('') || '<div class="job-filter-empty">No jobs available</div>';
    }
    return true;
}

let eiReasonsChart, eiReturnChart, eiExperienceChart, eiTrainingChart, eiFairTreatmentChart, eiWorkloadChart, eiWorkPressureChart;
// colorMode: 'categorical' (default, hash-by-label) | 'yesno' | 'likert' — see chart-colors.js.
function eiMkChart(ref, id, labels, values, horizontal, colorMode) {
    if (ref) ref.destroy();
    const ctx = document.getElementById(id);
    if (!ctx) return null;
    if (horizontal) {
        return new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: { labels, datasets: [{ data: values, backgroundColor: ChartColors.colorsByLabel(labels, null), borderRadius: 4, maxBarThickness: 26 }] },
            options: { indexAxis: 'y', maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.formattedValue} response(s)` } }, datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' } }, scales: { x: { grid: { color: 'oklch(0.92 0.008 255)' }, ticks: { color: 'oklch(0.5 0.03 258)' } }, y: { grid: { display: false }, ticks: { color: 'oklch(0.5 0.03 258)' } } } }
        });
    }
    const colors = colorMode === 'yesno'  ? ChartColors.colorsByYesNo(labels)
                 : colorMode === 'likert' ? ChartColors.colorsByLikert(labels)
                 :                          ChartColors.colorsByLabel(labels);
    return new Chart(ctx.getContext('2d'), {
        type: 'doughnut',
        data: { labels, datasets: [{ data: values, backgroundColor: colors, borderWidth: 2, borderColor: 'oklch(1 0 0)' }] },
        options: { cutout: '60%', maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: 'oklch(0.5 0.03 258)', boxWidth: 10, boxHeight: 10, padding: 12, font: { size: 11 } } }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.formattedValue} response(s)` } }, datalabels: { color: '#fff', font: { size: 11, weight: '700' }, textShadowBlur: 4, textShadowColor: 'rgba(0,0,0,0.4)', formatter: (v, ctx) => { const t = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0); return t > 0 && v > 0 ? Math.round(v / t * 100) + '%' : ''; } } } }
    });
}

