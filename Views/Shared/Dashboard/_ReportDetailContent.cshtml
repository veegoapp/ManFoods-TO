<script>
const rdPeriods = @Html.Raw(periodsJson);
const __AREA_PREFIX = '@__areaPrefix';
const RD_REPORT_ID = '@rep.Id';

function rdUpdateMonths() {
    const yearEl = document.getElementById('rd-year');
    if (!yearEl) return;
    const year = parseInt(yearEl.value);
    const sel  = document.getElementById('rd-month');
    const prev = parseInt(sel.value) || 0;
    sel.innerHTML = '';
    rdPeriods.filter(p => p.year === year).forEach(p => {
        const o = document.createElement('option');
        o.value = p.month;
        o.textContent = p.label;
        if (p.month === prev) o.selected = true;
        sel.appendChild(o);
    });
}

/* Generic multi-select checkbox dropdown — uses event delegation on the
   options container so callers (e.g. the Months multiselect) can rebuild
   the checkbox list on the fly via setOptionsHtml() without re-wiring. */
function rdCreateMultiselect(prefix) {
    const root    = document.getElementById(`rd-${prefix}-ms`);
    if (!root) return { getSelected: () => [], setOptionsHtml: () => {} };
    const trigger = document.getElementById(`rd-${prefix}-trigger`);
    const panel   = document.getElementById(`rd-${prefix}-panel`);
    const chips   = document.getElementById(`rd-${prefix}-chips`);
    const optionsEl = document.getElementById(`rd-${prefix}-options`);
    const allLabel = root.dataset.allLabel;
    const checkboxes = () => Array.from(optionsEl.querySelectorAll('input[type=checkbox]'));

    function renderChips() {
        const selected = checkboxes().filter(cb => cb.checked).map(cb => cb.dataset.label || cb.value);
        if (selected.length === 0) { chips.textContent = allLabel; return; }
        chips.textContent = selected.length <= 2 ? selected.join('، ') : `${selected[0]}، ${selected[1]} +${selected.length - 2}`;
    }

    optionsEl.addEventListener('change', (e) => { if (e.target.matches('input[type=checkbox]')) renderChips(); });
    trigger.addEventListener('click', (e) => { e.stopPropagation(); panel.classList.toggle('open'); });
    document.addEventListener('click', (e) => { if (!root.contains(e.target)) panel.classList.remove('open'); });
    document.getElementById(`rd-${prefix}-selectall`)?.addEventListener('click', () => {
        checkboxes().forEach(cb => cb.checked = true); renderChips();
    });
    document.getElementById(`rd-${prefix}-clearall`)?.addEventListener('click', () => {
        checkboxes().forEach(cb => cb.checked = false); renderChips();
    });

    return {
        getSelected: () => checkboxes().filter(cb => cb.checked).map(cb => cb.value),
        setOptionsHtml: (html) => { optionsEl.innerHTML = html; renderChips(); },
    };
}

const rdStoreMs  = rdCreateMultiselect('store');
const rdOmMs     = rdCreateMultiselect('om');
const rdOcMs     = rdCreateMultiselect('oc');
const rdSocMs    = rdCreateMultiselect('soc');
const rdOdMs     = rdCreateMultiselect('od');
const rdMonthsMs = rdCreateMultiselect('months');
const rdJobMs    = rdCreateMultiselect('job');

const RD_MONTH_NAMES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthNames));

/* Months multiselect is tied to the "since year" select — options are
   whichever months actually have data in that year. */
function rdUpdateMonthsMultiselect() {
    const yearEl = document.getElementById('rd-since-year');
    if (!yearEl) return;
    const year = parseInt(yearEl.value);
    const months = rdPeriods.filter(p => p.year === year).map(p => p.month).sort((a, b) => a - b);
    const html = months.map(m =>
        `<label class="rd-ms-option"><input type="checkbox" value="${m}" data-label="${RD_MONTH_NAMES[m - 1]}"><span>${RD_MONTH_NAMES[m - 1]}</span></label>`
    ).join('');
    rdMonthsMs.setOptionsHtml(html);
}

function rdResetFilters() {
    const yearEl = document.getElementById('rd-year');
    if (yearEl) { yearEl.selectedIndex = 0; rdUpdateMonths(); }
    const sinceYearEl = document.getElementById('rd-since-year');
    if (sinceYearEl) { sinceYearEl.selectedIndex = 0; rdUpdateMonthsMultiselect(); }
    ['months', 'store', 'job', 'om', 'oc', 'soc', 'od'].forEach(p => document.getElementById(`rd-${p}-clearall`)?.click());
    if (RD_REPORT_ID === 'comparisons') rdInitComparisonSides();
}

/* Comparison (Period A vs Period B) report — independent year/months/store/
   OM/OC/SOC/OD per side. Leaving a side's Year unset (the "Default" option)
   lets the server pick the same default as the Comparisons dashboard page
   (A = latest year, all months; B = the same months one year earlier). */
const rdYears = Array.from(new Set(rdPeriods.map(p => p.year))).sort((a, b) => b - a);
const rdMonthsAMs = rdCreateMultiselect('months-a');
const rdMonthsBMs = rdCreateMultiselect('months-b');

function rdUpdateComparisonMonths(side) {
    const yearEl = document.getElementById(`rd-year-${side}`);
    const ms = side === 'a' ? rdMonthsAMs : rdMonthsBMs;
    if (!yearEl || !yearEl.value) { ms.setOptionsHtml(''); return; }
    const year = parseInt(yearEl.value);
    const months = rdPeriods.filter(p => p.year === year).map(p => p.month).sort((a, b) => a - b);
    ms.setOptionsHtml(months.map(m =>
        `<label class="rd-ms-option"><input type="checkbox" value="${m}" data-label="${RD_MONTH_NAMES[m - 1]}"><span>${RD_MONTH_NAMES[m - 1]}</span></label>`
    ).join(''));
}

function rdInitComparisonSides() {
    ['a', 'b'].forEach(side => {
        const yearEl = document.getElementById(`rd-year-${side}`);
        if (!yearEl) return;
        yearEl.innerHTML = '<option value="">' + '@L["Common_Default"]' + '</option>'
            + rdYears.map(y => `<option value="${y}">${y}</option>`).join('');
        ['store', 'om', 'oc', 'soc', 'od'].forEach(f => { const el = document.getElementById(`rd-${f}-${side}`); if (el) el.selectedIndex = 0; });
        rdUpdateComparisonMonths(side);
    });
}

const RD_PREPARING = '@L["Common_Preparing"]';
const RD_FAILED = '@L["Common_DownloadFailed"]';
let rdDownloading = false;

/* The export is built on the server and can take a while. Download it through fetch so the button stays
   disabled until the file arrives: a second click would otherwise start the same heavy request again. */
async function rdStartDownload(url) {
    if (rdDownloading) return;
    const btn = document.querySelector('.rep-dl-btn');
    const label = btn ? btn.innerHTML : '';
    rdDownloading = true;
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>' + RD_PREPARING; }
    try {
        const r = await fetch(url, { credentials: 'same-origin' });
        if (!r.ok || !/spreadsheet|octet-stream/i.test(r.headers.get('Content-Type') || '')) throw new Error();
        const m = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(r.headers.get('Content-Disposition') || '');
        const blob = await r.blob();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = m ? decodeURIComponent(m[1]) : 'report.xlsx';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 10000);
    } catch {
        alert(RD_FAILED);
    } finally {
        rdDownloading = false;
        if (btn) { btn.disabled = false; btn.innerHTML = label; }
    }
}

function rdDownload() {
    const p = new URLSearchParams({ reportType: RD_REPORT_ID });

    if (RD_REPORT_ID === 'comparisons') {
        const yearA = document.getElementById('rd-year-a')?.value;
        if (yearA) p.set('year', yearA);
        const monthsA = rdMonthsAMs.getSelected();
        if (monthsA.length) p.set('months', monthsA.join(','));
        const yearB = document.getElementById('rd-year-b')?.value;
        if (yearB) p.set('yearB', yearB);
        const monthsB = rdMonthsBMs.getSelected();
        if (monthsB.length) p.set('monthsB', monthsB.join(','));
        ['store', 'om', 'oc', 'soc', 'od'].forEach(f => {
            const a = document.getElementById(`rd-${f}-a`)?.value;
            if (a) p.set(f, a);
            const b = document.getElementById(`rd-${f}-b`)?.value;
            if (b) p.set(f === 'store' ? 'storeB' : `${f}B`, b);
        });
        rdStartDownload(__AREA_PREFIX + '/dashboard/export?' + p.toString());
        return;
    }

    const yearEl = document.getElementById('rd-year');
    const monthEl = document.getElementById('rd-month');
    if (yearEl && monthEl) { p.set('year', yearEl.value); p.set('month', monthEl.value); }

    const sinceYearEl = document.getElementById('rd-since-year');
    if (sinceYearEl) p.set('year', sinceYearEl.value);

    const selectedStores = rdStoreMs.getSelected();
    if (selectedStores.length) p.set('store', selectedStores.join(','));

    const selectedOms = rdOmMs.getSelected();
    if (selectedOms.length) p.set('om', selectedOms.join(','));

    const selectedOcs = rdOcMs.getSelected();
    if (selectedOcs.length) p.set('oc', selectedOcs.join(','));

    const selectedSocs = rdSocMs.getSelected();
    if (selectedSocs.length) p.set('soc', selectedSocs.join(','));

    const selectedOds = rdOdMs.getSelected();
    if (selectedOds.length) p.set('od', selectedOds.join(','));

    const selectedMonths = rdMonthsMs.getSelected();
    if (selectedMonths.length) p.set('months', selectedMonths.join(','));

    const selectedJobs = rdJobMs.getSelected();
    if (selectedJobs.length) p.set('jobs', selectedJobs.join(','));

    rdStartDownload(__AREA_PREFIX + '/dashboard/export?' + p.toString());
}

rdUpdateMonths();
rdUpdateMonthsMultiselect();
if (RD_REPORT_ID === 'comparisons') rdInitComparisonSides();
</script>
