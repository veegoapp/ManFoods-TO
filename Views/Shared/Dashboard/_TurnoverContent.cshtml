@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
}
<style>
/* ── Turnover filter bar ─────────────────────────────────── */
.tv-filterbar { display:flex; flex-wrap:wrap; gap:14px; align-items:flex-end; }
.tv-filter-group { display:flex; flex-direction:column; gap:5px; }
.tv-filter-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--text-3); }

.tv-select-wrap { position:relative; }
.tv-select {
    appearance:none; -webkit-appearance:none;
    background:var(--card-bg); border:1px solid var(--card-border); color:var(--text);
    border-radius:var(--radius-sm); font-size:13.5px; font-weight:600;
    height:42px; padding:0 34px 0 14px; min-width:110px;
    box-shadow:var(--shadow-sm); cursor:pointer; transition:border-color .15s, box-shadow .15s;
}
.tv-select:focus { outline:none; border-color:var(--red); box-shadow:0 0 0 3px var(--red-light); }
.tv-select-wrap i { position:absolute; top:50%; right:12px; transform:translateY(-50%); font-size:11px; color:var(--text-3); pointer-events:none; }
[dir="rtl"] .tv-select { padding:0 14px 0 34px; }
[dir="rtl"] .tv-select-wrap i { right:auto; left:12px; }

/* Mini "top driver" callout inside a chart card header */
.tv-stat-callout { font-size:12.5px; color:var(--text-2); margin-top:4px; }
.tv-stat-callout .tv-stat-highlight { color:var(--red); font-weight:700; }

/* Gender chart: doughnut + side breakdown list */
.tv-gender-body { display:flex; align-items:center; gap:18px; height:220px; }
.tv-gender-canvas-wrap { flex:0 0 44%; height:100%; position:relative; }
.tv-gender-list { flex:1; display:flex; flex-direction:column; gap:10px; }
.tv-gender-row { display:flex; align-items:center; gap:9px; font-size:13px; color:var(--text-2); }
.tv-gender-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.tv-gender-label { flex:1; }
.tv-gender-value { font-weight:700; color:var(--text); }
.tv-gender-pct { font-weight:500; color:var(--text-3); }

@@media (max-width: 640px) {
    .tv-gender-body { flex-direction:column; height:auto; }
    .tv-gender-canvas-wrap { flex:0 0 auto; width:100%; height:180px; }
}

/* Chart.js draws its tick/legend text on <canvas>, which otherwise inherits
   the page's dir="rtl" and reorders labels like "<3m" into "m3<". */
.chart-body canvas, .tv-gender-canvas-wrap canvas { direction:ltr; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_Turnover"]</h1>
        <p class="page-subtitle">@L["Page_TurnoverSub"]</p>
    </div>
    <div class="tv-filterbar">
        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_From"]</span>
            <div class="tv-select-wrap">
                <select id="fromPeriodSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_To"]</span>
            <div class="tv-select-wrap">
                <select id="periodSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_StoreName"]</span>
            <div class="tv-select-wrap">
                <select id="storeSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_OperationManager"]</span>
            <div class="tv-select-wrap">
                <select id="omSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_OperationConsultant"]</span>
            <div class="tv-select-wrap">
                <select id="ocSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_SeniorOperationConsultants"]</span>
            <div class="tv-select-wrap">
                <select id="socSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_OperationDirectors"]</span>
            <div class="tv-select-wrap">
                <select id="odSelect" class="tv-select"></select>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <div class="tv-filter-group">
            <span class="tv-filter-label">@L["Common_JobTitle"]</span>
            <div class="job-filter-wrap">
                <button type="button" id="jobSelectButton" class="job-filter-button" aria-haspopup="listbox" aria-expanded="false">
                    <span id="jobSelectLabel">@L["Common_JobTitle"]</span><i class="bi bi-chevron-down"></i>
                </button>
                <div id="jobSelectPanel" class="job-filter-panel" hidden></div>
            </div>
        </div>

        <button type="button" class="reset-filters-btn" onclick="resetFilters()">
            <i class="bi bi-arrow-counterclockwise"></i>@L["Common_ResetFilters"]
        </button>
    </div>
</div>

@{
    var turnoverGuide = new PageGuideViewModel
    {
        PageKey = "turnover",
        Overview = L["Guide_Turnover_Overview"],
        FilterNote = L["Guide_Turnover_FilterNote"],
        Sections = new List<PageGuideSection>
        {
            new() { Icon = "bi-calendar3", Title = L["Chart_TurnoverByMonth"], Body = L["Guide_Turnover_Chart_ByMonth"] },
            new() { Icon = "bi-person-lines-fill", Title = L["Chart_TurnoverByJobTitle"], Body = L["Guide_Turnover_Chart_JobTitle"] },
            new() { Icon = "bi-hourglass-split", Title = L["Chart_TurnoverByTenure"], Body = L["Guide_Turnover_Chart_Tenure"] },
            new() { Icon = "bi-cash-coin", Title = L["Chart_TurnoverByPayroll"], Body = L["Guide_Turnover_Chart_Payroll"] },
            new() { Icon = "bi-gender-ambiguous", Title = L["Chart_GenderBreakdown"], Body = L["Guide_Turnover_Chart_Gender"] },
            new() { Icon = "bi-chat-left-text", Title = L["Chart_ReasonsForLeaving"], Body = L["Guide_Turnover_Chart_Reasons"] },
            new() { Icon = "bi-graph-up-arrow", Title = L["Chart_MonthlyTrend"], Body = L["Guide_Turnover_Chart_Trend"] },
            new() { Icon = "bi-table", Title = L["Common_StoreComparison"], Body = L["Guide_Turnover_Chart_StoreTable"] },
            new() { Icon = "bi-people", Title = L["Common_ByOcOm"], Body = L["Guide_Turnover_Chart_OcOm"] },
            new() { Icon = "bi-grid-3x3", Title = L["Common_FullDataTable"], Body = L["Guide_Turnover_Chart_Matrix"] },
        }
    };
}
@await Html.PartialAsync("~/Views/Shared/Dashboard/_PageGuide.cshtml", turnoverGuide)

<!-- ── KPI Cards ───────────────────────────────────────────── -->
<div id="kpiCards" class="kpi-grid mb-4">
    <div class="kpi-spinner text-center py-3 w-100">
        <div class="spinner-border spinner-border-sm" style="color:oklch(0.5 0.18 25)"></div>
    </div>
</div>
<p id="tvKpiRangeNote" class="text-muted-custom small mb-3" style="margin-top:-10px"></p>

<!-- ── Smart Insights ─────────────────────────────────────── -->
<div class="d-flex align-items-center gap-2 mb-3">
    <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
    <h5 class="mb-0 fw-bold">@L["Common_SmartInsights"]</h5>
    <span class="badge ms-1" style="background:oklch(0.6 0.16 25);color:#1C1C27;font-size:10px;padding:4px 8px">@L["Common_AutoGenerated"]</span>
    <i class="bi bi-info-circle" tabindex="0" title="@L["Common_TurnoverOver100Info"]" style="cursor:help;color:var(--text-3);font-size:14px"></i>
</div>
<div id="insightsContainer" class="mb-4">
    <div class="row g-3">
        <div class="col-12 text-center py-3 text-muted">
            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.22 22)"></div>@L["Common_LoadingInsights"]
        </div>
    </div>
</div>

<!-- ── Turnover Rate by Month (per-month formula, all-time — not affected by the period filter) ── -->
<div class="chart-card mb-4" style="border-radius:14px">
    <div class="chart-header">
        <h6 id="tvByMonthTitle">@L["Chart_TurnoverByMonth"]</h6>
        <p>@L["Chart_TurnoverByMonthSub"]</p>
    </div>
    <div class="chart-body"><canvas id="turnoverByMonthChart" style="max-height:240px"></canvas></div>
</div>

<!-- ── Charts ────────────────────────────────────────────── -->
<div class="charts-grid mb-4">
    <div class="chart-card">
        <div class="chart-header">
            <h6 id="tvJobTitleTitle">@L["Chart_TurnoverByJobTitle"]</h6>
            <p>@L["Chart_TurnoverByJobTitleSub"]</p>
            <div id="jobTitleTopStat" class="tv-stat-callout"></div>
        </div>
        <div class="chart-body"><canvas id="jobTitleChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6 id="tvTenureTitle">@L["Chart_TurnoverByTenure"]</h6><p>@L["Chart_TurnoverByTenureSub"]</p></div>
        <div class="chart-body"><canvas id="tenureChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header">
            <h6 id="tvPayrollTitle">@L["Chart_TurnoverByPayroll"]</h6><p>@L["TV_PayrollSub"]</p>
            <div id="payrollTopStat" class="tv-stat-callout"></div>
        </div>
        <div class="chart-body"><canvas id="payrollGroupChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6 id="tvGenderTitle">@L["Chart_GenderBreakdown"]</h6><p>@L["Chart_GenderBreakdownSub"]</p></div>
        <div class="tv-gender-body">
            <div class="tv-gender-canvas-wrap"><canvas id="genderChart"></canvas></div>
            <div class="tv-gender-list" id="genderStatsList"></div>
        </div>
    </div>
</div>

<!-- ── Reasons for Leaving (all resignations in the selected period) ── -->
<div class="chart-card mb-4">
    <div class="chart-header"><h6 id="tvReasonsTitle">@L["Chart_ReasonsForLeaving"]</h6><p>@L["TV_ReasonsSub"]</p></div>
    <div class="chart-body"><canvas id="reasonsChart" style="max-height:260px"></canvas></div>
</div>

<!-- ── Monthly Trend Chart (always full history from selected year onward) ── -->
<div class="chart-card mb-4" style="border-radius:14px">
    <div class="chart-header d-flex align-items-center justify-content-between">
        <div>
            <h6 id="tvTrendTitle">@L["Chart_MonthlyTrend"]</h6>
            <p id="trendChartSubtitle">@L["Chart_MonthlyTrendSub"]</p>
        </div>
        <a href="@__areaPrefix/dashboard/reports" class="btn btn-sm" style="background:rgba(218,41,28,.12);color:oklch(0.5 0.18 25);border:1px solid rgba(218,41,28,.3);font-size:12px;border-radius:7px">
            <i class="bi bi-download me-1"></i>@L["Common_Export"]
        </a>
    </div>
    <div class="chart-body"><canvas id="trendChart" style="max-height:260px"></canvas></div>
</div>

<!-- ── Store Comparison Table ─────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
        <h5 class="mb-0 fw-bold" id="tvStoreComparisonTitle">@L["Common_StoreComparison"]</h5>
        <span id="storeCountBadge" class="badge" style="background:var(--bg-2);color:var(--text-2);font-size:11px"></span>
    </div>
    <input type="text" id="storeSearch" class="form-control form-control-sm"
           placeholder="&#xF52A; @L["Common_SearchStore"]" style="width:220px;border-radius:20px">
</div>
<div class="chart-card mb-4 p-0" style="overflow:hidden">
    <div class="table-responsive" style="max-height:400px;overflow-y:auto">
        <table id="storeTable" class="table table-hover mb-0" style="font-size:13px">
            <thead style="background:var(--bg-2);border-bottom:2px solid var(--card-border);position:sticky;top:0;z-index:1">
                <tr>
                    <th class="tv-sort px-3 py-2" data-col="storeName" style="cursor:pointer;min-width:160px">
                        @L["Common_StoreName"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2" data-col="operationConsultant" style="cursor:pointer">
                        @L["Common_OC"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2" data-col="operationManager" style="cursor:pointer">
                        @L["Common_OM"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2 text-center" data-col="headcount" style="cursor:pointer">
                        @L["Common_Headcount"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2 text-center" data-col="newHires" style="cursor:pointer">
                        @L["Common_NewHires"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2 text-center" data-col="resignations" style="cursor:pointer">
                        @L["Common_Resignations"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                    <th class="tv-sort px-3 py-2 text-center" data-col="turnoverRate" style="cursor:pointer">
                        @L["Common_TurnoverPct"] <i class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>
                    </th>
                </tr>
            </thead>
            <tbody id="storeTableBody">
                <tr><td colspan="7" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.22 22)"></div>@L["Common_Loading"]
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ── OC / OM Analysis ───────────────────────────────────── -->
<div class="d-flex align-items-center gap-2 mb-3">
    <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
    <h5 class="mb-0 fw-bold">@L["Common_ByOcOm"]</h5>
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="chart-card oc-analysis-card p-0 h-100 d-flex flex-column" style="overflow:hidden;min-height:0">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon role-icon role-icon-oc" data-role="OC"><i class="bi bi-person-fill"></i></span>
                <div>
                    <h6 class="mb-0" id="tvOcTitle">@L["Common_OperationConsultants"]</h6>
                    <p class="mb-0">@L["TV_RankedByWeighted"]</p>
                </div>
            </div>
            <div class="table-responsive" style="flex:1;overflow-y:auto;min-height:0">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                        <tr>
                            <th class="px-3 py-2">@L["Common_Name"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Stores"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Headcount"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Resignations"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_TurnoverPct"]</th>
                        </tr>
                    </thead>
                    <tbody id="ocTableBody">
                        <tr><td colspan="5" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.22 22)"></div>@L["Common_Loading"]
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6 d-flex flex-column gap-3">
        <div class="chart-card p-0" style="overflow:hidden">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon role-icon role-icon-od" data-role="OD"><i class="bi bi-person-fill"></i></span>
                <div>
                    <h6 class="mb-0" id="tvOdTitle">@L["Common_OperationDirectors"]</h6>
                    <p class="mb-0">@L["TV_RankedByWeighted"]</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2)">
                        <tr>
                            <th class="px-3 py-2">@L["Common_Name"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Stores"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Headcount"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Resignations"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_TurnoverPct"]</th>
                        </tr>
                    </thead>
                    <tbody id="odTableBody">
                        <tr><td colspan="5" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 250)"></div>@L["Common_Loading"]
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="chart-card p-0" style="overflow:hidden">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon role-icon role-icon-om" data-role="OM"><i class="bi bi-person-fill"></i></span>
                <div>
                    <h6 class="mb-0" id="tvOmTitle">@L["Common_OperationManagers"]</h6>
                    <p class="mb-0">@L["TV_RankedByWeighted"]</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2)">
                        <tr>
                            <th class="px-3 py-2">@L["Common_Name"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Stores"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Headcount"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Resignations"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_TurnoverPct"]</th>
                        </tr>
                    </thead>
                    <tbody id="omTableBody">
                        <tr><td colspan="5" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.16 25)"></div>@L["Common_Loading"]
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="chart-card p-0" style="overflow:hidden">
            <div class="chart-header stat-card-header">
                <span class="stat-card-icon role-icon role-icon-soc" data-role="SOC"><i class="bi bi-person-fill"></i></span>
                <div>
                    <h6 class="mb-0" id="tvSocTitle">@L["Common_SeniorOperationConsultants"]</h6>
                    <p class="mb-0">@L["TV_RankedByWeighted"]</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2)">
                        <tr>
                            <th class="px-3 py-2">@L["Common_Name"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Stores"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Headcount"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_Resignations"]</th>
                            <th class="px-3 py-2 text-center">@L["Common_TurnoverPct"]</th>
                        </tr>
                    </thead>
                    <tbody id="socTableBody">
                        <tr><td colspan="5" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.55 0.2 300)"></div>@L["Common_Loading"]
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ── Full Data Table (Trend Matrix) — always from selected year to latest upload ── -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <div style="width:4px;height:22px;background:linear-gradient(135deg,oklch(0.44 0.18 25),oklch(0.6 0.16 25));border-radius:2px"></div>
        <h5 class="mb-0 fw-bold" id="tvTrendMatrixTitle">@L["Common_FullDataTable"]</h5>
        <span class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px">@L["TV_AllPeriodsBadge"]</span>
    </div>
    <input type="text" id="matrixSearch" class="form-control form-control-sm"
           placeholder="&#xF52A; @L["Common_SearchStoreOc"]" style="width:220px;border-radius:20px">
</div>
<div class="chart-card mb-4 p-0" style="overflow:hidden">
    <div id="matrixScroll" style="max-height:450px;overflow:auto">
        <table id="matrixTable" class="table table-hover mb-0" style="font-size:12.5px;min-width:600px">
            <thead id="matrixHead" style="background:var(--bg-2);position:sticky;top:0;z-index:2">
                <tr>
                    <th class="px-3 py-2" style="min-width:50px;cursor:pointer" data-mcol="oc"
                        onclick="mxSort('oc')">@L["Common_OC"] <i id="mxi-oc" class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <th class="px-3 py-2" style="min-width:160px;cursor:pointer" data-mcol="store"
                        onclick="mxSort('store')">@L["Common_Store"] <i id="mxi-store" class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                    <!-- period columns injected by JS -->
                    <th class="px-3 py-2 text-center" style="min-width:70px;cursor:pointer;background:oklch(0.5 0.18 25 / .08)" data-mcol="total"
                        onclick="mxSort('total')">@L["Common_TotalUpper"] <i id="mxi-total" class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i></th>
                </tr>
            </thead>
            <tbody id="matrixBody">
                <tr><td colspan="3" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.22 22)"></div>@L["Common_LoadingShort"]
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<div id="tvL" hidden
     data-stores-suffix="@L["Common_StoresCountSuffix"]"
     data-no-matching-stores="@L["Common_NoMatchingStores"]"
     data-no-data="@L["Common_NoData"]"
     data-no-insights="@L["TV_NoInsights"]"
     data-spike-header-singular="@L["TV_SpikeHeaderSingular"]"
     data-spike-header-plural="@L["TV_SpikeHeaderPlural"]"
     data-resignations-suffix="@L["Common_ResignationsCountSuffix"]"
     data-turnover-pct-label="@L["Common_TurnoverPctLabel"]"
     data-kpi-resignations="@L["Common_Resignations"]"
     data-kpi-resignations-desc="@L["TV_KpiResignationsDesc"]"
     data-kpi-turnover="@L["Common_TurnoverRate"]"
     data-kpi-turnover-desc="@L["TV_KpiTurnoverDesc"]"
     data-kpi-trend="@L["TV_KpiTrend"]"
     data-kpi-trend-desc="@L["TV_KpiTrendDesc"]"
     data-kpi-range-note="@L["TV_KpiRangeNote"]"
     data-loading-short="@L["Common_LoadingShort"]"
     data-no-data-available="@L["Common_NoDataAvailable"]"
     data-trend-subtitle-store="@L["TV_TrendSubtitleStore"]"
     data-trend-subtitle-top6="@L["TV_TrendSubtitleTop6"]"></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Turnover Analytics — uses dashboard.js's shared continuous From→To
   period filter (#periodSelect/#fromPeriodSelect/#storeSelect/#omSelect/
   #ocSelect + periodMonth/periodYear/fromPeriodMonth/fromPeriodYear/
   storeFilter/omFilter/ocFilter/buildQuery()) instead of a page-specific
   discrete Year+Months picker, so the same range filter behaves identically
   across every page. dashboard.js's own loadPeriods() (called at the bottom
   of dashboard.js) drives initial load. */

function tvMonthShortName(m) {
    return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' });
}

/* Same title-badge helper as the Workforce page (rangeFilterBadge lives in
   dashboard.js) — captures each title's original text once, so repeated
   loadAll() calls on filter change don't stack badges. */
const tvTitleBase = {};
function tvSetTitleBadge(id, affected) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!(id in tvTitleBase)) tvTitleBase[id] = el.textContent;
    el.innerHTML = tvTitleBase[id] + ' ' + rangeFilterBadge(isPeriodRangeActive(), affected);
}

/* Expands the selected From→To range into an ordered list of {month, year}. */
function tvExpandRange(fromM, fromY, toM, toY) {
    if (!fromM || !fromY || !toM || !toY) return [];
    let m = fromM, y = fromY;
    if (y > toY || (y === toY && m > toM)) { [m, y, toM, toY] = [toM, toY, m, y]; }
    const out = [];
    while (y < toY || (y === toY && m <= toM)) {
        out.push({ month: m, year: y });
        m++; if (m > 12) { m = 1; y++; }
    }
    return out;
}

const __AREA_PREFIX = '@__areaPrefix';

// Deep link from the Stores page cards: /turnover?store=Downtown. Set before
// dashboard.js's in-flight loadPeriods()/loadStores() resume (single-threaded
// JS: this synchronous code runs before those awaited continuations do).
const __urlStore = new URLSearchParams(window.location.search).get('store');
if (__urlStore) storeFilter = __urlStore;

const _tvOrigLoadStores = loadStores;
loadStores = async function () {
    await _tvOrigLoadStores();
    if (storeFilter) {
        const sel = document.getElementById('storeSelect');
        if (sel) sel.value = storeFilter;
    }
};

/* ── Extra sections (Smart Insights, Store Comparison, OC/OM, Payroll chart) ── */
const tvL = document.getElementById('tvL').dataset;
let tvStoreData = [], tvSortCol = 'turnoverRate', tvSortAsc = false;

/* Admin-configurable via the Settings page (loaded once in loadAll below). */
let tvTurnoverColorRules = null;
let tvTurnoverTotalColorRules = null;
function tvRateColor(rate) {
    const c = ChartColors.rateColor(tvTurnoverColorRules, rate);
    return { bg: c.bg || 'transparent', fg: c.fg || 'var(--text)' };
}
function tvTotalRateColor(rate) {
    const c = ChartColors.rateColor(tvTurnoverTotalColorRules, rate);
    return { bg: c.bg || 'transparent', fg: c.fg || 'var(--text)' };
}

/* Store Comparison ----------------------------------------- */
function tvRenderStoreTable() {
    const search = (document.getElementById('storeSearch').value || '').toLowerCase();
    let rows = tvStoreData.filter(r =>
        r.storeName.toLowerCase().includes(search) ||
        (r.operationConsultant || '').toLowerCase().includes(search) ||
        (r.operationManager    || '').toLowerCase().includes(search)
    );
    rows.sort((a, b) => {
        const va = a[tvSortCol], vb = b[tvSortCol];
        if (typeof va === 'string') return tvSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
        return tvSortAsc ? va - vb : vb - va;
    });

    const badge = document.getElementById('storeCountBadge');
    if (badge) badge.textContent = rows.length + ' ' + tvL.storesSuffix;

    const tbody = document.getElementById('storeTableBody');
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">' + tvL.noMatchingStores + '</td></tr>';
        return;
    }
    tbody.innerHTML = rows.map(r => {
        const c = tvRateColor(r.turnoverRate);
        const rateBadge = `<span style="background:${c.bg};color:${c.fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${r.turnoverRate.toFixed(1)}%</span>`;
        return `<tr>
            <td class="px-3 py-2 fw-semibold"><a href="${__AREA_PREFIX}/dashboard/turnover?store=${encodeURIComponent(r.storeName)}" style="color:inherit;text-decoration:none" onmouseover="this.style.color='oklch(0.5 0.18 25)'" onmouseout="this.style.color='inherit'">${sapEscape(r.storeName)}</a></td>
            <td class="px-3 py-2" style="color:var(--text-2)">${r.operationConsultant ? sapEscape(r.operationConsultant) : '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2" style="color:var(--text-2)">${r.operationManager ? sapEscape(r.operationManager) : '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.GOOD};font-weight:600">+${r.newHires}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.BAD};font-weight:600">${r.resignations}</td>
            <td class="px-3 py-2 text-center">${rateBadge}</td>
        </tr>`;
    }).join('');
}

async function tvLoadStoreComparison() {
    tvSetTitleBadge('tvStoreComparisonTitle', true);
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/store-comparison?${buildQuery()}`);
    tvStoreData = data || [];
    tvRenderStoreTable();
}

/* OC / OM Analysis ----------------------------------------- */
function tvRenderOcOmTable(tbodyId, rows) {
    const tbody = document.getElementById(tbodyId);
    if (!rows || !rows.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">' + tvL.noData + '</td></tr>';
        return;
    }
    tbody.innerHTML = rows.map((r, i) => {
        const c     = tvRateColor(r.avgTurnoverRate);
        const badge = `<span style="background:${c.bg};color:${c.fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${r.avgTurnoverRate.toFixed(1)}%</span>`;
        const rank  = i === 0 ? `<span style="color:${ChartColors.SEMANTIC.BAD}">▲</span>` : i === 1 ? `<span style="color:${ChartColors.SEMANTIC.WARNING_STRONG}">▲</span>` : '<span style="color:#aaa">•</span>';
        return `<tr>
            <td class="px-3 py-2">${rank} <span class="fw-semibold">${sapEscape(r.name)}</span></td>
            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.totalHeadcount}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.BAD};font-weight:600">${r.totalResignations}</td>
            <td class="px-3 py-2 text-center">${badge}</td>
        </tr>`;
    }).join('');
}

async function tvLoadOcOmAnalysis() {
    tvSetTitleBadge('tvOcTitle', true);
    tvSetTitleBadge('tvOdTitle', true);
    tvSetTitleBadge('tvOmTitle', true);
    tvSetTitleBadge('tvSocTitle', true);
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/oc-om-analysis?${buildQuery()}`);
    tvRenderOcOmTable('ocTableBody', data.ocRows);
    tvRenderOcOmTable('omTableBody', data.omRows);
    tvRenderOcOmTable('socTableBody', data.socRows);
    tvRenderOcOmTable('odTableBody', data.odRows);
}

/* Smart Insights ------------------------------------------- */
async function tvLoadSmartInsights() {
    if (!periodMonth || !periodYear) return;
    const items     = await fetchJson(`/api/dashboard/smart-insights?${buildQuery()}`);
    const container = document.getElementById('insightsContainer');

    if (!items || !items.length) {
        container.innerHTML = '<div class="row g-3"><div class="col-12"><div class="alert alert-secondary py-2">' + tvL.noInsights + '</div></div></div>';
        return;
    }

    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' }
    };

    function tvInsightCard(item) {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6 col-xl-4">
            <div style="background:${c.bg};border-left:4px solid ${c.border};border-radius:8px;padding:14px 16px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:17px"></i>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:${c.text};margin-bottom:3px">${sapEscape(item.title)}</div>
                        <div style="font-size:12.5px;color:var(--text-2);line-height:1.55">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }

    // Three rows, grouped by what the insight is about — not just insertion
    // order — so the layout stays stable regardless of which insights fire:
    // 1) headline (highest/best store + overall trend), 2) leadership
    // (highest OC/OM/OD), 3) the up-to-3 spiking stores, labeled so it's
    // clear why the same "Turnover Spike" title can repeat.
    const primary    = items.filter(i => i.group === 'primary');
    const leadership = items.filter(i => i.group === 'leadership');
    const spike      = items.filter(i => i.group === 'spike');

    let html = '';
    if (primary.length)    html += `<div class="row g-3">${primary.map(tvInsightCard).join('')}</div>`;
    if (leadership.length) html += `<div class="row g-3 mt-1">${leadership.map(tvInsightCard).join('')}</div>`;
    if (spike.length) {
        html += `<div class="d-flex align-items-center gap-2 mt-3 mb-2">
            <i class="bi bi-lightning-charge-fill" style="color:${ChartColors.SEMANTIC.WARNING};font-size:13px"></i>
            <span style="font-size:11.5px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px">${(spike.length > 1 ? tvL.spikeHeaderPlural : tvL.spikeHeaderSingular).replace('{0}', spike.length)}</span>
        </div>`;
        html += `<div class="row g-3">${spike.map(tvInsightCard).join('')}</div>`;
    }
    container.innerHTML = html;
}

/* Wire up sort headers ------------------------------------- */
document.querySelectorAll('#storeTable .tv-sort').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (tvSortCol === col) { tvSortAsc = !tvSortAsc; }
        else { tvSortCol = col; tvSortAsc = (col === 'storeName' || col === 'operationConsultant' || col === 'operationManager'); }
        document.querySelectorAll('#storeTable .tv-sort i').forEach(i => i.className = 'bi bi-arrow-down-up text-muted');
        const icon = th.querySelector('i');
        if (icon) icon.className = tvSortAsc ? 'bi bi-sort-up text-danger' : 'bi bi-sort-down text-danger';
        tvRenderStoreTable();
    });
});

/* Search filter -------------------------------------------- */
document.getElementById('storeSearch').addEventListener('input', tvRenderStoreTable);

/* "Top driver" mini-callout beside a chart card header ----- */
function tvRenderTopStat(elId, data) {
    const el = document.getElementById(elId);
    if (!el) return;
    if (!data || !data.length) { el.innerHTML = ''; return; }
    const total = data.reduce((s, d) => s + d.value, 0);
    const top   = data.slice().sort((a, b) => b.value - a.value)[0];
    const pct   = total > 0 ? Math.round(top.value / total * 100) : 0;
    el.innerHTML = `<span class="tv-stat-highlight">${sapEscape(top.label)}</span> — ${top.value} (${pct}%)`;
}

async function tvLoadJobTitleStat() {
    const data = await fetchJson(`/api/dashboard/turnover-by-job-title?${buildQuery()}`);
    tvRenderTopStat('jobTitleTopStat', data);
}

/* Payroll Group chart --------------------------------------- */
let payrollGroupChart;
async function tvLoadPayrollGroupChart() {
    tvSetTitleBadge('tvPayrollTitle', true);
    const data = await fetchJson(`/api/dashboard/turnover-by-payroll-group?${buildQuery()}`);
    const payrollLabels = data.map(d => d.label);
    const payrollColors = ChartColors.colorsByLabel(payrollLabels, ChartColors.PAYROLL_GROUP_COLORS);
    payrollGroupChart = mkChart(payrollGroupChart, 'payrollGroupChart', {
        type: 'bar',
        data: { labels: payrollLabels, datasets: [{ data: data.map(d => d.value), backgroundColor: payrollColors, borderRadius: 4 }] },
        options: { indexAxis: 'y', plugins: {
            legend: { display: false },
            tooltip: { enabled: true, callbacks: { label: c => ` ${c.formattedValue} ${tvL.resignationsSuffix}` } },
            datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' } },
            scales: { x: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } }, y: { grid: { display: false }, ticks: { color: '#5B5875' } } } }
    });
    tvRenderTopStat('payrollTopStat', data);
}

/* Gender breakdown side list -------------------------------- */
async function tvLoadGenderStats() {
    const data = await fetchJson(`/api/dashboard/gender-breakdown?${buildQuery()}`);
    const el = document.getElementById('genderStatsList');
    if (!el) return;
    if (!data || !data.length) { el.innerHTML = ''; return; }
    const total = data.reduce((s, d) => s + d.value, 0);
    const genderColors = ChartColors.colorsByLabel(data.map(d => d.label), ChartColors.GENDER_COLORS);
    el.innerHTML = data.map((d, i) => {
        const pct = total > 0 ? Math.round(d.value / total * 100) : 0;
        return `<div class="tv-gender-row">
            <span class="tv-gender-dot" style="background:${genderColors[i]}"></span>
            <span class="tv-gender-label">${sapEscape(d.label)}</span>
            <span class="tv-gender-value">${d.value} <span class="tv-gender-pct">(${pct}%)</span></span>
        </div>`;
    }).join('');
}

/* Turnover Rate by Month — always ALL available months regardless of the
   From→To period filter (store/OM/OC filters still apply), one bar per
   month, each computed independently as resignations ÷ headcount for that
   single month. Each bar gets its own color instead of one solid color. */
let turnoverByMonthChart;
async function tvLoadTurnoverByMonthChart() {
    tvSetTitleBadge('tvByMonthTitle', false);
    const allPeriods = await fetchJson('/api/dashboard/available-periods');
    if (!allPeriods || !allPeriods.length) return;
    const sortedMonths = allPeriods.slice().sort((a, b) => (a.year * 100 + a.month) - (b.year * 100 + b.month));
    const results = await Promise.all(sortedMonths.map(({ month, year }) => {
        const q = new URLSearchParams({ year: year, months: month, month: month });
        if (storeFilter) q.set('store', storeFilter);
        if (omFilter)    q.set('om', omFilter);
        if (ocFilter)    q.set('oc', ocFilter);
        if (socFilter)   q.set('soc', socFilter);
        if (odFilter)    q.set('od', odFilter);
        if (jobFilter.length) q.set('jobs', jobFilter.join(','));
        return fetchJson(`/api/dashboard/kpis?${q.toString()}`);
    }));

    const monthLabels = sortedMonths.map(({ month, year }) => `${tvMonthShortName(month)} ${String(year).slice(-2)}`);
    const monthColors = ChartColors.colorsByLabel(monthLabels, null);
    turnoverByMonthChart = mkChart(turnoverByMonthChart, 'turnoverByMonthChart', {
        type: 'bar',
        data: {
            labels: monthLabels,
            datasets: [{
                label: tvL.turnoverPctLabel,
                data: results.map(r => r.turnoverRate || 0),
                backgroundColor: monthColors,
                borderRadius: 6,
                maxBarThickness: 46
            }]
        },
        options: {
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => `${ctx.parsed.y.toFixed(1)}%` } },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v.toFixed(1) + '%' : '' }
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: '#5B5875' } },
                y: { ticks: { color: '#5B5875', callback: v => v + '%' }, grid: { color: '#E4E2F5' } }
            }
        }
    });
}

/* Reasons for Leaving — all resignations in the selected period, from
   exit interviews (unlike the 90-Day page's version, not restricted to
   early leavers). Reuses the existing /api/exit-interviews/reasons endpoint,
   which only understands year + a discrete months list (not a continuous
   range) — translate the selected From→To range into that shape when it
   fits within a single year; otherwise fall back to the undated/all pool
   below, same as when the exit-interview data itself lacks parsed dates. */
let reasonsChartInstance;
async function tvLoadReasonsChart() {
    tvSetTitleBadge('tvReasonsTitle', true);
    const ctx = document.getElementById('reasonsChart');
    if (!ctx) return;
    if (reasonsChartInstance) reasonsChartInstance.destroy();
    if (!periodMonth || !periodYear) return;
    const q = new URLSearchParams();
    if (fromPeriodYear === periodYear) {
        const monthsInRange = tvExpandRange(fromPeriodMonth, fromPeriodYear, periodMonth, periodYear).map(p => p.month);
        q.set('year', periodYear);
        q.set('months', monthsInRange.join(','));
    }
    if (storeFilter) q.set('store', storeFilter);
    if (omFilter)    q.set('om', omFilter);
    if (ocFilter)    q.set('oc', ocFilter);
    if (socFilter)   q.set('soc', socFilter);
    if (odFilter)    q.set('od', odFilter);
    if (jobFilter.length) q.set('jobs', jobFilter.join(','));
    let data = await fetchJson(`/api/exit-interviews/reasons?${q.toString()}`) || [];
    // Exit interview submissions may lack a parsed date (month/year = 0) when the
    // Forms export didn't include a recognisable date column. In that case the
    // period filter above matches nothing — fall back to the undated pool so the
    // chart isn't silently empty just because the selected year has no dated rows.
    if (!data.length) {
        const qAll = new URLSearchParams();
        if (storeFilter) qAll.set('store', storeFilter);
        if (omFilter)    qAll.set('om', omFilter);
        if (ocFilter)    qAll.set('oc', ocFilter);
        if (socFilter)   qAll.set('soc', socFilter);
        if (odFilter)    qAll.set('od', odFilter);
        if (jobFilter.length) qAll.set('jobs', jobFilter.join(','));
        data = await fetchJson(`/api/exit-interviews/reasons?${qAll.toString()}`) || [];
    }
    if (!data.length) return;
    const reasonLabels = data.map(d => d.label);
    reasonsChartInstance = new Chart(ctx.getContext('2d'), {
        type: 'doughnut',
        data: { labels: reasonLabels, datasets: [{ data: data.map(d => d.value), backgroundColor: ChartColors.colorsByLabel(reasonLabels), borderWidth: 2, borderColor: 'oklch(1 0 0)' }] },
        options: { cutout: '60%', plugins: { legend: { position: 'bottom', labels: { color: 'oklch(0.5 0.03 258)', boxWidth: 10, boxHeight: 10, padding: 12, font: { size: 11 } } }, tooltip: { callbacks: { label: c => ` ${c.label}: ${c.formattedValue}` } }, datalabels: { color: '#fff', font: { size: 11, weight: '700' }, textShadowBlur: 4, textShadowColor: 'rgba(0,0,0,0.4)', formatter: (v, c) => { const t = c.chart.data.datasets[0].data.reduce((a, b) => a + b, 0); return t > 0 && v > 0 ? Math.round(v / t * 100) + '%' : ''; } } } }
    });
}

/* Turnover-page-specific KPI cards: Resignations, Turnover Rate, and a Trend
   card (current rate vs. the equivalent immediately-prior period) — replaces
   dashboard.js's default 4-card set (Total Headcount/New Hires are already
   shown on the Workforce page; repeating them here added nothing turnover-
   specific). Overriding the global loadKpis (rather than just not calling
   it) means _tvOrigLoadAll's internal loadKpis() call below picks this up
   too, since it resolves the function by name at call time. */
async function tvLoadKpis() {
    const kpiEl = document.getElementById('kpiCards');
    if (!kpiEl) return;
    const [kpi, trend] = await Promise.all([
        fetchJson('/api/dashboard/kpis?' + buildQuery()),
        fetchJson('/api/dashboard/turnover-trend?' + buildQuery())
    ]);
    const diff = trend && trend.hasPrevious ? Math.round((trend.currentRate - trend.previousRate) * 10) / 10 : null;
    const trendIcon  = diff === null ? 'bi-dash-circle' : diff > 0 ? 'bi-arrow-up-circle-fill' : diff < 0 ? 'bi-arrow-down-circle-fill' : 'bi-dash-circle-fill';
    const trendClass = diff === null ? '' : diff > 0 ? 'text-danger' : diff < 0 ? 'text-success' : '';
    const trendValue = diff === null ? '—' : `${diff > 0 ? '+' : ''}${diff.toFixed(1)}%`;
    kpiEl.innerHTML = `
        <div class="kpi-card"><div class="kpi-icon text-danger"><i class="bi bi-person-dash-fill"></i></div><div class="kpi-value text-danger">${kpi.totalResignations||0}</div><div class="kpi-label">${tvL.kpiResignations}</div><div class="kpi-desc">${tvL.kpiResignationsDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-graph-up"></i></div><div class="kpi-value">${(kpi.turnoverRate||0).toFixed(1)}%</div><div class="kpi-label">${tvL.kpiTurnover}</div><div class="kpi-desc">${tvL.kpiTurnoverDesc}</div></div>
        <div class="kpi-card"><div class="kpi-icon ${trendClass}"><i class="bi ${trendIcon}"></i></div><div class="kpi-value ${trendClass}">${trendValue}</div><div class="kpi-label">${tvL.kpiTrend}</div><div class="kpi-desc">${tvL.kpiTrendDesc}</div></div>
    `;
}
loadKpis = tvLoadKpis;

/* Hook everything into dashboard.js's loadAll() so it all refreshes together */
const _tvOrigLoadAll = loadAll;
loadAll = async function () {
    if (!tvTurnoverColorRules) tvTurnoverColorRules = await ChartColors.loadRateRules('turnover');
    if (!tvTurnoverTotalColorRules) tvTurnoverTotalColorRules = await ChartColors.loadRateRules('turnover-total');
    await _tvOrigLoadAll();
    tvSetTitleBadge('tvJobTitleTitle', true);
    tvSetTitleBadge('tvTenureTitle', true);
    tvSetTitleBadge('tvGenderTitle', true);
    tvSetTitleBadge('tvTrendTitle', false);
    tvSetTitleBadge('tvTrendMatrixTitle', false);
    const kpiNote = document.getElementById('tvKpiRangeNote');
    if (kpiNote) kpiNote.innerHTML = isPeriodRangeActive() ? rangeFilterBadge(true, true) + ' ' + tvL.kpiRangeNote : '';
    await Promise.all([
        tvLoadSmartInsights(),
        tvLoadStoreComparison(),
        tvLoadOcOmAnalysis(),
        tvLoadPayrollGroupChart(),
        tvLoadTrendMatrix(),
        tvLoadTurnoverByMonthChart(),
        tvLoadGenderStats(),
        tvLoadJobTitleStat(),
        tvLoadReasonsChart()
    ]);
};

/* ── Full Data Trend Matrix (unaffected by the Months multi-select —
   always spans from the selected Year to the latest uploaded period) ── */
let mxData = null;
let mxSortCol  = 'total';
let mxSortAsc  = false;

function fmtPeriod(pk) {
    const [y, m] = pk.split('-');
    return new Date(+y, +m - 1, 1).toLocaleString('default', { month: 'short', year: '2-digit' });
}

function mxRateCell(rate, rules = tvTurnoverColorRules) {
    if (rate === null || rate === undefined)
        return `<td class="px-2 py-2 text-center text-muted" style="color:#ccc">—</td>`;
    const c = ChartColors.rateColor(rules, rate);
    const cellColor = { bg: c.bg || 'transparent', fg: c.fg || 'var(--text)' };
    const style = cellColor.bg === 'transparent'
        ? 'font-weight:700;white-space:nowrap'
        : `background:${cellColor.bg};color:${cellColor.fg};padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap`;
    return `<td class="px-2 py-2 text-center">
        <span style="${style}">${rate.toFixed(1)}%</span>
    </td>`;
}

// Total = sum of this row's already-displayed monthly turnover-rate values
// (not a KPI/pooled rate) — reuses the same periodRates used for the monthly
// cells, treating a missing month (—) as 0 rather than skipping the row.
function mxTotalRate(row) {
    return mxData.periods.reduce((sum, pk) => sum + (row.periodRates[pk] ?? 0), 0);
}

function mxBuildHeader(periods) {
    const tr = document.querySelector('#matrixHead tr');
    const totalTh = tr.querySelector('[data-mcol="total"]');
    tr.querySelectorAll('[data-mcol^="p-"]').forEach(el => el.remove());

    periods.forEach(pk => {
        const th = document.createElement('th');
        th.className = 'px-2 py-2 text-center';
        th.style.cssText = 'min-width:72px;cursor:pointer;white-space:nowrap';
        th.dataset.mcol = `p-${pk}`;
        th.innerHTML = `${fmtPeriod(pk)} <i id="mxi-${pk}" class="bi bi-arrow-down-up text-muted" style="font-size:10px"></i>`;
        th.onclick = () => mxSort(`p-${pk}`);
        tr.insertBefore(th, totalTh);
    });
}

function mxRender() {
    if (!mxData) return;
    const search = (document.getElementById('matrixSearch').value || '').toLowerCase();

    let rows = mxData.rows.filter(r =>
        r.storeName.toLowerCase().includes(search) ||
        (r.operationConsultant || '').toLowerCase().includes(search)
    );

    rows.sort((a, b) => {
        let va, vb;
        if (mxSortCol === 'store') { va = a.storeName; vb = b.storeName; }
        else if (mxSortCol === 'oc') { va = a.operationConsultant || ''; vb = b.operationConsultant || ''; }
        else if (mxSortCol === 'total') { va = mxTotalRate(a); vb = mxTotalRate(b); }
        else {
            va = a.periodRates[mxSortCol.replace('p-', '')] ?? -1;
            vb = b.periodRates[mxSortCol.replace('p-', '')] ?? -1;
        }
        if (typeof va === 'string') return mxSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
        return mxSortAsc ? va - vb : vb - va;
    });

    const colSpan = 2 + mxData.periods.length + 1;
    if (!rows.length) {
        document.getElementById('matrixBody').innerHTML =
            `<tr><td colspan="${colSpan}" class="text-center py-4 text-muted">${tvL.noMatchingStores}</td></tr>`;
        return;
    }

    document.getElementById('matrixBody').innerHTML = rows.map(r => {
        const periodCells = mxData.periods.map(pk => mxRateCell(r.periodRates[pk])).join('');
        const totalCell = mxRateCell(mxTotalRate(r), tvTurnoverTotalColorRules)
            .replace('<td', '<td style="background:oklch(0.5 0.18 25 / .06)"');
        return `<tr>
            <td class="px-3 py-2" style="color:var(--text-2);white-space:nowrap">${r.operationConsultant ? sapEscape(r.operationConsultant) : '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2 fw-semibold" style="white-space:nowrap"><a href="${__AREA_PREFIX}/dashboard/turnover?store=${encodeURIComponent(r.storeName)}" style="color:inherit;text-decoration:none" onmouseover="this.style.color='oklch(0.5 0.18 25)'" onmouseout="this.style.color='inherit'">${sapEscape(r.storeName)}</a></td>
            ${periodCells}
            ${totalCell}
        </tr>`;
    }).join('');
}

function mxSort(col) {
    if (mxSortCol === col) { mxSortAsc = !mxSortAsc; }
    else { mxSortCol = col; mxSortAsc = (col === 'store' || col === 'oc'); }
    document.querySelectorAll('#matrixHead [data-mcol] i').forEach(i =>
        i.className = 'bi bi-arrow-down-up text-muted');
    const icon = document.querySelector(`#matrixHead [data-mcol="${col}"] i`);
    if (icon) icon.className = mxSortAsc ? 'bi bi-sort-up text-danger' : 'bi bi-sort-down text-danger';
    mxRender();
}

async function tvLoadTrendMatrix() {
    const body = document.getElementById('matrixBody');
    body.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.22 22)"></div>' + tvL.loadingShort + '</td></tr>';
    const q = new URLSearchParams();
    if (storeFilter) q.set('store', storeFilter);
    if (omFilter) q.set('om', omFilter);
    if (ocFilter) q.set('oc', ocFilter);
    if (socFilter) q.set('soc', socFilter);
    if (odFilter) q.set('od', odFilter);
    if (fromPeriodYear) q.set('sinceYear', fromPeriodYear);
    if (jobFilter.length) q.set('jobs', jobFilter.join(','));
    mxData = await fetchJson(`/api/dashboard/trend-matrix?${q.toString()}`);
    if (!mxData || !mxData.rows || !mxData.rows.length) {
        body.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">' + tvL.noDataAvailable + '</td></tr>';
        return;
    }
    mxBuildHeader(mxData.periods);
    mxRender();
    tvRenderTrendChart();
}

document.getElementById('matrixSearch').addEventListener('input', mxRender);

/* Monthly Trend Chart — single store when filtered, top 6 BY AVERAGE
   TURNOVER RATE (descending) when "All Stores". mxData.rows arrives from
   the server in plain alphabetical order (same rows the Full Data Table
   below re-sorts client-side) — this chart used to just slice the first 6
   of that alphabetical list, which had nothing to do with which stores
   actually mattered; sort by avgRate first so "top 6" means what it says. */
let trendChartInstance;
function tvRenderTrendChart() {
    if (!mxData || !mxData.periods || !mxData.periods.length) return;
    const colors = [
        ChartColors.SERIES.PRIMARY, ChartColors.SERIES.SECONDARY, ChartColors.SERIES.TERTIARY,
        ChartColors.SERIES.QUATERNARY, ChartColors.SERIES.QUINARY, ChartColors.SERIES.SKY
    ];
    const colorsFill = [
        ChartColors.SERIES_FILL.PRIMARY, ChartColors.SERIES_FILL.SECONDARY, ChartColors.SERIES_FILL.TERTIARY,
        ChartColors.SERIES_FILL.QUATERNARY, ChartColors.SERIES_FILL.QUINARY, ChartColors.SERIES_FILL.SKY
    ];
    const subtitle = document.getElementById('trendChartSubtitle');

    let rows;
    if (storeFilter) {
        rows = mxData.rows.filter(r => r.storeName === storeFilter);
        if (subtitle) subtitle.textContent = tvL.trendSubtitleStore.replace('{0}', storeFilter);
    } else {
        rows = mxData.rows.slice().sort((a, b) => (b.avgRate ?? -1) - (a.avgRate ?? -1)).slice(0, 6);
        if (subtitle) subtitle.textContent = tvL.trendSubtitleTop6;
    }

    const ctx = document.getElementById('trendChart');
    if (!ctx) return;
    if (trendChartInstance) trendChartInstance.destroy();
    trendChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: mxData.periods.map(fmtPeriod),
            datasets: rows.map((row, i) => ({
                label: row.storeName,
                data: mxData.periods.map(p => row.periodRates?.[p] ?? null),
                borderColor: colors[i % colors.length],
                backgroundColor: colorsFill[i % colorsFill.length],
                tension: 0.4,
                fill: false,
                pointRadius: 4,
                pointHoverRadius: 6,
                spanGaps: true
            }))
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { labels: { color: 'oklch(0.5 0.03 258)', font: { size: 11 } } },
                tooltip: { enabled: true, callbacks: { label: c => ` ${c.dataset.label}: ${c.formattedValue}%` } },
                datalabels: { display: false }
            },
            scales: {
                x: { ticks: { color: 'oklch(0.5 0.03 258)', font: { size: 11 } }, grid: { color: 'oklch(0.92 0.008 255)' } },
                y: { ticks: { color: 'oklch(0.5 0.03 258)', font: { size: 11 }, callback: v => v + '%' }, grid: { color: 'oklch(0.92 0.008 255)' } }
            }
        }
    });
}
</script>
