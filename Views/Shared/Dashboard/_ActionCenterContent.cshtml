@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";

    // Localized label maps handed to JS as one JSON object. System.Text.Json
    // escapes non-ASCII to \uXXXX, which JavaScript decodes correctly inside a
    // <script> block — avoiding the HTML numeric-entity problem that a bare
    // @@L[...] inside a JS string literal would hit for Arabic text.
    var acLabels = new Dictionary<string, object>
    {
        ["sev"] = new Dictionary<string, string>
        {
            ["Critical"] = L["ACH_Sev_Critical"].Value,
            ["High"] = L["ACH_Sev_High"].Value,
            ["Medium"] = L["ACH_Sev_Medium"].Value,
            ["Low"] = L["ACH_Sev_Low"].Value,
            ["Healthy"] = L["ACH_Sev_Healthy"].Value,
        },
        ["pillar"] = new Dictionary<string, string>
        {
            ["turnover"] = L["ACH_Pillar_turnover"].Value,
            ["early_attrition"] = L["ACH_Pillar_early_attrition"].Value,
            ["retention"] = L["ACH_Pillar_retention"].Value,
            ["engagement"] = L["ACH_Pillar_engagement"].Value,
            ["leadership"] = L["ACH_Pillar_leadership"].Value,
            ["workforce"] = L["ACH_Pillar_workforce"].Value,
        },
        ["driver"] = new Dictionary<string, string>
        {
            ["fair_treatment"] = L["ACH_Driver_fair_treatment"].Value,
            ["complaints_handling"] = L["ACH_Driver_complaints_handling"].Value,
            ["benefits_match"] = L["ACH_Driver_benefits_match"].Value,
            ["workload"] = L["ACH_Driver_workload"].Value,
            ["communication"] = L["ACH_Driver_communication"].Value,
            ["encourage_opinions"] = L["ACH_Driver_encourage_opinions"].Value,
            ["teamwork"] = L["ACH_Driver_teamwork"].Value,
            ["task_fit"] = L["ACH_Driver_task_fit"].Value,
            ["training"] = L["ACH_Driver_training"].Value,
            ["use_personal_abilities"] = L["ACH_Driver_use_personal_abilities"].Value,
        },
        ["ui"] = new Dictionary<string, string>
        {
            ["noData"] = L["ACH_NoMatchingStores"].Value,
            ["vs"] = L["ACH_Vs"].Value,
            ["storesSuffix"] = L["ACH_StoresSuffix"].Value,
            ["projectionPending"] = L["ACH_ProjectionPending"].Value,
            ["noData2"] = L["ACH_NoData"].Value,
            ["statusActive"] = L["SAP_StatusActive"].Value,
            ["statusResolved"] = L["SAP_StatusResolved"].Value,
            ["statusNone"] = L["SAP_StatusNone"].Value,
            ["healthLabel"] = L["ACH_ColHealth"].Value,
        },
        ["insight"] = new Dictionary<string, string>
        {
            ["allClearTitle"] = L["ACH_Insight_AllClearTitle"].Value,
            ["allClearDesc"] = L["ACH_Insight_AllClearDesc"].Value,
            ["criticalTitle"] = L["ACH_Insight_CriticalTitle"].Value,
            ["criticalDesc"] = L["ACH_Insight_CriticalDesc"].Value,
            ["topStoreTitle"] = L["ACH_Insight_TopStoreTitle"].Value,
            ["topStoreDesc"] = L["ACH_Insight_TopStoreDesc"].Value,
            ["driverTitle"] = L["ACH_Insight_DriverTitle"].Value,
            ["driverDesc"] = L["ACH_Insight_DriverDesc"].Value,
            ["stalledTitle"] = L["ACH_Insight_StalledTitle"].Value,
            ["stalledDesc"] = L["ACH_Insight_StalledDesc"].Value,
            ["projectionTitle"] = L["ACH_Insight_ProjectionTitle"].Value,
            ["projectionDesc"] = L["ACH_Insight_ProjectionDesc"].Value,
        },
    };
}
<style>
.ach-sort-header { cursor:pointer; user-select:none; white-space:nowrap; }
.ach-sort-header:hover { color:var(--red); }
.ach-sort-icon { font-size:10px; margin-left:4px; opacity:0.35; }
[dir="rtl"] .ach-sort-icon { margin-left:0; margin-right:4px; }
.ach-sort-header.ach-asc .ach-sort-icon, .ach-sort-header.ach-desc .ach-sort-icon { opacity:1; color:var(--red); }
.ach-sort-header.ach-asc .ach-sort-icon::before { content:"\f235"; }
.ach-sort-header.ach-desc .ach-sort-icon::before { content:"\f229"; }
.ach-sort-header:not(.ach-asc):not(.ach-desc) .ach-sort-icon::before { content:"\f229"; }
.chart-body canvas { direction:ltr; }

/* Health score chip — a compact gauge that reads at a glance. */
.ach-score { display:inline-flex; align-items:center; gap:9px; }
.ach-score-ring { width:40px; height:40px; flex-shrink:0; }
.ach-score-num { font-weight:800; font-size:15px; line-height:1; }
.ach-score-sub { font-size:10px; color:var(--text-3); }

/* The distinctive per-store pillar strip: six segments, one per pillar,
   coloured by that pillar's own severity — the multi-dimensional breakdown
   visible without opening the store. */
.ach-strip { display:flex; gap:3px; }
.ach-seg { width:16px; height:8px; border-radius:2px; background:var(--card-bg-2); }
.ach-seg[title] { cursor:default; }

.ach-badge { padding:3px 9px; border-radius:20px; font-size:10.5px; font-weight:700; white-space:nowrap; display:inline-block; }
.ach-store-link { text-decoration:none; color:inherit; font-weight:700; }
.ach-store-link:hover { color:var(--red); }
.ach-progress-track { background:var(--card-bg-2); border-radius:20px; height:6px; width:70px; overflow:hidden; }
.ach-progress-fill { height:100%; border-radius:20px; background:oklch(0.62 0.15 155); }
.ach-pri { font-variant-numeric:tabular-nums; font-weight:700; }
.ach-legend { display:flex; flex-wrap:wrap; gap:10px 16px; font-size:11.5px; color:var(--text-2); }
.ach-legend span { display:inline-flex; align-items:center; gap:6px; }
.ach-legend i { width:10px; height:10px; border-radius:3px; display:inline-block; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_ActionCenter"]</h1>
        <p class="page-subtitle">@L["ACH_Subtitle"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" id="achSearch" class="form-control form-control-dark form-control-sm"
               placeholder="&#xF52A; @L["Common_SearchStore"]" style="width:220px;border-radius:20px">
        <button type="button" class="reset-filters-btn" onclick="achReset()">
            <i class="bi bi-arrow-counterclockwise"></i>@L["Common_ResetFilters"]
        </button>
    </div>
</div>

@{
    var actionCenterGuide = new PageGuideViewModel
    {
        PageKey = "actioncenter",
        Overview = L["Guide_ACH_Overview"],
        FilterNote = L["Guide_ACH_FilterNote"],
        Sections = new List<PageGuideSection>
        {
            new() { Icon = "bi-heart-pulse", Title = L["ACH_HealthTitle"], Body = L["Guide_ACH_Section_Health"] },
            new() { Icon = "bi-bar-chart-steps", Title = L["ACH_ChartPillarImpact"], Body = L["Guide_ACH_Section_Pillars"] },
            new() { Icon = "bi-chat-left-dots", Title = L["ACH_ChartEngagement"], Body = L["Guide_ACH_Section_RootCause"] },
            new() { Icon = "bi-table", Title = L["ACH_TableTitle"], Body = L["Guide_ACH_Section_Scorecard"] },
            new() { Icon = "bi-calculator", Title = L["Guide_ACH_HowTitle"], Body = L["Guide_ACH_HowBody"] },
        }
    };
}
@await Html.PartialAsync("~/Views/Shared/Dashboard/_PageGuide.cshtml", actionCenterGuide)

<div id="achKpis" class="kpi-grid mb-4">
    <div class="kpi-spinner text-center py-3 w-100">
        <div class="spinner-border spinner-border-sm" style="color:oklch(0.5 0.18 25)"></div>
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-lightbulb-fill" style="color:oklch(0.75 0.16 75)"></i>
    <h5 class="mb-0 fw-bold">@L["Common_SmartInsights"]</h5>
    <span class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px">@L["Common_AutoGenerated"]</span>
</div>
<div class="chart-card mb-4"><div id="achInsights">
    <div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["Common_Loading"]</div>
</div></div>

<div class="charts-grid mb-4">
    <div class="chart-card">
        <div class="chart-header"><h6>@L["ACH_ChartPillarImpact"]</h6><p>@L["ACH_ChartPillarImpactSub"]</p></div>
        <div class="chart-body"><canvas id="achPillarChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["ACH_ChartEngagement"]</h6><p>@L["ACH_ChartEngagementSub"]</p></div>
        <div class="chart-body"><canvas id="achDriverChart"></canvas></div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <div class="section-accent"></div>
        <h5 class="mb-0 fw-bold">@L["ACH_TableTitle"]</h5>
        <span id="achCountBadge" class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px"></span>
    </div>
    <div class="ach-legend" id="achLegend"></div>
</div>
<div class="chart-card p-0" style="overflow:hidden">
    <div class="table-responsive" style="max-height:620px;overflow-y:auto">
        <table class="table table-hover mb-0" style="font-size:13px">
            <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                <tr>
                    <th class="px-3 py-2 ach-sort-header" data-sort-key="storeName">@L["ACH_ColStore"]<i class="bi ach-sort-icon"></i></th>
                    <th class="px-3 py-2 ach-sort-header" data-sort-key="healthScore">@L["ACH_ColHealth"]<i class="bi ach-sort-icon"></i></th>
                    <th class="px-3 py-2 ach-sort-header" data-sort-key="severityRank">@L["ACH_ColSeverity"]<i class="bi ach-sort-icon"></i></th>
                    <th class="px-3 py-2">@L["ACH_ColDriver"]</th>
                    <th class="px-3 py-2">@L["ACH_ColPillars"]</th>
                    <th class="px-3 py-2 ach-sort-header" data-sort-key="priorityScore">@L["ACH_ColPriority"]<i class="bi ach-sort-icon"></i></th>
                    <th class="px-3 py-2 ach-sort-header" data-sort-key="headcount">@L["ACH_ColHeadcount"]<i class="bi ach-sort-icon"></i></th>
                    <th class="px-3 py-2">@L["ACH_ColStatus"]</th>
                    <th class="px-3 py-2">@L["ACH_ColResponsible"]</th>
                    <th class="px-3 py-2">@L["ACH_ColProgress"]</th>
                </tr>
            </thead>
            <tbody id="achBody">
                <tr><td colspan="10" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["Common_Loading"]
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="charts-grid mb-4 mt-4">
    <div class="chart-card" style="grid-column:1 / -1">
        <div class="chart-header"><h6>@L["ACH_ChartTrend"]</h6><p>@L["ACH_ChartTrendSub"]</p></div>
        <div class="chart-body"><canvas id="achTrendChart"></canvas></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/store-action-plan.js" asp-append-version="true"></script>
<script>
const AC_L = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(acLabels));
const AC_AREA = '@__areaPrefix';
const AC_PILLARS = ['turnover','early_attrition','retention','engagement','leadership','workforce'];
const AC_SEV_RANK = { Critical:4, High:3, Medium:2, Low:1, Healthy:0 };

// Severity → colour. One scale used everywhere (score ring, tier badge, pillar
// segments) so the page reads as one system.
function achSevColor(sev) {
    switch (sev) {
        case 'Critical': return { c: ChartColors.SEMANTIC.BAD, bg: 'oklch(0.6 0.22 22 / .12)' };
        case 'High':     return { c: 'oklch(0.62 0.19 45)', bg: 'oklch(0.7 0.19 45 / .14)' };
        case 'Medium':   return { c: 'oklch(0.6 0.14 75)', bg: 'oklch(0.75 0.16 75 / .14)' };
        case 'Low':      return { c: 'oklch(0.58 0.09 90)', bg: 'oklch(0.8 0.09 90 / .18)' };
        default:         return { c: 'oklch(0.5 0.15 155)', bg: 'oklch(0.62 0.15 155 / .12)' };
    }
}
function achPillarSegColor(status) {
    return achSevColor(status === 'healthy' || status === 'no_data' ? 'Healthy' : status).c;
}
function achLabel(map, key) { return (AC_L[map] && AC_L[map][key]) || key; }

/* ── Score ring (mini donut gauge) ─────────────────────────────────────── */
function achRing(score, color) {
    const r = 15, c = 2 * Math.PI * r, off = c * (1 - Math.max(0, Math.min(100, score)) / 100);
    return `<svg class="ach-score-ring" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="${r}" fill="none" stroke="var(--card-bg-2)" stroke-width="5"/>
        <circle cx="20" cy="20" r="${r}" fill="none" stroke="${color}" stroke-width="5"
                stroke-linecap="round" stroke-dasharray="${c.toFixed(1)}" stroke-dashoffset="${off.toFixed(1)}"
                transform="rotate(-90 20 20)"/>
    </svg>`;
}

let achData = [];
let achSort = { key: 'priorityScore', dir: 'desc' };

async function achLoadSummary() {
    const s = await sapFetchJson('/api/store-action-plan/action-center/health/summary');
    if (!s) return;
    achRenderKpis(s);
    achRenderInsights(s);
    achRenderPillarChart(s.pillarImpact || []);
    achRenderDriverChart(s.engagementBreakdown || []);
    achRenderTrend(s.monthlyTrend || []);
    achRenderLegend();
}

function achRenderKpis(s) {
    const avg = s.avgHealthScore ?? 0;
    const avgColor = achSevColor(avg >= 88 ? 'Healthy' : avg >= 75 ? 'Low' : avg >= 58 ? 'Medium' : avg >= 40 ? 'High' : 'Critical').c;
    document.getElementById('achKpis').innerHTML = `
        <div class="kpi-card">
            <div class="d-flex align-items-center gap-2">${achRing(avg, avgColor)}<div><div class="kpi-value" style="color:${avgColor}">${avg}</div></div></div>
            <div class="kpi-label">@L["ACH_KpiAvgHealth"]</div><div class="kpi-desc">@L["ACH_KpiAvgHealthDesc"]</div>
        </div>
        <div class="kpi-card"><div class="kpi-icon text-danger"><i class="bi bi-exclamation-octagon-fill"></i></div><div class="kpi-value text-danger">${s.criticalCount}</div><div class="kpi-label">@L["ACH_KpiCritical"]</div><div class="kpi-desc">@L["ACH_KpiCriticalDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon" style="color:oklch(0.62 0.19 45)"><i class="bi bi-exclamation-triangle-fill"></i></div><div class="kpi-value" style="color:oklch(0.62 0.19 45)">${s.highCount}</div><div class="kpi-label">@L["ACH_KpiHigh"]</div><div class="kpi-desc">@L["ACH_KpiHighDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-clipboard-pulse"></i></div><div class="kpi-value">${s.activePlans}</div><div class="kpi-label">@L["ACH_KpiActivePlans"]</div><div class="kpi-desc">@L["ACH_KpiActivePlansDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-hourglass-bottom"></i></div><div class="kpi-value">${s.stalledCount}</div><div class="kpi-label">@L["ACH_KpiStalled"]</div><div class="kpi-desc">@L["ACH_KpiStalledDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-check2-circle"></i></div><div class="kpi-value">${s.resolvedThisMonth}</div><div class="kpi-label">@L["ACH_KpiResolved"]</div><div class="kpi-desc">@L["ACH_KpiResolvedDesc"]</div></div>
    `;
}

function achRenderInsights(s) {
    const el = document.getElementById('achInsights');
    const I = AC_L.insight;
    const colorMap = {
        danger: { bg:'oklch(0.6 0.22 22 / .08)', b:ChartColors.SEMANTIC.BAD, t:ChartColors.SEMANTIC.BAD },
        warning:{ bg:'oklch(0.75 0.16 75 / .12)', b:ChartColors.SEMANTIC.WARNING, t:'oklch(0.6 0.14 75)' },
        info:   { bg:'var(--bg-2)', b:'var(--text-3)', t:'var(--text-2)' },
        success:{ bg:'oklch(0.62 0.15 155 / .1)', b:'oklch(0.5 0.15 155)', t:'oklch(0.5 0.15 155)' },
    };
    const items = [];
    if ((s.storesEvaluated || 0) === 0 || (s.criticalCount + s.highCount + s.mediumCount) === 0) {
        items.push({ icon:'bi-check-circle-fill', color:'success', title:I.allClearTitle, desc:I.allClearDesc });
    } else {
        if (s.criticalCount > 0) items.push({ icon:'bi-exclamation-octagon-fill', color:'danger', title:I.criticalTitle, desc:`${s.criticalCount} ${I.criticalDesc}` });
        const top = (s.topPriority || [])[0];
        if (top) items.push({ icon:'bi-graph-up-arrow', color:'warning', title:I.topStoreTitle,
            desc:`${top.storeName} — ${I.topStoreDesc.replace('{0}', top.healthScore).replace('{1}', achLabel('pillar', top.topPillarKey || ''))}` });
        const drv = (s.engagementBreakdown || [])[0];
        if (drv && drv.negativePercent > 0) items.push({ icon:'bi-chat-left-dots-fill', color:'info', title:I.driverTitle,
            desc:`${achLabel('driver', drv.key)} — ${I.driverDesc.replace('{0}', drv.negativePercent)}` });
        if (s.stalledCount > 0) items.push({ icon:'bi-hourglass-bottom', color:'warning', title:I.stalledTitle, desc:`${s.stalledCount} ${I.stalledDesc}` });
        if (!s.hasProjectionData) items.push({ icon:'bi-graph-up', color:'info', title:I.projectionTitle, desc:I.projectionDesc });
    }
    el.innerHTML = '<div class="row g-3">' + items.map(it => {
        const c = colorMap[it.color] || colorMap.info;
        return `<div class="col-md-6"><div style="background:${c.bg};border-left:3px solid ${c.b};border-radius:8px;padding:12px 14px;height:100%">
            <div class="d-flex align-items-start gap-2"><i class="bi ${it.icon} mt-1 flex-shrink-0" style="color:${c.t};font-size:15px"></i>
            <div><div style="font-size:12.5px;font-weight:700;color:${c.t};margin-bottom:2px">${sapEscape(it.title)}</div>
            <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(it.desc)}</div></div></div></div></div>`;
    }).join('') + '</div>';
}

let achPillarInst, achDriverInst, achTrendInst;

function achRenderPillarChart(items) {
    const ctx = document.getElementById('achPillarChart'); if (!ctx) return;
    if (achPillarInst) achPillarInst.destroy();
    const labels = items.map(i => achLabel('pillar', i.key));
    achPillarInst = new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets: [{ data: items.map(i => i.avgWeightedScore), backgroundColor: ChartColors.colorsByLabel(labels, null), borderRadius:4, maxBarThickness:32 }] },
        options: { indexAxis:'y', responsive:true, maintainAspectRatio:false,
            plugins:{ legend:{display:false}, datalabels:{ anchor:'end', align:'end', color:'var(--text-2)', font:{size:11,weight:'bold'}, formatter:v=>v>0?v:'' } },
            scales:{ x:{ beginAtZero:true, max:100, ticks:{ callback:v=>v } } } }
    });
}

function achRenderDriverChart(items) {
    const ctx = document.getElementById('achDriverChart'); if (!ctx) return;
    if (achDriverInst) achDriverInst.destroy();
    const top = items.slice(0, 8);
    const labels = top.map(i => achLabel('driver', i.key));
    achDriverInst = new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets: [{ data: top.map(i => i.negativePercent), backgroundColor: ChartColors.SEMANTIC.BAD, borderRadius:4, maxBarThickness:30 }] },
        options: { indexAxis:'y', responsive:true, maintainAspectRatio:false,
            plugins:{ legend:{display:false}, datalabels:{ anchor:'end', align:'end', color:'var(--text-2)', font:{size:11,weight:'bold'}, formatter:v=>v>0?v+'%':'' } },
            scales:{ x:{ beginAtZero:true, ticks:{ callback:v=>v+'%' } } } }
    });
}

function achRenderTrend(points) {
    const ctx = document.getElementById('achTrendChart'); if (!ctx) return;
    if (achTrendInst) achTrendInst.destroy();
    achTrendInst = new Chart(ctx, {
        type: 'line',
        data: { labels: points.map(p => p.label), datasets: [
            { label: '@L["AC_TrendOpened"]', data: points.map(p => p.opened), borderColor: ChartColors.SEMANTIC.BAD, backgroundColor:'transparent', tension:0.3, pointRadius:3 },
            { label: '@L["AC_TrendResolved"]', data: points.map(p => p.resolved), borderColor:'oklch(0.5 0.15 155)', backgroundColor:'transparent', tension:0.3, pointRadius:3 },
        ] },
        options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:true,position:'bottom'}, datalabels:{display:false} }, scales:{ y:{ beginAtZero:true, ticks:{precision:0} } } }
    });
}

function achRenderLegend() {
    document.getElementById('achLegend').innerHTML = ['Critical','High','Medium','Low','Healthy'].map(sev => {
        const m = achSevColor(sev);
        return `<span><i style="background:${m.c}"></i>${sapEscape(achLabel('sev', sev))}</span>`;
    }).join('');
}

/* ── Table ─────────────────────────────────────────────────────────────── */
function achRowHtml(r) {
    const sev = achSevColor(r.severity);
    const scoreCell = `<div class="ach-score">${achRing(r.healthScore, sev.c)}
        <div><div class="ach-score-num" style="color:${sev.c}">${r.healthScore}</div><div class="ach-score-sub">/100</div></div></div>`;

    const byKey = {}; (r.pillars || []).forEach(p => byKey[p.key] = p);
    const strip = AC_PILLARS.map(k => {
        const p = byKey[k];
        if (!p || !p.hasData) return `<span class="ach-seg" title="${sapEscape(achLabel('pillar', k))}: —"></span>`;
        const col = achPillarSegColor(p.status);
        return `<span class="ach-seg" title="${sapEscape(achLabel('pillar', k))}: ${Math.round(p.subScore)}" style="background:${col}"></span>`;
    }).join('');

    const driver = r.topPillarKey ? achLabel('pillar', r.topPillarKey) : '—';
    const st = r.planStatus === 'Active' ? { t: AC_L.ui.statusActive, c:'oklch(0.6 0.14 75)', bg:'oklch(0.75 0.16 75 / .12)' }
             : r.planStatus === 'Resolved' ? { t: AC_L.ui.statusResolved, c:'oklch(0.5 0.15 155)', bg:'oklch(0.62 0.15 155 / .12)' }
             : { t: AC_L.ui.statusNone, c:'var(--text-3)', bg:'var(--card-bg-2)' };
    const pct = r.tasksTotal > 0 ? Math.round(r.tasksCompleted / r.tasksTotal * 100) : 0;
    const link = `${AC_AREA}/dashboard/actioncenterdetail?store=${encodeURIComponent(r.storeName)}`;

    return `<tr>
        <td class="px-3 py-2"><a class="ach-store-link" href="${link}">${sapEscape(r.storeName)}</a></td>
        <td class="px-3 py-2">${scoreCell}</td>
        <td class="px-3 py-2"><span class="ach-badge" style="background:${sev.bg};color:${sev.c}">${sapEscape(achLabel('sev', r.severity))}</span></td>
        <td class="px-3 py-2" style="color:var(--text-2)">${sapEscape(driver)}</td>
        <td class="px-3 py-2"><div class="ach-strip">${strip}</div></td>
        <td class="px-3 py-2 ach-pri" style="color:${sev.c}">${Math.round(r.priorityScore)}</td>
        <td class="px-3 py-2" style="color:var(--text-2)">${r.headcount || '—'}</td>
        <td class="px-3 py-2"><span class="ach-badge" style="background:${st.bg};color:${st.c}">${sapEscape(st.t)}</span></td>
        <td class="px-3 py-2" style="color:var(--text-2)">${r.responsibleName ? sapEscape(r.responsibleName) : '—'}</td>
        <td class="px-3 py-2">${r.tasksTotal > 0 ? `<div class="d-flex align-items-center gap-2"><div class="ach-progress-track"><div class="ach-progress-fill" style="width:${pct}%"></div></div><span style="font-size:11px;color:var(--text-3)">${r.tasksCompleted}/${r.tasksTotal}</span></div>` : '—'}</td>
    </tr>`;
}

function achRenderTable() {
    const search = (document.getElementById('achSearch').value || '').toLowerCase();
    let rows = achData.filter(r =>
        (r.storeName || '').toLowerCase().includes(search) ||
        (r.responsibleName || '').toLowerCase().includes(search)
    ).map(r => ({ ...r, severityRank: AC_SEV_RANK[r.severity] ?? 0 }));

    const { key, dir } = achSort;
    rows.sort((a, b) => {
        let av = a[key], bv = b[key];
        if (typeof av === 'string') av = av.toLowerCase();
        if (typeof bv === 'string') bv = bv.toLowerCase();
        if (av == null) av = dir === 'asc' ? Infinity : -Infinity;
        if (bv == null) bv = dir === 'asc' ? Infinity : -Infinity;
        if (av < bv) return dir === 'asc' ? -1 : 1;
        if (av > bv) return dir === 'asc' ? 1 : -1;
        return 0;
    });

    document.getElementById('achCountBadge').textContent = `${rows.length} ${AC_L.ui.storesSuffix}`;
    const body = document.getElementById('achBody');
    body.innerHTML = rows.length
        ? rows.map(achRowHtml).join('')
        : `<tr><td colspan="10" class="text-center py-4 text-muted">${sapEscape(AC_L.ui.noData)}</td></tr>`;
}

document.querySelectorAll('.ach-sort-header').forEach(th => {
    th.addEventListener('click', () => {
        const key = th.dataset.sortKey;
        if (achSort.key === key) achSort.dir = achSort.dir === 'asc' ? 'desc' : 'asc';
        else { achSort.key = key; achSort.dir = (key === 'storeName') ? 'asc' : 'desc'; }
        document.querySelectorAll('.ach-sort-header').forEach(h => h.classList.remove('ach-asc', 'ach-desc'));
        th.classList.add(achSort.dir === 'asc' ? 'ach-asc' : 'ach-desc');
        achRenderTable();
    });
});

async function achLoadStores() {
    achData = await sapFetchJson('/api/store-action-plan/action-center/health/stores') || [];
    achRenderTable();
}

document.getElementById('achSearch').addEventListener('input', achRenderTable);
function achReset() { document.getElementById('achSearch').value = ''; achRenderTable(); }

achLoadSummary();
achLoadStores();
</script>
