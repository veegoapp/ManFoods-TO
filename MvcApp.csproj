<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MvcApp</RootNamespace>
    <AssemblyName>MvcApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Transitive via ClosedXML; the 6.0.0 it pulls in has known High advisories (GHSA-f32c-w444-8ppv, GHSA-qj66-m88j-hmgj). Patch-level pin, same major. -->
    <PackageReference Include="System.IO.Packaging" Version="6.0.2" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MvcApp.Tests/**/*.cs" />
    <Content Remove="MvcApp.Tests/**/*" />
    <EmbeddedResource Remove="MvcApp.Tests/**/*" />
    <None Remove="MvcApp.Tests/**/*" />
    <Compile Remove="Tools/**/*.cs" />
    <Content Remove="Tools/**/*" />
    <EmbeddedResource Remove="Tools/**/*" />
    <None Remove="Tools/**/*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MvcApp.Tests" />
  </ItemGroup>
</Project>