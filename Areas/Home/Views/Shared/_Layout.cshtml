@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpCtx
@inject Microsoft.Extensions.Localization.IStringLocalizer<MvcApp.Resources.SharedResource> L
@inject MvcApp.Services.IDataFreshnessService DataFreshness
@{
    var session = HttpCtx.HttpContext?.Session;
    var userEmail    = session?.GetString("Email") ?? "";
    var userRole     = session?.GetString("Role")  ?? "";
    var assignedName = session?.GetString("AssignedName") ?? "";
    var displayName  = !string.IsNullOrEmpty(assignedName) ? assignedName : userEmail;
    var initials     = string.IsNullOrEmpty(displayName) ? "U" : displayName.Substring(0,1).ToUpper();
    var currentLang  = HttpCtx.HttpContext?.Request.Cookies["mf-lang"] ?? "en";
    var isRtl        = currentLang == "ar";
    var returnUrl    = HttpCtx.HttpContext?.Request.Path.Value ?? "/";
    var switchLang   = isRtl ? "en" : "ar";
    var currentPath  = HttpCtx.HttpContext?.Request.Path.Value ?? "";
    bool IsActive(string seg) => currentPath.Contains(seg, StringComparison.OrdinalIgnoreCase);

    string RoleLabel(string r) => string.IsNullOrEmpty(r) ? "" : L["Role_" + r.Replace("_", "")].Value;
    var latestDataPeriod = await DataFreshness.GetLatestDataPeriodAsync();
    var latestDataPeriodLabel = latestDataPeriod is null
        ? ""
        : new DateTime(latestDataPeriod.Year, latestDataPeriod.Month, 1)
            .ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
}
<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " + L["Brand_Hub"].Value : L["Brand_HubCrewLevel"].Value)</title>
    <link rel="icon" type="image/png" href="~/images/mclogo.png"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('mf-theme') || 'light');</script>
</head>
<body data-area-prefix="/home"
      data-range-badge-on="@L["Common_RangeBadgeOn"]" data-range-badge-off="@L["Common_RangeBadgeOff"]"
      data-kpi-headcount="@L["Common_TotalHeadcount"]" data-kpi-new-hires="@L["Common_NewHires"]"
      data-kpi-resignations="@L["Common_Resignations"]" data-kpi-turnover-rate="@L["Common_TurnoverRate"]"
      data-resignations-suffix="@L["Common_ResignationsCountSuffix"]">
<div class="app-wrapper">
    <aside class="home-sidebar">
        <!-- Brand strip -->
        <div class="home-brand sidebar-brand">
            <div class="brand-logo-row">
                <img src="/images/mclogo.png" alt="@L["Common_Logo"]" class="brand-logo-img"/>
                <div class="brand-texts">
                    <span class="brand-name-main">@L["Brand_Hub"]</span>
                    <span class="brand-name-sub">@L["Brand_CrewLevel"]</span>
                </div>
            </div>
        </div>

        <!-- User card -->
        <div class="home-user-hero">
            <div class="notif-wrap home-notif-wrap" id="notifWrap">
                <button type="button" class="notif-btn home-notif-btn" id="notifBtn" title="@L["Notif_Title"]" data-empty-text="@L["Notif_Empty"]">
                    <i class="bi bi-bell-fill"></i>
                    <span class="notif-badge" id="notifBadge" hidden>0</span>
                </button>
                <div class="notif-panel" id="notifPanel" hidden>
                    <div class="notif-panel-header">
                        <span>@L["Notif_Title"]</span>
                        <button type="button" class="notif-clear-btn" id="notifClearBtn" hidden>@L["Notif_ClearAll"]</button>
                    </div>
                    <div id="notifList"></div>
                </div>
            </div>
            <div class="hero-avatar">@initials</div>
            <div class="hero-name">@displayName</div>
            <div class="hero-role">@RoleLabel(userRole)</div>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav" style="flex:1; padding: 8px 0; overflow-y:auto;">
            <div class="nav-section-label">@L["Nav_MyWorkspace"]</div>
            <a href="/home/dashboard/workforce" class="nav-item @(IsActive("Workforce") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-people-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_Workforce"]</span>
                </span>
            </a>
            <a href="/home/dashboard/turnover" class="nav-item @(IsActive("Turnover") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-pie-chart-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_Turnover"]</span>
                </span>
            </a>
            <a href="/home/dashboard/ninetydayturnover" class="nav-item @(IsActive("NinetyDayTurnover") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-hourglass-split"></i></span>
                    <span class="nav-item-label">@L["Nav_NinetyDay"]</span>
                </span>
            </a>
            <a href="/home/dashboard/comparisons" class="nav-item @(IsActive("Comparisons") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-arrow-left-right"></i></span>
                    <span class="nav-item-label">@L["Nav_Comparisons"]</span>
                </span>
            </a>
            <a href="/home/dashboard/retention" class="nav-item @(IsActive("Retention") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-graph-up-arrow"></i></span>
                    <span class="nav-item-label">@L["Nav_Retention"]</span>
                </span>
            </a>
            <a href="/home/dashboard/exitinterviews" class="nav-item @(IsActive("ExitInterviews") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-chat-square-text-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_ExitInterviews"]</span>
                </span>
            </a>
            <a href="/home/dashboard/earlywarning" class="nav-item @(IsActive("EarlyWarning") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-exclamation-diamond-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_EarlyWarning"]</span>
                </span>
            </a>
            <a href="/home/dashboard/scorecard" class="nav-item @(IsActive("Scorecard") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-award-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_Scorecard"]</span>
                </span>
            </a>
            @{ var acSectionActive = IsActive("ActionCenter") || IsActive("ActionCenterDetail") || IsActive("ActionPlanGuide"); }
            <a href="/home/dashboard/actioncenter" class="nav-item @(acSectionActive ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-bullseye"></i></span>
                    <span class="nav-item-label">@L["Nav_ActionCenter"]</span>
                </span>
            </a>
            @if (acSectionActive)
            {
                <div class="nav-submenu">
                    <a href="/home/dashboard/actionplanguide" class="nav-subitem @(IsActive("ActionPlanGuide") ? "active" : "")">
                        <i class="bi bi-book-half"></i><span>@L["Nav_ActionPlanGuide"]</span>
                    </a>
                </div>
            }
            <a href="/home/dashboard/stores" class="nav-item @(IsActive("Stores") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-shop"></i></span>
                    <span class="nav-item-label">@L["Nav_Stores"]</span>
                </span>
            </a>
            <a href="/home/dashboard/reports" class="nav-item @(IsActive("Reports") ? "active" : "")">
                <span class="nav-item-inner">
                    <span class="nav-icon-wrap"><i class="bi bi-file-earmark-bar-graph-fill"></i></span>
                    <span class="nav-item-label">@L["Nav_Reports"]</span>
                </span>
            </a>
        </nav>

        <!-- Footer -->
        <div class="sidebar-footer">
            <div class="sidebar-footer-inner">
                <button class="btn-change-password w-100 mb-1" id="themeToggle" title="@L["Layout_DarkMode"] / @L["Layout_LightMode"]">
                    <i class="bi bi-moon-stars-fill icon-dark"></i>
                    <i class="bi bi-sun-fill icon-light"></i>
                    <span class="icon-dark">@L["Layout_DarkMode"]</span>
                    <span class="icon-light">@L["Layout_LightMode"]</span>
                </button>
                <form action="/language/set" method="post" class="w-100 mb-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lang" value="@switchLang"/>
                    <input type="hidden" name="returnUrl" value="@returnUrl"/>
                    <button type="submit" class="btn-change-password w-100" style="font-weight:700">
                        <i class="bi bi-translate me-1"></i>@L["Layout_SwitchLang"]
                    </button>
                </form>
                <form asp-area="Home" asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-signout-full">
                        <i class="bi bi-box-arrow-left me-2"></i>@L["Layout_SignOut"]
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert-banner alert-success-banner">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-banner alert-error-banner">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            </div>
        }
        @if (latestDataPeriod is not null)
        {
            <div class="data-freshness-wrap">
                <span class="data-freshness-chip" role="status" title="@L["Layout_DataFreshnessCaption"]">
                    <i class="bi bi-database-check"></i>
                    <span class="data-freshness-label">@L["Layout_DataFreshnessLabel"]:</span>
                    <strong class="data-freshness-period">@latestDataPeriodLabel</strong>
                </span>
            </div>
        }
        <div class="page-content">
            @RenderBody()
        </div>
        <div class="portal-footer">&copy; @DateTime.Now.Year @L["Layout_FooterText"]</div>
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/notifications.js" asp-append-version="true"></script>
<script>
(function () {
    const themeBtn = document.getElementById('themeToggle');
    const root = document.documentElement;
    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            localStorage.setItem('mf-theme', next);
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
