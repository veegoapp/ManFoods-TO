@using MvcApp.Extensions
@using MvcApp.Services
@model List<MvcApp.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = L["Page_Users"].Value;

    string RoleLabel(string role) => role switch
    {
        "Admin" => L["Role_Admin"].Value,
        "User" => L["Role_User"].Value,
        "Operation_Manager" => L["Common_OperationManager"].Value,
        "Operation_Consultant" => L["Common_OperationConsultant"].Value,
        "Head_Manager" => L["Role_HeadManager"].Value,
        "Senior_Operation_Consultant" => L["Role_SeniorOperationConsultant"].Value,
        "Operation_Director" => L["Role_OperationDirector"].Value,
        _ => role,
    };

    var restrictedRoles = new HashSet<string> { "Operation_Manager", "Operation_Consultant", "Head_Manager", "Senior_Operation_Consultant", "Operation_Director" };
    // "Active" means the user has actually completed their first-login
    // password setup — a system-generated temporary password already sits
    // in PasswordHash from creation, so HasPassword alone isn't enough.
    bool IsActive(MvcApp.Models.ViewModels.UserViewModel u) => u.HasPassword && !u.MustChangePassword;
    var total = Model.Count;
    var active = Model.Count(IsActive);
    var pending = total - active;
    var admins = Model.Count(u => u.Role == "Admin");
    var restricted = Model.Count(u => restrictedRoles.Contains(u.Role));
    // Master Recovery Key management and Admin-targeted OTP generation are
    // Super-Admin-only — this only decides what's shown; the server side
    // (UserService/OtpService) is the actual enforcement point.
    var isSuperAdmin = SuperAdminPolicy.IsSuperAdmin(Context.Session.GetEmail());
    var generatedEmail = TempData["GeneratedPasswordEmail"] as string;
    var generatedPassword = TempData["GeneratedPassword"] as string;
}

<style>
.us-toolbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:16px; }
.us-search-wrap { position:relative; flex:1; min-width:220px; max-width:340px; }
.us-search-wrap i { position:absolute; top:50%; left:14px; transform:translateY(-50%); font-size:13px; color:var(--text-3); pointer-events:none; }
[dir="rtl"] .us-search-wrap i { left:auto; right:14px; }
.us-search-input { width:100%; padding-inline-start:36px; }
.us-role-filter { min-width:170px; }
.us-avatar {
    width:34px; height:34px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    background:var(--red-light); color:var(--red); font-weight:700; font-size:13px;
}
.us-name-cell { display:flex; align-items:center; gap:10px; }
.us-matched-badge { padding:2px 9px; border-radius:12px; font-size:11px; font-weight:700; white-space:nowrap; }
.us-matched-ok   { background:var(--success-bg); color:var(--success); }
.us-matched-zero { background:var(--danger-bg);  color:var(--danger); }
.us-matched-na   { color:var(--text-3); font-size:11px; }
#usTableBody tr[hidden] { display:none; }
</style>

<div class="page-header">
    <div><h1 class="page-title">@L["Page_Users"]</h1><p class="page-subtitle">@L["Page_UsersSub"]</p></div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/admin/dashboard/download-template?type=bulk_users" class="btn btn-outline-template btn-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>@L["Users_TemplateBulk"]
        </a>
        <a href="/admin/dashboard/createuser" class="btn btn-primary btn-sm"><i class="bi bi-person-plus me-2"></i>@L["Users_NewUser"]</a>
    </div>
</div>

<div class="kpi-grid mb-4">
    <div class="kpi-card">
        <div class="kpi-icon"><i class="bi bi-people-fill"></i></div>
        <div class="kpi-value">@total</div>
        <div class="kpi-label">@L["Users_KpiTotal"]</div>
        <div class="kpi-desc">@L["Users_KpiTotalDesc"]</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="color:var(--success)"><i class="bi bi-check-circle-fill"></i></div>
        <div class="kpi-value">@active</div>
        <div class="kpi-label">@L["Users_Active"]</div>
        <div class="kpi-desc">@L["Users_KpiActiveDesc"]</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="color:var(--warning)"><i class="bi bi-hourglass-split"></i></div>
        <div class="kpi-value">@pending</div>
        <div class="kpi-label">@L["Users_PendingActivation"]</div>
        <div class="kpi-desc">@L["Users_KpiPendingDesc"]</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <div class="kpi-value">@admins</div>
        <div class="kpi-label">@L["Users_KpiAdmins"]</div>
        <div class="kpi-desc">@L["Users_KpiAdminsDesc"]</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="color:var(--info)"><i class="bi bi-geo-alt-fill"></i></div>
        <div class="kpi-value">@restricted</div>
        <div class="kpi-label">@L["Users_KpiRestricted"]</div>
        <div class="kpi-desc">@L["Users_KpiRestrictedDesc"]</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card-dark h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="card-icon"><i class="bi bi-people-fill"></i></div>
                <div><h6 class="mb-0">@L["Users_BulkUpload"]</h6><p class="text-muted-custom mb-0 small">@L["Users_BulkUploadDesc"]</p></div>
            </div>
            <form asp-area="Admin" asp-controller="Dashboard" asp-action="UploadBulkUsers" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-2"><input type="file" name="File" accept=".xlsx,.xls" class="form-control form-control-dark form-control-sm" required/></div>
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-cloud-upload me-1"></i>@L["Users_UploadUsers"]</button>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-dark h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="card-icon"><i class="bi bi-key-fill"></i></div>
                <div><h6 class="mb-0">@L["Users_GenerateBulkOtps"]</h6><p class="text-muted-custom mb-0 small">@L["Users_GenerateBulkOtpsDesc"]</p></div>
            </div>
            <a href="/admin/dashboard/generatedefaultpasswords" class="btn btn-primary btn-sm w-100"><i class="bi bi-file-earmark-arrow-down me-1"></i>@L["Users_GenerateDownloadOtps"]</a>
        </div>
    </div>
    @if (isSuperAdmin)
    {
        <div class="col-lg-4">
            <div class="card-dark h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="card-icon"><i class="bi bi-shield-lock-fill"></i></div>
                    <div><h6 class="mb-0">@L["Users_GenerateRecoveryKeyTitle"]</h6><p class="text-muted-custom mb-0 small">@L["Users_RegenerateRecoveryKeyDesc"]</p></div>
                </div>
                <button type="button" class="btn btn-primary btn-sm w-100 js-regenerate-recovery-key"><i class="bi bi-shield-lock me-1"></i>@L["Users_GenerateKey"]</button>
            </div>
        </div>
    }
</div>

<div class="card-dark">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-people"></i><p>@L["Users_NoUsers"]</p></div>
    }
    else
    {
        <div class="us-toolbar">
            <div class="us-search-wrap">
                <i class="bi bi-search"></i>
                <input type="search" id="usSearchInput" class="form-control form-control-dark form-control-sm us-search-input" placeholder="@L["Users_SearchPlaceholder"]" autocomplete="off" autocapitalize="none" spellcheck="false" data-lpignore="true" data-1p-ignore="true" readonly>
            </div>
            <select id="usRoleFilter" class="form-select form-select-dark form-select-sm us-role-filter">
                <option value="">@L["Users_FilterAllRoles"]</option>
                @foreach (var r in new[] { "Admin", "User", "Operation_Manager", "Operation_Consultant", "Head_Manager", "Senior_Operation_Consultant", "Operation_Director" })
                {
                    <option value="@r">@RoleLabel(r)</option>
                }
            </select>
        </div>

        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th>@L["Common_Email"]</th>
                        <th>@L["Users_AssignedName"]</th>
                        <th>@L["Common_Phone"]</th>
                        <th>@L["Common_Role"]</th>
                        <th>@L["Common_Status"]</th>
                        <th>@L["Users_MatchedStores"]</th>
                        <th>@L["Common_Created"]</th>
                        <th class="text-end">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody id="usTableBody">
                    @foreach (var user in Model)
                    {
                        <tr class="us-user-row" data-email="@user.Email.ToLower()" data-name="@user.AssignedName.ToLower()" data-role="@user.Role">
                            <td>
                                <div class="us-name-cell">
                                    <div class="us-avatar">@((string.IsNullOrWhiteSpace(user.AssignedName) ? user.Email : user.AssignedName).Substring(0,1).ToUpper())</div>
                                    <span class="fw-medium">@user.Email</span>
                                </div>
                            </td>
                            <td class="text-muted-custom">@(string.IsNullOrWhiteSpace(user.AssignedName) ? "—" : user.AssignedName)</td>
                            <td class="text-muted-custom">@user.Phone</td>
                            <td><span class="role-badge role-@user.Role">@RoleLabel(user.Role)</span></td>
                            <td>
                                @if (IsActive(user))
                                {
                                    <span class="role-badge" style="background:var(--success-bg);color:var(--success)">@L["Users_Active"]</span>
                                }
                                else
                                {
                                    <span class="role-badge role-pending">@L["Users_PendingActivation"]</span>
                                }
                            </td>
                            <td>
                                @if (user.MatchedStoreCount.HasValue)
                                {
                                    <span class="us-matched-badge @(user.MatchedStoreCount.Value > 0 ? "us-matched-ok" : "us-matched-zero")" title="@L["Users_MatchedStoresHelp"]">
                                        <i class="bi bi-shop"></i> @user.MatchedStoreCount.Value
                                    </span>
                                }
                                else
                                {
                                    <span class="us-matched-na">@L["Users_NotStoreRestricted"]</span>
                                }
                            </td>
                            <td class="text-muted-custom small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                @if (user.Role != "Admin")
                                {
                                    @if (!IsActive(user))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-generate-default-password" data-id="@user.Id" data-email="@user.Email" title="@L["Users_RegenerateDefaultPassword"]"><i class="bi bi-file-earmark-arrow-down"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-send-outlook-credentials" data-id="@user.Id" data-email="@user.Email" title="@L["Users_SendOutlookCredentials"]"><i class="bi bi-envelope-fill"></i></button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-generate-otp" data-id="@user.Id" data-email="@user.Email" title="@L["Users_GenerateOtp"]"><i class="bi bi-key"></i></button>
                                }
                                else if (isSuperAdmin && !SuperAdminPolicy.IsSuperAdmin(user.Email))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-generate-otp" data-id="@user.Id" data-email="@user.Email" data-admin="true" title="@L["Users_GenerateOtp"]"><i class="bi bi-key"></i></button>
                                }
                                <a href="/admin/dashboard/loginhistory/@user.Id" class="btn btn-sm btn-outline-secondary me-1" title="@L["Users_ViewLoginHistory"]"><i class="bi bi-clock-history"></i></a>
                                <a href="/admin/dashboard/edituser/@user.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i></a>
                                @if (!SuperAdminPolicy.IsSuperAdmin(user.Email))
                                {
                                    <form asp-area="Admin" asp-controller="Dashboard" asp-action="DeleteUser" method="post" class="d-inline" autocomplete="off" onsubmit="return confirm('@(string.Format(L["Users_DeleteConfirm"].Value, user.Email))')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id"/>
                                        <button type="submit" class="btn btn-sm btn-danger-outline"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="usNoResults" class="empty-state py-4" style="display:none"><i class="bi bi-search"></i><p>@L["Users_NoResults"]</p></div>
        </div>
    }
</div>

<div id="usL" hidden
     data-otp-failed="@L["Users_OtpFailed"]"
     data-default-password-failed="@L["Users_DefaultPasswordFailed"]"
     data-something-went-wrong="@L["Common_SomethingWentWrong"]"
     data-outlook-subject="@L["Users_OutlookEmailSubject"]"
     data-outlook-invalid-email="@L["Users_OutlookInvalidEmail"]"
     data-generated-email="@generatedEmail"
     data-generated-password="@generatedPassword"></div>

<div id="userCreatedModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);align-items:center;justify-content:center">
    <div class="card-dark" style="max-width:420px;width:90%">
        <h6 class="mb-2"><i class="bi bi-person-check-fill me-1"></i>@L["Users_UserCreatedTitle"]</h6>
        <p class="text-muted-custom small mb-2" id="userCreatedEmail"></p>
        <div class="d-flex align-items-center gap-2 mb-3">
            <input type="text" id="userCreatedPassword" class="form-control form-control-dark" readonly style="font-size:16px;font-weight:700"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="userCreatedCopyBtn" title="@L["Common_Copy"]"><i class="bi bi-clipboard"></i></button>
        </div>
        <p class="text-muted-custom small mb-3">@L["Users_UserCreatedDesc"]</p>
        <button type="button" class="btn btn-primary w-100" id="userCreatedCloseBtn">@L["Users_Close"]</button>
    </div>
</div>

<div id="otpResultModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);align-items:center;justify-content:center">
    <div class="card-dark" style="max-width:380px;width:90%">
        <h6 class="mb-2"><i class="bi bi-key-fill me-1"></i>@L["Users_OtpGenerated"]</h6>
        <p class="text-muted-custom small mb-2" id="otpResultEmail"></p>
        <div class="d-flex align-items-center gap-2 mb-3">
            <input type="text" id="otpResultCode" class="form-control form-control-dark" readonly style="font-size:20px;letter-spacing:4px;text-align:center;font-weight:700"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="otpCopyBtn" title="@L["Common_Copy"]"><i class="bi bi-clipboard"></i></button>
        </div>
        <p class="text-muted-custom small mb-3">@L["Users_ValidFor"]</p>
        <button type="button" class="btn btn-primary w-100" id="otpCloseBtn">@L["Users_Close"]</button>
    </div>
</div>

<div id="defaultPasswordResultModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);align-items:center;justify-content:center">
    <div class="card-dark" style="max-width:420px;width:90%">
        <h6 class="mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>@L["Users_DefaultPasswordGenerated"]</h6>
        <p class="text-muted-custom small mb-2" id="defaultPasswordResultEmail"></p>
        <div class="d-flex align-items-center gap-2 mb-3">
            <input type="text" id="defaultPasswordResultValue" class="form-control form-control-dark" readonly style="font-size:16px;font-weight:700"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="defaultPasswordCopyBtn" title="@L["Common_Copy"]"><i class="bi bi-clipboard"></i></button>
        </div>
        <p class="text-muted-custom small mb-3">@L["Users_DefaultPasswordGeneratedDesc"]</p>
        <button type="button" class="btn btn-primary w-100" id="defaultPasswordCloseBtn">@L["Users_Close"]</button>
    </div>
</div>

<div id="recoveryPasswordModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);align-items:center;justify-content:center">
    <div class="card-dark" style="max-width:380px;width:90%">
        <h6 class="mb-2"><i class="bi bi-shield-lock me-1"></i>@L["Users_ConfirmPassword"]</h6>
        <p class="text-muted-custom small mb-3">@Html.Raw(L["Users_RecoveryPasswordPrompt"].Value)</p>
        <input type="password" id="recoveryPasswordInput" class="form-control form-control-dark mb-2" placeholder="@L["Users_YourPassword"]"/>
        <p class="text-danger small mb-2" id="recoveryPasswordError" style="display:none"></p>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary w-100" id="recoveryPasswordCancelBtn">@L["Common_Cancel"]</button>
            <button type="button" class="btn btn-primary w-100" id="recoveryPasswordSubmitBtn">@L["Users_GenerateKey"]</button>
        </div>
    </div>
</div>

<div id="recoveryResultModal" style="display:none;position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.5);align-items:center;justify-content:center">
    <div class="card-dark" style="max-width:420px;width:90%">
        <h6 class="mb-2"><i class="bi bi-shield-check me-1"></i>@L["Users_NewRecoveryKey"]</h6>
        <div class="d-flex align-items-center gap-2 mb-3">
            <input type="text" id="recoveryResultKey" class="form-control form-control-dark" readonly style="font-size:14px;font-weight:700"/>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="recoveryCopyBtn" title="@L["Common_Copy"]"><i class="bi bi-clipboard"></i></button>
        </div>
        <p class="text-danger small mb-3"><i class="bi bi-exclamation-triangle-fill me-1"></i>@L["Users_SaveKeyWarning"]</p>
        <button type="button" class="btn btn-primary w-100" id="recoveryResultCloseBtn">@L["Users_SaveKey"]</button>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const usL = document.getElementById('usL').dataset;

    // ── Auto-shown once after CreateUser redirects back here with a
    // freshly-generated temporary password (TempData — never persisted, gone on refresh) ──
    if (usL.generatedPassword) {
        document.getElementById('userCreatedEmail').textContent = usL.generatedEmail;
        const pwEl = document.getElementById('userCreatedPassword');
        pwEl.value = usL.generatedPassword;
        document.getElementById('userCreatedModal').style.display = 'flex';
        document.getElementById('userCreatedCopyBtn').addEventListener('click', () => {
            pwEl.select();
            navigator.clipboard.writeText(pwEl.value);
        });
        document.getElementById('userCreatedCloseBtn').addEventListener('click', () => {
            document.getElementById('userCreatedModal').style.display = 'none';
        });
    }

    const modal = document.getElementById('otpResultModal');
    const emailEl = document.getElementById('otpResultEmail');
    const codeEl = document.getElementById('otpResultCode');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    document.querySelectorAll('.js-generate-otp').forEach(btn => {
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
                const endpoint = btn.dataset.admin === 'true' ? 'generateadminotp' : 'generateotp';
                const res = await fetch(`/admin/dashboard/${endpoint}/${btn.dataset.id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                if (!res.ok) { alert(usL.otpFailed); return; }
                const data = await res.json();
                emailEl.textContent = btn.dataset.email;
                codeEl.value = data.otp;
                modal.style.display = 'flex';
            } finally {
                btn.disabled = false;
            }
        });
    });

    document.getElementById('otpCopyBtn').addEventListener('click', () => {
        codeEl.select();
        navigator.clipboard.writeText(codeEl.value);
    });
    document.getElementById('otpCloseBtn').addEventListener('click', () => { modal.style.display = 'none'; });

    // ── Regenerate a single pending user's default (temporary) password ──
    const pwResultModal = document.getElementById('defaultPasswordResultModal');
    const pwResultEmailEl = document.getElementById('defaultPasswordResultEmail');
    const pwResultValueEl = document.getElementById('defaultPasswordResultValue');

    document.querySelectorAll('.js-generate-default-password').forEach(btn => {
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
                const res = await fetch(`/admin/dashboard/generatedefaultpassword/${btn.dataset.id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                if (!res.ok) { alert(usL.defaultPasswordFailed); return; }
                const data = await res.json();
                pwResultEmailEl.textContent = btn.dataset.email;
                pwResultValueEl.value = data.password;
                pwResultModal.style.display = 'flex';
            } finally {
                btn.disabled = false;
            }
        });
    });

    document.getElementById('defaultPasswordCopyBtn').addEventListener('click', () => {
        pwResultValueEl.select();
        navigator.clipboard.writeText(pwResultValueEl.value);
    });
    document.getElementById('defaultPasswordCloseBtn').addEventListener('click', () => { pwResultModal.style.display = 'none'; });

    // ── Send a pending user's temporary-password credentials via Outlook ──
    // Reuses the same single-user password-generation endpoint as the button
    // above (new password generated server-side, only the BCrypt hash is
    // persisted) and the same welcome/portal-link wording the bulk Excel
    // export uses (returned as "message" from that endpoint) — the plaintext
    // password never leaves browser memory for longer than this click.
    const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

    document.querySelectorAll('.js-send-outlook-credentials').forEach(btn => {
        btn.addEventListener('click', async () => {
            const email = (btn.dataset.email || '').trim();
            if (!emailPattern.test(email)) { alert(usL.outlookInvalidEmail); return; }

            btn.disabled = true;
            try {
                const res = await fetch(`/admin/dashboard/generatedefaultpassword/${btn.dataset.id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                if (!res.ok) { alert(usL.defaultPasswordFailed); return; }
                const data = await res.json();
                if (!data.password || !data.message) { alert(usL.somethingWentWrong); return; }

                const mailto = `mailto:${encodeURIComponent(email)}` +
                    `?subject=${encodeURIComponent(usL.outlookSubject)}` +
                    `&body=${encodeURIComponent(data.message)}`;
                // Navigating to a mailto: URL hands off to the OS's registered
                // mail client (Outlook Desktop, when set as default) and opens
                // a compose window pre-filled but unsent — it does not send
                // anything itself and does not leave this page.
                window.location.href = mailto;
            } finally {
                btn.disabled = false;
            }
        });
    });

    // ── Regenerate admin recovery key ──────────────────────
    const pwModal = document.getElementById('recoveryPasswordModal');
    const pwInput = document.getElementById('recoveryPasswordInput');
    const pwError = document.getElementById('recoveryPasswordError');
    const resultModal = document.getElementById('recoveryResultModal');
    const resultKeyEl = document.getElementById('recoveryResultKey');

    document.querySelectorAll('.js-regenerate-recovery-key').forEach(btn => {
        btn.addEventListener('click', () => {
            pwInput.value = '';
            pwError.style.display = 'none';
            pwModal.style.display = 'flex';
            pwInput.focus();
        });
    });

    document.getElementById('recoveryPasswordCancelBtn').addEventListener('click', () => { pwModal.style.display = 'none'; });

    async function submitRecoveryPassword() {
        const submitBtn = document.getElementById('recoveryPasswordSubmitBtn');
        pwError.style.display = 'none';
        submitBtn.disabled = true;
        try {
            const body = new URLSearchParams({ password: pwInput.value });
            const res = await fetch('/admin/dashboard/regeneraterecoverykey', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body
            });
            const data = await res.json();
            if (!res.ok || data.error) {
                pwError.textContent = data.error || usL.somethingWentWrong;
                pwError.style.display = '';
                return;
            }
            pwModal.style.display = 'none';
            resultKeyEl.value = data.key;
            resultModal.style.display = 'flex';
        } finally {
            submitBtn.disabled = false;
        }
    }

    document.getElementById('recoveryPasswordSubmitBtn').addEventListener('click', submitRecoveryPassword);
    pwInput.addEventListener('keydown', e => { if (e.key === 'Enter') submitRecoveryPassword(); });

    document.getElementById('recoveryCopyBtn').addEventListener('click', () => {
        resultKeyEl.select();
        navigator.clipboard.writeText(resultKeyEl.value);
    });
    document.getElementById('recoveryResultCloseBtn').addEventListener('click', () => { resultModal.style.display = 'none'; resultKeyEl.value = ''; });

    // ── Search + role filter (client-side, small dataset) ──────────────────
    const searchInput = document.getElementById('usSearchInput');
    const roleFilter = document.getElementById('usRoleFilter');
    const rows = Array.from(document.querySelectorAll('#usTableBody tr'));
    const noResults = document.getElementById('usNoResults');

    // Chrome (and others) can silently inject a saved login email into this
    // field despite autocomplete="off" — the "email" in its placeholder is
    // enough for the browser's autofill heuristic to treat it as a
    // username-like field, and it can do this asynchronously, after this
    // script has already run, so clearing the value here alone isn't
    // reliable (the injected value can still end up baked into a
    // back/forward-cache snapshot and reappear on browser Back). The
    // `readonly` attribute in the markup is the actual fix — browsers skip
    // autofilling readonly fields — and is lifted here on first focus so
    // typing still works normally. Clearing on load stays as a harmless
    // backup for any autofill that still slips through before this runs.
    if (searchInput) {
        searchInput.value = '';
        searchInput.addEventListener('focus', () => searchInput.removeAttribute('readonly'), { once: true });
    }

    // User rows contain independent links/forms. Keep their clicks inside the
    // table so a page-level click/autofocus handler cannot treat a row action
    // as an interaction with the search field.
    rows.forEach(row => {
        row.addEventListener('pointerdown', event => event.stopPropagation());
        row.addEventListener('click', event => event.stopPropagation());
    });

    function applyFilters() {
        const q = (searchInput?.value || '').trim().toLowerCase();
        const role = roleFilter?.value || '';
        let visible = 0;
        rows.forEach(row => {
            const matchesSearch = !q || row.dataset.email.includes(q) || row.dataset.name.includes(q);
            const matchesRole = !role || row.dataset.role === role;
            const show = matchesSearch && matchesRole;
            row.hidden = !show;
            if (show) visible++;
        });
        if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
    }

    searchInput?.addEventListener('input', applyFilters);
    roleFilter?.addEventListener('change', applyFilters);
})();
</script>
}
