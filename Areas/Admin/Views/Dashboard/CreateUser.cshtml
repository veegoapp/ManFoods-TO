@model MvcApp.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = L["Page_CreateUser"].Value;
}

<div class="page-header">
    <div><h1 class="page-title">@L["Page_CreateUser"]</h1><p class="page-subtitle">@L["Page_CreateUserSub"]</p></div>
    <a href="/admin/dashboard/users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@L["Common_Back"]</a>
</div>

<div class="card-dark" style="max-width:640px">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="card-icon" style="width:48px;height:48px;font-size:20px"><i class="bi bi-person-plus-fill"></i></div>
        <div><h6 class="mb-0">@L["Page_CreateUser"]</h6><p class="text-muted-custom mb-0 small">@L["Page_CreateUserSub"]</p></div>
    </div>
    <form asp-area="Admin" asp-controller="Dashboard" asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert-banner alert-error-banner mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label-dark">@L["Common_Email"]</label>
                <input asp-for="Email" class="form-control form-control-dark" placeholder="user@manfoods.com"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label-dark">@L["Common_Phone"]</label>
                <input asp-for="Phone" class="form-control form-control-dark" placeholder="+20 1xx xxx xxxx"/>
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="AssignedName" class="form-label-dark">@L["Users_AssignedName"]</label>
            <input asp-for="AssignedName" class="form-control form-control-dark" placeholder="@L["Users_AssignedNamePlaceholder"]"/>
            <p class="text-muted-custom small mt-1 mb-0">@L["Users_AssignedNameHelp"]</p>
        </div>

        <div class="alert-banner mb-3" style="background:var(--card-bg-2);border:1px solid var(--card-border);color:var(--text-2);font-size:13px;padding:10px 14px;border-radius:8px">
            <i class="bi bi-info-circle me-1"></i>@L["CU_PasswordGeneratedNote"]
        </div>

        <div class="mb-4">
            <label asp-for="Role" class="form-label-dark">@L["Common_Role"]</label>
            <select asp-for="Role" class="form-select form-select-dark">
                <option value="">@L["CU_SelectRole"]</option>
                <option value="Admin">@L["Role_Admin"]</option>
                <option value="User">@L["Role_User"]</option>
                <option value="HR">@L["Role_HR"]</option>
                <optgroup label="@L["Users_KpiRestricted"]">
                    <option value="Operation_Manager">@L["Common_OperationManager"]</option>
                    <option value="Operation_Consultant">@L["Common_OperationConsultant"]</option>
                    <option value="Head_Manager">@L["Role_HeadManager"]</option>
                    <option value="Senior_Operation_Consultant">@L["Role_SeniorOperationConsultant"]</option>
                    <option value="Operation_Director">@L["Role_OperationDirector"]</option>
                </optgroup>
            </select>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">@L["CU_CreateUser"]</button>
    </form>
</div>
