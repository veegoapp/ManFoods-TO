@using MvcApp.Extensions
@using MvcApp.Services
@model MvcApp.Models.ViewModels.UserLoginHistoryViewModel
@{
    ViewData["Title"] = L["Page_LoginHistory"].Value;
    var displayName = string.IsNullOrWhiteSpace(Model.AssignedName) ? Model.Email : Model.AssignedName;
    // Logins are most-recent-first, so when the viewer is looking at their own
    // history, the top successful row is (in the overwhelming majority of
    // cases) the very session they're viewing it from. There's no per-session
    // id threaded through login_history to match exactly, so this is a
    // best-effort marker, not a guarantee.
    var viewingOwnHistory = Context.Session.GetUserId() == Model.UserId;
    var currentSessionAt = viewingOwnHistory ? Model.Logins.FirstOrDefault(l => l.Success)?.LoggedInAt : null;
    // Stored in UTC; always shown in Cairo time (never the server's or the viewer's own zone).
    string CairoDate(DateTime utc) => CairoTime.FromUtc(utc).ToString("MMM dd, yyyy");
    string CairoClock(DateTime utc) => CairoTime.FromUtc(utc).ToString("hh:mm:ss tt");
}

<div class="page-header">
    <div><h1 class="page-title">@L["Page_LoginHistory"]</h1><p class="page-subtitle">@displayName · @Model.Email</p></div>
    <a href="/admin/dashboard/users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@L["Common_Back"]</a>
</div>

<div class="card-dark">
    @if (!Model.Logins.Any())
    {
        <div class="empty-state"><i class="bi bi-clock-history"></i><p>@L["Users_NoLoginHistory"]</p></div>
    }
    else
    {
        <p class="text-muted-custom small mb-3">@L["Users_LoginHistoryCount"] @Model.Logins.Count · @L["Users_LoginHistoryCairo"]</p>
        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th>@L["Common_Date"]</th>
                        <th>@L["Users_LoginTime"]</th>
                        <th>@L["Users_LoginResult"]</th>
                        <th>@L["Users_LoginPortal"]</th>
                        <th>@L["Users_IpAddress"]</th>
                        <th>@L["Users_Device"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var login in Model.Logins)
                    {
                        var isCurrent = currentSessionAt.HasValue && login.LoggedInAt == currentSessionAt.Value;
                        <tr>
                            <td>
                                @CairoDate(login.LoggedInAt)
                                @if (isCurrent)
                                {
                                    <span class="role-badge" style="background:var(--success-bg);color:var(--success);margin-inline-start:6px">@L["Users_CurrentSession"]</span>
                                }
                            </td>
                            <td class="text-muted-custom">@CairoClock(login.LoggedInAt)</td>
                            <td>
                                @if (login.Success)
                                {
                                    <span class="role-badge" style="background:var(--success-bg);color:var(--success)">@L["Users_LoginSuccess"]</span>
                                }
                                else
                                {
                                    var reasonLabel = login.FailureReason switch
                                    {
                                        "wrong-password" => L["Users_LoginFailedWrongPassword"].Value,
                                        "no-password-set" => L["Users_LoginFailedNoPassword"].Value,
                                        _ => L["Users_LoginFailed"].Value,
                                    };
                                    <span class="role-badge" style="background:var(--danger-bg);color:var(--danger)" title="@reasonLabel">@L["Users_LoginFailed"]</span>
                                }
                            </td>
                            <td class="text-muted-custom">@(string.IsNullOrWhiteSpace(login.Portal) ? "—" : login.Portal)</td>
                            <td class="text-muted-custom">@(string.IsNullOrWhiteSpace(login.IpAddress) ? "—" : login.IpAddress)</td>
                            <td class="text-muted-custom small" title="@login.UserAgent">
                                @(login.Browser == "Unknown" && login.OperatingSystem == "Unknown" ? "—" : $"{login.Browser} · {login.OperatingSystem}")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
