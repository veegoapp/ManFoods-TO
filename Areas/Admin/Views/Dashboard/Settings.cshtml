<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script>
const setL = document.getElementById('setL').dataset;

const SET_METRICS = [
    { key: 'turnover',   title: setL.metricTurnoverTitle,  sub: setL.metricTurnoverSub },
    { key: 'turnover-total', title: setL.metricTurnoverTotalTitle, sub: setL.metricTurnoverTotalSub },
    { key: 'ninety-day', title: setL.metricNinetyTitle,    sub: setL.metricNinetySub },
    { key: 'ninety-day-total', title: setL.metricNinetyTotalTitle, sub: setL.metricNinetyTotalSub },
    { key: 'retention',  title: setL.metricRetentionTitle, sub: setL.metricRetentionSub },
    { key: 'early-warning', title: setL.metricEwTitle, sub: setL.metricEwSub, unit: '★', step: 1, max: 5 },
];

const SET_COLOR_OPTIONS = [
    { value: 'none',           label: setL.colorNone },
    { value: 'good',           label: setL.colorGreen },
    { value: 'warning',        label: setL.colorYellow },
    { value: 'warning_strong', label: setL.colorOrange },
    { value: 'bad',            label: setL.colorRed },
];

const setState = {}; // metric -> array of { upTo, color }

function setColorHex(name) {
    return { none: '#ffffff', good: ChartColors.SEMANTIC.GOOD, warning: ChartColors.SEMANTIC.WARNING,
             warning_strong: ChartColors.SEMANTIC.WARNING_STRONG, bad: ChartColors.SEMANTIC.BAD }[name] || '#fff';
}

function setColorSelectHtml(selected) {
    return `<select class="form-select form-select-sm set-color-select">
        ${SET_COLOR_OPTIONS.map(o => `<option value="${o.value}" ${o.value === selected ? 'selected' : ''}>${o.label}</option>`).join('')}
    </select>`;
}

function setRenderSection(metric) {
    const section = document.getElementById(`set-section-${metric.key}`);
    const rules = setState[metric.key];
    const rulesEl = section.querySelector('.set-rules');

    rulesEl.innerHTML = rules.map((r, i) => {
        const isLast = i === rules.length - 1;
        if (isLast) {
            return `<div class="set-rule-row" data-i="${i}">
                <span style="min-width:160px;font-size:13px;color:var(--text-2)">${setL.everythingAbove}</span>
                <span>&rarr;</span>
                ${setColorSelectHtml(r.color)}
                <span class="set-swatch" style="background:${setColorHex(r.color)}"></span>
            </div>`;
        }
        return `<div class="set-rule-row" data-i="${i}">
            <span style="font-size:13px;color:var(--text-2)">${setL.upTo}</span>
            <input type="number" step="${metric.step ?? 0.1}" min="0" ${metric.max ? `max="${metric.max}"` : ''} class="form-control form-control-sm set-upto-input" value="${r.upTo}">
            <span style="font-size:13px;color:var(--text-2)">${metric.unit ?? '%'}</span>
            <span>&rarr;</span>
            ${setColorSelectHtml(r.color)}
            <span class="set-swatch" style="background:${setColorHex(r.color)}"></span>
            <button type="button" class="btn btn-sm btn-outline-danger set-remove-btn" style="padding:2px 9px"><i class="bi bi-trash"></i></button>
        </div>`;
    }).join('');

    rulesEl.querySelectorAll('.set-rule-row').forEach(row => {
        const i = parseInt(row.dataset.i);
        const uptoInput = row.querySelector('.set-upto-input');
        if (uptoInput) uptoInput.addEventListener('input', () => { rules[i].upTo = parseFloat(uptoInput.value) || 0; setRenderPreview(metric); });
        row.querySelector('.set-color-select').addEventListener('change', e => {
            rules[i].color = e.target.value;
            row.querySelector('.set-swatch').style.background = setColorHex(e.target.value);
            setRenderPreview(metric);
        });
        const removeBtn = row.querySelector('.set-remove-btn');
        if (removeBtn) removeBtn.addEventListener('click', () => {
            rules.splice(i, 1);
            setRenderSection(metric);
        });
    });

    setRenderPreview(metric);
}

function setPreviewBadgeHtml(metric, rules, value) {
    const c = ChartColors.rateColor(rules, value);
    const text = metric.unit === '★' ? value.toFixed(0) + '★' : value.toFixed(1) + '%';
    if (!c.bg) return `<span style="font-weight:700">${text}</span>`;
    return `<span style="background:${c.bg};color:${c.fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${text}</span>`;
}

function setRenderPreview(metric) {
    const rules = setState[metric.key];
    const el = document.getElementById(`set-preview-${metric.key}`);
    // A handful of sample values spanning below/at/between/above the configured cutoffs.
    const cutoffs = rules.filter(r => r.upTo !== null).map(r => r.upTo);
    const max = cutoffs.length ? Math.max(...cutoffs) : 20;
    const upperBound = metric.max ?? Math.round(max * 1.5);
    const samples = new Set([0, ...cutoffs, ...cutoffs.map(c => c + 1), upperBound]);
    el.innerHTML = [...samples].filter(v => !metric.max || v <= metric.max).sort((a, b) => a - b)
        .map(p => setPreviewBadgeHtml(metric, rules, p)).join('');
}

function setAddRule(metric) {
    const rules = setState[metric.key];
    // Insert before the catch-all (last) row, defaulting just above the previous cutoff.
    const prevUpTo = rules.length > 1 ? rules[rules.length - 2].upTo : 0;
    rules.splice(rules.length - 1, 0, { upTo: prevUpTo + 1, color: 'warning' });
    setRenderSection(metric);
}

async function setSave(metric) {
    const statusEl = document.getElementById(`set-status-${metric.key}`);
    const rules = setState[metric.key];
    // Keep rules sorted ascending by upTo (catch-all null rule stays last).
    const sorted = rules.slice(0, -1).sort((a, b) => a.upTo - b.upTo).concat(rules[rules.length - 1]);
    setState[metric.key] = sorted;
    setRenderSection(metric);

    statusEl.textContent = setL.saving;
    statusEl.style.color = 'var(--text-3)';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const r = await fetch(`/api/settings/color-rules/${metric.key}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(sorted.map(r => ({ upTo: r.upTo === null ? null : r.upTo, color: r.color }))),
        });
        if (!r.ok) { statusEl.textContent = setL.saveFailed + (await r.text()); statusEl.style.color = ChartColors.SEMANTIC.BAD; return; }
        statusEl.textContent = setL.saved;
        statusEl.style.color = ChartColors.SEMANTIC.GOOD;
    } catch (e) {
        statusEl.textContent = setL.saveFailed + e.message;
        statusEl.style.color = ChartColors.SEMANTIC.BAD;
    }
}

async function setInit() {
    const container = document.getElementById('setSections');
    container.innerHTML = SET_METRICS.map(m => `
        <div class="chart-card set-card" id="set-section-${m.key}">
            <div class="chart-header">
                <h6>${m.title}</h6>
                <p>${m.sub}</p>
            </div>
            <div style="padding:0 20px 20px">
                <div class="set-rules"></div>
                <div class="set-preview" id="set-preview-${m.key}"></div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary set-add-btn"><i class="bi bi-plus-lg me-1"></i>${setL.addRule}</button>
                    <button type="button" class="btn btn-sm btn-danger ms-2 set-save-btn">${setL.save}</button>
                    <span class="set-save-status" id="set-status-${m.key}"></span>
                </div>
            </div>
        </div>
    `).join('');

    for (const m of SET_METRICS) {
        const r = await fetch(`/api/settings/color-rules/${m.key}`);
        setState[m.key] = r.ok ? await r.json() : [];
        setRenderSection(m);
        document.getElementById(`set-section-${m.key}`).querySelector('.set-add-btn').addEventListener('click', () => setAddRule(m));
        document.getElementById(`set-section-${m.key}`).querySelector('.set-save-btn').addEventListener('click', () => setSave(m));
    }
}

function setShowTab(tab) {
    document.getElementById('setTabColors').hidden = tab !== 'colors';
    document.getElementById('setTabRec').hidden = tab !== 'rec';
    document.getElementById('setTabAprole').hidden = tab !== 'aprole';
    document.getElementById('setTabSeverity').hidden = tab !== 'severity';
    document.getElementById('setTabAccess').hidden = tab !== 'access';
    document.getElementById('setTabBtnColors').classList.toggle('active', tab === 'colors');
    document.getElementById('setTabBtnRec').classList.toggle('active', tab === 'rec');
    document.getElementById('setTabBtnAprole').classList.toggle('active', tab === 'aprole');
    document.getElementById('setTabBtnSeverity').classList.toggle('active', tab === 'severity');
    document.getElementById('setTabBtnAccess').classList.toggle('active', tab === 'access');
    if (tab === 'rec' && !setRecLoaded) setRecInit();
    if (tab === 'aprole' && !setAproleLoaded) setAproleInit();
    if (tab === 'severity' && !setSevLoaded) setSeverityInit();
    if (tab === 'access' && !setAccessLoaded) setAccessInit();
}

// ── Access matrix tab ─────────────────────────────────────────────
let setAccessLoaded = false;
const SET_ACCESS_AREAS = ['analytics','retention','ninety_day','ninety_day_leavers','exit_interviews','exit_comments','early_warning','scorecard','action_center','reports'];

function setAccessEsc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

async function setAccessInit() {
    setAccessLoaded = true;
    const el = document.getElementById('setTabAccess');
    const A = { restricted: el.getAttribute('data-restricted'), open: el.getAttribute('data-open') };
    let map = {};
    try {
        const r = await fetch('/api/settings/access-policy');
        if (r.ok) map = await r.json();
    } catch { /* fall through to defaults */ }

    const rows = SET_ACCESS_AREAS.map(area => {
        const restricted = map[area] !== false; // default restricted
        const label = el.getAttribute('data-area-' + area) || area;
        const desc = el.getAttribute('data-desc-' + area) || '';
        const isSub = area === 'ninety_day_leavers' || area === 'exit_comments';
        return `<div class="set-rule-row" style="align-items:flex-start;${isSub ? 'padding-left:26px' : ''}">
            <label class="set-access-toggle" style="min-width:0;flex:1;cursor:pointer;display:flex;gap:12px;align-items:flex-start">
                <input type="checkbox" data-area="${area}" ${restricted ? 'checked' : ''} style="width:18px;height:18px;margin-top:2px;accent-color:var(--red);flex-shrink:0">
                <span>
                    <span style="font-weight:700;font-size:13.5px">${isSub ? '↳ ' : ''}${setAccessEsc(label)}</span>
                    <span style="display:block;font-size:12px;color:var(--text-3);margin-top:2px">${setAccessEsc(desc)}</span>
                </span>
            </label>
            <span data-state="${area}" style="font-size:11px;font-weight:700;white-space:nowrap;color:${restricted ? 'oklch(0.6 0.14 75)' : 'oklch(0.5 0.15 155)'}">${restricted ? setAccessEsc(A.restricted) : setAccessEsc(A.open)}</span>
        </div>`;
    }).join('');
    document.getElementById('setAccessRows').innerHTML = rows;

    document.querySelectorAll('#setAccessRows input[type=checkbox]').forEach(cb => {
        cb.addEventListener('change', () => {
            const area = cb.dataset.area;
            const stateEl = document.querySelector(`#setAccessRows [data-state="${area}"]`);
            stateEl.textContent = cb.checked ? A.restricted : A.open;
            stateEl.style.color = cb.checked ? 'oklch(0.6 0.14 75)' : 'oklch(0.5 0.15 155)';
        });
    });
}

async function setAccessSave() {
    const setL = document.getElementById('setL').dataset;
    const btn = document.getElementById('setAccessSaveBtn');
    const status = document.getElementById('setAccessStatus');
    const settings = {};
    document.querySelectorAll('#setAccessRows input[type=checkbox]').forEach(cb => { settings[cb.dataset.area] = cb.checked; });

    btn.disabled = true;
    status.textContent = setL.saving || '';
    try {
        const r = await fetch('/api/settings/access-policy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify({ settings })
        });
        status.textContent = r.ok ? setL.saved : setL.saveFailed;
    } catch {
        status.textContent = setL.saveFailed;
    } finally {
        btn.disabled = false;
    }
}

// ── Severity bands tab ────────────────────────────────────────────
let setSevLoaded = false;

function setSevEsc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

async function setSeverityInit() {
    setSevLoaded = true;
    const r = await fetch('/api/action-plan-severity');
    if (r.ok) {
        const cfg = await r.json();
        document.getElementById('setSevMedium').value = cfg.mediumMinSignals;
        document.getElementById('setSevHigh').value = cfg.highMinSignals;
        document.getElementById('setSevCritical').value = cfg.criticalMinSignals;
    }
    await setSeverityLoadHistory();
}

async function setSeverityLoadHistory() {
    const d = setL;
    const container = document.getElementById('setSevHistory');
    const r = await fetch('/api/action-plan-severity/history');
    const rows = r.ok ? await r.json() : [];
    if (rows.length === 0) { container.innerHTML = `<p class="text-muted-custom">${d.sevHistoryNone}</p>`; return; }
    container.innerHTML = `<div style="display:flex;flex-direction:column;gap:8px">` + rows.map(h => `
        <div style="font-size:12.5px;color:var(--text-2);padding:8px 0;border-bottom:1px solid var(--card-border)">
            Medium ≥ ${h.mediumMinSignals} · High ≥ ${h.highMinSignals} · Critical ≥ ${h.criticalMinSignals}
            — ${d.sevHistoryBy} ${setSevEsc(h.changedByName)}, ${new Date(h.changedAt).toLocaleString()}
        </div>
    `).join('') + `</div>`;
}

async function setSeveritySave() {
    const d = setL;
    const statusEl = document.getElementById('setSevStatus');
    const medium = parseInt(document.getElementById('setSevMedium').value, 10);
    const high = parseInt(document.getElementById('setSevHigh').value, 10);
    const critical = parseInt(document.getElementById('setSevCritical').value, 10);

    if (!(medium >= 1 && high >= 1 && critical >= 1 && medium <= high && high <= critical)) {
        statusEl.textContent = d.sevInvalid;
        statusEl.style.color = ChartColors.SEMANTIC.BAD;
        return;
    }

    statusEl.textContent = d.saving;
    statusEl.style.color = 'var(--text-3)';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const r = await fetch('/api/action-plan-severity', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ mediumMinSignals: medium, highMinSignals: high, criticalMinSignals: critical }),
        });
        if (!r.ok) { statusEl.textContent = d.saveFailed + (await r.text()); statusEl.style.color = ChartColors.SEMANTIC.BAD; return; }
        statusEl.textContent = d.saved;
        statusEl.style.color = ChartColors.SEMANTIC.GOOD;
        await setSeverityLoadHistory();
    } catch (e) {
        statusEl.textContent = d.saveFailed + e.message;
        statusEl.style.color = ChartColors.SEMANTIC.BAD;
    }
}

// ── Action Plan Role tab ─────────────────────────────────────────
let setAproleLoaded = false;
let setAproleRows = [];

function setAproleEsc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
function setAproleRoleLabel(role) { return role ? role.replace(/_/g, ' ') : ''; }

function setAproleRowHtml(row) {
    const d = setL;
    const options = row.assignableRoles.map(o =>
        `<option value="${setAproleEsc(o.role)}" ${o.role === row.effectiveRole ? 'selected' : ''}>${setAproleEsc(setAproleRoleLabel(o.role))} — ${setAproleEsc(o.name)}</option>`
    ).join('');

    const badge = row.effectiveRole
        ? (row.isOverridden
            ? `<span class="set-aprole-badge" style="background:oklch(0.75 0.16 75 / .14);color:oklch(0.6 0.14 75)">${d.aproleOverridden}</span>`
            : `<span class="set-aprole-badge" style="background:oklch(0.62 0.15 155 / .12);color:oklch(0.5 0.15 155)">${d.aproleDefault}</span>`)
        : '';

    const controls = row.assignableRoles.length === 0
        ? `<span class="text-muted-custom" style="font-size:12.5px">${d.aproleNoRoles}</span>`
        : `<div class="set-aprole-actions">
            <select class="form-select form-select-sm set-aprole-select">${options}</select>
            <button type="button" class="btn btn-sm btn-danger set-aprole-save-btn">${d.save}</button>
            ${row.isOverridden ? `<button type="button" class="btn btn-sm btn-outline-secondary set-aprole-reset-btn">${d.aproleReset}</button>` : ''}
            <span class="set-save-status set-aprole-status"></span>
        </div>`;

    return `<tr data-store="${setAproleEsc(row.storeName)}">
        <td class="set-aprole-store">${setAproleEsc(row.storeName)}</td>
        <td>${row.effectiveRole ? setAproleEsc(setAproleRoleLabel(row.effectiveRole)) + ' — ' + setAproleEsc(row.effectiveName || '') : '—'}${badge}</td>
        <td>${controls}</td>
    </tr>`;
}

async function setAproleSave(storeName, role) {
    const rowEl = document.querySelector(`#setAproleBody tr[data-store="${CSS.escape(storeName)}"]`);
    const statusEl = rowEl.querySelector('.set-aprole-status');
    const d = setL;

    statusEl.textContent = d.saving;
    statusEl.style.color = 'var(--text-3)';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const r = await fetch(`/api/action-plan-role/${encodeURIComponent(storeName)}/set`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ role }),
        });
        if (!r.ok) { statusEl.textContent = d.saveFailed + (await r.text()); statusEl.style.color = ChartColors.SEMANTIC.BAD; return; }
        statusEl.textContent = d.saved;
        statusEl.style.color = ChartColors.SEMANTIC.GOOD;
        await setAproleRefreshRow(storeName);
    } catch (e) {
        statusEl.textContent = d.saveFailed + e.message;
        statusEl.style.color = ChartColors.SEMANTIC.BAD;
    }
}

async function setAproleRefreshRow(storeName) {
    const r = await fetch('/api/action-plan-role/stores');
    if (!r.ok) return;
    setAproleRows = await r.json();
    setAproleRenderFiltered();
}

function setAproleBindRow(row) {
    const rowEl = document.querySelector(`#setAproleBody tr[data-store="${CSS.escape(row.storeName)}"]`);
    if (!rowEl) return;
    const select = rowEl.querySelector('.set-aprole-select');
    const saveBtn = rowEl.querySelector('.set-aprole-save-btn');
    const resetBtn = rowEl.querySelector('.set-aprole-reset-btn');
    if (saveBtn) saveBtn.addEventListener('click', () => setAproleSave(row.storeName, select.value));
    if (resetBtn) resetBtn.addEventListener('click', () => setAproleSave(row.storeName, null));
}

function setAproleRenderFiltered() {
    const q = (document.getElementById('setAproleSearch').value || '').trim().toLowerCase();
    const filtered = q ? setAproleRows.filter(r => r.storeName.toLowerCase().includes(q)) : setAproleRows;
    const body = document.getElementById('setAproleBody');
    body.innerHTML = filtered.map(setAproleRowHtml).join('');
    filtered.forEach(setAproleBindRow);
}

async function setAproleInit() {
    setAproleLoaded = true;
    const r = await fetch('/api/action-plan-role/stores');
    setAproleRows = r.ok ? await r.json() : [];
    setAproleRenderFiltered();
    document.getElementById('setAproleSearch').addEventListener('input', setAproleRenderFiltered);
}

// ── Recommendations tab ──────────────────────────────────────────
// Friendly group labels, keyed by "SignalCode|Category" — matches the same
// (SignalCode, Category, Index) triple RecommendationTemplateService uses.
const SET_REC_GROUP_LABELS = {
    'HIGH_OVERALL_TURNOVER|Retention': setL.recGroupHighTurnover,
    'EARLY_TURNOVER_90D|Onboarding': setL.recGroupEarlyTurnover90,
    'LOW_RETENTION_6M|Retention': setL.recGroupLowRetention6m,
    'LEADERSHIP_INSTABILITY|Leadership': setL.recGroupLeadershipInstability,
    'LOW_EXIT_SENTIMENT|Culture': setL.recGroupLowExitSentiment,
    'REASON_CONCENTRATION|Compensation': setL.recGroupReasonCompensation,
    'REASON_CONCENTRATION|Workload': setL.recGroupReasonWorkload,
    'REASON_CONCENTRATION|Management': setL.recGroupReasonManagement,
    'REASON_CONCENTRATION|Onboarding': setL.recGroupReasonOnboarding,
    'REASON_CONCENTRATION|Other': setL.recGroupReasonOther,
    'EARLY_WARNING_WATCHLIST|Monitoring': setL.recGroupEarlyWarningWatchlist,
    'NO_DOMINANT_DRIVER|General': setL.recGroupNoDominantDriver,
};

let setRecLoaded = false;
let setRecTemplates = [];

function setRecEsc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
function setRecRowId(t) { return `${t.signalCode}__${t.category}__${t.index}`; }

function setRecRowHtml(t) {
    const id = setRecRowId(t);
    const updated = t.updatedAtUtc
        ? `${setL.recLastUpdated}: ${new Date(t.updatedAtUtc).toLocaleString()}`
        : setL.recNeverEdited;
    return `<div class="card-dark set-rec-row" id="set-rec-row-${id}" data-signal="${setRecEsc(t.signalCode)}" data-category="${setRecEsc(t.category)}" data-index="${t.index}">
        <div class="set-rec-fields">
            <div class="set-rec-field">
                <label>${setL.recTextEn}</label>
                <textarea class="form-control set-rec-en" dir="ltr">${setRecEsc(t.textEn)}</textarea>
            </div>
            <div class="set-rec-field">
                <label>${setL.recTextAr}</label>
                <textarea class="form-control set-rec-ar" dir="rtl">${setRecEsc(t.textAr)}</textarea>
            </div>
        </div>
        <div class="set-rec-actions">
            <button type="button" class="btn btn-sm btn-danger set-rec-save-btn">${setL.save}</button>
            <span class="set-rec-meta set-rec-updated">${updated}</span>
            <span class="set-save-status set-rec-status"></span>
        </div>
    </div>`;
}

async function setRecSave(t) {
    const row = document.getElementById(`set-rec-row-${setRecRowId(t)}`);
    const statusEl = row.querySelector('.set-rec-status');
    const textEn = row.querySelector('.set-rec-en').value.trim();
    const textAr = row.querySelector('.set-rec-ar').value.trim();

    statusEl.textContent = setL.saving;
    statusEl.style.color = 'var(--text-3)';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const r = await fetch('/api/settings/recommendation-templates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ signalCode: t.signalCode, category: t.category, index: t.index, textEn, textAr }),
        });
        if (!r.ok) { statusEl.textContent = setL.saveFailed + (await r.text()); statusEl.style.color = ChartColors.SEMANTIC.BAD; return; }
        statusEl.textContent = setL.saved;
        statusEl.style.color = ChartColors.SEMANTIC.GOOD;
        row.querySelector('.set-rec-updated').textContent = `${setL.recLastUpdated}: ${new Date().toLocaleString()}`;
    } catch (e) {
        statusEl.textContent = setL.saveFailed + e.message;
        statusEl.style.color = ChartColors.SEMANTIC.BAD;
    }
}

async function setRecInit() {
    setRecLoaded = true;
    const container = document.getElementById('setRecSections');
    const r = await fetch('/api/settings/recommendation-templates');
    setRecTemplates = r.ok ? await r.json() : [];

    const groups = new Map();
    for (const t of setRecTemplates) {
        const key = `${t.signalCode}|${t.category}`;
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push(t);
    }

    container.innerHTML = [...groups.entries()].map(([key, rows]) => `
        <div class="chart-card set-card set-rec-group">
            <div class="chart-header"><h6>${SET_REC_GROUP_LABELS[key] || key}</h6></div>
            <div style="padding:0 20px 20px;display:flex;flex-direction:column;gap:14px">
                ${rows.sort((a, b) => a.index - b.index).map(setRecRowHtml).join('')}
            </div>
        </div>
    `).join('');

    for (const t of setRecTemplates) {
        document.getElementById(`set-rec-row-${setRecRowId(t)}`)
            .querySelector('.set-rec-save-btn')
            .addEventListener('click', () => setRecSave(t));
    }
}

setInit();
</script>
