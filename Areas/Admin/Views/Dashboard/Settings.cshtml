@{
    ViewData["Title"] = L["Page_Settings"].Value;
}

<style>
.set-card { margin-bottom: 28px; }
.set-rules { display: flex; flex-direction: column; gap: 8px; margin: 16px 0; }
.set-rule-row { display: flex; align-items: center; gap: 10px; }
.set-rule-row .form-control, .set-rule-row .form-select { max-width: 160px; }
.set-swatch { width: 16px; height: 16px; border-radius: 4px; flex-shrink: 0; border: 1px solid rgba(0,0,0,.08); }
.set-preview { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 18px; }
.set-save-status { font-size: 12.5px; margin-inline-start: 10px; }

.set-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--card-border); margin-bottom: 22px; }
.set-tab-btn {
    background: transparent; border: none; border-bottom: 2px solid transparent;
    padding: 10px 4px; margin-inline-end: 22px; font-size: 14px; font-weight: 600;
    color: var(--text-3); cursor: pointer;
}
.set-tab-btn.active { color: var(--red); border-bottom-color: var(--red); }
.set-rec-group { margin-bottom: 22px; }
.set-rec-row { display: flex; flex-direction: column; gap: 10px; padding: 16px 18px; }
.set-rec-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@@media (max-width: 900px) { .set-rec-fields { grid-template-columns: 1fr; } }
.set-rec-field label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: var(--text-3); margin-bottom: 4px; display: block; }
.set-rec-field textarea { width: 100%; min-height: 64px; resize: vertical; }
.set-rec-field textarea[dir="rtl"] { text-align: right; }
.set-rec-meta { font-size: 12px; color: var(--text-3); }
.set-rec-actions { display: flex; align-items: center; gap: 10px; }
.set-aprole-search { max-width: 320px; margin-bottom: 16px; }
.set-aprole-table { width: 100%; border-collapse: collapse; }
.set-aprole-table th { text-align: start; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: var(--text-3); padding: 8px 10px; border-bottom: 1px solid var(--card-border); }
.set-aprole-table td { padding: 10px; border-bottom: 1px solid var(--card-border); vertical-align: middle; }
.set-aprole-store { font-weight: 600; }
.set-aprole-badge { padding: 2px 9px; border-radius: 20px; font-size: 10.5px; font-weight: 700; display: inline-block; margin-inline-start: 8px; }
.set-aprole-select { min-width: 220px; }
.set-aprole-actions { display: flex; align-items: center; gap: 8px; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_Settings"]</h1>
        <p class="page-subtitle">@L["Page_SettingsSub"]</p>
    </div>
</div>

<div class="set-tabs">
    <button type="button" class="set-tab-btn active" id="setTabBtnColors" onclick="setShowTab('colors')">@L["Set_Tab_Colors"]</button>
    <button type="button" class="set-tab-btn" id="setTabBtnRec" onclick="setShowTab('rec')">@L["Set_Tab_Recommendations"]</button>
    <button type="button" class="set-tab-btn" id="setTabBtnAprole" onclick="setShowTab('aprole')">@L["Set_Tab_ActionPlanRole"]</button>
    <button type="button" class="set-tab-btn" id="setTabBtnSeverity" onclick="setShowTab('severity')">@L["Set_Tab_Severity"]</button>
    <button type="button" class="set-tab-btn" id="setTabBtnAccess" onclick="setShowTab('access')">@L["Set_Tab_Access"]</button>
</div>

