@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpCtx
@inject Microsoft.Extensions.Localization.IStringLocalizer<MvcApp.Resources.SharedResource> L
@inject MvcApp.Services.IDataFreshnessService DataFreshness
@inject MvcApp.Services.IPageVisibilityService PageVis
@{
    var session      = HttpCtx.HttpContext?.Session;
    var userEmail    = session?.GetString("Email") ?? "";
    var userRole     = session?.GetString("Role")  ?? "";
    var currentPath  = HttpCtx.HttpContext?.Request.Path.Value ?? "";
    // Exact path-segment match, not substring — "Turnover" is itself a substring
    // of "NinetyDayTurnover", so a plain Contains() lit up both nav links at once
    // whenever the 90-Day Turnover page was active.
    bool IsActive(string seg) => currentPath
        .Split('/', StringSplitOptions.RemoveEmptyEntries)
        .Any(s => string.Equals(s, seg, StringComparison.OrdinalIgnoreCase));
    var initials     = string.IsNullOrEmpty(userEmail) ? "A" : userEmail.Substring(0,1).ToUpper();
    var currentLang  = HttpCtx.HttpContext?.Request.Cookies["mf-lang"] ?? "en";
    var isRtl        = currentLang == "ar";
    var returnUrl    = HttpCtx.HttpContext?.Request.Path.Value ?? "/";
    var switchLang   = isRtl ? "en" : "ar";
    var __area       = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
    // This layout also serves the User (Home) portal. Pages an Admin hid for this person's role in Settings → Pages
    // are left out of the sidebar; the Admin portal always shows everything.
    var hiddenPages = userRole == "Admin" ? new HashSet<string>() : await PageVis.GetHiddenAsync(userRole);
    var latestDataPeriod = await DataFreshness.GetLatestDataPeriodAsync();
    var latestDataPeriodLabel = latestDataPeriod is null
        ? ""
        : new DateTime(latestDataPeriod.Year, latestDataPeriod.Month, 1)
            .ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
}
<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " + L["Brand_Hub"].Value : L["Brand_HubCrewLevel"].Value)</title>
    <link rel="icon" type="image/png" href="~/images/mclogo.png"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css"/>
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('mf-theme') || 'light');</script>
</head>
<body class="admin-theme" data-theme="light" data-area-prefix="@__areaPrefix"
      data-range-badge-on="@L["Common_RangeBadgeOn"]" data-range-badge-off="@L["Common_RangeBadgeOff"]"
      data-kpi-headcount="@L["Common_TotalHeadcount"]" data-kpi-new-hires="@L["Common_NewHires"]"
      data-kpi-resignations="@L["Common_Resignations"]" data-kpi-turnover-rate="@L["Common_TurnoverRate"]"
      data-resignations-suffix="@L["Common_ResignationsCountSuffix"]">
<script>document.body.setAttribute('data-theme', localStorage.getItem('mf-theme') || 'light');</script>

<div class="admin-shell">
    <!-- ══ GLOBAL HEADER — full-width, brand left, logo pinned top-right ══ -->
    <header class="admin-global-header">
        <a class="admin-global-brand" href="@__areaPrefix/dashboard/turnover" style="text-decoration:none">
            <div class="admin-global-logo"><img src="/images/mclogo.png" alt="@L["Brand_McdEgypt"]"/></div>
            <div>
                <div class="admin-global-brand-line1">@L["Brand_McdEgypt"]</div>
                <div class="admin-global-brand-main">@L["Brand_CrewHub"]</div>
            </div>
        </a>
        <div class="admin-global-right">
            <partial name="_UserMenu" model="@(userRole == "Admin" ? "Admin" : "Home")" />
        </div>
    </header>

    <div class="admin-body">
    <!-- ══ SIDEBAR ════════════════════════════════════════ -->
    <aside class="admin-sidebar" id="adminSidebar">
        <nav class="admin-sidebar-nav">
            @if (!hiddenPages.Contains("workforce"))
            {
                <a href="@__areaPrefix/dashboard/workforce" class="admin-nav-link @(IsActive("Workforce") ? "active" : "")">
                    <i class="bi bi-people-fill"></i><span>@L["Nav_Workforce"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("workforceplanning"))
            {
                <a href="@__areaPrefix/dashboard/workforceplanning" class="admin-nav-link @(IsActive("WorkforcePlanning") ? "active" : "")">
                    <i class="bi bi-diagram-3-fill"></i><span>@L["Nav_WorkforcePlanning"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("hiringforecast"))
            {
                <a href="@__areaPrefix/dashboard/hiringforecast" class="admin-nav-link @(IsActive("HiringForecast") ? "active" : "")">
                    <i class="bi bi-person-plus-fill"></i><span>@L["Nav_HiringForecast"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("crewtrainers"))
            {
                <a href="@__areaPrefix/dashboard/crewtrainers" class="admin-nav-link @(IsActive("CrewTrainers") ? "active" : "")">
                    <i class="bi bi-mortarboard-fill"></i><span>@L["Nav_CrewTrainers"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("turnover"))
            {
                <a href="@__areaPrefix/dashboard/turnover" class="admin-nav-link @(IsActive("Turnover") ? "active" : "")">
                    <i class="bi bi-pie-chart-fill"></i><span>@L["Nav_Turnover"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("ninetyday"))
            {
                <a href="@__areaPrefix/dashboard/ninetydayturnover" class="admin-nav-link @(IsActive("NinetyDayTurnover") ? "active" : "")">
                    <i class="bi bi-hourglass-split"></i><span>@L["Nav_NinetyDay"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("comparisons"))
            {
                <a href="@__areaPrefix/dashboard/comparisons" class="admin-nav-link @(IsActive("Comparisons") ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i><span>@L["Nav_Comparisons"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("retention"))
            {
                <a href="@__areaPrefix/dashboard/retention" class="admin-nav-link @(IsActive("Retention") ? "active" : "")">
                    <i class="bi bi-graph-up-arrow"></i><span>@L["Nav_Retention"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("exitinterviews"))
            {
                <a href="@__areaPrefix/dashboard/exitinterviews" class="admin-nav-link @(IsActive("ExitInterviews") ? "active" : "")">
                    <i class="bi bi-chat-square-text-fill"></i><span>@L["Nav_ExitInterviews"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("earlywarning"))
            {
                <a href="@__areaPrefix/dashboard/earlywarning" class="admin-nav-link @(IsActive("EarlyWarning") ? "active" : "")">
                    <i class="bi bi-exclamation-diamond-fill"></i><span>@L["Nav_EarlyWarning"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("scorecard"))
            {
                <a href="@__areaPrefix/dashboard/scorecard" class="admin-nav-link @(IsActive("Scorecard") ? "active" : "")">
                    <i class="bi bi-award-fill"></i><span>@L["Nav_Scorecard"]</span>
                </a>
            }
            @{ var acSectionActive = IsActive("ActionCenter") || IsActive("ActionCenterDetail") || IsActive("ActionPlanGuide"); }
            @if (!hiddenPages.Contains("actioncenter"))
            {
                <a href="@__areaPrefix/dashboard/actioncenter" class="admin-nav-link @(acSectionActive ? "active" : "")">
                    <i class="bi bi-bullseye"></i><span>@L["Nav_ActionCenter"]</span>
                </a>
                @if (acSectionActive)
                {
                    <div class="admin-nav-submenu">
                        <a href="@__areaPrefix/dashboard/actionplanguide" class="admin-nav-sublink @(IsActive("ActionPlanGuide") ? "active" : "")">
                            <i class="bi bi-book-half"></i><span>@L["Nav_ActionPlanGuide"]</span>
                        </a>
                    </div>
                }
            }
            @if (!hiddenPages.Contains("stores"))
            {
                <a href="@__areaPrefix/dashboard/stores" class="admin-nav-link @(IsActive("Stores") ? "active" : "")">
                    <i class="bi bi-shop"></i><span>@L["Nav_Stores"]</span>
                </a>
            }
            @if (userRole == "Admin")
            {
                <a href="/admin/dashboard/uploads" class="admin-nav-link @(IsActive("Uploads") ? "active" : "")">
                    <i class="bi bi-cloud-upload-fill"></i><span>@L["Nav_DataManagement"]</span>
                </a>
            }
            @if (!hiddenPages.Contains("reports"))
            {
                <a href="@__areaPrefix/dashboard/reports" class="admin-nav-link @(IsActive("Reports") ? "active" : "")">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i><span>@L["Nav_Reports"]</span>
                </a>
            }
            @if (userRole == "Admin")
            {
                <a href="/admin/dashboard/users" class="admin-nav-link @(IsActive("Users") ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i><span>@L["Nav_Users"]</span>
                </a>
                @if (MvcApp.Services.SuperAdminPolicy.IsSuperAdmin(userEmail))
                {
                    <a href="/admin/dashboard/activitylogs" class="admin-nav-link @(IsActive("ActivityLogs") ? "active" : "")">
                        <i class="bi bi-clock-history"></i><span>@L["Nav_ActivityLogs"]</span>
                    </a>
                }
                <a href="/admin/dashboard/settings" class="admin-nav-link @(IsActive("Settings") ? "active" : "")">
                    <i class="bi bi-sliders"></i><span>@L["Nav_Settings"]</span>
                </a>
            }
        </nav>

    </aside>

    <!-- ══ MAIN ═══════════════════════════════════════════ -->
    <div class="admin-main">
        <header class="admin-topbar">
            <button class="admin-hamburger" id="adminSidebarToggle" aria-label="@L["Common_ToggleMenu"]">
                <i class="bi bi-list"></i>
            </button>
        </header>

        <main class="admin-content">
            @{
                // ViewData takes priority: pages that render their result directly
                // (no redirect) use ViewData so the message can't be lost to a
                // cookie/redirect round trip; other pages still use the classic
                // TempData+RedirectToAction pattern.
                var successMessage = ViewData["Success"] ?? TempData["Success"];
                var errorMessage = ViewData["Error"] ?? TempData["Error"];
                var warningMessage = ViewData["Warning"] ?? TempData["Warning"];
            }
            @if (successMessage != null)
            {
                <div class="alert-banner alert-success-banner">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                </div>
            }
            @if (warningMessage != null)
            {
                <div class="alert-banner alert-warning-banner">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@warningMessage
                </div>
            }
            @if (errorMessage != null)
            {
                <div class="alert-banner alert-error-banner">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                </div>
            }
            @if (latestDataPeriod is not null)
            {
                <div class="data-freshness-wrap">
                    <span class="data-freshness-chip" role="status" title="@L["Layout_DataFreshnessCaption"]">
                        <i class="bi bi-database-check"></i>
                        <span class="data-freshness-label">@L["Layout_DataFreshnessLabel"]:</span>
                        <strong class="data-freshness-period">@latestDataPeriodLabel</strong>
                    </span>
                </div>
            }
            <div class="page-content">
                @RenderBody()
            </div>
            <div class="portal-footer">&copy; @DateTime.Now.Year @L["Layout_FooterText"]</div>
        </main>
    </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    // Mobile sidebar toggle
    const toggle  = document.getElementById('adminSidebarToggle');
    const sidebar = document.getElementById('adminSidebar');
    if (toggle) {
        toggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
            if (sidebar.classList.contains('open') && !sidebar.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });
    }

    // Theme toggle
    const themeBtn = document.getElementById('themeToggle');
    const body = document.body;
    const saved = localStorage.getItem('mf-theme') || 'light';
    body.setAttribute('data-theme', saved);
    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const next = body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', next);
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('mf-theme', next);
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
